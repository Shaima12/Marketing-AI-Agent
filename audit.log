{"t": 1791494154.8868866, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost, launch_date FROM public.products ORDER BY category, list_price DESC", "rows": 17, "error": null}
{"t": 1791494160.044848, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT count(*) AS total_reviews,\n       count(CASE WHEN LOWER(review_text) LIKE '%price%' OR LOWER(review_text) LIKE '%expensive%' OR LOWER(review_text) LIKE '%cheap%' OR LOWER(review_text) LIKE '%competitor%' OR LOWER(review_text) LIKE '%worth%' THEN 1 END) AS price_mention_count\nFROM (SELECT DISTINCT review_id, review_text FROM public.reviews) r", "rows": 1, "error": null}
{"t": 1791494169.4795077, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT review_id, product_id, rating, review_title, review_text\nFROM (SELECT DISTINCT review_id, product_id, rating, review_title, review_text FROM public.reviews) r\nWHERE LOWER(review_text) LIKE '%competitor%' OR LOWER(review_text) LIKE '%compete%' OR LOWER(review_title) LIKE '%competitor%'\nLIMIT 20", "rows": 0, "error": null}
{"t": 1791494183.2950106, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT review_id, product_id, rating, review_title, review_text\nFROM (SELECT DISTINCT review_id, product_id, rating, review_title, review_text FROM public.reviews) r\nWHERE LOWER(review_text) LIKE '%brand%' OR LOWER(review_text) LIKE '%other%'\nLIMIT 20", "rows": 20, "error": null}
{"t": 1791494189.1903176, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT review_title, review_text, count(*) \nFROM (SELECT DISTINCT review_id, review_title, review_text FROM public.reviews) r\nWHERE LOWER(review_text) LIKE '%price%' OR LOWER(review_text) LIKE '%expensive%' OR LOWER(review_text) LIKE '%cheap%'\nGROUP BY review_title, review_text\nORDER BY count(*) DESC\nLIMIT 15", "rows": 15, "error": null}
{"t": 1791494195.1254058, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT count(CASE WHEN LOWER(review_text) LIKE '%expensive%' THEN 1 END) AS mentions_expensive,\n       count(CASE WHEN LOWER(review_text) LIKE '%overpriced%' THEN 1 END) AS mentions_overpriced,\n       count(CASE WHEN LOWER(review_text) LIKE '%cheap%' THEN 1 END) AS mentions_cheap,\n       count(CASE WHEN LOWER(review_text) LIKE '%compet%' THEN 1 END) AS mentions_compet,\n       count(CASE WHEN LOWER(review_text) LIKE '%alternative%' THEN 1 END) AS mentions_alternative\nFROM (SELECT DISTINCT review_id, review_text FROM public.reviews) r", "rows": 1, "error": null}
{"t": 1791494198.9371502, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT review_id, product_id, rating, review_title, review_text\nFROM (SELECT DISTINCT review_id, product_id, rating, review_title, review_text FROM public.reviews) r\nWHERE LOWER(review_text) LIKE '%expensive%' OR LOWER(review_text) LIKE '%overpriced%'", "rows": 6, "error": null}
{"t": 1791494203.5850065, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT table_schema, table_name \nFROM information_schema.tables \nWHERE table_schema NOT IN ('information_schema', 'pg_catalog')", "rows": 10, "error": null}
{"t": 1791494236.33287, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n  p.category,\n  count(DISTINCT p.product_id) AS product_count,\n  min(p.list_price) AS min_list_price,\n  max(p.list_price) AS max_list_price,\n  round(avg(p.list_price), 2) AS avg_list_price,\n  round(avg(p.unit_cost), 2) AS avg_unit_cost,\n  round(avg((p.list_price - p.unit_cost) / p.list_price) * 100, 1) AS avg_list_markup_pct,\n  round(sum(oi.quantity * oi.unit_price) / nullif(sum(oi.quantity), 0), 2) AS avg_realized_price,\n  round(avg(oi.discount_pct) * 100, 1) AS avg_discount_pct\nFROM public.products p\nLEFT JOIN public.order_items oi ON p.product_id = oi.product_id\nLEFT JOIN public.orders o ON oi.order_id = o.order_id AND o.status = 'delivered'\nLEFT JOIN public.customers c ON o.customer_id = c.customer_id AND c.is_internal = false\nGROUP BY p.category\nORDER BY avg_list_price DESC", "rows": 6, "error": null}
{"t": 1791540932.5044513, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost FROM public.products ORDER BY category, product_name;", "rows": 17, "error": null}
{"t": 1791540964.2354574, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT table_schema, table_name FROM information_schema.tables WHERE table_schema NOT IN ('information_schema', 'pg_catalog');", "rows": 10, "error": null}
{"t": 1791540968.928351, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT DISTINCT review_id, product_id, rating, review_title, review_text\nFROM public.reviews\nWHERE LOWER(review_text) LIKE '%compet%'\n   OR LOWER(review_title) LIKE '%compet%'\n   OR LOWER(review_text) LIKE '%price%'\n   OR LOWER(review_title) LIKE '%price%'\n   OR LOWER(review_text) LIKE '%expensive%'\n   OR LOWER(review_text) LIKE '%cheap%'\nLIMIT 20;", "rows": 20, "error": null}
{"t": 1791567838.4609616, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    COUNT(*) AS total_reviews,\n    COUNT(CASE WHEN LOWER(review_text) LIKE '%competitor%' \n                 OR LOWER(review_text) LIKE '%cheaper%' \n                 OR LOWER(review_text) LIKE '%expensive%' \n                 OR LOWER(review_text) LIKE '%price%' \n                 OR LOWER(review_text) LIKE '%alternative%' \n               THEN 1 END) AS price_or_competitor_mentions\nFROM public.reviews;", "rows": 1, "error": null}
{"t": 1791568424.0641387, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT p.category, \n       COUNT(DISTINCT r.review_id) AS total_reviews, \n       ROUND(AVG(r.rating), 2) AS avg_rating,\n       COUNT(DISTINCT CASE WHEN r.rating <= 2 THEN r.review_id END) AS low_star_reviews,\n       ROUND(COUNT(DISTINCT CASE WHEN r.rating <= 2 THEN r.review_id END)::numeric / COUNT(DISTINCT r.review_id)::numeric * 100, 2) AS pct_low_star\nFROM (SELECT DISTINCT * FROM public.reviews) r\nJOIN public.customers c ON r.customer_id = c.customer_id\nJOIN public.products p ON r.product_id = p.product_id\nWHERE c.is_internal = false\nGROUP BY p.category\nORDER BY avg_rating ASC;", "rows": 6, "error": null}
{"t": 1791569744.6571176, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost, launch_date\nFROM public.products\nWHERE product_name ILIKE '%Trail Shell%' OR product_name ILIKE '%Jacket%';", "rows": 2, "error": null}
{"t": 1791569811.892301, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT rating, COUNT(*) AS cnt\nFROM (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01'\n) r\nGROUP BY rating\nORDER BY rating DESC;", "rows": 4, "error": null}
{"t": 1791569839.722412, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT rating, review_title, review_text\nFROM (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01'\n) r\nLIMIT 30;", "rows": 30, "error": null}
{"t": 1791569881.4414368, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01'\n)\nSELECT \n  rating >= 4 AS is_positive,\n  COUNT(*) AS total_reviews,\n  COUNT(CASE WHEN review_text ILIKE '%light%' THEN 1 END) AS mentions_light,\n  COUNT(CASE WHEN review_text ILIKE '%pack%' OR review_text ILIKE '%stuff%' THEN 1 END) AS mentions_packable,\n  COUNT(CASE WHEN review_text ILIKE '%rain%' OR review_text ILIKE '%drizzle%' OR review_text ILIKE '%dry%' THEN 1 END) AS mentions_rain,\n  COUNT(CASE WHEN review_text ILIKE '%fit%' OR review_text ILIKE '%size%' THEN 1 END) AS mentions_fit_size,\n  COUNT(CASE WHEN review_text ILIKE '%pocket%' THEN 1 END) AS mentions_pocket,\n  COUNT(CASE WHEN review_text ILIKE '%ship%' OR review_text ILIKE '%arrive%' THEN 1 END) AS mentions_shipping\nFROM deduped_reviews\nGROUP BY rating >= 4;", "rows": 2, "error": null}
{"t": 1791570043.9369905, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01' AND rating <= 3 AND review_text IS NOT NULL\n)\nSELECT review_text, COUNT(*) as cnt\nFROM deduped_reviews\nGROUP BY review_text\nORDER BY cnt DESC\nLIMIT 30;", "rows": 30, "error": null}
{"t": 1791570101.1509085, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01' AND rating <= 3\n)\nSELECT \n  COUNT(*) as total_low_rating_reviews,\n  COUNT(CASE WHEN review_text ILIKE '%pocket%' THEN 1 END) AS pocket_complaints,\n  COUNT(CASE WHEN review_text ILIKE '%pocket%' THEN 1 END) * 100.0 / COUNT(*) AS pocket_pct,\n  COUNT(CASE WHEN review_text ILIKE '%runs small%' OR review_text ILIKE '%size up%' OR (review_text ILIKE '%fit%' AND NOT review_text ILIKE '%spot on%' AND NOT review_text ILIKE '%hoped%') THEN 1 END) AS fit_sizing_complaints,\n  COUNT(CASE WHEN review_text ILIKE '%runs small%' OR review_text ILIKE '%size up%' OR (review_text ILIKE '%fit%' AND NOT review_text ILIKE '%spot on%' AND NOT review_text ILIKE '%hoped%') THEN 1 END) * 100.0 / COUNT(*) AS fit_pct,\n  COUNT(CASE WHEN review_text ILIKE '%overpriced%' OR review_text ILIKE '%price%' THEN 1 END) AS price_complaints,\n  COUNT(CASE WHEN review_text ILIKE '%downpour%' OR review_text ILIKE '%not a downpour%' THEN 1 END) AS weather_limit_complaints\nFROM deduped_reviews;", "rows": 1, "error": null}
{"t": 1791570129.7831273, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01' AND rating >= 4\n)\nSELECT \n  COUNT(*) as total_positive,\n  COUNT(CASE WHEN review_text ILIKE '%light%' THEN 1 END) AS mentions_light,\n  COUNT(CASE WHEN review_text ILIKE '%light%' THEN 1 END) * 100.0 / COUNT(*) AS pct_light,\n  COUNT(CASE WHEN review_text ILIKE '%pack%' OR review_text ILIKE '%stuff%' OR review_text ILIKE '%takes no space%' THEN 1 END) AS mentions_packable,\n  COUNT(CASE WHEN review_text ILIKE '%pack%' OR review_text ILIKE '%stuff%' OR review_text ILIKE '%takes no space%' THEN 1 END) * 100.0 / COUNT(*) AS pct_packable,\n  COUNT(CASE WHEN review_text ILIKE '%rain%' OR review_text ILIKE '%drizzle%' OR review_text ILIKE '%dry%' THEN 1 END) AS mentions_weather,\n  COUNT(CASE WHEN review_text ILIKE '%rain%' OR review_text ILIKE '%drizzle%' OR review_text ILIKE '%dry%' THEN 1 END) * 100.0 / COUNT(*) AS pct_weather,\n  COUNT(CASE WHEN review_text ILIKE '%stylish%' OR review_text ILIKE '%understated%' OR review_text ILIKE '%look%' OR review_text ILIKE '%compliment%' THEN 1 END) AS mentions_aesthetic,\n  COUNT(CASE WHEN review_text ILIKE '%stylish%' OR review_text ILIKE '%understated%' OR review_text ILIKE '%look%' OR review_text ILIKE '%compliment%' THEN 1 END) * 100.0 / COUNT(*) AS pct_aesthetic\nFROM deduped_reviews;", "rows": 1, "error": null}
{"t": 1791570223.7049284, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n  o.status,\n  COUNT(*) as order_count\nFROM public.orders o\nJOIN public.order_items oi ON o.order_id = oi.order_id\nWHERE oi.product_id = 'P01'\nGROUP BY o.status;", "rows": 3, "error": null}
{"t": 1791570322.6061528, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n  oi.product_id,\n  p.product_name,\n  COUNT(CASE WHEN o.status = 'returned' THEN 1 END) AS returns,\n  COUNT(CASE WHEN o.status = 'delivered' THEN 1 END) AS delivered,\n  ROUND(COUNT(CASE WHEN o.status = 'returned' THEN 1 END) * 100.0 / NULLIF(COUNT(CASE WHEN o.status IN ('delivered', 'returned') THEN 1 END), 0), 2) AS return_rate_pct\nFROM public.orders o\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nGROUP BY oi.product_id, p.product_name\nORDER BY return_rate_pct DESC;", "rows": 17, "error": null}
{"t": 1791570527.612879, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01'\n)\nSELECT \n  review_text,\n  COUNT(*) as cnt\nFROM deduped_reviews\nWHERE review_text ILIKE '%rain%' OR review_text ILIKE '%water%' OR review_text ILIKE '%drizzle%'\nGROUP BY review_text;", "rows": 121, "error": null}
{"t": 1791570565.7792416, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost\nFROM public.products\nWHERE category = 'Jackets';", "rows": 3, "error": null}
{"t": 1791626513.9605, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT * FROM public.promotions ORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791626569.2857454, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT MIN(order_date) AS min_date, MAX(order_date) AS max_date FROM public.orders;", "rows": 1, "error": null}
{"t": 1791626629.718631, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    o.order_date,\n    COUNT(DISTINCT o.order_id) AS total_orders,\n    COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n    COUNT(DISTINCT CASE WHEN o.discount_code = 'SUMMER25' THEN o.order_id END) AS summer25_orders,\n    SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) AS net_revenue,\n    SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) AS gross_profit\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false\n  AND o.order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY o.order_date\nORDER BY o.order_date;", "rows": 31, "error": null}
{"t": 1791626638.2883255, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT * FROM public.marketing_spend WHERE month BETWEEN '2025-05-01' AND '2025-09-01' ORDER BY month, channel;", "rows": 35, "error": null}
{"t": 1791626659.5146687, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT month, SUM(spend_usd) AS total_spend\nFROM public.marketing_spend\nGROUP BY month\nORDER BY month;", "rows": 12, "error": null}
{"t": 1791626673.226916, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    CASE \n        WHEN o.order_date BETWEEN '2025-06-11' AND '2025-07-10' THEN '30d_pre_sale'\n        WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '10d_pre_sale'\n        WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'sale_10d'\n        WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'post_sale_10d'\n        WHEN o.order_date BETWEEN '2025-07-21' AND '2025-08-19' THEN 'post_sale_30d'\n        ELSE 'other'\n    END AS period,\n    COUNT(DISTINCT o.order_date) AS days,\n    COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n    ROUND(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END)::numeric / COUNT(DISTINCT o.order_date), 2) AS orders_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS net_revenue,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / COUNT(DISTINCT o.order_date), 2) AS rev_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END), 2) AS gross_profit,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) / COUNT(DISTINCT o.order_date), 2) AS gp_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) / NULLIF(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) * 100, 2) AS gross_margin_pct,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / NULLIF(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END), 0), 2) AS aov\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false\n  AND (\n       (o.order_date BETWEEN '2025-06-11' AND '2025-07-10')\n    OR (o.order_date BETWEEN '2025-07-11' AND '2025-07-20')\n    OR (o.order_date BETWEEN '2025-07-21' AND '2025-08-19')\n  )\nGROUP BY 1\nORDER BY 1;", "rows": 4, "error": null}
{"t": 1791626702.172262, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_defs AS (\n    SELECT 'Pre-sale 10d (Jul 1-10)' AS period_name, '2025-07-01'::date AS start_d, '2025-07-10'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Pre-sale 30d (Jun 11-Jul 10)' AS period_name, '2025-06-11'::date AS start_d, '2025-07-10'::date AS end_d, 30 AS num_days\n    UNION ALL\n    SELECT 'Sale 10d (Jul 11-20)' AS period_name, '2025-07-11'::date AS start_d, '2025-07-20'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Post-sale 10d (Jul 21-30)' AS period_name, '2025-07-21'::date AS start_d, '2025-07-30'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Post-sale 30d (Jul 21-Aug 19)' AS period_name, '2025-07-21'::date AS start_d, '2025-08-19'::date AS end_d, 30 AS num_days\n)\nSELECT \n    p.period_name,\n    p.num_days,\n    COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n    ROUND(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END)::numeric / p.num_days, 2) AS orders_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS net_revenue,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / p.num_days, 2) AS rev_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END), 2) AS gross_profit,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END) / p.num_days, 2) AS gp_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END) / NULLIF(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) * 100, 2) AS gross_margin_pct,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / NULLIF(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END), 0), 2) AS aov\nFROM period_defs p\nLEFT JOIN public.orders o ON o.order_date BETWEEN p.start_d AND p.end_d\nLEFT JOIN public.customers c ON o.customer_id = c.customer_id AND c.is_internal = false\nLEFT JOIN public.order_items oi ON o.order_id = oi.order_id\nLEFT JOIN public.products p_prod ON oi.product_id = p_prod.product_id\nWHERE c.customer_id IS NOT NULL OR o.order_id IS NULL\nGROUP BY p.period_name, p.num_days, p.start_d\nORDER BY p.start_d;", "rows": 5, "error": null}
{"t": 1791626775.3848176, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_defs AS (\n    SELECT 'Pre-sale 10d (Jul 1-10)' AS period_name, '2025-07-01'::date AS start_d, '2025-07-10'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Pre-sale 30d (Jun 11-Jul 10)' AS period_name, '2025-06-11'::date AS start_d, '2025-07-10'::date AS end_d, 30 AS num_days\n    UNION ALL\n    SELECT 'Sale 10d (Jul 11-20)' AS period_name, '2025-07-11'::date AS start_d, '2025-07-20'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Post-sale 10d (Jul 21-30)' AS period_name, '2025-07-21'::date AS start_d, '2025-07-30'::date AS end_d, 10 AS num_days\n    UNION ALL\n    SELECT 'Post-sale 30d (Jul 21-Aug 19)' AS period_name, '2025-07-21'::date AS start_d, '2025-08-19'::date AS end_d, 30 AS num_days\n)\nSELECT \n    p.period_name,\n    p.num_days,\n    COUNT(DISTINCT o.order_id) AS total_orders,\n    COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n    ROUND(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END)::numeric / p.num_days, 2) AS orders_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS net_revenue,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / p.num_days, 2) AS rev_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END), 2) AS gross_profit,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END) / p.num_days, 2) AS gp_per_day,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p_prod.unit_cost) ELSE 0 END) / NULLIF(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) * 100, 2) AS gross_margin_pct,\n    ROUND(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) / NULLIF(COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END), 0), 2) AS aov\nFROM period_defs p\nJOIN public.orders o ON o.order_date BETWEEN p.start_d AND p.end_d\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p_prod ON oi.product_id = p_prod.product_id\nWHERE c.is_internal = false\nGROUP BY p.period_name, p.num_days, p.start_d\nORDER BY p.start_d;", "rows": 5, "error": null}
{"t": 1791626856.9989648, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_first_order AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\nsale_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        cfo.first_order_date,\n        CASE WHEN cfo.first_order_date = o.order_date THEN 'new_customer' ELSE 'existing_customer' END AS customer_type,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN customer_first_order cfo ON o.customer_id = cfo.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    GROUP BY o.order_id, o.customer_id, o.order_date, cfo.first_order_date\n)\nSELECT \n    customer_type,\n    COUNT(DISTINCT order_id) AS delivered_orders,\n    COUNT(DISTINCT customer_id) AS distinct_customers,\n    ROUND(SUM(net_revenue), 2) AS total_revenue,\n    ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n    ROUND(SUM(gross_profit) / NULLIF(SUM(net_revenue), 0) * 100, 2) AS gross_margin_pct,\n    ROUND(SUM(net_revenue) / COUNT(DISTINCT order_id), 2) AS aov\nFROM sale_orders\nGROUP BY customer_type;", "rows": 2, "error": null}
{"t": 1791626866.694024, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_first_order AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\nsale_new_customers AS (\n    SELECT DISTINCT customer_id\n    FROM customer_first_order\n    WHERE first_order_date BETWEEN '2025-07-11' AND '2025-07-20'\n)\nSELECT \n    COUNT(DISTINCT snc.customer_id) AS total_new_customers,\n    COUNT(DISTINCT CASE WHEN o.order_date > '2025-07-20' AND o.status = 'delivered' THEN o.customer_id END) AS customers_who_repeated,\n    COUNT(DISTINCT CASE WHEN o.order_date > '2025-07-20' AND o.status = 'delivered' THEN o.order_id END) AS repeat_orders_after_sale,\n    ROUND(SUM(CASE WHEN o.order_date > '2025-07-20' AND o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS post_sale_revenue,\n    ROUND(SUM(CASE WHEN o.order_date > '2025-07-20' AND o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END), 2) AS post_sale_gross_profit\nFROM sale_new_customers snc\nLEFT JOIN public.orders o ON snc.customer_id = o.customer_id\nLEFT JOIN public.order_items oi ON o.order_id = oi.order_id\nLEFT JOIN public.products p ON oi.product_id = p.product_id;", "rows": 1, "error": null}
{"t": 1791626888.4940207, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH daily_stats AS (\n    SELECT \n        o.order_date,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS orders,\n        SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) AS net_revenue,\n        SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.order_date BETWEEN '2025-06-01' AND '2025-08-31'\n    GROUP BY o.order_date\n),\nperiod_metrics AS (\n    SELECT \n        'Pre-sale 10d (Jul 1-10)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(revenue) / 10 AS rev_per_day,\n        SUM(gp) / 10 AS gp_per_day,\n        SUM(gp) / SUM(revenue) * 100 AS margin_pct,\n        SUM(revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-01' AND '2025-07-10'\n    UNION ALL\n    SELECT \n        'Pre-sale 30d (Jun 11-Jul 10)' AS period,\n        30 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 30 AS orders_per_day,\n        SUM(revenue) / 30 AS rev_per_day,\n        SUM(gp) / 30 AS gp_per_day,\n        SUM(gp) / SUM(revenue) * 100 AS margin_pct,\n        SUM(revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-06-11' AND '2025-07-10'\n    UNION ALL\n    SELECT \n        'Sale 10d (Jul 11-20)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(revenue) / 10 AS rev_per_day,\n        SUM(gp) / 10 AS gp_per_day,\n        SUM(gp) / SUM(revenue) * 100 AS margin_pct,\n        SUM(revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    UNION ALL\n    SELECT \n        'Post-sale 10d (Jul 21-30)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(revenue) / 10 AS rev_per_day,\n        SUM(gp) / 10 AS gp_per_day,\n        SUM(gp) / SUM(revenue) * 100 AS margin_pct,\n        SUM(revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-21' AND '2025-07-30'\n    UNION ALL\n    SELECT \n        'Post-sale 30d (Jul 21-Aug 19)' AS period,\n        30 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 30 AS orders_per_day,\n        SUM(revenue) / 30 AS rev_per_day,\n        SUM(gp) / 30 AS gp_per_day,\n        SUM(gp) / SUM(revenue) * 100 AS margin_pct,\n        SUM(revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-21' AND '2025-08-19'\n)\nSELECT \n    period,\n    days,\n    orders,\n    ROUND(orders_per_day, 2) AS orders_per_day,\n    ROUND(revenue, 2) AS revenue,\n    ROUND(rev_per_day, 2) AS rev_per_day,\n    ROUND(gp, 2) AS gp,\n    ROUND(gp_per_day, 2) AS gp_per_day,\n    ROUND(margin_pct, 2) AS margin_pct,\n    ROUND(aov, 2) AS aov\nFROM period_metrics;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42703', 'M': 'column \"revenue\" does not exist', 'P': '977', 'F': 'parse_relation.c', 'L': '3716', 'R': 'errorMissingColumn'}"}
{"t": 1791626931.5619678, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH daily_stats AS (\n    SELECT \n        o.order_date,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS orders,\n        SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) AS net_revenue,\n        SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.order_date BETWEEN '2025-06-01' AND '2025-08-31'\n    GROUP BY o.order_date\n),\nperiod_metrics AS (\n    SELECT \n        'Pre-sale 10d (Jul 1-10)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(net_revenue) / 10 AS rev_per_day,\n        SUM(gross_profit) / 10 AS gp_per_day,\n        SUM(gross_profit) / SUM(net_revenue) * 100 AS margin_pct,\n        SUM(net_revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-01' AND '2025-07-10'\n    UNION ALL\n    SELECT \n        'Pre-sale 30d (Jun 11-Jul 10)' AS period,\n        30 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 30 AS orders_per_day,\n        SUM(net_revenue) / 30 AS rev_per_day,\n        SUM(gross_profit) / 30 AS gp_per_day,\n        SUM(gross_profit) / SUM(net_revenue) * 100 AS margin_pct,\n        SUM(net_revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-06-11' AND '2025-07-10'\n    UNION ALL\n    SELECT \n        'Sale 10d (Jul 11-20)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(net_revenue) / 10 AS rev_per_day,\n        SUM(gross_profit) / 10 AS gp_per_day,\n        SUM(gross_profit) / SUM(net_revenue) * 100 AS margin_pct,\n        SUM(net_revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    UNION ALL\n    SELECT \n        'Post-sale 10d (Jul 21-30)' AS period,\n        10 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 10 AS orders_per_day,\n        SUM(net_revenue) / 10 AS rev_per_day,\n        SUM(gross_profit) / 10 AS gp_per_day,\n        SUM(gross_profit) / SUM(net_revenue) * 100 AS margin_pct,\n        SUM(net_revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-21' AND '2025-07-30'\n    UNION ALL\n    SELECT \n        'Post-sale 30d (Jul 21-Aug 19)' AS period,\n        30 AS days,\n        SUM(orders) AS orders,\n        SUM(net_revenue) AS revenue,\n        SUM(gross_profit) AS gp,\n        SUM(orders)::numeric / 30 AS orders_per_day,\n        SUM(net_revenue) / 30 AS rev_per_day,\n        SUM(gross_profit) / 30 AS gp_per_day,\n        SUM(gross_profit) / SUM(net_revenue) * 100 AS margin_pct,\n        SUM(net_revenue) / SUM(orders) AS aov\n    FROM daily_stats\n    WHERE order_date BETWEEN '2025-07-21' AND '2025-08-19'\n)\nSELECT \n    period,\n    days,\n    orders,\n    ROUND(orders_per_day, 2) AS orders_per_day,\n    ROUND(revenue, 2) AS revenue,\n    ROUND(rev_per_day, 2) AS rev_per_day,\n    ROUND(gp, 2) AS gp,\n    ROUND(gp_per_day, 2) AS gp_per_day,\n    ROUND(margin_pct, 2) AS margin_pct,\n    ROUND(aov, 2) AS aov\nFROM period_metrics;", "rows": 5, "error": null}
{"t": 1791626957.9086883, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH baseline_10 AS (\n    SELECT 41.50::numeric AS base_orders_day, 4530.145::numeric AS base_rev_day, 2584.845::numeric AS base_gp_day\n),\nbaseline_30 AS (\n    SELECT 40.90::numeric AS base_orders_day, 4339.11333::numeric AS base_rev_day, 2487.71333::numeric AS base_gp_day\n)\nSELECT \n    '10-day Sale Window (Jul 11-20) vs 10d Baseline' AS evaluation_window,\n    96884.10 - (b10.base_rev_day * 10) AS incremental_revenue,\n    43722.10 - (b10.base_gp_day * 10) AS incremental_gross_profit,\n    ROUND(((96884.10 / (b10.base_rev_day * 10)) - 1) * 100, 2) AS rev_lift_pct,\n    ROUND(((43722.10 / (b10.base_gp_day * 10)) - 1) * 100, 2) AS gp_lift_pct\nFROM baseline_10 b10\nUNION ALL\nSELECT \n    '10-day Post-Sale Window (Jul 21-30) vs 10d Baseline' AS evaluation_window,\n    41702.90 - (b10.base_rev_day * 10) AS incremental_revenue,\n    23872.90 - (b10.base_gp_day * 10) AS incremental_gross_profit,\n    ROUND(((41702.90 / (b10.base_rev_day * 10)) - 1) * 100, 2) AS rev_lift_pct,\n    ROUND(((23872.90 / (b10.base_gp_day * 10)) - 1) * 100, 2) AS gp_lift_pct\nFROM baseline_10 b10\nUNION ALL\nSELECT \n    'Combined 20-day Window (Sale + 10d Post) vs 10d Baseline' AS evaluation_window,\n    (96884.10 + 41702.90) - (b10.base_rev_day * 20) AS incremental_revenue,\n    (43722.10 + 23872.90) - (b10.base_gp_day * 20) AS incremental_gross_profit,\n    ROUND((((96884.10 + 41702.90) / (b10.base_rev_day * 20)) - 1) * 100, 2) AS rev_lift_pct,\n    ROUND((((43722.10 + 23872.90) / (b10.base_gp_day * 20)) - 1) * 100, 2) AS gp_lift_pct\nFROM baseline_10 b10\nUNION ALL\nSELECT \n    'Combined 40-day Window (Sale + 30d Post) vs 30d Baseline' AS evaluation_window,\n    (96884.10 + 119300.35) - (b30.base_rev_day * 40) AS incremental_revenue,\n    (43722.10 + 68478.35) - (b30.base_gp_day * 40) AS incremental_gross_profit,\n    ROUND((((96884.10 + 119300.35) / (b30.base_rev_day * 40)) - 1) * 100, 2) AS rev_lift_pct,\n    ROUND((((43722.10 + 68478.35) / (b30.base_gp_day * 40)) - 1) * 100, 2) AS gp_lift_pct\nFROM baseline_30 b30;", "rows": 4, "error": null}
{"t": 1791626971.223351, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_orders AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        o.status,\n        o.promised_days,\n        o.ship_days,\n        CASE \n            WHEN o.ship_days > o.promised_days THEN 1 \n            ELSE 0 \n        END AS is_late,\n        CASE \n            WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-sale 10d'\n            WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale 10d'\n            WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-sale 10d'\n        END AS period\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.order_date BETWEEN '2025-07-01' AND '2025-07-30'\n)\nSELECT \n    period,\n    COUNT(*) AS total_orders,\n    SUM(CASE WHEN status = 'delivered' THEN 1 ELSE 0 END) AS delivered_orders,\n    SUM(CASE WHEN status = 'returned' THEN 1 ELSE 0 END) AS returned_orders,\n    SUM(CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END) AS cancelled_orders,\n    ROUND(SUM(CASE WHEN status = 'returned' THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS return_rate_pct,\n    ROUND(SUM(CASE WHEN status = 'cancelled' THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS cancel_rate_pct,\n    SUM(is_late) AS late_orders,\n    ROUND(SUM(is_late)::numeric / NULLIF(SUM(CASE WHEN status = 'delivered' THEN 1 ELSE 0 END), 0) * 100, 2) AS late_pct_of_delivered,\n    ROUND(AVG(ship_days)::numeric, 2) AS avg_ship_days\nFROM period_orders\nGROUP BY period\nORDER BY MIN(order_date);", "rows": 3, "error": null}
{"t": 1791626977.535631, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT se.*, p.product_name, p.category\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nWHERE se.start_date <= '2025-07-31' AND se.end_date >= '2025-07-01'\nORDER BY se.start_date;", "rows": 0, "error": null}
{"t": 1791627003.1693022, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH deduped_reviews AS (\n    SELECT DISTINCT \n        r.review_id,\n        r.order_id,\n        r.product_id,\n        r.customer_id,\n        r.rating,\n        r.review_text,\n        r.review_date\n    FROM public.reviews r\n),\norder_reviews AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        CASE \n            WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-sale 10d'\n            WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale 10d'\n            WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-sale 10d'\n        END AS period,\n        dr.rating\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN deduped_reviews dr ON o.order_id = dr.order_id\n    WHERE c.is_internal = false\n      AND o.order_date BETWEEN '2025-07-01' AND '2025-07-30'\n)\nSELECT \n    period,\n    COUNT(*) AS total_reviews,\n    ROUND(AVG(rating)::numeric, 2) AS avg_rating,\n    SUM(CASE WHEN rating >= 4 THEN 1 ELSE 0 END) AS positive_reviews,\n    ROUND(SUM(CASE WHEN rating >= 4 THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS positive_pct,\n    SUM(CASE WHEN rating <= 2 THEN 1 ELSE 0 END) AS negative_reviews,\n    ROUND(SUM(CASE WHEN rating <= 2 THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS negative_pct\nFROM order_reviews\nGROUP BY period\nORDER BY MIN(order_date);", "rows": 3, "error": null}
{"t": 1791734303.5114903, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost, launch_date FROM public.products WHERE product_name ILIKE '%Trail Shell Jacket%';", "rows": 1, "error": null}
{"t": 1791734459.8727045, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    r.rating,\n    COUNT(*) as review_count,\n    ROUND(COUNT(*)::numeric / SUM(COUNT(*)) OVER () * 100, 1) as pct_of_total\nFROM (\n    SELECT DISTINCT r.review_id, r.order_id, r.product_id, r.customer_id, r.rating, r.review_title, r.review_text, r.review_date, r.verified_purchase\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false AND r.product_id = 'P01'\n) r\nGROUP BY r.rating\nORDER BY r.rating DESC;", "rows": 4, "error": null}
{"t": 1791734464.8731086, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    rating,\n    review_title,\n    review_text\nFROM (\n    SELECT DISTINCT r.review_id, r.order_id, r.product_id, r.customer_id, r.rating, r.review_title, r.review_text\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false AND r.product_id = 'P01'\n) r\nWHERE rating <= 3 AND review_text IS NOT NULL AND length(review_text) > 0\nORDER BY rating ASC\nLIMIT 50;", "rows": 50, "error": null}
{"t": 1791743512.5440786, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT product_id, product_name, category, list_price, unit_cost, launch_date\nFROM public.products\nWHERE product_name ILIKE '%Trail Shell%'", "rows": 1, "error": null}
{"t": 1791743662.1194544, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT rating, COUNT(*) as cnt\nFROM (\n  SELECT DISTINCT review_id, order_id, product_id, customer_id, rating, review_title, review_text, review_date, verified_purchase\n  FROM public.reviews\n  WHERE product_id = 'P01'\n) r\nGROUP BY rating\nORDER BY rating DESC;", "rows": 4, "error": null}
{"t": 1791743798.2899075, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n  r.rating,\n  r.review_title,\n  COUNT(*) as cnt\nFROM (\n  SELECT DISTINCT rev.review_id, rev.product_id, rev.customer_id, rev.rating, rev.review_title, rev.review_text\n  FROM public.reviews rev\n  JOIN public.customers c ON rev.customer_id = c.customer_id\n  WHERE rev.product_id = 'P01' AND c.is_internal = false\n) r\nGROUP BY r.rating, r.review_title\nORDER BY r.rating ASC, cnt DESC\nLIMIT 50;", "rows": 19, "error": null}
{"t": 1791753499.4329643, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791753522.9901175, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    discount_code,\n    COUNT(*) AS total_orders,\n    MIN(order_date) AS first_used,\n    MAX(order_date) AS last_used\nFROM public.orders\nWHERE order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY discount_code\nORDER BY total_orders DESC;", "rows": 5, "error": null}
{"t": 1791753995.6337767, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791754133.9042127, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791754160.5876899, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    MIN(order_date) AS min_date, \n    MAX(order_date) AS max_date \nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791754182.646461, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH valid_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        o.status\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n),\norder_financials AS (\n    SELECT \n        vo.order_id,\n        vo.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM valid_orders vo\n    JOIN public.order_items oi ON vo.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    GROUP BY vo.order_id, vo.order_date\n),\nperiod_tagged AS (\n    SELECT \n        order_id,\n        order_date,\n        net_revenue,\n        gross_profit,\n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1. Baseline (10d: Jul 01 - Jul 10)'\n            WHEN order_date BETWEEN '2025-06-11' AND '2025-07-10' THEN '0. Extended Baseline (30d: Jun 11 - Jul 10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2. Sale Window (10d: Jul 11 - Jul 20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN '3. Post-Sale (10d: Jul 21 - Jul 30)'\n            ELSE 'Other'\n        END AS period_name\n    FROM order_financials\n)\nSELECT \n    CASE \n        WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-Sale (Jul 01 - Jul 10)'\n        WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (Jul 11 - Jul 20)'\n        WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-Sale (Jul 21 - Jul 30)'\n    END AS period,\n    COUNT(DISTINCT order_date) AS days_count,\n    COUNT(order_id) AS delivered_orders,\n    ROUND(COUNT(order_id)::numeric / COUNT(DISTINCT order_date), 2) AS orders_per_day,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(net_revenue) / COUNT(DISTINCT order_date), 2) AS rev_per_day,\n    ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n    ROUND(SUM(gross_profit) / COUNT(DISTINCT order_date), 2) AS gp_per_day,\n    ROUND(SUM(net_revenue) / COUNT(order_id), 2) AS aov,\n    ROUND((SUM(gross_profit) / SUM(net_revenue)) * 100, 2) AS gross_margin_pct\nFROM order_financials\nWHERE order_date BETWEEN '2025-07-01' AND '2025-07-30'\nGROUP BY 1\nORDER BY MIN(order_date);", "rows": 3, "error": null}
