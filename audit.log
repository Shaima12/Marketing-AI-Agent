{"t": 1791802475.8156447, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    MIN(order_date) AS min_date, \n    MAX(order_date) AS max_date \nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791802497.4054856, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT \n        *,\n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1_pre_sale_10d'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2_sale_10d'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN '3_post_sale_10d'\n            WHEN order_date BETWEEN '2025-06-11' AND '2025-07-10' THEN '0_pre_sale_30d'\n            ELSE 'other'\n        END AS period\n    FROM order_level\n)\nSELECT \n    period,\n    COUNT(DISTINCT order_date) AS active_days,\n    COUNT(order_id) AS total_orders,\n    ROUND(COUNT(order_id)::numeric / COUNT(DISTINCT order_date), 2) AS orders_per_day,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(net_revenue) / COUNT(DISTINCT order_date), 2) AS daily_net_revenue,\n    ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n    ROUND(SUM(gross_profit) / COUNT(DISTINCT order_date), 2) AS daily_gross_profit,\n    ROUND(SUM(net_revenue) / COUNT(order_id), 2) AS aov,\n    ROUND((SUM(gross_profit) / SUM(net_revenue)) * 100, 2) AS gross_margin_pct\nFROM period_tagged\nWHERE period IN ('0_pre_sale_30d', '1_pre_sale_10d', '2_sale_10d', '3_post_sale_10d')\nGROUP BY period\nORDER BY period;", "rows": 4, "error": null}
{"t": 1791802624.007266, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH daily_metrics AS (\n    SELECT \n        o.order_date,\n        COUNT(DISTINCT o.order_id) AS orders,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN '2025-07-01' AND '2025-07-30'\n    GROUP BY o.order_date\n),\nperiod_summary AS (\n    SELECT\n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-Sale (10d)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (10d)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-Sale (10d)'\n        END AS period,\n        COUNT(order_date) AS days,\n        SUM(orders) AS total_orders,\n        ROUND(SUM(orders)::numeric / COUNT(order_date), 2) AS daily_orders,\n        ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n        ROUND(SUM(net_revenue) / COUNT(order_date), 2) AS daily_net_revenue,\n        ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n        ROUND(SUM(gross_profit) / COUNT(order_date), 2) AS daily_gross_profit,\n        ROUND(SUM(net_revenue) / SUM(orders), 2) AS aov,\n        ROUND((SUM(gross_profit) / SUM(net_revenue)) * 100, 2) AS gross_margin_pct\n    FROM daily_metrics\n    GROUP BY 1\n)\nSELECT \n    period,\n    days,\n    total_orders,\n    daily_orders,\n    total_net_revenue,\n    daily_net_revenue,\n    total_gross_profit,\n    daily_gross_profit,\n    aov,\n    gross_margin_pct\nFROM period_summary\nORDER BY CASE \n    WHEN period = 'Pre-Sale (10d)' THEN 1 \n    WHEN period = 'Sale (10d)' THEN 2 \n    WHEN period = 'Post-Sale (10d)' THEN 3 \nEND;", "rows": 3, "error": null}
{"t": 1791802806.579872, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_summary AS (\n    SELECT\n        CASE \n            WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-Sale'\n            WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale'\n            WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-Sale'\n        END AS period,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT o.order_date) AS days,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN '2025-07-01' AND '2025-07-30'\n    GROUP BY 1\n),\nmetrics AS (\n    SELECT\n        period,\n        days,\n        total_orders,\n        ROUND(total_orders::numeric / days, 2) AS daily_orders,\n        ROUND(net_revenue, 2) AS total_net_revenue,\n        ROUND(net_revenue / days, 2) AS daily_net_revenue,\n        ROUND(gross_profit, 2) AS total_gross_profit,\n        ROUND(gross_profit / days, 2) AS daily_gross_profit,\n        ROUND(net_revenue / total_orders, 2) AS aov,\n        ROUND((gross_profit / net_revenue) * 100, 2) AS gross_margin_pct\n    FROM period_summary\n)\nSELECT \n    m.period,\n    m.days,\n    m.total_orders,\n    m.daily_orders,\n    m.total_net_revenue,\n    m.daily_net_revenue,\n    m.total_gross_profit,\n    m.daily_gross_profit,\n    m.aov,\n    m.gross_margin_pct,\n    ROUND(((m.daily_orders - b.daily_orders) / b.daily_orders) * 100, 2) AS order_lift_pct,\n    ROUND(((m.daily_net_revenue - b.daily_net_revenue) / b.daily_net_revenue) * 100, 2) AS rev_lift_pct,\n    ROUND(((m.daily_gross_profit - b.daily_gross_profit) / b.daily_gross_profit) * 100, 2) AS profit_lift_pct,\n    ROUND(((m.aov - b.aov) / b.aov) * 100, 2) AS aov_lift_pct,\n    ROUND(m.gross_margin_pct - b.gross_margin_pct, 2) AS margin_diff_pct_pts\nFROM metrics m\nCROSS JOIN (SELECT * FROM metrics WHERE period = 'Pre-Sale') b\nORDER BY CASE \n    WHEN m.period = 'Pre-Sale' THEN 1 \n    WHEN m.period = 'Sale' THEN 2 \n    WHEN m.period = 'Post-Sale' THEN 3 \nEND;", "rows": 3, "error": null}
