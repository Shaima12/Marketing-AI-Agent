{"t": 1791823422.0044153, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_orders AS (\n  SELECT \n    CASE \n      WHEN o.order_date BETWEEN '2025-06-11' AND '2025-07-10' THEN 'Baseline (30d: Jun 11 - Jul 10)'\n      WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Baseline (10d: Jul 01 - Jul 10)'\n      WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (10d: Jul 11 - Jul 20)'\n      WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-Sale (10d: Jul 21 - Jul 30)'\n      WHEN o.order_date BETWEEN '2025-07-21' AND '2025-08-19' THEN 'Post-Sale (30d: Jul 21 - Aug 19)'\n      ELSE NULL\n    END AS period_label,\n    o.order_id,\n    o.order_date,\n    oi.quantity,\n    oi.unit_price,\n    p.unit_cost\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n)\nSELECT \n  'Baseline 10d (Jul 1 - Jul 10)' AS period,\n  10 AS days,\n  COUNT(DISTINCT order_id) AS delivered_orders,\n  ROUND(COUNT(DISTINCT order_id)::numeric / 10, 2) AS delivered_orders_per_day,\n  ROUND(SUM(quantity * unit_price), 2) AS net_revenue,\n  ROUND(SUM(quantity * unit_price) / 10, 2) AS net_revenue_per_day,\n  ROUND(SUM(quantity * unit_price) / COUNT(DISTINCT order_id), 2) AS aov,\n  ROUND(SUM(quantity * (unit_price - unit_cost)), 2) AS gross_profit,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / 10, 2) AS gross_profit_per_day,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / SUM(quantity * unit_price) * 100, 2) AS gross_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false AND o.status = 'delivered'\n  AND o.order_date BETWEEN '2025-07-01' AND '2025-07-10'\n\nUNION ALL\n\nSELECT \n  'Baseline 30d (Jun 11 - Jul 10)' AS period,\n  30 AS days,\n  COUNT(DISTINCT order_id) AS delivered_orders,\n  ROUND(COUNT(DISTINCT order_id)::numeric / 30, 2) AS delivered_orders_per_day,\n  ROUND(SUM(quantity * unit_price), 2) AS net_revenue,\n  ROUND(SUM(quantity * unit_price) / 30, 2) AS net_revenue_per_day,\n  ROUND(SUM(quantity * unit_price) / COUNT(DISTINCT order_id), 2) AS aov,\n  ROUND(SUM(quantity * (unit_price - unit_cost)), 2) AS gross_profit,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / 30, 2) AS gross_profit_per_day,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / SUM(quantity * unit_price) * 100, 2) AS gross_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false AND o.status = 'delivered'\n  AND o.order_date BETWEEN '2025-06-11' AND '2025-07-10'\n\nUNION ALL\n\nSELECT \n  'Sale 10d (Jul 11 - Jul 20)' AS period,\n  10 AS days,\n  COUNT(DISTINCT order_id) AS delivered_orders,\n  ROUND(COUNT(DISTINCT order_id)::numeric / 10, 2) AS delivered_orders_per_day,\n  ROUND(SUM(quantity * unit_price), 2) AS net_revenue,\n  ROUND(SUM(quantity * unit_price) / 10, 2) AS net_revenue_per_day,\n  ROUND(SUM(quantity * unit_price) / COUNT(DISTINCT order_id), 2) AS aov,\n  ROUND(SUM(quantity * (unit_price - unit_cost)), 2) AS gross_profit,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / 10, 2) AS gross_profit_per_day,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / SUM(quantity * unit_price) * 100, 2) AS gross_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false AND o.status = 'delivered'\n  AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n\nUNION ALL\n\nSELECT \n  'Post-Sale 10d (Jul 21 - Jul 30)' AS period,\n  10 AS days,\n  COUNT(DISTINCT order_id) AS delivered_orders,\n  ROUND(COUNT(DISTINCT order_id)::numeric / 10, 2) AS delivered_orders_per_day,\n  ROUND(SUM(quantity * unit_price), 2) AS net_revenue,\n  ROUND(SUM(quantity * unit_price) / 10, 2) AS net_revenue_per_day,\n  ROUND(SUM(quantity * unit_price) / COUNT(DISTINCT order_id), 2) AS aov,\n  ROUND(SUM(quantity * (unit_price - unit_cost)), 2) AS gross_profit,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / 10, 2) AS gross_profit_per_day,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / SUM(quantity * unit_price) * 100, 2) AS gross_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false AND o.status = 'delivered'\n  AND o.order_date BETWEEN '2025-07-21' AND '2025-07-30'\n\nUNION ALL\n\nSELECT \n  'Post-Sale 30d (Jul 21 - Aug 19)' AS period,\n  30 AS days,\n  COUNT(DISTINCT order_id) AS delivered_orders,\n  ROUND(COUNT(DISTINCT order_id)::numeric / 30, 2) AS delivered_orders_per_day,\n  ROUND(SUM(quantity * unit_price), 2) AS net_revenue,\n  ROUND(SUM(quantity * unit_price) / 30, 2) AS net_revenue_per_day,\n  ROUND(SUM(quantity * unit_price) / COUNT(DISTINCT order_id), 2) AS aov,\n  ROUND(SUM(quantity * (unit_price - unit_cost)), 2) AS gross_profit,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / 30, 2) AS gross_profit_per_day,\n  ROUND(SUM(quantity * (unit_price - unit_cost)) / SUM(quantity * unit_price) * 100, 2) AS gross_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false AND o.status = 'delivered'\n  AND o.order_date BETWEEN '2025-07-21' AND '2025-08-19';", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42702', 'M': 'column reference \"order_id\" is ambiguous', 'P': '1033', 'F': 'parse_relation.c', 'L': '831', 'R': 'scanRTEForColumn'}"}
{"t": 1791823521.288861, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n  SELECT\n    o.order_id,\n    o.order_date,\n    SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n    SUM(oi.quantity * p.unit_cost) AS order_cogs,\n    SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS order_gross_profit\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n  GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n  SELECT\n    *,\n    CASE\n      WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1. Pre-Sale (10d: Jul 01-10)'\n      WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2. Sale (10d: Jul 11-20)'\n      WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN '3. Post-Sale (10d: Jul 21-30)'\n      WHEN order_date BETWEEN '2025-06-11' AND '2025-07-10' THEN '0. Pre-Sale (30d: Jun 11-Jul 10)'\n      WHEN order_date BETWEEN '2025-07-21' AND '2025-08-19' THEN '4. Post-Sale (30d: Jul 21-Aug 19)'\n      ELSE 'Other'\n    END AS period_tag\n  FROM order_level\n)\nSELECT\n  period,\n  days,\n  total_orders,\n  ROUND(total_orders::numeric / days, 2) AS delivered_orders_per_day,\n  ROUND(total_net_rev, 2) AS total_net_revenue,\n  ROUND(total_net_rev / days, 2) AS net_revenue_per_day,\n  ROUND(total_net_rev / total_orders, 2) AS aov,\n  ROUND(total_gp, 2) AS total_gross_profit,\n  ROUND(total_gp / days, 2) AS gross_profit_per_day,\n  ROUND(100.0 * total_gp / total_net_rev, 2) AS gross_margin_pct\nFROM (\n  SELECT\n    'Pre-Sale 10d (Jul 01 - Jul 10)' AS period,\n    10 AS days,\n    COUNT(*) AS total_orders,\n    SUM(order_net_revenue) AS total_net_rev,\n    SUM(order_gross_profit) AS total_gp\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-01' AND '2025-07-10'\n  \n  UNION ALL\n  \n  SELECT\n    'Pre-Sale 30d (Jun 11 - Jul 10)' AS period,\n    30 AS days,\n    COUNT(*) AS total_orders,\n    SUM(order_net_revenue) AS total_net_rev,\n    SUM(order_gross_profit) AS total_gp\n  FROM order_level\n  WHERE order_date BETWEEN '2025-06-11' AND '2025-07-10'\n\n  UNION ALL\n\n  SELECT\n    'Sale 10d (Jul 11 - Jul 20)' AS period,\n    10 AS days,\n    COUNT(*) AS total_orders,\n    SUM(order_net_revenue) AS total_net_rev,\n    SUM(order_gross_profit) AS total_gp\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-11' AND '2025-07-20'\n\n  UNION ALL\n\n  SELECT\n    'Post-Sale 10d (Jul 21 - Jul 30)' AS period,\n    10 AS days,\n    COUNT(*) AS total_orders,\n    SUM(order_net_revenue) AS total_net_rev,\n    SUM(order_gross_profit) AS total_gp\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-21' AND '2025-07-30'\n\n  UNION ALL\n\n  SELECT\n    'Post-Sale 30d (Jul 21 - Aug 19)' AS period,\n    30 AS days,\n    COUNT(*) AS total_orders,\n    SUM(order_net_revenue) AS total_net_rev,\n    SUM(order_gross_profit) AS total_gp\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-21' AND '2025-08-19'\n) sub\nORDER BY period;", "rows": 5, "error": null}
{"t": 1791823545.4012346, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n  SELECT\n    o.order_id,\n    o.order_date,\n    SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n    SUM(oi.quantity * p.unit_cost) AS order_cogs,\n    SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS order_gross_profit\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n  GROUP BY o.order_id, o.order_date\n),\nperiod_metrics AS (\n  SELECT\n    'Pre-Sale (10d: Jul 01-10)' AS period_name,\n    10 AS days,\n    COUNT(*) AS orders,\n    SUM(order_net_revenue) AS net_revenue,\n    SUM(order_gross_profit) AS gross_profit\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-01' AND '2025-07-10'\n\n  UNION ALL\n\n  SELECT\n    'Sale (10d: Jul 11-20)' AS period_name,\n    10 AS days,\n    COUNT(*) AS orders,\n    SUM(order_net_revenue) AS net_revenue,\n    SUM(order_gross_profit) AS gross_profit\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-11' AND '2025-07-20'\n\n  UNION ALL\n\n  SELECT\n    'Post-Sale (10d: Jul 21-30)' AS period_name,\n    10 AS days,\n    COUNT(*) AS orders,\n    SUM(order_net_revenue) AS net_revenue,\n    SUM(order_gross_profit) AS gross_profit\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-21' AND '2025-07-30'\n\n  UNION ALL\n\n  SELECT\n    'Post-Sale (30d: Jul 21-Aug 19)' AS period_name,\n    30 AS days,\n    COUNT(*) AS orders,\n    SUM(order_net_revenue) AS net_revenue,\n    SUM(order_gross_profit) AS gross_profit\n  FROM order_level\n  WHERE order_date BETWEEN '2025-07-21' AND '2025-08-19'\n\n  UNION ALL\n\n  SELECT\n    'Pre-Sale (30d: Jun 11-Jul 10)' AS period_name,\n    30 AS days,\n    COUNT(*) AS orders,\n    SUM(order_net_revenue) AS net_revenue,\n    SUM(order_gross_profit) AS gross_profit\n  FROM order_level\n  WHERE order_date BETWEEN '2025-06-11' AND '2025-07-10'\n),\nbase AS (\n  SELECT * FROM period_metrics WHERE period_name = 'Pre-Sale (10d: Jul 01-10)'\n)\nSELECT\n  p.period_name,\n  p.days,\n  p.orders,\n  ROUND(p.orders::numeric / p.days, 2) AS orders_per_day,\n  ROUND(100.0 * (p.orders::numeric / p.days - b.orders::numeric / b.days) / (b.orders::numeric / b.days), 2) AS orders_per_day_pct_chg_vs_pre10,\n  ROUND(p.net_revenue, 2) AS total_net_revenue,\n  ROUND(p.net_revenue / p.days, 2) AS net_rev_per_day,\n  ROUND(100.0 * (p.net_revenue / p.days - b.net_revenue / b.days) / (b.net_revenue / b.days), 2) AS net_rev_per_day_pct_chg_vs_pre10,\n  ROUND(p.net_revenue / p.orders, 2) AS aov,\n  ROUND(100.0 * (p.net_revenue / p.orders - b.net_revenue / b.orders) / (b.net_revenue / b.orders), 2) AS aov_pct_chg_vs_pre10,\n  ROUND(p.gross_profit, 2) AS total_gross_profit,\n  ROUND(p.gross_profit / p.days, 2) AS gross_profit_per_day,\n  ROUND(100.0 * (p.gross_profit / p.days - b.gross_profit / b.days) / (b.gross_profit / b.days), 2) AS gp_per_day_pct_chg_vs_pre10,\n  ROUND(100.0 * p.gross_profit / p.net_revenue, 2) AS gross_margin_pct,\n  ROUND(100.0 * p.gross_profit / p.net_revenue - 100.0 * b.gross_profit / b.net_revenue, 2) AS gross_margin_pp_chg_vs_pre10,\n  ROUND((p.net_revenue / p.days - b.net_revenue / b.days) * p.days, 2) AS net_incremental_rev_vs_pre10_baseline,\n  ROUND((p.gross_profit / p.days - b.gross_profit / b.days) * p.days, 2) AS net_incremental_gp_vs_pre10_baseline\nFROM period_metrics p\nCROSS JOIN base b\nORDER BY p.period_name;", "rows": 5, "error": null}
{"t": 1791824019.8939662, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct FROM public.promotions ORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791824035.7214453, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    discount_code,\n    MIN(order_date) AS min_order_date,\n    MAX(order_date) AS max_order_date,\n    COUNT(*) AS total_orders,\n    COUNT(CASE WHEN status = 'delivered' THEN 1 END) AS delivered_orders\nFROM public.orders\nWHERE order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY discount_code\nORDER BY total_orders DESC;", "rows": 5, "error": null}
{"t": 1791824054.595796, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    MIN(order_date) AS earliest_order,\n    MAX(order_date) AS latest_order\nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791825100.7424278, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791825110.340726, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    o.discount_code,\n    COUNT(*) AS total_orders,\n    COUNT(CASE WHEN o.status = 'delivered' THEN 1 END) AS delivered_orders,\n    COUNT(CASE WHEN o.status = 'returned' THEN 1 END) AS returned_orders,\n    COUNT(CASE WHEN o.status = 'cancelled' THEN 1 END) AS cancelled_orders,\n    MIN(o.order_date) AS first_order_date,\n    MAX(o.order_date) AS last_order_date\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nWHERE c.is_internal = FALSE\n  AND (o.discount_code = 'SUMMER25' OR (o.order_date BETWEEN '2025-07-11' AND '2025-07-20'))\nGROUP BY o.discount_code\nORDER BY total_orders DESC;", "rows": 3, "error": null}
{"t": 1791825129.008342, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT MIN(order_date) AS min_date, MAX(order_date) AS max_date, COUNT(*) AS total_orders\nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791825143.3094049, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT \n        order_id,\n        order_date,\n        order_net_revenue,\n        order_cogs,\n        order_net_revenue - order_cogs AS order_gross_profit,\n        CASE\n            WHEN order_date BETWEEN '2025-06-13' AND '2025-07-10' THEN 'Baseline (28d: Jun 13 - Jul 10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (10d: Jul 11 - Jul 20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-03' THEN 'Post-sale (14d: Jul 21 - Aug 03)'\n            WHEN order_date BETWEEN '2025-08-04' AND '2025-08-17' THEN 'Post-sale late (14d: Aug 04 - Aug 17)'\n            ELSE NULL\n        END AS period_label,\n        CASE\n            WHEN order_date BETWEEN '2025-06-13' AND '2025-07-10' THEN 28\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 10\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-03' THEN 14\n            WHEN order_date BETWEEN '2025-08-04' AND '2025-08-17' THEN 14\n            ELSE NULL\n        END AS period_days\n    FROM order_level\n)\nSELECT \n    period_label,\n    period_days,\n    COUNT(order_id) AS delivered_orders,\n    ROUND(COUNT(order_id)::numeric / period_days, 2) AS orders_per_day,\n    ROUND(SUM(order_net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(order_net_revenue) / period_days, 2) AS net_revenue_per_day,\n    ROUND(SUM(order_net_revenue) / COUNT(order_id), 2) AS aov,\n    ROUND(SUM(order_cogs), 2) AS total_cogs,\n    ROUND(SUM(order_gross_profit), 2) AS total_gross_profit,\n    ROUND(SUM(order_gross_profit) / period_days, 2) AS gross_profit_per_day,\n    ROUND((SUM(order_gross_profit) / SUM(order_net_revenue)) * 100, 2) AS gross_margin_pct\nFROM period_tagged\nWHERE period_label IS NOT NULL\nGROUP BY period_label, period_days\nORDER BY MIN(order_date);", "rows": 4, "error": null}
{"t": 1791825165.4077141, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT \n        order_id,\n        order_date,\n        order_net_revenue,\n        order_cogs,\n        order_net_revenue - order_cogs AS order_gross_profit,\n        CASE\n            WHEN order_date BETWEEN '2025-06-13' AND '2025-07-10' THEN 'Baseline'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-03' THEN 'Post-sale 14d'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-17' THEN 'Post-sale 28d'\n            ELSE NULL\n        END AS period_label,\n        CASE\n            WHEN order_date BETWEEN '2025-06-13' AND '2025-07-10' THEN 28\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 10\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-03' THEN 14\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-17' THEN 28\n            ELSE NULL\n        END AS period_days\n    FROM order_level\n),\nperiod_summary AS (\n    SELECT \n        period_label,\n        period_days,\n        COUNT(order_id) AS delivered_orders,\n        COUNT(order_id)::numeric / period_days AS orders_per_day,\n        SUM(order_net_revenue) AS total_net_revenue,\n        SUM(order_net_revenue) / period_days AS net_revenue_per_day,\n        SUM(order_net_revenue) / COUNT(order_id) AS aov,\n        SUM(order_gross_profit) AS total_gross_profit,\n        SUM(order_gross_profit) / period_days AS gross_profit_per_day,\n        (SUM(order_gross_profit) / SUM(order_net_revenue)) * 100 AS gross_margin_pct\n    FROM period_tagged\n    WHERE period_label IS NOT NULL\n    GROUP BY period_label, period_days\n)\nSELECT \n    ps.period_label,\n    ps.period_days,\n    ROUND(ps.orders_per_day, 2) AS orders_per_day,\n    ROUND(ps.net_revenue_per_day, 2) AS net_revenue_per_day,\n    ROUND(ps.aov, 2) AS aov,\n    ROUND(ps.gross_margin_pct, 2) AS gross_margin_pct,\n    ROUND(ps.gross_profit_per_day, 2) AS gross_profit_per_day,\n    ROUND(((ps.orders_per_day - base.orders_per_day) / base.orders_per_day) * 100, 2) AS orders_per_day_lift_pct,\n    ROUND(((ps.net_revenue_per_day - base.net_revenue_per_day) / base.net_revenue_per_day) * 100, 2) AS net_revenue_per_day_lift_pct,\n    ROUND(((ps.gross_profit_per_day - base.gross_profit_per_day) / base.gross_profit_per_day) * 100, 2) AS gross_profit_per_day_lift_pct,\n    ROUND((ps.gross_profit_per_day - base.gross_profit_per_day) * ps.period_days, 2) AS total_incremental_gross_profit\nFROM period_summary ps\nCROSS JOIN (SELECT * FROM period_summary WHERE period_label = 'Baseline') base\nORDER BY \n    CASE \n        WHEN ps.period_label = 'Baseline' THEN 1\n        WHEN ps.period_label = 'Sale' THEN 2\n        WHEN ps.period_label = 'Post-sale 14d' THEN 3\n        WHEN ps.period_label = 'Post-sale 28d' THEN 4\n    END;", "rows": 4, "error": null}
{"t": 1791825203.3715806, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_level AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nwindows AS (\n    SELECT 'Baseline (28d: Jun 13 - Jul 10)' AS window_name, DATE '2025-06-13' AS start_date, DATE '2025-07-10' AS end_date, 28 AS days\n    UNION ALL\n    SELECT 'Sale (10d: Jul 11 - Jul 20)', DATE '2025-07-11', DATE '2025-07-20', 10\n    UNION ALL\n    SELECT 'Post-sale 14d (Jul 21 - Aug 03)', DATE '2025-07-21', DATE '2025-08-03', 14\n    UNION ALL\n    SELECT 'Post-sale 28d (Jul 21 - Aug 17)', DATE '2025-07-21', DATE '2025-08-17', 28\n    UNION ALL\n    SELECT 'Sale + Post-sale 14d (24d: Jul 11 - Aug 03)', DATE '2025-07-11', DATE '2025-08-03', 24\n    UNION ALL\n    SELECT 'Sale + Post-sale 28d (38d: Jul 11 - Aug 17)', DATE '2025-07-11', DATE '2025-08-17', 38\n),\nwindow_metrics AS (\n    SELECT \n        w.window_name,\n        w.days,\n        COUNT(ol.order_id) AS delivered_orders,\n        ROUND(COUNT(ol.order_id)::numeric / w.days, 2) AS orders_per_day,\n        ROUND(SUM(ol.order_net_revenue), 2) AS net_revenue,\n        ROUND(SUM(ol.order_net_revenue) / w.days, 2) AS net_revenue_per_day,\n        ROUND(SUM(ol.order_net_revenue) / COUNT(ol.order_id), 2) AS aov,\n        ROUND(SUM(ol.order_net_revenue - ol.order_cogs), 2) AS gross_profit,\n        ROUND(SUM(ol.order_net_revenue - ol.order_cogs) / w.days, 2) AS gross_profit_per_day,\n        ROUND(((SUM(ol.order_net_revenue - ol.order_cogs) / SUM(ol.order_net_revenue)) * 100), 2) AS gross_margin_pct\n    FROM windows w\n    LEFT JOIN order_level ol ON ol.order_date BETWEEN w.start_date AND w.end_date\n    GROUP BY w.window_name, w.days, w.start_date\n    ORDER BY w.start_date, w.days\n)\nSELECT \n    wm.window_name,\n    wm.days,\n    wm.delivered_orders,\n    wm.orders_per_day,\n    wm.net_revenue,\n    wm.net_revenue_per_day,\n    wm.aov,\n    wm.gross_margin_pct,\n    wm.gross_profit,\n    wm.gross_profit_per_day,\n    ROUND(((wm.orders_per_day - base.orders_per_day) / base.orders_per_day) * 100, 2) AS orders_day_lift_pct,\n    ROUND(((wm.net_revenue_per_day - base.net_revenue_per_day) / base.net_revenue_per_day) * 100, 2) AS revenue_day_lift_pct,\n    ROUND(((wm.gross_profit_per_day - base.gross_profit_per_day) / base.gross_profit_per_day) * 100, 2) AS gp_day_lift_pct,\n    ROUND(wm.gross_profit - (base.gross_profit_per_day * wm.days), 2) AS incremental_gross_profit_vs_baseline\nFROM window_metrics wm\nCROSS JOIN (SELECT * FROM window_metrics WHERE window_name = 'Baseline (28d: Jun 13 - Jul 10)') base;", "rows": 6, "error": null}
