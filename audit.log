{"t": 1791812270.7718446, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    discount_code,\n    MIN(order_date) AS min_date,\n    MAX(order_date) AS max_date,\n    COUNT(*) AS order_count\nFROM public.orders\nWHERE order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY discount_code\nORDER BY order_count DESC;", "rows": 5, "error": null}
{"t": 1791812331.1278834, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    MIN(order_date) AS min_date,\n    MAX(order_date) AS max_date,\n    COUNT(*) AS total_orders\nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791812356.2228277, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_base AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT \n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1. Pre-Sale Baseline (Jul 1-10, 10d)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2. Summer Sale (Jul 11-20, 10d)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN '3. Post-Sale (Jul 21-31, 11d)'\n            WHEN order_date BETWEEN '2025-06-01' AND '2025-06-30' THEN '0. June Baseline (Jun 1-30, 30d)'\n            ELSE 'Other'\n        END AS period,\n        order_id,\n        net_revenue,\n        total_cost\n    FROM order_base\n)\nSELECT \n    period,\n    COUNT(DISTINCT order_id) AS delivered_orders,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(total_cost), 2) AS total_cost,\n    ROUND(SUM(net_revenue) - SUM(total_cost), 2) AS total_gross_profit,\n    ROUND(100.0 * (SUM(net_revenue) - SUM(total_cost)) / SUM(net_revenue), 2) AS gross_margin_pct,\n    ROUND(SUM(net_revenue) / COUNT(DISTINCT order_id), 2) AS aov\nFROM period_tagged\nWHERE period != 'Other'\nGROUP BY period\nORDER BY period;", "rows": 4, "error": null}
{"t": 1791812391.6312788, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_base AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT \n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-Sale Baseline (Jul 1-10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Summer Sale (Jul 11-20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN 'Post-Sale (Jul 21-31)'\n            WHEN order_date BETWEEN '2025-06-01' AND '2025-06-30' THEN 'June Baseline (Jun 1-30)'\n            ELSE 'Other'\n        END AS period_name,\n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 10\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 10\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN 11\n            WHEN order_date BETWEEN '2025-06-01' AND '2025-06-30' THEN 30\n            ELSE NULL\n        END AS days_in_period,\n        order_id,\n        net_revenue,\n        total_cost\n    FROM order_base\n),\nagg AS (\n    SELECT \n        period_name,\n        days_in_period,\n        COUNT(DISTINCT order_id) AS delivered_orders,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(total_cost) AS total_cost,\n        SUM(net_revenue) - SUM(total_cost) AS total_gross_profit\n    FROM period_tagged\n    WHERE period_name != 'Other'\n    GROUP BY period_name, days_in_period\n)\nSELECT \n    period_name,\n    days_in_period,\n    delivered_orders,\n    ROUND(delivered_orders::numeric / days_in_period, 2) AS orders_per_day,\n    ROUND(total_net_revenue, 2) AS total_net_revenue,\n    ROUND(total_net_revenue / days_in_period, 2) AS revenue_per_day,\n    ROUND(total_cost / days_in_period, 2) AS cost_per_day,\n    ROUND(total_gross_profit, 2) AS total_gross_profit,\n    ROUND(total_gross_profit / days_in_period, 2) AS gross_profit_per_day,\n    ROUND(100.0 * total_gross_profit / total_net_revenue, 2) AS gross_margin_pct,\n    ROUND(total_net_revenue / delivered_orders, 2) AS aov\nFROM agg\nORDER BY period_name;", "rows": 4, "error": null}
{"t": 1791812415.7946968, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH period_daily AS (\n    SELECT \n        CASE \n            WHEN o.order_date BETWEEN '2025-06-01' AND '2025-06-30' THEN '0_june_baseline'\n            WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1_pre_sale'\n            WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2_sale'\n            WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN '3_post_sale'\n        END AS period_key,\n        CASE \n            WHEN o.order_date BETWEEN '2025-06-01' AND '2025-06-30' THEN 30\n            WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 10\n            WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 10\n            WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN 11\n        END AS days,\n        COUNT(DISTINCT o.order_id) AS delivered_orders,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND (\n          (o.order_date BETWEEN '2025-06-01' AND '2025-06-30') OR\n          (o.order_date BETWEEN '2025-07-01' AND '2025-07-31')\n      )\n    GROUP BY 1, 2\n),\nmetrics AS (\n    SELECT \n        period_key,\n        days,\n        delivered_orders,\n        net_revenue,\n        gross_profit,\n        delivered_orders::numeric / days AS orders_per_day,\n        net_revenue / days AS rev_per_day,\n        gross_profit / days AS gp_per_day,\n        100.0 * gross_profit / net_revenue AS gross_margin_pct,\n        net_revenue / delivered_orders AS aov\n    FROM period_daily\n)\nSELECT \n    m.period_key,\n    m.days,\n    ROUND(m.orders_per_day, 2) AS orders_per_day,\n    ROUND(m.rev_per_day, 2) AS rev_per_day,\n    ROUND(m.gp_per_day, 2) AS gp_per_day,\n    ROUND(m.gross_margin_pct, 2) AS gross_margin_pct,\n    ROUND(m.aov, 2) AS aov,\n    -- Lift vs Pre-Sale baseline (Jul 1-10)\n    ROUND(100.0 * (m.orders_per_day - pre.orders_per_day) / pre.orders_per_day, 2) AS orders_per_day_lift_vs_presale_pct,\n    ROUND(100.0 * (m.rev_per_day - pre.rev_per_day) / pre.rev_per_day, 2) AS rev_per_day_lift_vs_presale_pct,\n    ROUND(100.0 * (m.gp_per_day - pre.gp_per_day) / pre.gp_per_day, 2) AS gp_per_day_lift_vs_presale_pct,\n    ROUND((m.rev_per_day - pre.rev_per_day) * m.days, 2) AS total_incremental_rev_vs_presale,\n    ROUND((m.gp_per_day - pre.gp_per_day) * m.days, 2) AS total_incremental_gp_vs_presale\nFROM metrics m\nCROSS JOIN (SELECT * FROM metrics WHERE period_key = '1_pre_sale') pre\nORDER BY m.period_key;", "rows": 4, "error": null}
{"t": 1791815115.048987, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791815147.9686282, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    COUNT(*) AS total_orders,\n    COUNT(CASE WHEN o.status = 'delivered' THEN 1 END) AS delivered_orders,\n    COUNT(CASE WHEN o.discount_code = 'SUMMER25' THEN 1 END) AS summer25_orders,\n    COUNT(CASE WHEN o.discount_code = 'SUMMER25' AND o.status = 'delivered' THEN 1 END) AS summer25_delivered_orders\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nWHERE c.is_internal = false\n  AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20';", "rows": 1, "error": null}
