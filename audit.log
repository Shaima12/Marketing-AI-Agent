{"t": 1792234126.9956076, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    promo_code,\n    description,\n    start_date,\n    end_date,\n    discount_pct,\n    (end_date - start_date + 1) AS promo_duration_days\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1792234379.2428539, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    date_trunc('month', o.order_date)::date AS month,\n    min(o.order_date) AS min_order_date,\n    max(o.order_date) AS max_order_date,\n    count(DISTINCT o.order_id) AS delivered_orders,\n    count(DISTINCT o.customer_id) AS active_customers,\n    sum(oi.quantity) AS units_sold,\n    round(sum(oi.quantity * oi.unit_price), 2) AS net_revenue,\n    round(sum(oi.quantity * p.unit_cost), 2) AS cogs,\n    round(sum(oi.quantity * oi.unit_price) - sum(oi.quantity * p.unit_cost), 2) AS gross_profit,\n    round((sum(oi.quantity * oi.unit_price) - sum(oi.quantity * p.unit_cost)) / nullif(sum(oi.quantity * oi.unit_price), 0) * 100, 2) AS gross_margin_pct,\n    round(sum(oi.quantity * oi.unit_price) / nullif(count(DISTINCT o.order_id), 0), 2) AS aov\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE c.is_internal = false\n  AND o.status = 'delivered'\nGROUP BY 1\nORDER BY 1;", "rows": 12, "error": null}
{"t": 1792234660.1689205, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_first_order AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\norder_financials AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        o.status,\n        COALESCE(o.discount_code, 'NO_CODE') AS discount_code,\n        c.signup_date,\n        c.acquisition_channel,\n        CASE \n            WHEN cfo.first_order_date < '2025-07-11' THEN 'Existing Customer'\n            ELSE 'New Customer'\n        END AS customer_type_prior_orders,\n        CASE \n            WHEN c.signup_date < '2025-07-11' THEN 'Existing Signup'\n            ELSE 'New Signup'\n        END AS customer_type_signup,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS order_gross_profit,\n        SUM(oi.quantity) AS order_units\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN customer_first_order cfo ON o.customer_id = cfo.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    GROUP BY \n        o.order_id, \n        o.customer_id, \n        o.order_date, \n        o.status, \n        o.discount_code, \n        c.signup_date, \n        c.acquisition_channel,\n        cfo.first_order_date\n)\nSELECT \n    customer_type_prior_orders,\n    discount_code,\n    COUNT(DISTINCT customer_id) AS distinct_customers,\n    COUNT(order_id) AS delivered_orders,\n    ROUND(COUNT(order_id)::numeric / 10.0, 2) AS orders_per_day,\n    ROUND(SUM(order_net_revenue), 2) AS net_revenue,\n    ROUND(SUM(order_net_revenue) / 10.0, 2) AS revenue_per_day,\n    ROUND(SUM(order_gross_profit), 2) AS gross_profit,\n    ROUND(SUM(order_gross_profit) / 10.0, 2) AS gross_profit_per_day,\n    ROUND(SUM(order_net_revenue) / NULLIF(COUNT(order_id), 0), 2) AS aov,\n    ROUND(100.0 * SUM(order_gross_profit) / NULLIF(SUM(order_net_revenue), 0), 2) AS gross_margin_pct,\n    ROUND(100.0 * COUNT(order_id)::numeric / SUM(COUNT(order_id)) OVER (), 2) AS pct_of_total_orders,\n    ROUND(100.0 * SUM(order_net_revenue) / SUM(SUM(order_net_revenue)) OVER (), 2) AS pct_of_total_revenue,\n    ROUND(100.0 * SUM(order_gross_profit) / SUM(SUM(order_gross_profit)) OVER (), 2) AS pct_of_total_gross_profit\nFROM order_financials\nGROUP BY GROUPING SETS (\n    (),\n    (customer_type_prior_orders),\n    (discount_code),\n    (customer_type_prior_orders, discount_code)\n)\nORDER BY \n    customer_type_prior_orders NULLS LAST, \n    discount_code NULLS LAST;", "rows": 12, "error": null}
{"t": 1792234687.8359091, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_first_purchase AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\norder_details AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        COALESCE(o.discount_code, 'NO_CODE') AS discount_code,\n        CASE \n            WHEN cfp.first_order_date < '2025-07-11' THEN 'Existing Customer'\n            ELSE 'New Customer'\n        END AS customer_type,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS order_gross_profit,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS order_discount_amount\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN customer_first_purchase cfp ON o.customer_id = cfp.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    GROUP BY o.order_id, o.customer_id, o.order_date, o.discount_code, cfp.first_order_date\n),\ntotals AS (\n    SELECT \n        COUNT(DISTINCT order_id) AS total_orders,\n        COUNT(DISTINCT customer_id) AS total_customers,\n        SUM(order_net_revenue) AS total_revenue,\n        SUM(order_gross_profit) AS total_gross_profit,\n        SUM(order_discount_amount) AS total_discount\n    FROM order_details\n)\nSELECT \n    od.customer_type,\n    od.discount_code,\n    COUNT(DISTINCT od.customer_id) AS customers,\n    COUNT(DISTINCT od.order_id) AS delivered_orders,\n    ROUND(COUNT(DISTINCT od.order_id)::numeric / 10.0, 2) AS orders_per_day,\n    ROUND(SUM(od.order_net_revenue), 2) AS net_revenue,\n    ROUND(SUM(od.order_net_revenue) / 10.0, 2) AS revenue_per_day,\n    ROUND(SUM(od.order_gross_profit), 2) AS gross_profit,\n    ROUND(SUM(od.order_gross_profit) / 10.0, 2) AS gross_profit_per_day,\n    ROUND(SUM(od.order_discount_amount), 2) AS total_discount_given,\n    ROUND(SUM(od.order_net_revenue) / COUNT(DISTINCT od.order_id), 2) AS aov,\n    ROUND(100.0 * SUM(od.order_gross_profit) / SUM(od.order_net_revenue), 2) AS gross_margin_pct,\n    ROUND(100.0 * COUNT(DISTINCT od.order_id) / MAX(t.total_orders), 2) AS pct_of_total_orders,\n    ROUND(100.0 * SUM(od.order_net_revenue) / MAX(t.total_revenue), 2) AS pct_of_total_revenue,\n    ROUND(100.0 * SUM(od.order_gross_profit) / MAX(t.total_gross_profit), 2) AS pct_of_total_gross_profit,\n    ROUND(100.0 * SUM(od.order_discount_amount) / MAX(t.total_discount), 2) AS pct_of_total_discount\nFROM order_details od\nCROSS JOIN totals t\nGROUP BY od.customer_type, od.discount_code\nORDER BY od.customer_type, od.discount_code;", "rows": 6, "error": null}
{"t": 1792235547.5666738, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    promo_code,\n    description,\n    start_date,\n    end_date,\n    discount_pct,\n    (end_date - start_date + 1) AS promo_days\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1792236067.7390985, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct, (end_date - start_date + 1) AS promo_days\nFROM public.promotions\nWHERE (start_date >= '2025-06-01' AND start_date <= '2025-08-31')\n   OR description ILIKE '%july%'\n   OR promo_code ILIKE '%july%';", "rows": 1, "error": null}
{"t": 1792236080.9283822, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_financials AS (\n    SELECT\n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date >= '2025-06-13'\n      AND o.order_date <= '2025-08-03'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_tagged AS (\n    SELECT\n        order_id,\n        order_date,\n        net_revenue,\n        gross_profit,\n        CASE\n            WHEN order_date >= '2025-06-13' AND order_date <= '2025-07-10' THEN '1_baseline'\n            WHEN order_date >= '2025-07-11' AND order_date <= '2025-07-20' THEN '2_sale'\n            WHEN order_date >= '2025-07-21' AND order_date <= '2025-08-03' THEN '3_post_sale'\n        END AS period,\n        CASE\n            WHEN order_date >= '2025-06-13' AND order_date <= '2025-07-10' THEN 28\n            WHEN order_date >= '2025-07-11' AND order_date <= '2025-07-20' THEN 10\n            WHEN order_date >= '2025-07-21' AND order_date <= '2025-08-03' THEN 14\n        END AS period_days\n    FROM order_financials\n),\nperiod_agg AS (\n    SELECT\n        period,\n        period_days,\n        COUNT(DISTINCT order_id) AS total_orders,\n        ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n        ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n        ROUND(COUNT(DISTINCT order_id)::numeric / period_days, 2) AS orders_per_day,\n        ROUND(SUM(net_revenue) / period_days, 2) AS rev_per_day,\n        ROUND(SUM(gross_profit) / period_days, 2) AS gp_per_day,\n        ROUND(SUM(net_revenue) / COUNT(DISTINCT order_id), 2) AS aov,\n        ROUND((SUM(gross_profit) / SUM(net_revenue)) * 100, 2) AS realized_margin_pct\n    FROM period_tagged\n    GROUP BY period, period_days\n),\nbaseline AS (\n    SELECT\n        orders_per_day AS b_orders_per_day,\n        rev_per_day AS b_rev_per_day,\n        gp_per_day AS b_gp_per_day\n    FROM period_agg\n    WHERE period = '1_baseline'\n),\nperiods_with_lift AS (\n    SELECT\n        p.*,\n        ROUND(p.orders_per_day - b.b_orders_per_day, 2) AS diff_orders_per_day,\n        ROUND(((p.orders_per_day - b.b_orders_per_day) / b.b_orders_per_day) * 100, 2) AS pct_lift_orders_per_day,\n        ROUND(p.rev_per_day - b.b_rev_per_day, 2) AS diff_rev_per_day,\n        ROUND(((p.rev_per_day - b.b_rev_per_day) / b.b_rev_per_day) * 100, 2) AS pct_lift_rev_per_day,\n        ROUND(p.gp_per_day - b.b_gp_per_day, 2) AS diff_gp_per_day,\n        ROUND(((p.gp_per_day - b.b_gp_per_day) / b.b_gp_per_day) * 100, 2) AS pct_lift_gp_per_day,\n        ROUND((p.rev_per_day - b.b_rev_per_day) * p.period_days, 2) AS incremental_net_revenue,\n        ROUND((p.gp_per_day - b.b_gp_per_day) * p.period_days, 2) AS incremental_gross_profit\n    FROM period_agg p\n    CROSS JOIN baseline b\n),\ncombined_window AS (\n    SELECT\n        '4_combined_sale_and_post' AS period,\n        24 AS period_days,\n        COUNT(DISTINCT order_id) AS total_orders,\n        ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n        ROUND(SUM(gross_profit), 2) AS total_gross_profit,\n        ROUND(COUNT(DISTINCT order_id)::numeric / 24, 2) AS orders_per_day,\n        ROUND(SUM(net_revenue) / 24, 2) AS rev_per_day,\n        ROUND(SUM(gross_profit) / 24, 2) AS gp_per_day,\n        ROUND(SUM(net_revenue) / COUNT(DISTINCT order_id), 2) AS aov,\n        ROUND((SUM(gross_profit) / SUM(net_revenue)) * 100, 2) AS realized_margin_pct,\n        ROUND((COUNT(DISTINCT order_id)::numeric / 24) - b.b_orders_per_day, 2) AS diff_orders_per_day,\n        ROUND((((COUNT(DISTINCT order_id)::numeric / 24) - b.b_orders_per_day) / b.b_orders_per_day) * 100, 2) AS pct_lift_orders_per_day,\n        ROUND((SUM(net_revenue) / 24) - b.b_rev_per_day, 2) AS diff_rev_per_day,\n        ROUND((((SUM(net_revenue) / 24) - b.b_rev_per_day) / b.b_rev_per_day) * 100, 2) AS pct_lift_rev_per_day,\n        ROUND((SUM(gross_profit) / 24) - b.b_gp_per_day, 2) AS diff_gp_per_day,\n        ROUND((((SUM(gross_profit) / 24) - b.b_gp_per_day) / b.b_gp_per_day) * 100, 2) AS pct_lift_gp_per_day,\n        ROUND(((SUM(net_revenue) / 24) - b.b_rev_per_day) * 24, 2) AS incremental_net_revenue,\n        ROUND(((SUM(gross_profit) / 24) - b.b_gp_per_day) * 24, 2) AS incremental_gross_profit\n    FROM period_tagged pt\n    CROSS JOIN baseline b\n    WHERE pt.period IN ('2_sale', '3_post_sale')\n    GROUP BY b.b_orders_per_day, b.b_rev_per_day, b.b_gp_per_day\n)\nSELECT * FROM periods_with_lift\nUNION ALL\nSELECT * FROM combined_window\nORDER BY period;", "rows": 4, "error": null}
{"t": 1792236094.42123, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH sale_orders AS (\n  SELECT \n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    o.discount_code,\n    o.status,\n    c.signup_date,\n    -- A customer is new if their signup_date falls in the promo period ('2025-07-11' to '2025-07-20')\n    -- Or if this was their first ever order. Let's check both or signup date:\n    CASE \n      WHEN c.signup_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'new_customer'\n      ELSE 'returning_customer'\n    END AS customer_cohort,\n    CASE \n      WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.discount_code \n      ELSE 'NO_CODE' \n    END AS promo_used\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  WHERE c.is_internal = false\n    AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n),\norder_financials AS (\n  SELECT \n    so.order_id,\n    so.customer_id,\n    so.customer_cohort,\n    so.promo_used,\n    so.status,\n    COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n    COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit\n  FROM sale_orders so\n  LEFT JOIN public.order_items oi ON so.order_id = oi.order_id\n  LEFT JOIN public.products p ON oi.product_id = p.product_id\n  GROUP BY so.order_id, so.customer_id, so.customer_cohort, so.promo_used, so.status\n)\nSELECT \n  customer_cohort,\n  promo_used,\n  COUNT(DISTINCT order_id) AS total_orders,\n  COUNT(DISTINCT CASE WHEN status = 'delivered' THEN order_id END) AS delivered_orders,\n  COUNT(DISTINCT customer_id) AS unique_customers,\n  ROUND(SUM(CASE WHEN status = 'delivered' THEN net_revenue ELSE 0 END), 2) AS delivered_net_revenue,\n  ROUND(SUM(CASE WHEN status = 'delivered' THEN gross_profit ELSE 0 END), 2) AS delivered_gross_profit,\n  ROUND(\n    100.0 * SUM(CASE WHEN status = 'delivered' THEN gross_profit ELSE 0 END) / \n    NULLIF(SUM(CASE WHEN status = 'delivered' THEN net_revenue ELSE 0 END), 0), 2\n  ) AS gross_margin_pct,\n  ROUND(\n    SUM(CASE WHEN status = 'delivered' THEN net_revenue ELSE 0 END) / \n    NULLIF(COUNT(DISTINCT CASE WHEN status = 'delivered' THEN order_id END), 0), 2\n  ) AS delivered_aov\nFROM order_financials\nGROUP BY GROUPING SETS (\n  (customer_cohort),\n  (customer_cohort, promo_used),\n  ()\n)\nORDER BY customer_cohort NULLS LAST, promo_used NULLS LAST;", "rows": 8, "error": null}
{"t": 1792236102.1631083, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH promo_orders AS (\n  SELECT \n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    o.discount_code,\n    o.status,\n    c.signup_date,\n    CASE \n      WHEN c.signup_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'new_customer'\n      ELSE 'returning_customer'\n    END AS customer_cohort\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  WHERE c.is_internal = false\n    AND o.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n),\norder_financials AS (\n  SELECT \n    po.order_id,\n    po.customer_id,\n    po.customer_cohort,\n    po.discount_code,\n    po.status,\n    SUM(oi.quantity * oi.unit_price) AS line_revenue,\n    SUM(oi.quantity * p.unit_cost) AS line_cost\n  FROM promo_orders po\n  JOIN public.order_items oi ON po.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  GROUP BY po.order_id, po.customer_id, po.customer_cohort, po.discount_code, po.status\n),\ncohort_summary AS (\n  SELECT \n    customer_cohort,\n    COUNT(DISTINCT order_id) AS total_orders,\n    COUNT(DISTINCT CASE WHEN status = 'delivered' THEN order_id END) AS delivered_orders,\n    COUNT(DISTINCT customer_id) AS total_customers,\n    ROUND(SUM(CASE WHEN status = 'delivered' THEN line_revenue ELSE 0 END), 2) AS delivered_revenue,\n    ROUND(SUM(CASE WHEN status = 'delivered' THEN line_revenue - line_cost ELSE 0 END), 2) AS delivered_gross_profit\n  FROM order_financials\n  GROUP BY customer_cohort\n),\ntotals AS (\n  SELECT \n    SUM(total_orders) AS all_orders,\n    SUM(delivered_orders) AS all_delivered_orders,\n    SUM(total_customers) AS all_customers,\n    SUM(delivered_revenue) AS all_revenue,\n    SUM(delivered_gross_profit) AS all_gross_profit\n  FROM cohort_summary\n)\nSELECT \n  cs.customer_cohort,\n  cs.total_orders,\n  ROUND(cs.total_orders * 100.0 / t.all_orders, 2) AS pct_total_orders,\n  cs.delivered_orders,\n  ROUND(cs.delivered_orders * 100.0 / t.all_delivered_orders, 2) AS pct_delivered_orders,\n  cs.total_customers,\n  ROUND(cs.total_customers * 100.0 / t.all_customers, 2) AS pct_total_customers,\n  cs.delivered_revenue,\n  ROUND(cs.delivered_revenue * 100.0 / t.all_revenue, 2) AS pct_delivered_revenue,\n  cs.delivered_gross_profit,\n  ROUND(cs.delivered_gross_profit * 100.0 / t.all_gross_profit, 2) AS pct_delivered_gross_profit,\n  ROUND(cs.delivered_gross_profit * 100.0 / NULLIF(cs.delivered_revenue, 0), 2) AS gross_margin_pct,\n  ROUND(cs.delivered_revenue / NULLIF(cs.delivered_orders, 0), 2) AS aov\nFROM cohort_summary cs\nCROSS JOIN totals t;", "rows": 2, "error": null}
{"t": 1792236640.801815, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit,\n        COUNT(DISTINCT o.order_id) AS delivered_orders\n    FROM public.customers c\n    LEFT JOIN public.orders o \n        ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON o.order_id = oi.order_id\n    LEFT JOIN public.products p \n        ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        gross_profit,\n        delivered_orders,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile\n    FROM customer_rev\n),\ndecile_summary AS (\n    SELECT \n        decile,\n        COUNT(*) AS customer_count,\n        ROUND(MIN(net_revenue), 2) AS min_net_rev,\n        ROUND(MAX(net_revenue), 2) AS max_net_rev,\n        ROUND(AVG(net_revenue), 2) AS avg_net_rev,\n        ROUND(SUM(net_revenue), 2) AS decile_net_revenue,\n        ROUND(SUM(gross_profit), 2) AS decile_gross_profit,\n        ROUND(AVG(delivered_orders), 2) AS avg_orders\n    FROM ranked_customers\n    GROUP BY decile\n),\ntotals AS (\n    SELECT \n        SUM(decile_net_revenue) AS total_net_rev,\n        SUM(decile_gross_profit) AS total_gross_profit,\n        SUM(customer_count) AS total_customers\n    FROM decile_summary\n)\nSELECT \n    d.decile,\n    d.customer_count,\n    ROUND((d.customer_count::numeric / t.total_customers) * 100, 2) AS pct_customers,\n    d.min_net_rev,\n    d.max_net_rev,\n    d.avg_net_rev,\n    d.decile_net_revenue,\n    ROUND((d.decile_net_revenue / t.total_net_rev) * 100, 2) AS pct_of_total_net_revenue,\n    ROUND(SUM(d.decile_net_revenue) OVER (ORDER BY d.decile)::numeric, 2) AS cum_net_revenue,\n    ROUND((SUM(d.decile_net_revenue) OVER (ORDER BY d.decile) / t.total_net_rev) * 100, 2) AS cum_pct_net_revenue,\n    d.decile_gross_profit,\n    ROUND((d.decile_gross_profit / t.total_gross_profit) * 100, 2) AS pct_of_total_gross_profit,\n    ROUND(SUM(d.decile_gross_profit) OVER (ORDER BY d.decile)::numeric, 2) AS cum_gross_profit,\n    ROUND((SUM(d.decile_gross_profit) OVER (ORDER BY d.decile) / t.total_gross_profit) * 100, 2) AS cum_pct_gross_profit,\n    ROUND((d.decile_gross_profit / NULLIF(d.decile_net_revenue, 0)) * 100, 2) AS realized_margin_pct,\n    d.avg_orders\nFROM decile_summary d\nCROSS JOIN totals t\nORDER BY d.decile ASC;", "rows": 10, "error": null}
{"t": 1792236650.5593112, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_metrics AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit,\n        COUNT(DISTINCT o.order_id) AS delivered_orders\n    FROM public.customers c\n    LEFT JOIN public.orders o \n        ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON o.order_id = oi.order_id\n    LEFT JOIN public.products p \n        ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\noverall AS (\n    SELECT \n        COUNT(*) AS total_customers,\n        SUM(net_revenue) AS total_net_rev,\n        SUM(gross_profit) AS total_gp\n    FROM cust_metrics\n),\nranked AS (\n    SELECT \n        cm.*,\n        ROW_NUMBER() OVER (ORDER BY cm.net_revenue DESC, cm.gross_profit DESC, cm.customer_id) AS rn,\n        COUNT(*) OVER () AS n_cust\n    FROM cust_metrics cm\n)\nSELECT \n    tier,\n    customer_count,\n    ROUND(customer_count * 100.0 / total_customers, 2) AS pct_customers,\n    ROUND(min_net_rev, 2) AS min_net_rev,\n    ROUND(max_net_rev, 2) AS max_net_rev,\n    ROUND(tier_net_rev, 2) AS tier_net_revenue,\n    ROUND(tier_net_rev * 100.0 / total_net_rev, 2) AS pct_of_total_net_rev,\n    ROUND(tier_gp, 2) AS tier_gross_profit,\n    ROUND(tier_gp * 100.0 / total_gp, 2) AS pct_of_total_gp,\n    ROUND(tier_gp * 100.0 / NULLIF(tier_net_rev, 0), 2) AS realized_margin_pct,\n    ROUND(avg_orders, 2) AS avg_orders_per_customer\nFROM (\n    SELECT \n        'Top 1% (Decile 0.1)' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        1 AS ord\n    FROM ranked\n    WHERE rn <= CEIL(n_cust * 0.01)\n\n    UNION ALL\n\n    SELECT \n        'Top 5%' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        2 AS ord\n    FROM ranked\n    WHERE rn <= CEIL(n_cust * 0.05)\n\n    UNION ALL\n\n    SELECT \n        'Top 10% (Decile 1)' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        3 AS ord\n    FROM ranked\n    WHERE rn <= CEIL(n_cust * 0.10)\n\n    UNION ALL\n\n    SELECT \n        'Top 20% (Deciles 1-2)' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        4 AS ord\n    FROM ranked\n    WHERE rn <= CEIL(n_cust * 0.20)\n\n    UNION ALL\n\n    SELECT \n        'Bottom 80% (Deciles 3-10)' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        5 AS ord\n    FROM ranked\n    WHERE rn > CEIL(n_cust * 0.20)\n\n    UNION ALL\n\n    SELECT \n        'Total Customer Base' AS tier,\n        COUNT(*) AS customer_count,\n        MIN(net_revenue) AS min_net_rev,\n        MAX(net_revenue) AS max_net_rev,\n        SUM(net_revenue) AS tier_net_rev,\n        SUM(gross_profit) AS tier_gp,\n        AVG(delivered_orders::numeric) AS avg_orders,\n        6 AS ord\n    FROM ranked\n) t\nCROSS JOIN overall\nORDER BY ord;", "rows": 6, "error": null}
{"t": 1792236677.2190897, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_totals AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        c.country,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_rev,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity END), 0) AS delivered_units,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' AND oi.discount_pct > 0 THEN oi.quantity * oi.unit_price END), 0) AS discounted_rev,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' AND (o.discount_code IS NOT NULL AND o.discount_code != '') THEN o.order_id END) AS discounted_orders\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel, c.country\n),\nranked_custs AS (\n    SELECT \n        *,\n        NTILE(10) OVER (ORDER BY net_rev DESC) AS decile,\n        CASE \n            WHEN net_rev >= 604.00 THEN 'Top 10%'\n            ELSE 'Bottom 90%'\n        END AS tier_10,\n        CASE \n            WHEN net_rev >= 415.00 THEN 'Top 20%'\n            ELSE 'Bottom 80%'\n        END AS tier_20\n    FROM cust_totals\n)\nSELECT \n    tier_10 AS segment,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / SUM(COUNT(*)) OVER () * 100, 2) AS pct_customers,\n    ROUND(SUM(net_rev), 2) AS total_net_revenue,\n    ROUND(AVG(net_rev), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_rev) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(COUNT(*), 0), 2) AS units_per_cust,\n    ROUND(SUM(discounted_rev) / NULLIF(SUM(net_rev), 0) * 100, 2) AS pct_rev_discounted,\n    ROUND(SUM(discounted_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n    ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\nFROM ranked_custs\nGROUP BY tier_10\nUNION ALL\nSELECT \n    'Top 20%' AS segment,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / 5820.0 * 100, 2) AS pct_customers,\n    ROUND(SUM(net_rev), 2) AS total_net_revenue,\n    ROUND(AVG(net_rev), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_rev) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(COUNT(*), 0), 2) AS units_per_cust,\n    ROUND(SUM(discounted_rev) / NULLIF(SUM(net_rev), 0) * 100, 2) AS pct_rev_discounted,\n    ROUND(SUM(discounted_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n    ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\nFROM ranked_custs\nWHERE tier_20 = 'Top 20%'\nUNION ALL\nSELECT \n    'Bottom 80%' AS segment,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / 5820.0 * 100, 2) AS pct_customers,\n    ROUND(SUM(net_rev), 2) AS total_net_revenue,\n    ROUND(AVG(net_rev), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_rev) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(COUNT(*), 0), 2) AS units_per_cust,\n    ROUND(SUM(discounted_rev) / NULLIF(SUM(net_rev), 0) * 100, 2) AS pct_rev_discounted,\n    ROUND(SUM(discounted_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n    ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\nFROM ranked_custs\nWHERE tier_20 = 'Bottom 80%'\nUNION ALL\nSELECT \n    'Total Customer Base' AS segment,\n    COUNT(*) AS customer_count,\n    100.00 AS pct_customers,\n    ROUND(SUM(net_rev), 2) AS total_net_revenue,\n    ROUND(AVG(net_rev), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_rev) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(SUM(delivered_units)::numeric / NULLIF(COUNT(*), 0), 2) AS units_per_cust,\n    ROUND(SUM(discounted_rev) / NULLIF(SUM(net_rev), 0) * 100, 2) AS pct_rev_discounted,\n    ROUND(SUM(discounted_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n    ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\nFROM ranked_custs;", "rows": 5, "error": null}
{"t": 1792236678.2875721, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_rev AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_rev\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nsegmented AS (\n    SELECT \n        *,\n        CASE WHEN net_rev >= 604.00 THEN 'Top 10%' ELSE 'Bottom 90%' END AS tier_10,\n        CASE WHEN net_rev >= 415.00 THEN 'Top 20%' ELSE 'Bottom 80%' END AS tier_20\n    FROM cust_rev\n)\nSELECT \n    acquisition_channel,\n    COUNT(*) AS total_customers,\n    ROUND(COUNT(*)::numeric / (SELECT COUNT(*) FROM segmented) * 100, 2) AS pct_of_total_base,\n    COUNT(CASE WHEN tier_10 = 'Top 10%' THEN 1 END) AS top10_customers,\n    ROUND(COUNT(CASE WHEN tier_10 = 'Top 10%' THEN 1 END)::numeric / NULLIF((SELECT COUNT(*) FROM segmented WHERE tier_10 = 'Top 10%'), 0) * 100, 2) AS pct_of_top10,\n    ROUND(COUNT(CASE WHEN tier_10 = 'Top 10%' THEN 1 END)::numeric / COUNT(*) * 100, 2) AS top10_penetration_rate,\n    COUNT(CASE WHEN tier_20 = 'Top 20%' THEN 1 END) AS top20_customers,\n    ROUND(COUNT(CASE WHEN tier_20 = 'Top 20%' THEN 1 END)::numeric / NULLIF((SELECT COUNT(*) FROM segmented WHERE tier_20 = 'Top 20%'), 0) * 100, 2) AS pct_of_top20,\n    ROUND(COUNT(CASE WHEN tier_20 = 'Top 20%' THEN 1 END)::numeric / COUNT(*) * 100, 2) AS top20_penetration_rate,\n    COUNT(CASE WHEN tier_10 = 'Bottom 90%' THEN 1 END) AS bottom90_customers,\n    ROUND(COUNT(CASE WHEN tier_10 = 'Bottom 90%' THEN 1 END)::numeric / NULLIF((SELECT COUNT(*) FROM segmented WHERE tier_10 = 'Bottom 90%'), 0) * 100, 2) AS pct_of_bottom90\nFROM segmented\nGROUP BY acquisition_channel\nORDER BY top10_customers DESC;", "rows": 7, "error": null}
{"t": 1792236679.494037, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_rev AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_rev\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\ncust_tier AS (\n    SELECT \n        customer_id,\n        net_rev,\n        CASE WHEN net_rev >= 604.00 THEN 'Top 10%' ELSE 'Bottom 90%' END AS tier_10,\n        CASE WHEN net_rev >= 415.00 THEN 'Top 20%' ELSE 'Bottom 80%' END AS tier_20\n    FROM cust_rev\n),\ncat_spending AS (\n    SELECT \n        ct.tier_10,\n        p.category,\n        COUNT(DISTINCT c.customer_id) AS buying_customers,\n        SUM(oi.quantity) AS total_quantity,\n        SUM(oi.quantity * oi.unit_price) AS category_net_rev\n    FROM cust_tier ct\n    JOIN public.customers c ON ct.customer_id = c.customer_id\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    GROUP BY ct.tier_10, p.category\n),\ntier_totals AS (\n    SELECT \n        tier_10,\n        SUM(category_net_rev) AS tier_rev,\n        CASE WHEN tier_10 = 'Top 10%' THEN 582 ELSE 5238 END AS total_tier_custs\n    FROM cat_spending\n    GROUP BY tier_10\n)\nSELECT \n    cs.tier_10,\n    cs.category,\n    ROUND(cs.category_net_rev, 2) AS cat_net_rev,\n    ROUND(cs.category_net_rev / tt.tier_rev * 100, 2) AS cat_share_of_tier_rev,\n    cs.buying_customers,\n    ROUND(cs.buying_customers::numeric / tt.total_tier_custs * 100, 2) AS cat_customer_penetration_pct,\n    ROUND(cs.category_net_rev / cs.buying_customers, 2) AS rev_per_buying_cust\nFROM cat_spending cs\nJOIN tier_totals tt ON cs.tier_10 = tt.tier_10\nORDER BY cs.tier_10, cat_share_of_tier_rev DESC;", "rows": 12, "error": null}
{"t": 1792236688.5265687, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_base AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity END), 0) AS total_units,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' AND oi.discount_pct > 0 THEN oi.quantity * oi.unit_price END), 0) AS discounted_revenue,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' AND o.discount_code IS NOT NULL THEN o.order_id END) AS promo_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN p.category END) AS distinct_categories_bought\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    LEFT JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked_cust AS (\n    SELECT \n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile_rank\n    FROM cust_base\n),\nsegments AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        delivered_orders,\n        total_orders,\n        returned_orders,\n        total_units,\n        discounted_revenue,\n        promo_orders,\n        distinct_categories_bought,\n        CASE WHEN decile_rank = 1 THEN 'Top 10%' ELSE 'Bottom 90%' END AS segment_10,\n        CASE WHEN decile_rank <= 2 THEN 'Top 20%' ELSE 'Bottom 80%' END AS segment_20\n    FROM ranked_cust\n),\nagg_10 AS (\n    SELECT \n        segment_10 AS segment_name,\n        COUNT(*) AS customer_count,\n        ROUND(COUNT(*)::numeric / 5820 * 100, 2) AS pct_customers,\n        ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n        ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n        ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n        ROUND(SUM(net_revenue) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n        ROUND(SUM(total_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n        ROUND(AVG(distinct_categories_bought), 2) AS avg_categories_bought,\n        ROUND(SUM(discounted_revenue) / NULLIF(SUM(net_revenue), 0) * 100, 2) AS pct_rev_discounted,\n        ROUND(SUM(promo_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n        ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\n    FROM segments\n    GROUP BY segment_10\n),\nagg_total AS (\n    SELECT \n        'Total Base' AS segment_name,\n        COUNT(*) AS customer_count,\n        100.00 AS pct_customers,\n        ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n        ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n        ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n        ROUND(SUM(net_revenue) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n        ROUND(SUM(total_units)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n        ROUND(AVG(distinct_categories_bought), 2) AS avg_categories_bought,\n        ROUND(SUM(discounted_revenue) / NULLIF(SUM(net_revenue), 0) * 100, 2) AS pct_rev_discounted,\n        ROUND(SUM(promo_orders)::numeric / NULLIF(SUM(delivered_orders), 0) * 100, 2) AS pct_orders_with_promo,\n        ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS order_return_rate\n    FROM segments\n)\nSELECT * FROM agg_10\nUNION ALL\nSELECT * FROM agg_total;", "rows": 3, "error": null}
{"t": 1792236697.8057444, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_orders AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) AS net_rev\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\ncust_ranked AS (\n    SELECT \n        customer_id,\n        net_rev,\n        NTILE(10) OVER (ORDER BY net_rev DESC) AS decile\n    FROM cust_orders\n),\ncust_orders_summary AS (\n    SELECT \n        c.customer_id,\n        CASE WHEN cr.decile = 1 THEN 'Top 10%' ELSE 'Bottom 90%' END AS tier,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' AND (o.discount_code IS NOT NULL AND o.discount_code != '') THEN o.order_id END) AS promo_orders,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price END), 0) AS net_revenue,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' AND (o.discount_code IS NOT NULL AND o.discount_code != '') THEN oi.quantity * oi.unit_price END), 0) AS promo_net_revenue,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity END), 0) AS delivered_units,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN p.category END) AS distinct_categories\n    FROM public.customers c\n    JOIN cust_ranked cr ON c.customer_id = cr.customer_id\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    LEFT JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, cr.decile\n)\nSELECT \n    tier,\n    COUNT(DISTINCT customer_id) AS customer_count,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_revenue) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(CAST(SUM(delivered_units) AS NUMERIC) / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(AVG(distinct_categories), 2) AS avg_categories_per_customer,\n    ROUND(100.0 * SUM(promo_net_revenue) / NULLIF(SUM(net_revenue), 0), 2) AS pct_rev_from_promo,\n    ROUND(100.0 * SUM(promo_orders) / NULLIF(SUM(delivered_orders), 0), 2) AS pct_orders_with_promo,\n    ROUND(100.0 * SUM(returned_orders) / NULLIF(SUM(total_orders), 0), 2) AS return_rate_pct\nFROM cust_orders_summary\nGROUP BY tier\n\nUNION ALL\n\nSELECT \n    'Total Base' AS tier,\n    COUNT(DISTINCT customer_id) AS customer_count,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(SUM(net_revenue) / NULLIF(SUM(delivered_orders), 0), 2) AS aov,\n    ROUND(CAST(SUM(delivered_units) AS NUMERIC) / NULLIF(SUM(delivered_orders), 0), 2) AS units_per_order,\n    ROUND(AVG(distinct_categories), 2) AS avg_categories_per_customer,\n    ROUND(100.0 * SUM(promo_net_revenue) / NULLIF(SUM(net_revenue), 0), 2) AS pct_rev_from_promo,\n    ROUND(100.0 * SUM(promo_orders) / NULLIF(SUM(delivered_orders), 0), 2) AS pct_orders_with_promo,\n    ROUND(100.0 * SUM(returned_orders) / NULLIF(SUM(total_orders), 0), 2) AS return_rate_pct\nFROM cust_orders_summary;", "rows": 3, "error": null}
{"t": 1792236709.2070541, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH max_date_cte AS (\n    SELECT MAX(order_date) AS max_order_date FROM public.orders WHERE status = 'delivered'\n),\ncust_totals AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COUNT(DISTINCT o.order_id) AS delivered_orders\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n    GROUP BY c.customer_id\n),\ntop_cust AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        delivered_orders,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile\n    FROM cust_totals\n),\ncust_orders AS (\n    SELECT \n        o.customer_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date) AS prev_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered' AND c.is_internal = FALSE\n),\norder_intervals AS (\n    SELECT \n        customer_id,\n        order_date,\n        (order_date - prev_order_date) AS days_between\n    FROM cust_orders\n    WHERE prev_order_date IS NOT NULL\n),\ncust_cadence AS (\n    SELECT \n        customer_id,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY days_between) AS median_gap_days,\n        MAX(order_date) AS last_order_date\n    FROM order_intervals\n    GROUP BY customer_id\n),\ncust_risk AS (\n    SELECT \n        tc.customer_id,\n        tc.decile,\n        tc.net_revenue,\n        tc.delivered_orders,\n        cc.median_gap_days,\n        cc.last_order_date,\n        (m.max_order_date - cc.last_order_date) AS recency_days,\n        GREATEST(60, 2 * cc.median_gap_days) AS at_risk_threshold,\n        CASE \n            WHEN tc.delivered_orders < 3 THEN 'insufficient_history'\n            WHEN (m.max_order_date - cc.last_order_date) > GREATEST(60, 2 * cc.median_gap_days) THEN 'at_risk'\n            WHEN (m.max_order_date - cc.last_order_date) > cc.median_gap_days THEN 'cooling'\n            ELSE 'active'\n        END AS retention_status\n    FROM top_cust tc\n    CROSS JOIN max_date_cte m\n    LEFT JOIN cust_cadence cc ON tc.customer_id = cc.customer_id\n    WHERE tc.decile = 1\n)\nSELECT \n    retention_status,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pct_of_top_customers,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(net_revenue) * 100.0 / (SELECT SUM(net_revenue) FROM cust_risk), 2) AS pct_of_top_net_revenue,\n    ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_delivered_orders,\n    ROUND(AVG(median_gap_days), 2) AS avg_median_gap_days,\n    ROUND(AVG(recency_days), 2) AS avg_recency_days\nFROM cust_risk\nGROUP BY retention_status\nORDER BY customer_count DESC;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42883', 'M': 'function round(double precision, integer) does not exist', 'H': 'No function matches the given name and argument types. You might need to add explicit type casts.', 'P': '2688', 'F': 'parse_func.c', 'L': '629', 'R': 'ParseFuncOrColumn'}"}
{"t": 1792236717.5979807, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\ncust_totals AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COUNT(DISTINCT do.order_id) AS delivered_orders\n    FROM public.customers c\n    JOIN delivered_orders do ON c.customer_id = do.customer_id\n    JOIN public.order_items oi ON do.order_id = oi.order_id\n    GROUP BY c.customer_id\n),\ntop_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        delivered_orders,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile\n    FROM cust_totals\n),\ndataset_max_date AS (\n    SELECT MAX(order_date) AS max_order_date FROM public.orders\n),\norder_lags AS (\n    SELECT \n        do.customer_id,\n        do.order_date,\n        LAG(do.order_date) OVER (PARTITION BY do.customer_id ORDER BY do.order_date) AS prev_order_date\n    FROM delivered_orders do\n    JOIN top_customers tc ON do.customer_id = tc.customer_id\n    WHERE tc.decile = 1 AND tc.delivered_orders >= 3\n),\norder_gaps AS (\n    SELECT \n        customer_id,\n        (order_date - prev_order_date) AS gap_days\n    FROM order_lags\n    WHERE prev_order_date IS NOT NULL\n),\ncust_cadence AS (\n    SELECT \n        customer_id,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY gap_days)::numeric AS median_gap_days\n    FROM order_gaps\n    GROUP BY customer_id\n),\ncust_recency AS (\n    SELECT \n        do.customer_id,\n        MAX(do.order_date) AS last_order_date,\n        (dmd.max_order_date - MAX(do.order_date)) AS days_since_last_order\n    FROM delivered_orders do\n    JOIN top_customers tc ON do.customer_id = tc.customer_id\n    CROSS JOIN dataset_max_date dmd\n    WHERE tc.decile = 1 AND tc.delivered_orders >= 3\n    GROUP BY do.customer_id, dmd.max_order_date\n),\ncust_risk_status AS (\n    SELECT \n        tc.customer_id,\n        tc.net_revenue,\n        tc.delivered_orders,\n        cc.median_gap_days,\n        cr.days_since_last_order,\n        GREATEST(60::numeric, 2.0 * cc.median_gap_days) AS risk_threshold_days,\n        CASE \n            WHEN cr.days_since_last_order > GREATEST(60::numeric, 2.0 * cc.median_gap_days) THEN 'At Risk / Lapsing'\n            WHEN cr.days_since_last_order > cc.median_gap_days THEN 'Cooling'\n            ELSE 'Active'\n        END AS status\n    FROM top_customers tc\n    JOIN cust_cadence cc ON tc.customer_id = cc.customer_id\n    JOIN cust_recency cr ON tc.customer_id = cr.customer_id\n)\nSELECT \n    status,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / SUM(COUNT(*)) OVER () * 100, 2) AS pct_of_analyzed_top_customers,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(net_revenue) / SUM(SUM(net_revenue)) OVER () * 100, 2) AS pct_of_top_cohort_net_rev,\n    ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(delivered_orders), 2) AS avg_orders,\n    ROUND(AVG(median_gap_days), 2) AS avg_median_gap_days,\n    ROUND(AVG(days_since_last_order), 2) AS avg_days_since_last_order\nFROM cust_risk_status\nGROUP BY status\nORDER BY customer_count DESC;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42601', 'M': 'syntax error at or near \"do\"', 'P': '418', 'F': 'scan.l', 'L': '1244', 'R': 'scanner_yyerror'}"}
{"t": 1792236731.233078, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH max_d AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders WHERE status = 'delivered'\n),\ncust_orders AS (\n    SELECT \n        o.customer_id,\n        o.order_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date) AS prev_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered' AND c.is_internal = false\n),\norder_intervals AS (\n    SELECT \n        customer_id,\n        order_date,\n        prev_order_date,\n        (order_date - prev_order_date) AS interval_days\n    FROM cust_orders\n    WHERE prev_order_date IS NOT NULL\n),\ncust_cadence AS (\n    SELECT \n        customer_id,\n        COUNT(*) + 1 AS delivered_orders,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY interval_days) AS median_gap_days,\n        MAX(order_date) AS last_order_date\n    FROM order_intervals\n    GROUP BY customer_id\n),\ncust_rev AS (\n    SELECT \n        c.customer_id,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\ntop_custs AS (\n    SELECT \n        cr.customer_id,\n        cr.net_revenue,\n        cc.delivered_orders,\n        cc.median_gap_days,\n        cc.last_order_date,\n        (m.max_date - cc.last_order_date) AS days_since_last_order,\n        GREATEST(60, 2 * cc.median_gap_days) AS lapse_threshold_days,\n        CASE \n            WHEN (m.max_date - cc.last_order_date) > GREATEST(60, 2 * cc.median_gap_days) THEN 'At-Risk / Lapsed'\n            WHEN (m.max_date - cc.last_order_date) > cc.median_gap_days THEN 'Cooling'\n            ELSE 'Active'\n        END AS retention_status\n    FROM cust_rev cr\n    CROSS JOIN max_d m\n    LEFT JOIN cust_cadence cc ON cr.customer_id = cc.customer_id\n    WHERE cr.net_revenue >= 415.00 -- Top 20% threshold from Step 1\n)\nSELECT \n    CASE \n        WHEN net_revenue >= 604.00 THEN 'Top 10% (VIP)'\n        ELSE 'Next 10% (Decile 2)'\n    END AS tier,\n    CASE \n        WHEN delivered_orders >= 3 THEN retention_status\n        ELSE 'Insufficient History (<3 orders)'\n    END AS status_group,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / SUM(COUNT(*)) OVER (PARTITION BY CASE WHEN net_revenue >= 604.00 THEN 'Top 10% (VIP)' ELSE 'Next 10% (Decile 2)' END) * 100, 2) AS pct_of_tier,\n    ROUND(SUM(net_revenue), 2) AS group_net_revenue,\n    ROUND(AVG(net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(median_gap_days)::numeric, 1) AS avg_median_gap_days,\n    ROUND(AVG(days_since_last_order)::numeric, 1) AS avg_days_since_last_order\nFROM top_custs\nGROUP BY 1, 2\nORDER BY 1 DESC, 3 DESC;", "rows": 8, "error": null}
{"t": 1792270072.4209316, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH july_promo AS (\n    SELECT promo_code, description, start_date, end_date, discount_pct,\n           (end_date - start_date + 1) AS sale_duration_days\n    FROM promotions\n    WHERE (start_date >= '2025-07-01' AND start_date <= '2025-07-31')\n       OR (end_date >= '2025-07-01' AND end_date <= '2025-07-31')\n       OR promo_code ILIKE '%JUL%'\n),\ncustomer_order_cadence AS (\n    SELECT \n        o.customer_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date) AS prev_order_date\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n),\nintervals AS (\n    SELECT \n        (order_date - prev_order_date) AS days_between\n    FROM customer_order_cadence\n    WHERE prev_order_date IS NOT NULL\n),\ncadence_stats AS (\n    SELECT \n        percentile_cont(0.5) WITHIN GROUP (ORDER BY days_between) AS median_days_between,\n        ROUND(percentile_cont(0.5) WITHIN GROUP (ORDER BY days_between)::numeric, 2) AS median_days_rounded,\n        CEIL(percentile_cont(0.5) WITHIN GROUP (ORDER BY days_between) / 7.0) * 7 AS post_sale_days_weeks_rounded\n    FROM intervals\n),\nnext_promo AS (\n    SELECT \n        p.promo_code AS next_promo_code,\n        p.start_date AS next_promo_start_date\n    FROM promotions p, july_promo jp\n    WHERE p.start_date > jp.end_date\n    ORDER BY p.start_date ASC\n    LIMIT 1\n),\nmax_delivered_order_date AS (\n    SELECT MAX(o.order_date) AS max_order_date\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n)\nSELECT \n    jp.promo_code,\n    jp.description,\n    jp.start_date AS sale_start_date,\n    jp.end_date AS sale_end_date,\n    jp.discount_pct,\n    jp.sale_duration_days,\n    cs.median_days_between,\n    cs.post_sale_days_weeks_rounded,\n    np.next_promo_code,\n    np.next_promo_start_date,\n    m.max_order_date\nFROM july_promo jp\nCROSS JOIN cadence_stats cs\nLEFT JOIN next_promo np ON true\nCROSS JOIN max_delivered_order_date m;", "rows": 1, "error": null}
{"t": 1792270109.9929516, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH promo_info AS (\n    SELECT \n        '2025-07-11'::date AS sale_start,\n        '2025-07-20'::date AS sale_end,\n        10 AS sale_days,\n        49 AS post_sale_days,\n        59 AS combined_days,\n        ('2025-07-11'::date - 59) AS baseline_start,\n        ('2025-07-11'::date - 1) AS baseline_end,\n        ('2025-07-20'::date + 1) AS post_sale_start,\n        ('2025-07-20'::date + 49) AS post_sale_end\n),\n-- baseline: 2025-05-13 to 2025-07-10 (59 days)\n-- sale: 2025-07-11 to 2025-07-20 (10 days)\n-- post_sale: 2025-07-21 to 2025-09-08 (49 days)\n-- combined: 2025-07-11 to 2025-09-08 (59 days)\norder_level AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS order_gross_profit,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS order_discount_cost\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    JOIN order_items oi ON o.order_id = oi.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date >= '2025-05-13' AND o.order_date <= '2025-09-08'\n    GROUP BY o.order_id, o.order_date\n),\nwindow_metrics AS (\n    SELECT\n        CASE \n            WHEN order_date BETWEEN '2025-05-13' AND '2025-07-10' THEN 'Baseline (59d)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (10d)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-09-08' THEN 'Post-Sale (49d)'\n        END AS period,\n        CASE \n            WHEN order_date BETWEEN '2025-05-13' AND '2025-07-10' THEN 59\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 10\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-09-08' THEN 49\n        END AS days,\n        COUNT(DISTINCT order_id) AS orders,\n        SUM(order_net_revenue) AS net_revenue,\n        SUM(order_gross_profit) AS gross_profit,\n        SUM(order_discount_cost) AS discount_cost\n    FROM order_level\n    GROUP BY 1, 2\n),\ncombined_metric AS (\n    SELECT\n        'Combined Sale + Post-Sale (59d)' AS period,\n        59 AS days,\n        COUNT(DISTINCT order_id) AS orders,\n        SUM(order_net_revenue) AS net_revenue,\n        SUM(order_gross_profit) AS gross_profit,\n        SUM(order_discount_cost) AS discount_cost\n    FROM order_level\n    WHERE order_date BETWEEN '2025-07-11' AND '2025-09-08'\n),\nall_windows AS (\n    SELECT * FROM window_metrics\n    UNION ALL\n    SELECT * FROM combined_metric\n),\ncalc AS (\n    SELECT\n        period,\n        days,\n        orders,\n        ROUND((orders::numeric / days), 2) AS orders_per_day,\n        ROUND(net_revenue, 2) AS net_revenue,\n        ROUND((net_revenue / days), 2) AS revenue_per_day,\n        ROUND(gross_profit, 2) AS gross_profit,\n        ROUND((gross_profit / days), 2) AS gross_profit_per_day,\n        ROUND(discount_cost, 2) AS discount_cost,\n        ROUND((discount_cost / days), 2) AS discount_cost_per_day,\n        ROUND((net_revenue / NULLIF(orders, 0)), 2) AS aov,\n        ROUND((gross_profit / NULLIF(net_revenue, 0) * 100), 2) AS realized_margin_pct\n    FROM all_windows\n)\nSELECT \n    c.*,\n    -- Comparisons to Baseline per-day\n    ROUND(((c.revenue_per_day - b.revenue_per_day) / b.revenue_per_day * 100), 2) AS rev_per_day_lift_pct,\n    ROUND((c.revenue_per_day - b.revenue_per_day), 2) AS rev_per_day_diff,\n    ROUND(((c.gross_profit_per_day - b.gross_profit_per_day) / b.gross_profit_per_day * 100), 2) AS gp_per_day_lift_pct,\n    ROUND((c.gross_profit_per_day - b.gross_profit_per_day), 2) AS gp_per_day_diff,\n    ROUND(((c.orders_per_day - b.orders_per_day) / b.orders_per_day * 100), 2) AS orders_per_day_lift_pct,\n    -- Total difference relative to baseline scaled to same period days\n    ROUND((c.net_revenue - (b.revenue_per_day * c.days)), 2) AS net_revenue_incremental_vs_baseline_rate,\n    ROUND((c.gross_profit - (b.gross_profit_per_day * c.days)), 2) AS gross_profit_incremental_vs_baseline_rate\nFROM calc c\nCROSS JOIN (SELECT * FROM calc WHERE period = 'Baseline (59d)') b\nORDER BY CASE \n    WHEN c.period = 'Baseline (59d)' THEN 1\n    WHEN c.period = 'Sale (10d)' THEN 2\n    WHEN c.period = 'Post-Sale (49d)' THEN 3\n    WHEN c.period = 'Combined Sale + Post-Sale (59d)' THEN 4\nEND;", "rows": 4, "error": null}
{"t": 1792270321.0769753, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH sale_params AS (\n    SELECT \n        '2025-07-11'::date AS sale_start,\n        '2025-07-20'::date AS sale_end\n),\ncustomer_classification AS (\n    -- For each order during sale, classify customer as new or existing\n    -- existing_customer: non-internal customer with at least one delivered order BEFORE analysis window start (2025-07-11)\n    -- new_customer: non-internal customer whose first delivered order falls inside the analysis window (or >= 2025-07-11)\n    SELECT \n        c.customer_id,\n        MIN(o.order_date) AS first_delivered_order_date,\n        CASE \n            WHEN MIN(o.order_date) < (SELECT sale_start FROM sale_params) THEN 'existing'\n            ELSE 'new'\n        END AS customer_type\n    FROM customers c\n    JOIN orders o ON c.customer_id = o.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nsale_order_details AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        cc.customer_type,\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.list_price,\n        p.unit_cost,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * (oi.unit_price - p.unit_cost)) AS line_gross_profit,\n        (oi.quantity * (p.list_price - oi.unit_price)) AS line_discount_cost\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    JOIN customer_classification cc ON o.customer_id = cc.customer_id\n    JOIN order_items oi ON o.order_id = oi.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    CROSS JOIN sale_params sp\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN sp.sale_start AND sp.sale_end\n),\ncustomer_summary AS (\n    SELECT \n        customer_type,\n        COUNT(DISTINCT customer_id) AS distinct_customers,\n        COUNT(DISTINCT order_id) AS orders_count,\n        ROUND(SUM(line_net_revenue), 2) AS net_revenue,\n        ROUND(SUM(line_gross_profit), 2) AS gross_profit,\n        ROUND(SUM(line_discount_cost), 2) AS discount_cost,\n        ROUND(SUM(line_net_revenue) / NULLIF(COUNT(DISTINCT order_id), 0), 2) AS aov\n    FROM sale_order_details\n    GROUP BY customer_type\n),\ncustomer_totals AS (\n    SELECT \n        SUM(orders_count) AS total_orders,\n        SUM(distinct_customers) AS total_customers,\n        SUM(net_revenue) AS total_rev,\n        SUM(gross_profit) AS total_gp,\n        SUM(discount_cost) AS total_disc\n    FROM customer_summary\n)\nSELECT \n    cs.customer_type,\n    cs.distinct_customers,\n    ROUND(cs.distinct_customers::numeric / ct.total_customers * 100, 2) AS pct_of_customers,\n    cs.orders_count,\n    ROUND(cs.orders_count::numeric / ct.total_orders * 100, 2) AS pct_of_orders,\n    cs.net_revenue,\n    ROUND(cs.net_revenue / ct.total_rev * 100, 2) AS pct_of_revenue,\n    cs.gross_profit,\n    ROUND(cs.gross_profit / ct.total_gp * 100, 2) AS pct_of_gross_profit,\n    cs.discount_cost,\n    ROUND(cs.discount_cost / ct.total_disc * 100, 2) AS pct_of_discount_cost,\n    cs.aov\nFROM customer_summary cs\nCROSS JOIN customer_totals ct;\n", "rows": 2, "error": null}
{"t": 1792270322.2596273, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH sale_params AS (\n    SELECT \n        '2025-07-11'::date AS sale_start,\n        '2025-07-20'::date AS sale_end\n),\nsale_product_performance AS (\n    SELECT \n        p.product_id,\n        p.product_name,\n        p.category,\n        SUM(oi.quantity) AS units_sold,\n        ROUND(SUM(oi.quantity * oi.unit_price), 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 2) AS gross_profit,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price)), 2) AS discount_cost\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    JOIN order_items oi ON o.order_id = oi.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    CROSS JOIN sale_params sp\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n      AND o.order_date BETWEEN sp.sale_start AND sp.sale_end\n    GROUP BY p.product_id, p.product_name, p.category\n),\ntotal_sale AS (\n    SELECT \n        SUM(units_sold) AS total_units,\n        SUM(net_revenue) AS total_rev,\n        SUM(gross_profit) AS total_gp\n    FROM sale_product_performance\n),\noverlapping_stock_events AS (\n    SELECT \n        se.product_id,\n        se.event_type,\n        se.start_date,\n        se.end_date\n    FROM stock_events se\n    CROSS JOIN sale_params sp\n    WHERE se.start_date <= sp.sale_end AND se.end_date >= sp.sale_start\n)\nSELECT \n    spp.product_id,\n    spp.product_name,\n    spp.category,\n    spp.units_sold,\n    ROUND(spp.units_sold::numeric / ts.total_units * 100, 2) AS pct_of_units,\n    spp.net_revenue,\n    ROUND(spp.net_revenue / ts.total_rev * 100, 2) AS pct_of_net_revenue,\n    spp.gross_profit,\n    ROUND(spp.gross_profit / ts.total_gp * 100, 2) AS pct_of_gross_profit,\n    spp.discount_cost,\n    ose.event_type AS stock_event_type,\n    ose.start_date AS stock_event_start,\n    ose.end_date AS stock_event_end\nFROM sale_product_performance spp\nCROSS JOIN total_sale ts\nLEFT JOIN overlapping_stock_events ose ON spp.product_id = ose.product_id\nORDER BY spp.net_revenue DESC;\n", "rows": 17, "error": null}
{"t": 1792270323.7671676, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    se.product_id,\n    p.product_name,\n    se.event_type,\n    se.start_date,\n    se.end_date\nFROM stock_events se\nJOIN products p ON se.product_id = p.product_id\nWHERE (se.start_date <= '2025-09-07' AND se.end_date >= '2025-05-13')\nORDER BY se.start_date;\n", "rows": 1, "error": null}
{"t": 1792270667.0697784, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n        COUNT(DISTINCT o.order_id) AS order_count\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        gross_profit,\n        order_count,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id) AS decile\n    FROM customer_rev\n),\ntotals AS (\n    SELECT \n        COUNT(*) AS total_customers,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit\n    FROM customer_rev\n),\ndecile_summary AS (\n    SELECT \n        r.decile,\n        COUNT(*) AS customers_in_decile,\n        MIN(r.net_revenue) AS min_customer_revenue,\n        MAX(r.net_revenue) AS max_customer_revenue,\n        ROUND(SUM(r.net_revenue)::numeric, 2) AS decile_net_revenue,\n        ROUND(SUM(r.gross_profit)::numeric, 2) AS decile_gross_profit,\n        ROUND((SUM(r.net_revenue) / t.total_net_revenue * 100)::numeric, 2) AS net_revenue_share_pct,\n        ROUND((SUM(r.gross_profit) / t.total_gross_profit * 100)::numeric, 2) AS gross_profit_share_pct\n    FROM ranked_customers r\n    CROSS JOIN totals t\n    GROUP BY r.decile, t.total_net_revenue, t.total_gross_profit\n    ORDER BY r.decile\n)\nSELECT \n    decile,\n    customers_in_decile,\n    min_customer_revenue,\n    max_customer_revenue,\n    decile_net_revenue,\n    decile_gross_profit,\n    net_revenue_share_pct,\n    gross_profit_share_pct,\n    ROUND(SUM(net_revenue_share_pct) OVER (ORDER BY decile)::numeric, 2) AS cum_net_rev_share_pct,\n    ROUND(SUM(gross_profit_share_pct) OVER (ORDER BY decile)::numeric, 2) AS cum_gross_profit_share_pct\nFROM decile_summary;", "rows": 10, "error": null}
{"t": 1792270672.5512583, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked AS (\n    SELECT \n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id) AS decile\n    FROM customer_rev\n),\ntotals AS (\n    SELECT \n        SUM(net_revenue) AS total_rev,\n        SUM(gross_profit) AS total_gp,\n        COUNT(*) AS total_cust\n    FROM ranked\n)\nSELECT \n    CASE WHEN decile = 1 THEN 'Top Decile (Top 10%)' ELSE 'Remaining Base (Bottom 90%)' END AS segment,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric / MAX(t.total_cust) * 100, 2) AS customer_share_pct,\n    ROUND(SUM(r.net_revenue)::numeric, 2) AS segment_net_revenue,\n    ROUND(SUM(r.gross_profit)::numeric, 2) AS segment_gross_profit,\n    ROUND(SUM(r.net_revenue)::numeric / MAX(t.total_rev) * 100, 2) AS net_revenue_share_pct,\n    ROUND(SUM(r.gross_profit)::numeric / MAX(t.total_gp) * 100, 2) AS gross_profit_share_pct,\n    ROUND(AVG(r.net_revenue)::numeric, 2) AS avg_net_revenue_per_customer,\n    ROUND(AVG(r.gross_profit)::numeric, 2) AS avg_gross_profit_per_customer,\n    ROUND(MIN(r.net_revenue)::numeric, 2) AS min_net_revenue,\n    ROUND(MAX(r.net_revenue)::numeric, 2) AS max_net_revenue\nFROM ranked r\nCROSS JOIN totals t\nGROUP BY CASE WHEN decile = 1 THEN 'Top Decile (Top 10%)' ELSE 'Remaining Base (Bottom 90%)' END\nORDER BY segment DESC;", "rows": 2, "error": null}
{"t": 1792270707.8226795, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_order_count,\n        COUNT(DISTINCT o.order_id) AS total_order_count,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_order_count,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' AND o.discount_code IS NOT NULL THEN o.order_id END) AS delivered_discounted_order_count,\n        COUNT(DISTINCT oi.product_id) AS distinct_products_bought,\n        COUNT(DISTINCT p.category) AS distinct_categories_bought,\n        MIN(CASE WHEN o.status = 'delivered' THEN o.order_date END) AS first_order_date,\n        MAX(CASE WHEN o.status = 'delivered' THEN o.order_date END) AS last_order_date\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel, c.signup_date\n    HAVING SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) > 0\n),\ncustomer_ranked AS (\n    SELECT \n        cr.*,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile,\n        CASE \n            WHEN NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) = 1 THEN 'Top Decile'\n            ELSE 'Remaining Base'\n        END AS segment\n    FROM (\n        SELECT \n            c.customer_id,\n            c.acquisition_channel,\n            c.signup_date,\n            SUM(oi.quantity * oi.unit_price) AS net_revenue,\n            SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n            COUNT(DISTINCT o.order_id) AS delivered_orders,\n            COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL THEN o.order_id END) AS discounted_orders,\n            COUNT(DISTINCT p.category) AS categories_bought,\n            COUNT(DISTINCT oi.product_id) AS products_bought,\n            MIN(o.order_date) AS first_order_date,\n            MAX(o.order_date) AS last_order_date\n        FROM public.customers c\n        JOIN public.orders o ON c.customer_id = o.customer_id\n        JOIN public.order_items oi ON o.order_id = oi.order_id\n        JOIN public.products p ON oi.product_id = p.product_id\n        WHERE c.is_internal = false\n          AND o.status = 'delivered'\n        GROUP BY c.customer_id, c.acquisition_channel, c.signup_date\n    ) cr\n),\ncustomer_all_orders AS (\n    -- to get return rate across all placed orders by customer\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS total_placed_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n)\nSELECT \n    cr.segment,\n    COUNT(cr.customer_id) AS customer_count,\n    ROUND(SUM(cr.net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(cr.gross_profit), 2) AS total_gross_profit,\n    ROUND(AVG(cr.net_revenue), 2) AS avg_net_revenue,\n    ROUND(AVG(cr.gross_profit), 2) AS avg_gross_profit,\n    ROUND(AVG(cr.delivered_orders::numeric), 2) AS avg_delivered_orders,\n    ROUND(SUM(cr.net_revenue) / SUM(cr.delivered_orders), 2) AS aov,\n    ROUND(AVG(cr.categories_bought::numeric), 2) AS avg_categories_bought,\n    ROUND(AVG(cr.products_bought::numeric), 2) AS avg_products_bought,\n    ROUND(SUM(cr.discounted_orders)::numeric / SUM(cr.delivered_orders) * 100, 2) AS discount_order_pct,\n    ROUND(AVG(CASE WHEN cr.delivered_orders > 1 THEN (cr.last_order_date - cr.first_order_date)::numeric / (cr.delivered_orders - 1) ELSE NULL END), 2) AS avg_order_interval_days,\n    ROUND(SUM(cao.returned_orders)::numeric / SUM(cao.total_placed_orders) * 100, 2) AS return_rate_pct\nFROM customer_ranked cr\nJOIN customer_all_orders cao ON cr.customer_id = cao.customer_id\nGROUP BY cr.segment;", "rows": 2, "error": null}
{"t": 1792270715.9265134, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_rev\n),\ntagged_customers AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Remaining Base' END AS segment\n    FROM ranked_customers\n)\nSELECT \n    tc.acquisition_channel,\n    COUNT(CASE WHEN tc.segment = 'Top Decile' THEN 1 END) AS top_decile_customers,\n    ROUND(COUNT(CASE WHEN tc.segment = 'Top Decile' THEN 1 END)::numeric / 502.0 * 100, 2) AS top_decile_channel_share_pct,\n    COUNT(CASE WHEN tc.segment = 'Remaining Base' THEN 1 END) AS remaining_base_customers,\n    ROUND(COUNT(CASE WHEN tc.segment = 'Remaining Base' THEN 1 END)::numeric / 4511.0 * 100, 2) AS remaining_base_channel_share_pct,\n    ROUND(\n        (COUNT(CASE WHEN tc.segment = 'Top Decile' THEN 1 END)::numeric / 502.0 * 100) -\n        (COUNT(CASE WHEN tc.segment = 'Remaining Base' THEN 1 END)::numeric / 4511.0 * 100), 2\n    ) AS channel_share_diff_pct_points\nFROM tagged_customers tc\nGROUP BY tc.acquisition_channel\nORDER BY top_decile_channel_share_pct DESC;", "rows": 7, "error": null}
{"t": 1792270781.2626894, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id) AS decile\n    FROM customer_rev\n),\ndataset_max_date AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders\n),\ncustomer_orders AS (\n    SELECT \n        o.customer_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date) AS prev_order_date\n    FROM public.orders o\n    JOIN ranked_customers rc ON o.customer_id = rc.customer_id\n    WHERE o.status = 'delivered'\n      AND rc.decile = 1\n),\ncustomer_gaps AS (\n    SELECT \n        customer_id,\n        COUNT(*) AS delivered_orders,\n        MAX(order_date) AS last_order_date,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY (order_date - prev_order_date)) AS median_gap_days\n    FROM customer_orders\n    GROUP BY customer_id\n),\ncustomer_risk AS (\n    SELECT \n        cg.customer_id,\n        cg.delivered_orders,\n        cg.last_order_date,\n        cg.median_gap_days,\n        (d.max_date - cg.last_order_date) AS days_since_last_order,\n        GREATEST(60, 2 * cg.median_gap_days) AS risk_threshold_days,\n        CASE \n            WHEN (d.max_date - cg.last_order_date) > GREATEST(60, 2 * cg.median_gap_days) THEN 'at_risk'\n            ELSE 'active'\n        END AS risk_status\n    FROM customer_gaps cg\n    CROSS JOIN dataset_max_date d\n)\nSELECT \n    risk_status,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS pct_of_top_decile,\n    ROUND(AVG(days_since_last_order)::numeric, 1) AS avg_days_since_last_order,\n    ROUND(AVG(median_gap_days)::numeric, 1) AS avg_median_gap_days,\n    ROUND(AVG(delivered_orders)::numeric, 1) AS avg_delivered_orders\nFROM customer_risk\nGROUP BY risk_status;", "rows": 2, "error": null}
{"t": 1792270782.4313393, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id) AS decile\n    FROM customer_rev\n),\nproduct_metrics AS (\n    SELECT \n        p.category,\n        p.product_id,\n        p.product_name,\n        SUM(oi.quantity * oi.unit_price) AS top_decile_net_revenue,\n        SUM(oi.quantity) AS top_decile_units_sold,\n        COUNT(DISTINCT o.order_id) AS top_decile_orders_count\n    FROM ranked_customers rc\n    JOIN public.orders o ON rc.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE rc.decile = 1\n      AND o.status = 'delivered'\n    GROUP BY p.category, p.product_id, p.product_name\n)\nSELECT \n    category,\n    product_name,\n    ROUND(top_decile_net_revenue, 2) AS top_decile_net_revenue,\n    top_decile_units_sold,\n    top_decile_orders_count,\n    ROUND(top_decile_net_revenue * 100.0 / SUM(top_decile_net_revenue) OVER (), 2) AS revenue_share_pct\nFROM product_metrics\nORDER BY top_decile_net_revenue DESC\nLIMIT 10;", "rows": 10, "error": null}
{"t": 1792270783.7509263, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_rev AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id) AS decile\n    FROM customer_rev\n),\ndeduped_reviews AS (\n    SELECT DISTINCT\n        review_id,\n        order_id,\n        product_id,\n        customer_id,\n        rating,\n        review_text\n    FROM public.reviews\n)\nSELECT \n    CASE WHEN rc.decile = 1 THEN 'Top Decile' ELSE 'Remaining Base' END AS segment,\n    COUNT(r.review_id) AS review_count,\n    ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n    ROUND(COUNT(CASE WHEN r.rating >= 4 THEN 1 END) * 100.0 / COUNT(r.review_id), 2) AS positive_review_pct,\n    ROUND(COUNT(CASE WHEN r.rating <= 2 THEN 1 END) * 100.0 / COUNT(r.review_id), 2) AS negative_review_pct,\n    ROUND(COUNT(r.review_id)::numeric / COUNT(DISTINCT rc.customer_id), 2) AS reviews_per_customer\nFROM ranked_customers rc\nJOIN deduped_reviews r ON rc.customer_id = r.customer_id\nGROUP BY CASE WHEN rc.decile = 1 THEN 'Top Decile' ELSE 'Remaining Base' END;", "rows": 2, "error": null}
{"t": 1792323098.0109944, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH july_promo AS (\n  SELECT promo_code, description, discount_pct, start_date, end_date,\n         (end_date - start_date + 1) AS sale_days\n  FROM public.promotions\n  WHERE EXTRACT(MONTH FROM start_date) = 7 OR EXTRACT(MONTH FROM end_date) = 7\n),\ncustomer_intervals AS (\n  SELECT o.customer_id,\n         o.order_date,\n         LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date) AS prev_order_date\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n),\nreorder_diffs AS (\n  SELECT (order_date - prev_order_date) AS days_between\n  FROM customer_intervals\n  WHERE prev_order_date IS NOT NULL\n),\nmedian_calc AS (\n  SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY days_between) AS median_days,\n         CEIL(percentile_cont(0.5) WITHIN GROUP (ORDER BY days_between) / 7.0) * 7 AS post_sale_days_weeks\n  FROM reorder_diffs\n),\nall_promos AS (\n  SELECT promo_code, start_date, end_date\n  FROM public.promotions\n  ORDER BY start_date\n),\nmax_order_date AS (\n  SELECT MAX(order_date) AS max_order_date FROM public.orders\n)\nSELECT jp.promo_code, jp.description, jp.discount_pct, jp.start_date, jp.end_date, jp.sale_days,\n       mc.median_days, mc.post_sale_days_weeks,\n       mod.max_order_date\nFROM july_promo jp\nCROSS JOIN median_calc mc\nCROSS JOIN max_order_date mod;", "rows": 1, "error": null}
{"t": 1792323225.0112247, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH promo_info AS (\n  SELECT \n    '2025-07-11'::date AS sale_start,\n    '2025-07-20'::date AS sale_end,\n    10 AS sale_days,\n    49 AS post_sale_days,\n    59 AS combined_days,\n    ('2025-07-11'::date - INTERVAL '59 days')::date AS baseline_start,\n    ('2025-07-11'::date - INTERVAL '1 day')::date AS baseline_end,\n    ('2025-07-20'::date + INTERVAL '1 day')::date AS post_sale_start,\n    ('2025-07-20'::date + INTERVAL '49 days')::date AS post_sale_end\n),\nclassified_orders AS (\n  SELECT \n    o.order_id,\n    o.order_date,\n    p.sale_start, p.sale_end, p.baseline_start, p.baseline_end, p.post_sale_start, p.post_sale_end,\n    CASE \n      WHEN o.order_date BETWEEN p.baseline_start AND p.baseline_end THEN 'baseline'\n      WHEN o.order_date BETWEEN p.sale_start AND p.sale_end THEN 'sale'\n      WHEN o.order_date BETWEEN p.post_sale_start AND p.post_sale_end THEN 'post_sale'\n      ELSE 'other'\n    END AS period\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  CROSS JOIN promo_info p\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n),\ndelivered_items AS (\n  SELECT \n    co.period,\n    co.order_id,\n    co.order_date,\n    oi.quantity,\n    oi.unit_price,\n    pr.list_price,\n    pr.unit_cost,\n    (oi.quantity * oi.unit_price) AS line_net_revenue,\n    (oi.quantity * pr.unit_cost) AS line_cost,\n    (oi.quantity * oi.unit_price - oi.quantity * pr.unit_cost) AS line_gross_profit,\n    (oi.quantity * (pr.list_price - oi.unit_price)) AS line_discount_cost\n  FROM classified_orders co\n  JOIN public.order_items oi ON co.order_id = oi.order_id\n  JOIN public.products pr ON oi.product_id = pr.product_id\n  WHERE co.period IN ('baseline', 'sale', 'post_sale')\n),\nperiod_agg AS (\n  SELECT \n    period,\n    COUNT(DISTINCT order_id) AS orders_count,\n    SUM(quantity) AS total_units,\n    SUM(line_net_revenue) AS net_revenue,\n    SUM(line_cost) AS total_cost,\n    SUM(line_gross_profit) AS gross_profit,\n    SUM(line_discount_cost) AS discount_cost,\n    CASE WHEN period = 'baseline' THEN 59\n         WHEN period = 'sale' THEN 10\n         WHEN period = 'post_sale' THEN 49\n    END AS days_in_period\n  FROM delivered_items\n  GROUP BY period\n),\nmetrics_per_period AS (\n  SELECT \n    period,\n    days_in_period,\n    orders_count,\n    ROUND(orders_count::numeric / days_in_period, 2) AS orders_per_day,\n    total_units,\n    ROUND(total_units::numeric / days_in_period, 2) AS units_per_day,\n    ROUND(net_revenue, 2) AS net_revenue,\n    ROUND(net_revenue / days_in_period, 2) AS net_revenue_per_day,\n    ROUND(gross_profit, 2) AS gross_profit,\n    ROUND(gross_profit / days_in_period, 2) AS gross_profit_per_day,\n    ROUND(100.0 * gross_profit / net_revenue, 2) AS realized_margin_pct,\n    ROUND(discount_cost, 2) AS discount_cost,\n    ROUND(discount_cost / days_in_period, 2) AS discount_cost_per_day,\n    ROUND(net_revenue / orders_count, 2) AS aov\n  FROM period_agg\n),\ncombined_sale_post AS (\n  SELECT \n    'combined_sale_post' AS period,\n    59 AS days_in_period,\n    SUM(orders_count) AS orders_count,\n    ROUND(SUM(orders_count)::numeric / 59, 2) AS orders_per_day,\n    SUM(total_units) AS total_units,\n    ROUND(SUM(total_units)::numeric / 59, 2) AS units_per_day,\n    ROUND(SUM(net_revenue), 2) AS net_revenue,\n    ROUND(SUM(net_revenue) / 59, 2) AS net_revenue_per_day,\n    ROUND(SUM(gross_profit), 2) AS gross_profit,\n    ROUND(SUM(gross_profit) / 59, 2) AS gross_profit_per_day,\n    ROUND(100.0 * SUM(gross_profit) / SUM(net_revenue), 2) AS realized_margin_pct,\n    ROUND(SUM(discount_cost), 2) AS discount_cost,\n    ROUND(SUM(discount_cost) / 59, 2) AS discount_cost_per_day,\n    ROUND(SUM(net_revenue) / SUM(orders_count), 2) AS aov\n  FROM period_agg\n  WHERE period IN ('sale', 'post_sale')\n),\nall_periods AS (\n  SELECT * FROM metrics_per_period\n  UNION ALL\n  SELECT * FROM combined_sale_post\n),\nlift_calc AS (\n  SELECT \n    ap.*,\n    b.net_revenue_per_day AS baseline_rev_per_day,\n    b.gross_profit_per_day AS baseline_gp_per_day,\n    b.orders_per_day AS baseline_orders_per_day,\n    ROUND(ap.net_revenue_per_day - b.net_revenue_per_day, 2) AS diff_net_rev_per_day,\n    ROUND(100.0 * (ap.net_revenue_per_day - b.net_revenue_per_day) / b.net_revenue_per_day, 2) AS pct_lift_net_rev_per_day,\n    ROUND(ap.gross_profit_per_day - b.gross_profit_per_day, 2) AS diff_gp_per_day,\n    ROUND(100.0 * (ap.gross_profit_per_day - b.gross_profit_per_day) / b.gross_profit_per_day, 2) AS pct_lift_gp_per_day,\n    ROUND(ap.orders_per_day - b.orders_per_day, 2) AS diff_orders_per_day,\n    ROUND(100.0 * (ap.orders_per_day - b.orders_per_day) / b.orders_per_day, 2) AS pct_lift_orders_per_day,\n    -- Total incremental lift across the period's duration compared to baseline daily rate\n    ROUND((ap.net_revenue_per_day - b.net_revenue_per_day) * ap.days_in_period, 2) AS total_incremental_net_rev,\n    ROUND((ap.gross_profit_per_day - b.gross_profit_per_day) * ap.days_in_period, 2) AS total_incremental_gp\n  FROM all_periods ap\n  CROSS JOIN (SELECT * FROM metrics_per_period WHERE period = 'baseline') b\n)\nSELECT * FROM lift_calc ORDER BY CASE period WHEN 'baseline' THEN 1 WHEN 'sale' THEN 2 WHEN 'post_sale' THEN 3 WHEN 'combined_sale_post' THEN 4 END;", "rows": 4, "error": null}
{"t": 1792323266.9985683, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH sale_dates AS (\n  SELECT '2025-07-11'::date AS sale_start,\n         '2025-07-20'::date AS sale_end\n),\ncustomer_classification AS (\n  SELECT \n    c.customer_id,\n    MIN(o.order_date) AS first_order_date,\n    CASE \n      WHEN MIN(o.order_date) < (SELECT sale_start FROM sale_dates) THEN 'existing'\n      ELSE 'new'\n    END AS customer_type\n  FROM public.customers c\n  JOIN public.orders o ON c.customer_id = o.customer_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n  GROUP BY c.customer_id\n),\nsale_order_items AS (\n  SELECT\n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    cc.customer_type,\n    oi.product_id,\n    p.category,\n    oi.quantity,\n    oi.unit_price,\n    p.list_price,\n    p.unit_cost,\n    (oi.quantity * oi.unit_price) AS net_revenue,\n    (oi.quantity * p.unit_cost) AS total_cost,\n    (oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n    (oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n  FROM public.orders o\n  JOIN sale_dates sd ON o.order_date BETWEEN sd.sale_start AND sd.sale_end\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  JOIN customer_classification cc ON c.customer_id = cc.customer_id\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n),\ncustomer_type_summary AS (\n  SELECT\n    customer_type,\n    COUNT(DISTINCT customer_id) AS customer_count,\n    COUNT(DISTINCT order_id) AS order_count,\n    ROUND(SUM(net_revenue)::numeric, 2) AS total_net_revenue,\n    ROUND(SUM(gross_profit)::numeric, 2) AS total_gross_profit,\n    ROUND(SUM(discount_cost)::numeric, 2) AS total_discount_cost,\n    ROUND((SUM(net_revenue) / NULLIF(COUNT(DISTINCT order_id), 0))::numeric, 2) AS aov,\n    ROUND((SUM(gross_profit) / NULLIF(SUM(net_revenue), 0) * 100)::numeric, 2) AS realized_margin_pct\n  FROM sale_order_items\n  GROUP BY customer_type\n),\noverall_sale_totals AS (\n  SELECT\n    COUNT(DISTINCT customer_id) AS total_customers,\n    COUNT(DISTINCT order_id) AS total_orders,\n    SUM(net_revenue) AS total_net_revenue,\n    SUM(gross_profit) AS total_gross_profit,\n    SUM(discount_cost) AS total_discount_cost\n  FROM sale_order_items\n),\npost_sale_repeats AS (\n  SELECT\n    cc.customer_type,\n    COUNT(DISTINCT cc.customer_id) AS sale_buyers_count,\n    COUNT(DISTINCT CASE WHEN o_post.order_id IS NOT NULL THEN cc.customer_id END) AS repeat_buyers_post_sale,\n    ROUND((COUNT(DISTINCT CASE WHEN o_post.order_id IS NOT NULL THEN cc.customer_id END)::numeric / NULLIF(COUNT(DISTINCT cc.customer_id), 0) * 100)::numeric, 2) AS repeat_rate_pct,\n    COUNT(DISTINCT o_post.order_id) AS post_sale_orders,\n    ROUND(COALESCE(SUM(oi_post.quantity * oi_post.unit_price), 0)::numeric, 2) AS post_sale_net_revenue,\n    ROUND(COALESCE(SUM(oi_post.quantity * (oi_post.unit_price - p_post.unit_cost)), 0)::numeric, 2) AS post_sale_gross_profit\n  FROM sale_order_items soi\n  JOIN customer_classification cc ON soi.customer_id = cc.customer_id\n  LEFT JOIN public.orders o_post ON soi.customer_id = o_post.customer_id \n    AND o_post.order_date BETWEEN '2025-07-21' AND '2025-09-07' -- 49 days post-sale\n    AND o_post.status = 'delivered'\n  LEFT JOIN public.order_items oi_post ON o_post.order_id = oi_post.order_id\n  LEFT JOIN public.products p_post ON oi_post.product_id = p_post.product_id\n  GROUP BY cc.customer_type\n)\nSELECT \n  cts.customer_type,\n  cts.customer_count,\n  ROUND((cts.customer_count::numeric / ost.total_customers * 100)::numeric, 2) AS customer_pct_of_total,\n  cts.order_count,\n  ROUND((cts.order_count::numeric / ost.total_orders * 100)::numeric, 2) AS order_pct_of_total,\n  cts.total_net_revenue,\n  ROUND((cts.total_net_revenue / ost.total_net_revenue * 100)::numeric, 2) AS net_revenue_pct_of_total,\n  cts.total_gross_profit,\n  ROUND((cts.total_gross_profit / ost.total_gross_profit * 100)::numeric, 2) AS gross_profit_pct_of_total,\n  cts.total_discount_cost,\n  ROUND((cts.total_discount_cost / ost.total_discount_cost * 100)::numeric, 2) AS discount_cost_pct_of_total,\n  cts.aov,\n  cts.realized_margin_pct,\n  psr.repeat_buyers_post_sale,\n  psr.repeat_rate_pct,\n  psr.post_sale_orders,\n  psr.post_sale_net_revenue,\n  psr.post_sale_gross_profit\nFROM customer_type_summary cts\nCROSS JOIN overall_sale_totals ost\nJOIN post_sale_repeats psr ON cts.customer_type = psr.customer_type;", "rows": 2, "error": null}
{"t": 1792323281.0552175, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH sale_dates AS (\n  SELECT '2025-07-11'::date AS sale_start,\n         '2025-07-20'::date AS sale_end\n),\nsale_items AS (\n  SELECT \n    p.category,\n    p.product_id,\n    p.product_name,\n    COUNT(DISTINCT oi.order_id) AS orders_count,\n    SUM(oi.quantity) AS units_sold,\n    SUM(oi.quantity * oi.unit_price) AS net_revenue,\n    SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n    SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n  FROM public.orders o\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  WHERE c.is_internal = false\n    AND o.status = 'delivered'\n    AND o.order_date BETWEEN (SELECT sale_start FROM sale_dates) AND (SELECT sale_end FROM sale_dates)\n  GROUP BY p.category, p.product_id, p.product_name\n),\ntotals AS (\n  SELECT \n    SUM(net_revenue) AS total_revenue,\n    SUM(gross_profit) AS total_profit,\n    SUM(discount_cost) AS total_discount\n  FROM sale_items\n)\nSELECT \n  si.category,\n  SUM(si.units_sold) AS units_sold,\n  ROUND(SUM(si.net_revenue)::numeric, 2) AS net_revenue,\n  ROUND((SUM(si.net_revenue) * 100.0 / MAX(t.total_revenue))::numeric, 2) AS revenue_pct,\n  ROUND(SUM(si.gross_profit)::numeric, 2) AS gross_profit,\n  ROUND((SUM(si.gross_profit) * 100.0 / MAX(t.total_profit))::numeric, 2) AS gross_profit_pct,\n  ROUND(SUM(si.discount_cost)::numeric, 2) AS discount_cost,\n  ROUND((SUM(si.discount_cost) * 100.0 / MAX(t.total_discount))::numeric, 2) AS discount_cost_pct,\n  ROUND(((SUM(si.gross_profit) * 100.0) / NULLIF(SUM(si.net_revenue), 0))::numeric, 2) AS realized_margin_pct\nFROM sale_items si\nCROSS JOIN totals t\nGROUP BY si.category\nORDER BY net_revenue DESC;", "rows": 6, "error": null}
{"t": 1792325311.10243, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct, (end_date - start_date + 1) AS promo_days FROM public.promotions WHERE (start_date >= '2025-07-01' AND start_date <= '2025-07-31') OR promo_code ILIKE '%JULY%' OR promo_code ILIKE '%SUMMER%';", "rows": 1, "error": null}
{"t": 1792325366.6099732, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH windows AS (\n  SELECT\n    'Baseline (30d)' AS window_name,\n    DATE '2025-07-11' - INTERVAL '30 days' AS start_date,\n    DATE '2025-07-10' AS end_date,\n    30 AS day_count,\n    1 AS sort_order\n  UNION ALL\n  SELECT\n    'Sale (10d)',\n    DATE '2025-07-11',\n    DATE '2025-07-20',\n    10,\n    2\n  UNION ALL\n  SELECT\n    'Post-Sale (14d)',\n    DATE '2025-07-21',\n    DATE '2025-07-21' + INTERVAL '13 days',\n    14,\n    3\n  UNION ALL\n  SELECT\n    'Post-Sale (28d)',\n    DATE '2025-07-21',\n    DATE '2025-07-21' + INTERVAL '27 days',\n    28,\n    4\n  UNION ALL\n  SELECT\n    'Post-Sale (42d)',\n    DATE '2025-07-21',\n    DATE '2025-07-21' + INTERVAL '41 days',\n    42,\n    5\n  UNION ALL\n  SELECT\n    'Sale + Post (10d+14d=24d)',\n    DATE '2025-07-11',\n    DATE '2025-07-21' + INTERVAL '13 days',\n    24,\n    6\n  UNION ALL\n  SELECT\n    'Sale + Post (10d+28d=38d)',\n    DATE '2025-07-11',\n    DATE '2025-07-21' + INTERVAL '27 days',\n    38,\n    7\n  UNION ALL\n  SELECT\n    'Sale + Post (10d+42d=52d)',\n    DATE '2025-07-11',\n    DATE '2025-07-21' + INTERVAL '41 days',\n    52,\n    8\n),\norder_lines AS (\n  SELECT\n    o.order_id,\n    o.customer_id,\n    o.order_date,\n    oi.quantity,\n    oi.unit_price,\n    p.unit_cost,\n    p.list_price,\n    (oi.quantity * oi.unit_price) AS line_net_rev,\n    (oi.quantity * p.unit_cost) AS line_cost,\n    (oi.quantity * (p.list_price - oi.unit_price)) AS line_discount_cost\n  FROM public.orders o\n  JOIN public.customers c ON o.customer_id = c.customer_id\n  JOIN public.order_items oi ON o.order_id = oi.order_id\n  JOIN public.products p ON oi.product_id = p.product_id\n  WHERE o.status = 'delivered'\n    AND c.is_internal = false\n),\nwindow_metrics AS (\n  SELECT\n    w.window_name,\n    w.start_date,\n    w.end_date,\n    w.day_count,\n    w.sort_order,\n    COUNT(DISTINCT ol.order_id) AS total_orders,\n    ROUND(COUNT(DISTINCT ol.order_id)::numeric / w.day_count, 2) AS orders_per_day,\n    ROUND(SUM(ol.line_net_rev), 2) AS net_revenue,\n    ROUND(SUM(ol.line_net_rev) / w.day_count, 2) AS net_revenue_per_day,\n    ROUND(SUM(ol.line_net_rev - ol.line_cost), 2) AS gross_profit,\n    ROUND(SUM(ol.line_net_rev - ol.line_cost) / w.day_count, 2) AS gross_profit_per_day,\n    ROUND(SUM(ol.line_discount_cost), 2) AS discount_cost,\n    ROUND(SUM(ol.line_discount_cost) / w.day_count, 2) AS discount_cost_per_day,\n    ROUND((SUM(ol.line_net_rev - ol.line_cost) / NULLIF(SUM(ol.line_net_rev), 0)) * 100, 2) AS realized_margin_pct,\n    ROUND(SUM(ol.line_net_rev) / NULLIF(COUNT(DISTINCT ol.order_id), 0), 2) AS aov\n  FROM windows w\n  LEFT JOIN order_lines ol ON ol.order_date >= w.start_date AND ol.order_date <= w.end_date\n  GROUP BY w.window_name, w.start_date, w.end_date, w.day_count, w.sort_order\n),\nbaseline AS (\n  SELECT\n    orders_per_day AS base_orders_per_day,\n    net_revenue_per_day AS base_rev_per_day,\n    gross_profit_per_day AS base_gp_per_day\n  FROM window_metrics\n  WHERE window_name = 'Baseline (30d)'\n)\nSELECT\n  wm.sort_order,\n  wm.window_name,\n  wm.start_date,\n  wm.end_date,\n  wm.day_count,\n  wm.total_orders,\n  wm.orders_per_day,\n  ROUND((wm.orders_per_day - b.base_orders_per_day), 2) AS orders_per_day_diff,\n  ROUND(((wm.orders_per_day - b.base_orders_per_day) / b.base_orders_per_day) * 100, 2) AS orders_per_day_pct_change,\n  wm.net_revenue,\n  wm.net_revenue_per_day,\n  ROUND((wm.net_revenue_per_day - b.base_rev_per_day), 2) AS rev_per_day_diff,\n  ROUND(((wm.net_revenue_per_day - b.base_rev_per_day) / b.base_rev_per_day) * 100, 2) AS rev_lift_pct,\n  wm.gross_profit,\n  wm.gross_profit_per_day,\n  ROUND((wm.gross_profit_per_day - b.base_gp_per_day), 2) AS gp_per_day_diff,\n  ROUND(((wm.gross_profit_per_day - b.base_gp_per_day) / b.base_gp_per_day) * 100, 2) AS gp_lift_pct,\n  ROUND((wm.gross_profit - (b.base_gp_per_day * wm.day_count)), 2) AS total_incremental_gross_profit,\n  ROUND((wm.net_revenue - (b.base_rev_per_day * wm.day_count)), 2) AS total_incremental_net_revenue,\n  wm.discount_cost,\n  wm.discount_cost_per_day,\n  wm.realized_margin_pct,\n  wm.aov\nFROM window_metrics wm\nCROSS JOIN baseline b\nORDER BY wm.sort_order;", "rows": 8, "error": null}
{"t": 1792325402.313098, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH promo_info AS (\n    SELECT '2025-07-11'::date AS promo_start, '2025-07-20'::date AS promo_end\n),\ndelivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.customer_id, o.order_date\n),\nfirst_orders AS (\n    SELECT \n        customer_id,\n        MIN(order_date) AS first_order_date\n    FROM delivered_orders\n    GROUP BY customer_id\n),\nsale_orders AS (\n    SELECT \n        d.*,\n        f.first_order_date,\n        CASE \n            WHEN f.first_order_date < (SELECT promo_start FROM promo_info) THEN 'existing'\n            ELSE 'new'\n        END AS customer_type\n    FROM delivered_orders d\n    JOIN first_orders f ON d.customer_id = f.customer_id\n    WHERE d.order_date BETWEEN (SELECT promo_start FROM promo_info) AND (SELECT promo_end FROM promo_info)\n),\nsale_customers AS (\n    SELECT \n        customer_id,\n        customer_type,\n        COUNT(order_id) AS sale_orders_count,\n        SUM(order_net_revenue) AS sale_net_revenue,\n        SUM(order_cogs) AS sale_cogs\n    FROM sale_orders\n    GROUP BY customer_id, customer_type\n),\npost_sale_repurchases AS (\n    SELECT \n        sc.customer_id,\n        sc.customer_type,\n        COUNT(d.order_id) AS post_sale_orders_count,\n        COALESCE(SUM(d.order_net_revenue), 0) AS post_sale_net_revenue,\n        COALESCE(SUM(d.order_cogs), 0) AS post_sale_cogs\n    FROM sale_customers sc\n    LEFT JOIN delivered_orders d \n        ON sc.customer_id = d.customer_id \n        AND d.order_date > (SELECT promo_end FROM promo_info)\n    GROUP BY sc.customer_id, sc.customer_type\n)\nSELECT \n    customer_type,\n    COUNT(customer_id) AS customer_count,\n    ROUND(COUNT(customer_id)::numeric / SUM(COUNT(customer_id)) OVER () * 100, 2) AS pct_of_customers,\n    SUM(sale_orders_count) AS total_sale_orders,\n    ROUND(SUM(sale_net_revenue), 2) AS total_sale_net_revenue,\n    ROUND(SUM(sale_net_revenue - sale_cogs), 2) AS total_sale_gross_profit,\n    COUNT(CASE WHEN post_sale_orders_count > 0 THEN 1 END) AS repeat_customers_post_sale,\n    ROUND(COUNT(CASE WHEN post_sale_orders_count > 0 THEN 1 END)::numeric / COUNT(customer_id) * 100, 2) AS repeat_rate_post_sale_pct,\n    SUM(post_sale_orders_count) AS total_post_sale_orders,\n    ROUND(SUM(post_sale_net_revenue), 2) AS total_post_sale_net_revenue,\n    ROUND(SUM(post_sale_net_revenue - post_sale_cogs), 2) AS total_post_sale_gross_profit\nFROM post_sale_repurchases\nNATURAL JOIN sale_customers\nGROUP BY customer_type;", "rows": 2, "error": null}
{"t": 1792325410.0049665, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH promo_info AS (\n    SELECT '2025-07-11'::date AS promo_start, '2025-07-20'::date AS promo_end\n),\ndelivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS cogs\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY o.order_id, o.customer_id, o.order_date\n),\ncust_first_order AS (\n    SELECT customer_id, MIN(order_date) AS first_order_date\n    FROM delivered_orders\n    GROUP BY customer_id\n),\nsale_buyers AS (\n    SELECT \n        d.customer_id,\n        CASE \n            WHEN f.first_order_date < p.promo_start THEN 'existing'\n            ELSE 'new'\n        END AS customer_type,\n        COUNT(DISTINCT d.order_id) AS sale_orders,\n        SUM(d.net_revenue) AS sale_revenue,\n        SUM(d.net_revenue - d.cogs) AS sale_gross_profit\n    FROM delivered_orders d\n    CROSS JOIN promo_info p\n    JOIN cust_first_order f ON d.customer_id = f.customer_id\n    WHERE d.order_date BETWEEN p.promo_start AND p.promo_end\n    GROUP BY d.customer_id, f.first_order_date, p.promo_start\n)\nSELECT \n    COUNT(*) AS total_sale_buyers,\n    SUM(sale_orders) AS total_sale_orders,\n    ROUND(SUM(sale_revenue), 2) AS total_sale_revenue,\n    ROUND(SUM(sale_gross_profit), 2) AS total_sale_gross_profit,\n    ROUND(SUM(CASE WHEN customer_type = 'existing' THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS existing_buyer_pct,\n    ROUND(SUM(CASE WHEN customer_type = 'new' THEN 1 ELSE 0 END)::numeric / COUNT(*) * 100, 2) AS new_buyer_pct,\n    ROUND(SUM(CASE WHEN customer_type = 'existing' THEN sale_revenue ELSE 0 END)::numeric / SUM(sale_revenue) * 100, 2) AS existing_revenue_pct,\n    ROUND(SUM(CASE WHEN customer_type = 'new' THEN sale_revenue ELSE 0 END)::numeric / SUM(sale_revenue) * 100, 2) AS new_revenue_pct\nFROM sale_buyers;", "rows": 1, "error": null}
{"t": 1792325711.842172, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_delivered AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        order_count,\n        net_revenue,\n        gross_profit,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_delivered\n),\nsegmented_customers AS (\n    SELECT \n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Rest of Customers' END AS segment,\n        customer_id,\n        order_count,\n        net_revenue,\n        gross_profit\n    FROM ranked_customers\n),\naggregated_segments AS (\n    SELECT \n        segment,\n        COUNT(customer_id) AS customer_count,\n        SUM(order_count) AS total_orders,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit,\n        ROUND(AVG(net_revenue), 2) AS avg_revenue_per_customer,\n        ROUND(AVG(order_count::numeric), 2) AS avg_orders_per_customer,\n        ROUND(SUM(net_revenue) / NULLIF(SUM(order_count), 0), 2) AS aov,\n        ROUND((SUM(gross_profit) / NULLIF(SUM(net_revenue), 0)) * 100, 2) AS realized_margin_pct\n    FROM segmented_customers\n    GROUP BY segment\n),\ntotals AS (\n    SELECT \n        'Total' AS segment,\n        COUNT(customer_id) AS customer_count,\n        SUM(order_count) AS total_orders,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit,\n        ROUND(AVG(net_revenue), 2) AS avg_revenue_per_customer,\n        ROUND(AVG(order_count::numeric), 2) AS avg_orders_per_customer,\n        ROUND(SUM(net_revenue) / NULLIF(SUM(order_count), 0), 2) AS aov,\n        ROUND((SUM(gross_profit) / NULLIF(SUM(net_revenue), 0)) * 100, 2) AS realized_margin_pct\n    FROM segmented_customers\n),\ncombined AS (\n    SELECT * FROM aggregated_segments\n    UNION ALL\n    SELECT * FROM totals\n)\nSELECT \n    c.segment,\n    c.customer_count,\n    ROUND((c.customer_count::numeric / t.customer_count) * 100, 2) AS customer_share_pct,\n    c.total_orders,\n    ROUND((c.total_orders::numeric / t.total_orders) * 100, 2) AS order_share_pct,\n    c.total_net_revenue,\n    ROUND((c.total_net_revenue / t.total_net_revenue) * 100, 2) AS revenue_share_pct,\n    c.total_gross_profit,\n    ROUND((c.total_gross_profit / t.total_gross_profit) * 100, 2) AS profit_share_pct,\n    c.avg_revenue_per_customer,\n    c.avg_orders_per_customer,\n    c.aov,\n    c.realized_margin_pct\nFROM combined c\nCROSS JOIN totals t\nORDER BY CASE WHEN c.segment = 'Top Decile' THEN 1 WHEN c.segment = 'Rest of Customers' THEN 2 ELSE 3 END;", "rows": 3, "error": null}
{"t": 1792325722.6120255, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_revenue AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_revenue\n),\nsegmented_customers AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Rest of Customers' END AS segment\n    FROM ranked_customers\n),\nchannel_agg AS (\n    SELECT \n        s.segment,\n        s.acquisition_channel,\n        COUNT(*) AS customer_count,\n        ROUND(COUNT(*)::numeric / SUM(COUNT(*)) OVER (PARTITION BY s.segment) * 100, 2) AS channel_share_pct\n    FROM segmented_customers s\n    GROUP BY s.segment, s.acquisition_channel\n)\nSELECT * FROM channel_agg\nORDER BY segment, customer_count DESC;", "rows": 14, "error": null}
{"t": 1792325723.9788873, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_revenue AS (\n    SELECT \n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_revenue\n),\nsegmented_customers AS (\n    SELECT \n        customer_id,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Rest of Customers' END AS segment\n    FROM ranked_customers\n),\norder_discount_summary AS (\n    SELECT \n        sc.segment,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END) AS discounted_orders,\n        ROUND(COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END)::numeric / COUNT(DISTINCT o.order_id) * 100, 2) AS discounted_order_pct,\n        SUM(oi.quantity * oi.unit_price) AS total_net_revenue,\n        ROUND(AVG(oi.discount_pct * 100), 2) AS avg_item_discount_pct\n    FROM segmented_customers sc\n    JOIN public.orders o ON sc.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE o.status = 'delivered'\n    GROUP BY sc.segment\n),\ncategory_summary AS (\n    SELECT \n        sc.segment,\n        p.category,\n        SUM(oi.quantity * oi.unit_price) AS category_net_revenue,\n        ROUND(SUM(oi.quantity * oi.unit_price)::numeric / SUM(SUM(oi.quantity * oi.unit_price)) OVER (PARTITION BY sc.segment) * 100, 2) AS category_revenue_share_pct,\n        SUM(oi.quantity) AS total_units\n    FROM segmented_customers sc\n    JOIN public.orders o ON sc.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n    GROUP BY sc.segment, p.category\n),\nreview_summary AS (\n    SELECT \n        sc.segment,\n        COUNT(r.review_id) AS total_reviews,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        COUNT(DISTINCT sc.customer_id) AS total_customers_in_segment,\n        COUNT(DISTINCT r.customer_id) AS customers_who_reviewed,\n        ROUND(COUNT(DISTINCT r.customer_id)::numeric / COUNT(DISTINCT sc.customer_id) * 100, 2) AS pct_customers_reviewing\n    FROM segmented_customers sc\n    LEFT JOIN public.reviews r ON sc.customer_id = r.customer_id\n    GROUP BY sc.segment\n)\nSELECT 'discount' AS metric_type, segment, total_orders::numeric AS val1, discounted_orders::numeric AS val2, discounted_order_pct AS val3, avg_item_discount_pct AS val4, NULL::text AS text_val FROM order_discount_summary\nUNION ALL\nSELECT 'review' AS metric_type, segment, total_reviews::numeric, avg_rating, pct_customers_reviewing, customers_who_reviewed::numeric, NULL::text FROM review_summary\nUNION ALL\nSELECT 'category' AS metric_type, segment, category_net_revenue, category_revenue_share_pct, total_units::numeric, NULL::numeric, category FROM category_summary\nORDER BY metric_type, segment, val1 DESC;", "rows": 16, "error": null}
{"t": 1792325736.077133, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_delivered AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        order_count,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_delivered\n),\ntop_customers AS (\n    SELECT customer_id, order_count, net_revenue\n    FROM ranked_customers\n    WHERE decile = 1\n),\ndataset_max_date AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders WHERE status = 'delivered'\n),\norder_intervals AS (\n    SELECT \n        o.customer_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC) AS prev_order_date,\n        o.order_date - LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC) AS gap_days\n    FROM public.orders o\n    JOIN top_customers tc ON o.customer_id = tc.customer_id\n    WHERE o.status = 'delivered'\n),\ncustomer_cadence AS (\n    SELECT \n        customer_id,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY gap_days) AS median_gap_days,\n        MAX(order_date) AS last_order_date\n    FROM order_intervals\n    WHERE gap_days IS NOT NULL\n    GROUP BY customer_id\n),\ncustomer_risk_profile AS (\n    SELECT \n        tc.customer_id,\n        tc.order_count,\n        tc.net_revenue,\n        m.max_date,\n        COALESCE(cc.last_order_date, (SELECT MAX(o2.order_date) FROM public.orders o2 WHERE o2.customer_id = tc.customer_id AND o2.status = 'delivered')) AS last_order_date,\n        (m.max_date - COALESCE(cc.last_order_date, (SELECT MAX(o2.order_date) FROM public.orders o2 WHERE o2.customer_id = tc.customer_id AND o2.status = 'delivered'))) AS recency_days,\n        cc.median_gap_days,\n        CASE \n            WHEN tc.order_count < 3 THEN 'insufficient_history'\n            WHEN (m.max_date - cc.last_order_date) > GREATEST(60, 2 * cc.median_gap_days) THEN 'at_risk'\n            WHEN (m.max_date - cc.last_order_date) > GREATEST(45, 1.5 * cc.median_gap_days) THEN 'cooling'\n            ELSE 'active'\n        END AS status_cadence_based,\n        CASE \n            WHEN (m.max_date - COALESCE(cc.last_order_date, (SELECT MAX(o2.order_date) FROM public.orders o2 WHERE o2.customer_id = tc.customer_id AND o2.status = 'delivered'))) <= 60 THEN 'active_recency_60'\n            WHEN (m.max_date - COALESCE(cc.last_order_date, (SELECT MAX(o2.order_date) FROM public.orders o2 WHERE o2.customer_id = tc.customer_id AND o2.status = 'delivered'))) <= 120 THEN 'cooling_recency_61_120'\n            ELSE 'at_risk_recency_120_plus'\n        END AS status_recency_based\n    FROM top_customers tc\n    CROSS JOIN dataset_max_date m\n    LEFT JOIN customer_cadence cc ON tc.customer_id = cc.customer_id\n)\nSELECT \n    status_cadence_based,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*)::numeric * 100.0 / SUM(COUNT(*)) OVER (), 2) AS customer_pct,\n    ROUND(SUM(net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(net_revenue) * 100.0 / SUM(SUM(net_revenue)) OVER (), 2) AS revenue_pct,\n    ROUND(AVG(recency_days), 1) AS avg_recency_days,\n    ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY recency_days)::numeric, 1) AS median_recency_days,\n    ROUND(AVG(median_gap_days)::numeric, 1) AS avg_median_gap_days,\n    ROUND(PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY median_gap_days)::numeric, 1) AS overall_median_gap_days\nFROM customer_risk_profile\nGROUP BY status_cadence_based\nORDER BY customer_count DESC;", "rows": 3, "error": null}
{"t": 1792331665.8405116, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_orders AS (\n    SELECT\n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT\n        customer_id,\n        total_orders,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_orders\n),\nsummary_stats AS (\n    SELECT\n        COUNT(*) AS total_customers,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(total_orders) AS total_orders_all,\n        ROUND(AVG(net_revenue), 2) AS overall_avg_spend,\n        ROUND(AVG(total_orders), 2) AS overall_avg_orders,\n        COUNT(*) FILTER (WHERE decile = 1) AS top_decile_customers,\n        SUM(net_revenue) FILTER (WHERE decile = 1) AS top_decile_net_revenue,\n        SUM(total_orders) FILTER (WHERE decile = 1) AS top_decile_orders,\n        ROUND(AVG(net_revenue) FILTER (WHERE decile = 1), 2) AS top_decile_avg_spend,\n        ROUND(AVG(total_orders) FILTER (WHERE decile = 1), 2) AS top_decile_avg_orders,\n        MIN(net_revenue) FILTER (WHERE decile = 1) AS top_decile_min_spend\n    FROM ranked_customers\n)\nSELECT\n    total_customers,\n    total_net_revenue,\n    total_orders_all,\n    overall_avg_spend,\n    overall_avg_orders,\n    top_decile_customers,\n    top_decile_net_revenue,\n    top_decile_orders,\n    top_decile_avg_spend,\n    top_decile_avg_orders,\n    top_decile_min_spend,\n    ROUND(top_decile_customers * 100.0 / total_customers, 2) AS top_decile_customer_pct,\n    ROUND(top_decile_net_revenue * 100.0 / total_net_revenue, 2) AS top_decile_revenue_share_pct,\n    ROUND(top_decile_orders * 100.0 / total_orders_all, 2) AS top_decile_order_share_pct,\n    ROUND((top_decile_avg_spend - overall_avg_spend), 2) AS diff_avg_spend_vs_overall,\n    ROUND((top_decile_avg_spend - overall_avg_spend) * 100.0 / overall_avg_spend, 2) AS pct_diff_avg_spend_vs_overall\nFROM summary_stats;", "rows": 1, "error": null}
{"t": 1792331683.2661798, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_stats AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * oi.unit_price) / NULLIF(COUNT(DISTINCT o.order_id), 0) AS aov,\n        COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END) AS discounted_orders,\n        ROUND(100.0 * COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END) / NULLIF(COUNT(DISTINCT o.order_id), 0), 2) AS discount_order_pct\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked AS (\n    SELECT\n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_stats\n),\nlabeled AS (\n    SELECT\n        *,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Other Customers' END AS customer_segment\n    FROM ranked\n)\nSELECT\n    customer_segment,\n    COUNT(*) AS customer_count,\n    ROUND(SUM(net_revenue), 2) AS total_revenue,\n    ROUND(AVG(net_revenue), 2) AS avg_customer_revenue,\n    ROUND(AVG(order_count), 2) AS avg_orders_per_customer,\n    ROUND(SUM(net_revenue) / SUM(order_count), 2) AS overall_aov,\n    ROUND(AVG(aov), 2) AS avg_customer_aov,\n    ROUND(100.0 * SUM(discounted_orders) / SUM(order_count), 2) AS pct_orders_with_discount,\n    ROUND(AVG(discount_order_pct), 2) AS avg_customer_discount_order_pct\nFROM labeled\nGROUP BY customer_segment\nORDER BY customer_segment DESC;", "rows": 2, "error": null}
{"t": 1792331685.0107386, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_stats AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked AS (\n    SELECT\n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_stats\n),\nlabeled AS (\n    SELECT\n        *,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Other Customers' END AS customer_segment\n    FROM ranked\n),\nchannel_counts AS (\n    SELECT\n        customer_segment,\n        acquisition_channel,\n        COUNT(*) AS customers,\n        SUM(net_revenue) AS segment_channel_revenue\n    FROM labeled\n    GROUP BY customer_segment, acquisition_channel\n),\nsegment_totals AS (\n    SELECT\n        customer_segment,\n        COUNT(*) AS total_segment_customers,\n        SUM(net_revenue) AS total_segment_revenue\n    FROM labeled\n    GROUP BY customer_segment\n)\nSELECT\n    c.acquisition_channel,\n    c.customer_segment,\n    c.customers,\n    s.total_segment_customers,\n    ROUND(100.0 * c.customers / s.total_segment_customers, 2) AS pct_of_segment_customers,\n    ROUND(c.segment_channel_revenue, 2) AS channel_revenue,\n    ROUND(100.0 * c.segment_channel_revenue / s.total_segment_revenue, 2) AS pct_of_segment_revenue\nFROM channel_counts c\nJOIN segment_totals s ON c.customer_segment = s.customer_segment\nORDER BY c.acquisition_channel, c.customer_segment DESC;", "rows": 14, "error": null}
{"t": 1792331686.2895916, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_stats AS (\n    SELECT\n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked AS (\n    SELECT\n        customer_id,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_stats\n),\nlabeled AS (\n    SELECT\n        customer_id,\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Other Customers' END AS customer_segment\n    FROM ranked\n),\nitem_sales AS (\n    SELECT\n        l.customer_segment,\n        p.category,\n        SUM(oi.quantity) AS total_units,\n        SUM(oi.quantity * oi.unit_price) AS category_revenue\n    FROM labeled l\n    JOIN public.orders o ON l.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n    GROUP BY l.customer_segment, p.category\n),\nsegment_category_totals AS (\n    SELECT\n        customer_segment,\n        SUM(total_units) AS total_units_segment,\n        SUM(category_revenue) AS total_revenue_segment\n    FROM item_sales\n    GROUP BY customer_segment\n)\nSELECT\n    i.category,\n    i.customer_segment,\n    i.total_units,\n    ROUND(100.0 * i.total_units / s.total_units_segment, 2) AS pct_of_segment_units,\n    ROUND(i.category_revenue, 2) AS category_revenue,\n    ROUND(100.0 * i.category_revenue / s.total_revenue_segment, 2) AS pct_of_segment_revenue\nFROM item_sales i\nJOIN segment_category_totals s ON i.customer_segment = s.customer_segment\nORDER BY i.category, i.customer_segment DESC;", "rows": 12, "error": null}
{"t": 1792331694.6415894, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_stats AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.acquisition_channel\n),\nranked AS (\n    SELECT\n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_stats\n),\nsummary AS (\n    SELECT\n        CASE WHEN decile = 1 THEN 'Top Decile' ELSE 'Other Customers' END AS customer_segment,\n        COUNT(DISTINCT customer_id) AS customers,\n        SUM(order_count) AS total_orders,\n        SUM(net_revenue) AS total_revenue\n    FROM ranked\n    GROUP BY 1\n)\nSELECT\n    t.customers AS top_decile_customers,\n    o.customers AS other_customers,\n    t.total_orders AS top_decile_orders,\n    o.total_orders AS other_orders,\n    t.total_revenue AS top_decile_revenue,\n    o.total_revenue AS other_revenue,\n    ROUND(t.total_revenue / t.customers, 2) AS top_decile_avg_revenue,\n    ROUND(o.total_revenue / o.customers, 2) AS other_avg_revenue,\n    ROUND((t.total_revenue / t.customers) - (o.total_revenue / o.customers), 2) AS diff_avg_revenue,\n    ROUND(100.0 * ((t.total_revenue / t.customers) - (o.total_revenue / o.customers)) / (o.total_revenue / o.customers), 2) AS pct_diff_avg_revenue,\n    ROUND(CAST(t.total_orders AS NUMERIC) / t.customers, 2) AS top_decile_avg_orders,\n    ROUND(CAST(o.total_orders AS NUMERIC) / o.customers, 2) AS other_avg_orders,\n    ROUND((CAST(t.total_orders AS NUMERIC) / t.customers) - (CAST(o.total_orders AS NUMERIC) / o.customers), 2) AS diff_avg_orders,\n    ROUND(100.0 * ((CAST(t.total_orders AS NUMERIC) / t.customers) - (CAST(o.total_orders AS NUMERIC) / o.customers)) / (CAST(o.total_orders AS NUMERIC) / o.customers), 2) AS pct_diff_avg_orders,\n    ROUND(t.total_revenue / t.total_orders, 2) AS top_decile_aov,\n    ROUND(o.total_revenue / o.total_orders, 2) AS other_aov,\n    ROUND((t.total_revenue / t.total_orders) - (o.total_revenue / o.total_orders), 2) AS diff_aov,\n    ROUND(100.0 * ((t.total_revenue / t.total_orders) - (o.total_revenue / o.total_orders)) / (o.total_revenue / o.total_orders), 2) AS pct_diff_aov\nFROM summary t\nCROSS JOIN summary o\nWHERE t.customer_segment = 'Top Decile' AND o.customer_segment = 'Other Customers'", "rows": 1, "error": null}
{"t": 1792331728.4781024, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH max_date_cte AS (\n    SELECT MAX(order_date) AS max_order_date FROM public.orders WHERE status = 'delivered'\n),\ncustomer_net_rev AS (\n    SELECT\n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        COUNT(DISTINCT o.order_id) AS total_orders\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT\n        customer_id,\n        net_revenue,\n        total_orders,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_net_rev\n),\ntop_customers AS (\n    SELECT customer_id, net_revenue, total_orders\n    FROM ranked_customers\n    WHERE decile = 1\n),\norder_gaps AS (\n    SELECT\n        o.customer_id,\n        o.order_date,\n        LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC) AS prev_order_date,\n        (o.order_date - LAG(o.order_date) OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC)) AS gap_days\n    FROM public.orders o\n    JOIN top_customers tc ON o.customer_id = tc.customer_id\n    WHERE o.status = 'delivered'\n),\ncustomer_cadence AS (\n    SELECT\n        customer_id,\n        MAX(order_date) AS last_order_date,\n        PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY gap_days) AS median_gap_days,\n        AVG(gap_days) AS avg_gap_days\n    FROM order_gaps\n    GROUP BY customer_id\n),\ncustomer_risk AS (\n    SELECT\n        tc.customer_id,\n        tc.net_revenue,\n        tc.total_orders,\n        cc.last_order_date,\n        (m.max_order_date - cc.last_order_date) AS days_since_last_order,\n        cc.median_gap_days,\n        -- KB15 / KB8 methodology: threshold = GREATEST(60, 2 * median_gap_days) for customers with >= 3 orders\n        CASE \n            WHEN tc.total_orders < 3 THEN 'insufficient_history'\n            WHEN (m.max_order_date - cc.last_order_date) > GREATEST(60, 2 * cc.median_gap_days) THEN 'at_risk'\n            ELSE 'active'\n        END AS risk_status\n    FROM top_customers tc\n    CROSS JOIN max_date_cte m\n    JOIN customer_cadence cc ON tc.customer_id = cc.customer_id\n)\nSELECT\n    COUNT(*) AS total_top_customers,\n    ROUND(AVG(days_since_last_order), 2) AS avg_recency_days,\n    ROUND(AVG(median_gap_days)::numeric, 2) AS avg_median_gap_days,\n    COUNT(CASE WHEN risk_status = 'active' THEN 1 END) AS active_count,\n    ROUND(100.0 * COUNT(CASE WHEN risk_status = 'active' THEN 1 END) / COUNT(*), 2) AS active_pct,\n    COUNT(CASE WHEN risk_status = 'at_risk' THEN 1 END) AS at_risk_count,\n    ROUND(100.0 * COUNT(CASE WHEN risk_status = 'at_risk' THEN 1 END) / COUNT(*), 2) AS at_risk_pct,\n    COUNT(CASE WHEN risk_status = 'insufficient_history' THEN 1 END) AS insufficient_history_count,\n    ROUND(100.0 * COUNT(CASE WHEN risk_status = 'insufficient_history' THEN 1 END) / COUNT(*), 2) AS insufficient_history_pct,\n    ROUND(AVG(CASE WHEN risk_status = 'active' THEN net_revenue END), 2) AS active_avg_revenue,\n    ROUND(AVG(CASE WHEN risk_status = 'at_risk' THEN net_revenue END), 2) AS at_risk_avg_revenue\nFROM customer_risk;", "rows": 1, "error": null}
{"t": 1792331729.6419632, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_net_rev AS (\n    SELECT\n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT\n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_net_rev\n),\ntop_customers AS (\n    SELECT customer_id\n    FROM ranked_customers\n    WHERE decile = 1\n),\ntop_reviews AS (\n    SELECT\n        r.review_id,\n        r.rating,\n        r.review_title,\n        r.review_text,\n        r.customer_id\n    FROM public.reviews r\n    JOIN top_customers tc ON r.customer_id = tc.customer_id\n)\nSELECT\n    COUNT(*) AS total_reviews_from_top_customers,\n    COUNT(DISTINCT customer_id) AS unique_reviewers,\n    ROUND(AVG(rating), 2) AS avg_rating,\n    COUNT(CASE WHEN rating >= 4 THEN 1 END) AS positive_reviews_count,\n    ROUND(100.0 * COUNT(CASE WHEN rating >= 4 THEN 1 END) / COUNT(*), 2) AS positive_reviews_pct,\n    COUNT(CASE WHEN rating <= 2 THEN 1 END) AS negative_reviews_count,\n    ROUND(100.0 * COUNT(CASE WHEN rating <= 2 THEN 1 END) / COUNT(*), 2) AS negative_reviews_pct,\n    COUNT(CASE WHEN rating = 3 THEN 1 END) AS neutral_reviews_count,\n    ROUND(100.0 * COUNT(CASE WHEN rating = 3 THEN 1 END) / COUNT(*), 2) AS neutral_reviews_pct\nFROM top_reviews;", "rows": 1, "error": null}
{"t": 1792331730.87965, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_net_rev AS (\n    SELECT\n        c.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT\n        customer_id,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_net_rev\n),\ntop_customers AS (\n    SELECT customer_id\n    FROM ranked_customers\n    WHERE decile = 1\n)\nSELECT\n    r.rating,\n    r.review_title,\n    r.review_text,\n    p.product_name\nFROM public.reviews r\nJOIN top_customers tc ON r.customer_id = tc.customer_id\nJOIN public.products p ON r.product_id = p.product_id\nWHERE r.rating <= 3\nORDER BY r.rating ASC\nLIMIT 50;", "rows": 50, "error": null}
{"t": 1792332395.7118497, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct, (end_date - start_date + 1) AS promo_days\nFROM public.promotions\nWHERE (start_date >= '2025-06-01' AND start_date <= '2025-07-31')\n   OR promo_code ILIKE '%july%'\n   OR description ILIKE '%july%'\nORDER BY start_date;", "rows": 1, "error": null}
{"t": 1792333132.5460734, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    promo_code, \n    description, \n    start_date, \n    end_date, \n    discount_pct,\n    (end_date - start_date + 1) AS sale_days\nFROM public.promotions\nWHERE start_date >= '2025-07-01' AND start_date <= '2025-07-31'\n   OR promo_code ILIKE '%JULY%'\n   OR description ILIKE '%JULY%';", "rows": 1, "error": null}
{"t": 1792333146.0622282, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        o.customer_id,\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.unit_cost,\n        p.list_price,\n        (oi.quantity * oi.unit_price) AS line_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost,\n        (oi.quantity * (p.list_price - oi.unit_price)) AS line_discount_cost\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nperiod_definitions AS (\n    -- Sale: 2025-07-11 to 2025-07-20 (10 days)\n    -- Baseline: 30 days prior -> 2025-06-11 to 2025-07-10 (30 days)\n    -- Post 14d: 2025-07-21 to 2025-08-03 (14 days)\n    -- Post 28d: 2025-07-21 to 2025-08-17 (28 days)\n    -- Post 42d: 2025-07-21 to 2025-08-31 (42 days)\n    -- Combined Sale + Post 14d: 2025-07-11 to 2025-08-03 (24 days)\n    -- Combined Sale + Post 28d: 2025-07-11 to 2025-08-17 (38 days)\n    -- Combined Sale + Post 42d: 2025-07-11 to 2025-08-31 (52 days)\n    SELECT 'baseline_30d' AS period_name, DATE '2025-06-11' AS start_date, DATE '2025-07-10' AS end_date, 30 AS days\n    UNION ALL SELECT 'sale_10d', DATE '2025-07-11', DATE '2025-07-20', 10\n    UNION ALL SELECT 'post_14d', DATE '2025-07-21', DATE '2025-08-03', 14\n    UNION ALL SELECT 'post_28d', DATE '2025-07-21', DATE '2025-08-17', 28\n    UNION ALL SELECT 'post_42d', DATE '2025-07-21', DATE '2025-08-31', 42\n    UNION ALL SELECT 'combined_sale_post_14d', DATE '2025-07-11', DATE '2025-08-03', 24\n    UNION ALL SELECT 'combined_sale_post_28d', DATE '2025-07-11', DATE '2025-08-17', 38\n    UNION ALL SELECT 'combined_sale_post_42d', DATE '2025-07-11', DATE '2025-08-31', 52\n),\nperiod_metrics AS (\n    SELECT \n        pd.period_name,\n        pd.start_date,\n        pd.end_date,\n        pd.days,\n        COUNT(DISTINCT dl.order_id) AS total_orders,\n        ROUND(COUNT(DISTINCT dl.order_id)::numeric / pd.days, 2) AS orders_per_day,\n        ROUND(SUM(dl.line_revenue), 2) AS total_net_revenue,\n        ROUND(SUM(dl.line_revenue) / pd.days, 2) AS net_revenue_per_day,\n        ROUND(SUM(dl.line_revenue - dl.line_cost), 2) AS total_gross_profit,\n        ROUND(SUM(dl.line_revenue - dl.line_cost) / pd.days, 2) AS gross_profit_per_day,\n        ROUND(100.0 * (1 - SUM(dl.line_cost) / NULLIF(SUM(dl.line_revenue), 0)), 2) AS realized_margin_pct,\n        ROUND(SUM(dl.line_discount_cost), 2) AS total_discount_cost,\n        ROUND(SUM(dl.line_discount_cost) / pd.days, 2) AS discount_cost_per_day,\n        ROUND(SUM(dl.line_revenue) / NULLIF(COUNT(DISTINCT dl.order_id), 0), 2) AS aov\n    FROM period_definitions pd\n    LEFT JOIN delivered_lines dl \n        ON dl.order_date >= pd.start_date AND dl.order_date <= pd.end_date\n    GROUP BY pd.period_name, pd.start_date, pd.end_date, pd.days\n),\nbaseline AS (\n    SELECT * FROM period_metrics WHERE period_name = 'baseline_30d'\n)\nSELECT \n    pm.period_name,\n    pm.start_date,\n    pm.end_date,\n    pm.days,\n    pm.total_orders,\n    pm.orders_per_day,\n    pm.total_net_revenue,\n    pm.net_revenue_per_day,\n    pm.total_gross_profit,\n    pm.gross_profit_per_day,\n    pm.realized_margin_pct,\n    pm.total_discount_cost,\n    pm.discount_cost_per_day,\n    pm.aov,\n    -- Daily differences vs Baseline\n    ROUND(pm.orders_per_day - b.orders_per_day, 2) AS orders_per_day_diff,\n    ROUND(100.0 * (pm.orders_per_day - b.orders_per_day) / NULLIF(b.orders_per_day, 0), 2) AS orders_per_day_lift_pct,\n    ROUND(pm.net_revenue_per_day - b.net_revenue_per_day, 2) AS net_revenue_per_day_diff,\n    ROUND(100.0 * (pm.net_revenue_per_day - b.net_revenue_per_day) / NULLIF(b.net_revenue_per_day, 0), 2) AS net_revenue_lift_pct,\n    ROUND(pm.gross_profit_per_day - b.gross_profit_per_day, 2) AS gross_profit_per_day_diff,\n    ROUND(100.0 * (pm.gross_profit_per_day - b.gross_profit_per_day) / NULLIF(b.gross_profit_per_day, 0), 2) AS gross_profit_lift_pct,\n    ROUND(pm.realized_margin_pct - b.realized_margin_pct, 2) AS margin_pts_diff,\n    -- Total window lift vs baseline expected for that window duration\n    ROUND((pm.net_revenue_per_day - b.net_revenue_per_day) * pm.days, 2) AS total_incremental_net_revenue,\n    ROUND((pm.gross_profit_per_day - b.gross_profit_per_day) * pm.days, 2) AS total_incremental_gross_profit\nFROM period_metrics pm\nCROSS JOIN baseline b\nORDER BY \n    CASE pm.period_name\n        WHEN 'baseline_30d' THEN 1\n        WHEN 'sale_10d' THEN 2\n        WHEN 'post_14d' THEN 3\n        WHEN 'post_28d' THEN 4\n        WHEN 'post_42d' THEN 5\n        WHEN 'combined_sale_post_14d' THEN 6\n        WHEN 'combined_sale_post_28d' THEN 7\n        WHEN 'combined_sale_post_42d' THEN 8\n    END;", "rows": 8, "error": null}
{"t": 1792333158.941343, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        o.discount_code,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cost,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS order_discount_cost\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY o.order_id, o.customer_id, o.order_date, o.discount_code\n),\nfirst_orders AS (\n    SELECT \n        customer_id, \n        MIN(order_date) AS first_delivered_order_date\n    FROM delivered_orders\n    GROUP BY customer_id\n),\nsale_orders AS (\n    SELECT \n        d.*,\n        CASE \n            WHEN f.first_delivered_order_date < '2025-07-11' THEN 'existing'\n            ELSE 'new'\n        END AS customer_type\n    FROM delivered_orders d\n    JOIN first_orders f ON d.customer_id = f.customer_id\n    WHERE d.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n),\nrepeat_tracking AS (\n    -- check repeat purchases within 90 days after sale end (2025-07-21 to 2025-10-18)\n    SELECT \n        s.customer_id,\n        s.customer_type,\n        COUNT(DISTINCT r.order_id) AS repeat_orders_post_sale,\n        COALESCE(SUM(r.order_net_revenue), 0) AS repeat_net_revenue_post_sale,\n        COALESCE(SUM(r.order_net_revenue - r.order_cost), 0) AS repeat_gross_profit_post_sale\n    FROM sale_orders s\n    LEFT JOIN delivered_orders r \n        ON s.customer_id = r.customer_id \n        AND r.order_date > '2025-07-20' \n        AND r.order_date <= '2025-07-20'::date + INTERVAL '90 days'\n    GROUP BY s.customer_id, s.customer_type\n)\nSELECT \n    customer_type,\n    COUNT(DISTINCT customer_id) AS unique_buyers,\n    ROUND(COUNT(DISTINCT customer_id)::numeric / SUM(COUNT(DISTINCT customer_id)) OVER () * 100, 2) AS pct_of_buyers,\n    COUNT(order_id) AS total_orders,\n    ROUND(COUNT(order_id)::numeric / SUM(COUNT(order_id)) OVER () * 100, 2) AS pct_of_orders,\n    ROUND(SUM(order_net_revenue), 2) AS net_revenue,\n    ROUND(SUM(order_net_revenue)::numeric / SUM(SUM(order_net_revenue)) OVER () * 100, 2) AS pct_of_net_revenue,\n    ROUND(SUM(order_net_revenue - order_cost), 2) AS gross_profit,\n    ROUND(SUM(order_discount_cost), 2) AS discount_cost,\n    ROUND(AVG(order_net_revenue), 2) AS aov,\n    -- Repeat behavior\n    COUNT(DISTINCT CASE WHEN repeat_orders_post_sale > 0 THEN customer_id END) AS repeat_buyers_90d,\n    ROUND(COUNT(DISTINCT CASE WHEN repeat_orders_post_sale > 0 THEN customer_id END)::numeric / NULLIF(COUNT(DISTINCT customer_id), 0) * 100, 2) AS repeat_rate_90d,\n    ROUND(SUM(repeat_net_revenue_post_sale), 2) AS post_sale_90d_revenue,\n    ROUND(SUM(repeat_gross_profit_post_sale), 2) AS post_sale_90d_gross_profit\nFROM sale_orders\nJOIN repeat_tracking USING (customer_id, customer_type)\nGROUP BY customer_type;", "rows": 2, "error": null}
{"t": 1792333161.9647803, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    COUNT(*) AS total_promotions_in_year,\n    COUNT(CASE WHEN discount_pct > 20 THEN 1 END) AS sitewide_or_deep_sales_count,\n    STRING_AGG(promo_code || ' (' || discount_pct::text || '%, ' || start_date::text || ' to ' || end_date::text || ')', '; ') AS all_promotions\nFROM public.promotions\nWHERE start_date >= '2025-01-01' AND start_date <= '2025-12-31';", "rows": null, "error": "Forbidden query."}
{"t": 1792333184.9334075, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    COUNT(*) AS total_promotions_2025,\n    SUM(CASE WHEN discount_pct > 25.0 THEN 1 ELSE 0 END) AS promos_exceeding_25pct_discount,\n    SUM(CASE WHEN description ILIKE '%site-wide%' OR description ILIKE '%sitewide%' THEN 1 ELSE 0 END) AS sitewide_promos_count\nFROM public.promotions\nWHERE start_date >= '2025-01-01' AND start_date <= '2025-12-31';", "rows": 1, "error": null}
{"t": 1792333191.899345, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cost,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS order_discount_cost\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n      AND o.order_date >= '2025-07-11' AND o.order_date <= '2025-07-20'\n    GROUP BY o.order_id, o.customer_id\n)\nSELECT \n    COUNT(DISTINCT customer_id) AS total_unique_buyers,\n    COUNT(order_id) AS total_orders,\n    ROUND(SUM(order_net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(order_cost), 2) AS total_cost,\n    ROUND(SUM(order_net_revenue) - SUM(order_cost), 2) AS total_gross_profit,\n    ROUND(SUM(order_discount_cost), 2) AS total_discount_cost,\n    ROUND(SUM(order_net_revenue) / COUNT(order_id), 2) AS overall_aov\nFROM delivered_orders;", "rows": 1, "error": null}
{"t": 1792333410.1724963, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_customers AS (\n    SELECT customer_id, acquisition_channel, signup_date\n    FROM public.customers\n    WHERE is_internal = false\n),\ndelivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_rev,\n        SUM(oi.quantity * p.unit_cost) AS order_cost\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN non_internal_customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n    GROUP BY o.order_id, o.customer_id, o.order_date\n),\nall_orders_by_cust AS (\n    SELECT \n        o.customer_id,\n        COUNT(*) AS total_orders,\n        COUNT(*) FILTER (WHERE o.status = 'delivered') AS delivered_orders_count,\n        COUNT(*) FILTER (WHERE o.status = 'returned') AS returned_orders_count,\n        COUNT(*) FILTER (WHERE o.status = 'cancelled') AS cancelled_orders_count\n    FROM public.orders o\n    JOIN non_internal_customers c ON o.customer_id = c.customer_id\n    GROUP BY o.customer_id\n),\ncust_revenue AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        COALESCE(d.delivered_orders_count, 0) AS delivered_orders,\n        COALESCE(d.total_delivered_rev, 0) AS total_net_revenue,\n        COALESCE(d.total_cost, 0) AS total_cost,\n        COALESCE(a.total_orders, 0) AS total_orders,\n        COALESCE(a.returned_orders_count, 0) AS returned_orders\n    FROM non_internal_customers c\n    LEFT JOIN (\n        SELECT \n            customer_id,\n            COUNT(*) AS delivered_orders_count,\n            SUM(order_net_rev) AS total_delivered_rev,\n            SUM(order_cost) AS total_cost\n        FROM delivered_orders\n        GROUP BY customer_id\n    ) d ON c.customer_id = d.customer_id\n    LEFT JOIN all_orders_by_cust a ON c.customer_id = a.customer_id\n    WHERE COALESCE(d.delivered_orders_count, 0) > 0 -- segmentation_base requires at least one delivered order\n),\nranked_custs AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        delivered_orders,\n        total_net_revenue,\n        total_cost,\n        total_orders,\n        returned_orders,\n        NTILE(10) OVER (ORDER BY total_net_revenue DESC, customer_id ASC) AS decile\n    FROM cust_revenue\n),\nchannel_agg AS (\n    SELECT \n        acquisition_channel,\n        COUNT(*) AS segmentation_customers,\n        SUM(CASE WHEN delivered_orders >= 2 THEN 1 ELSE 0 END) AS repeat_customers,\n        ROUND(100.0 * SUM(CASE WHEN delivered_orders >= 2 THEN 1 ELSE 0 END) / COUNT(*), 2) AS repeat_rate_pct,\n        ROUND(SUM(total_net_revenue), 2) AS channel_net_revenue,\n        ROUND(SUM(total_net_revenue) / COUNT(*), 2) AS net_revenue_per_cust,\n        ROUND(SUM(total_net_revenue - total_cost), 2) AS channel_gross_profit,\n        ROUND(100.0 * (1.0 - SUM(total_cost) / NULLIF(SUM(total_net_revenue), 0)), 2) AS realized_margin_pct,\n        SUM(returned_orders) AS total_returned_orders,\n        SUM(total_orders) AS total_placed_orders,\n        ROUND(100.0 * SUM(returned_orders) / NULLIF(SUM(total_orders), 0), 2) AS return_rate_pct,\n        SUM(CASE WHEN decile = 1 THEN 1 ELSE 0 END) AS top_decile_customers,\n        ROUND(100.0 * SUM(CASE WHEN decile = 1 THEN 1 ELSE 0 END) / COUNT(*), 2) AS pct_of_channel_in_top_decile\n    FROM ranked_custs\n    GROUP BY acquisition_channel\n),\ntotals AS (\n    SELECT \n        COUNT(*) AS total_top_decile_customers\n    FROM ranked_custs\n    WHERE decile = 1\n)\nSELECT \n    ca.acquisition_channel,\n    ca.segmentation_customers,\n    ca.repeat_customers,\n    ca.repeat_rate_pct,\n    ca.channel_net_revenue,\n    ca.net_revenue_per_cust,\n    ca.channel_gross_profit,\n    ca.realized_margin_pct,\n    ca.total_returned_orders,\n    ca.total_placed_orders,\n    ca.return_rate_pct,\n    ca.top_decile_customers,\n    ca.pct_of_channel_in_top_decile,\n    ROUND(100.0 * ca.top_decile_customers / t.total_top_decile_customers, 2) AS share_of_all_top_decile_pct\nFROM channel_agg ca\nCROSS JOIN totals t\nORDER BY ca.channel_net_revenue DESC;", "rows": 7, "error": null}
{"t": 1792333421.4878118, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH spend_summary AS (\n    SELECT \n        channel,\n        SUM(spend_usd) AS total_spend\n    FROM public.marketing_spend\n    GROUP BY channel\n),\ncust_2025 AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel\n    FROM public.customers c\n    WHERE c.is_internal = false\n      AND c.signup_date >= '2025-01-01'\n      AND c.signup_date <= '2025-12-31'\n),\ncust_delivered_revenue AS (\n    SELECT \n        c.acquisition_channel,\n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS delivered_orders_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM cust_2025 c\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    GROUP BY c.acquisition_channel, c.customer_id\n),\nchannel_agg AS (\n    SELECT \n        c.acquisition_channel,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        COUNT(DISTINCT cdr.customer_id) AS paying_customers,\n        COALESCE(SUM(cdr.net_revenue), 0) AS channel_net_revenue,\n        COALESCE(SUM(cdr.gross_profit), 0) AS channel_gross_profit\n    FROM cust_2025 c\n    LEFT JOIN cust_delivered_revenue cdr ON c.customer_id = cdr.customer_id\n    GROUP BY c.acquisition_channel\n),\nchannel_joined AS (\n    SELECT \n        COALESCE(ca.acquisition_channel, s.channel) AS channel,\n        COALESCE(s.total_spend, 0) AS spend,\n        COALESCE(ca.new_customers, 0) AS new_customers,\n        COALESCE(ca.paying_customers, 0) AS paying_customers,\n        COALESCE(ca.channel_net_revenue, 0) AS net_revenue,\n        COALESCE(ca.channel_gross_profit, 0) AS gross_profit\n    FROM channel_agg ca\n    FULL OUTER JOIN spend_summary s ON ca.acquisition_channel = s.channel\n)\nSELECT \n    channel,\n    ROUND(spend::numeric, 2) AS spend,\n    new_customers,\n    paying_customers,\n    ROUND(net_revenue::numeric, 2) AS net_revenue,\n    ROUND(gross_profit::numeric, 2) AS gross_profit,\n    ROUND((spend / NULLIF(new_customers, 0))::numeric, 2) AS cac_per_new_customer,\n    ROUND((spend / NULLIF(paying_customers, 0))::numeric, 2) AS cac_per_paying_customer,\n    ROUND((net_revenue / NULLIF(spend, 0))::numeric, 2) AS roas,\n    ROUND((gross_profit / NULLIF(spend, 0))::numeric, 2) AS gross_profit_per_spend_dollar,\n    ROUND((gross_profit / NULLIF(net_revenue, 0) * 100)::numeric, 2) AS realized_margin_pct\nFROM (\n    SELECT \n        channel,\n        spend,\n        new_customers,\n        paying_customers,\n        net_revenue,\n        gross_profit,\n        1 AS sort_order\n    FROM channel_joined\n    UNION ALL\n    SELECT \n        'Total / Blended' AS channel,\n        SUM(spend) AS spend,\n        SUM(new_customers) AS new_customers,\n        SUM(paying_customers) AS paying_customers,\n        SUM(net_revenue) AS net_revenue,\n        SUM(gross_profit) AS gross_profit,\n        2 AS sort_order\n    FROM channel_joined\n    UNION ALL\n    SELECT \n        'Paid Channels Blended' AS channel,\n        SUM(spend) AS spend,\n        SUM(new_customers) AS new_customers,\n        SUM(paying_customers) AS paying_customers,\n        SUM(net_revenue) AS net_revenue,\n        SUM(gross_profit) AS gross_profit,\n        3 AS sort_order\n    FROM channel_joined\n    WHERE spend > 0\n) t\nORDER BY sort_order, spend DESC;", "rows": 9, "error": null}
{"t": 1792333433.4130855, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_spend AS (\n    SELECT \n        month,\n        channel,\n        spend_usd\n    FROM public.marketing_spend\n),\nmonthly_acq AS (\n    SELECT \n        DATE_TRUNC('month', c.signup_date)::date AS month,\n        c.acquisition_channel AS channel,\n        COUNT(c.customer_id) AS new_customers,\n        COUNT(DISTINCT CASE WHEN o.order_id IS NOT NULL THEN c.customer_id END) AS paying_customers,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit\n    FROM public.customers c\n    LEFT JOIN public.orders o \n        ON c.customer_id = o.customer_id \n       AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON o.order_id = oi.order_id\n    LEFT JOIN public.products p \n        ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND c.signup_date >= '2025-01-01'\n      AND c.signup_date <= '2025-12-31'\n    GROUP BY 1, 2\n),\ncombined AS (\n    SELECT \n        COALESCE(s.month, a.month) AS month,\n        COALESCE(s.channel, a.channel) AS channel,\n        COALESCE(s.spend_usd, 0) AS spend_usd,\n        COALESCE(a.new_customers, 0) AS new_customers,\n        COALESCE(a.paying_customers, 0) AS paying_customers,\n        COALESCE(a.net_revenue, 0) AS net_revenue,\n        COALESCE(a.gross_profit, 0) AS gross_profit\n    FROM monthly_spend s\n    FULL OUTER JOIN monthly_acq a \n        ON s.month = a.month AND s.channel = a.channel\n),\nchannel_monthly_metrics AS (\n    SELECT \n        month,\n        channel,\n        spend_usd,\n        new_customers,\n        paying_customers,\n        net_revenue,\n        gross_profit,\n        CASE WHEN new_customers > 0 THEN ROUND((spend_usd / new_customers)::numeric, 2) ELSE NULL END AS cac_per_new_customer,\n        CASE WHEN paying_customers > 0 THEN ROUND((spend_usd / paying_customers)::numeric, 2) ELSE NULL END AS cac_per_paying_customer,\n        CASE WHEN spend_usd > 0 THEN ROUND((net_revenue / spend_usd)::numeric, 2) ELSE NULL END AS roas,\n        CASE WHEN spend_usd > 0 THEN ROUND((gross_profit / spend_usd)::numeric, 2) ELSE NULL END AS gross_profit_per_spend\n    FROM combined\n),\nmonthly_totals AS (\n    SELECT \n        month,\n        'TOTAL_ALL_CHANNELS' AS channel,\n        SUM(spend_usd) AS spend_usd,\n        SUM(new_customers) AS new_customers,\n        SUM(paying_customers) AS paying_customers,\n        SUM(net_revenue) AS net_revenue,\n        SUM(gross_profit) AS gross_profit,\n        ROUND((SUM(spend_usd) / NULLIF(SUM(new_customers), 0))::numeric, 2) AS cac_per_new_customer,\n        ROUND((SUM(spend_usd) / NULLIF(SUM(paying_customers), 0))::numeric, 2) AS cac_per_paying_customer,\n        ROUND((SUM(net_revenue) / NULLIF(SUM(spend_usd), 0))::numeric, 2) AS roas,\n        ROUND((SUM(gross_profit) / NULLIF(SUM(spend_usd), 0))::numeric, 2) AS gross_profit_per_spend\n    FROM combined\n    GROUP BY month\n)\nSELECT * FROM channel_monthly_metrics\nUNION ALL\nSELECT * FROM monthly_totals\nORDER BY month, channel;\n", "rows": 96, "error": null}
{"t": 1792333439.874389, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel AS (\n    SELECT \n        s.month,\n        s.channel,\n        s.spend_usd,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        COUNT(DISTINCT CASE WHEN o.order_id IS NOT NULL THEN c.customer_id END) AS paying_customers,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit\n    FROM public.marketing_spend s\n    LEFT JOIN public.customers c \n        ON c.acquisition_channel = s.channel \n        AND DATE_TRUNC('month', c.signup_date)::date = s.month\n        AND c.is_internal = false\n    LEFT JOIN public.orders o \n        ON o.customer_id = c.customer_id \n        AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON oi.order_id = o.order_id\n    LEFT JOIN public.products p \n        ON p.product_id = oi.product_id\n    GROUP BY s.month, s.channel, s.spend_usd\n),\nchannel_agg AS (\n    SELECT \n        channel,\n        SUM(spend_usd) AS total_spend,\n        SUM(new_customers) AS total_new_cust,\n        SUM(paying_customers) AS total_paying_cust,\n        SUM(net_revenue) AS total_net_rev,\n        SUM(gross_profit) AS total_gross_profit,\n        ROUND(AVG(spend_usd), 2) AS avg_monthly_spend,\n        MIN(spend_usd) AS min_monthly_spend,\n        MAX(spend_usd) AS max_monthly_spend\n    FROM monthly_channel\n    GROUP BY channel\n),\nmonthly_totals AS (\n    SELECT \n        month,\n        SUM(spend_usd) AS total_monthly_spend,\n        SUM(net_revenue) AS total_monthly_revenue,\n        SUM(gross_profit) AS total_monthly_gross_profit\n    FROM monthly_channel\n    GROUP BY month\n)\nSELECT \n    'monthly_totals_summary' AS metric_type,\n    'ALL' AS channel,\n    ROUND(MIN(total_monthly_spend), 2) AS min_monthly_spend,\n    ROUND(MAX(total_monthly_spend), 2) AS max_monthly_spend,\n    ROUND(AVG(total_monthly_spend), 2) AS avg_monthly_spend,\n    ROUND(SUM(total_monthly_spend), 2) AS total_spend_annual,\n    NULL::numeric AS marginal_roas\nFROM monthly_totals\nUNION ALL\nSELECT \n    'channel_spend_summary' AS metric_type,\n    channel,\n    min_monthly_spend,\n    max_monthly_spend,\n    avg_monthly_spend,\n    ROUND(total_spend, 2) AS total_spend_annual,\n    ROUND(total_gross_profit / NULLIF(total_spend, 0), 2) AS marginal_roas\nFROM channel_agg\nORDER BY metric_type, total_spend_annual DESC;", "rows": 8, "error": null}
{"t": 1792334472.6532135, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH max_order_date AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders\n),\ncustomer_first_orders AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date,\n        MIN(o.order_date) AS first_order_date\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel, c.signup_date\n),\ncust_orders AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        cfo.first_order_date,\n        (m.max_date - cfo.first_order_date) >= 90 AS has_90d_tenure,\n        o.order_id,\n        o.order_date,\n        o.status,\n        (o.order_date <= cfo.first_order_date + INTERVAL '90 days') AS is_within_90d\n    FROM public.customers c\n    JOIN customer_first_orders cfo ON c.customer_id = cfo.customer_id\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    CROSS JOIN max_order_date m\n    WHERE c.is_internal = false\n),\norder_financials AS (\n    SELECT\n        o.order_id,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cost\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n    GROUP BY o.order_id\n),\ncust_summary AS (\n    SELECT\n        co.customer_id,\n        co.acquisition_channel,\n        co.has_90d_tenure,\n        COUNT(DISTINCT co.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN co.status = 'delivered' THEN co.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN co.status = 'returned' THEN co.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN co.status = 'cancelled' THEN co.order_id END) AS cancelled_orders,\n        COALESCE(SUM(f.order_net_revenue), 0) AS lifetime_net_revenue,\n        COALESCE(SUM(f.order_cost), 0) AS lifetime_cost,\n        COALESCE(SUM(CASE WHEN co.is_within_90d THEN f.order_net_revenue ELSE 0 END), 0) AS net_rev_90d,\n        COALESCE(SUM(CASE WHEN co.is_within_90d THEN f.order_cost ELSE 0 END), 0) AS cost_90d\n    FROM cust_orders co\n    LEFT JOIN order_financials f ON co.order_id = f.order_id AND co.status = 'delivered'\n    GROUP BY co.customer_id, co.acquisition_channel, co.has_90d_tenure\n)\nSELECT\n    acquisition_channel,\n    COUNT(customer_id) AS total_customers,\n    COUNT(CASE WHEN delivered_orders >= 1 THEN 1 END) AS customers_with_delivered_order,\n    COUNT(CASE WHEN delivered_orders >= 2 THEN 1 END) AS repeat_delivered_customers,\n    ROUND(COUNT(CASE WHEN delivered_orders >= 2 THEN 1 END)::numeric / NULLIF(COUNT(CASE WHEN delivered_orders >= 1 THEN 1 END), 0) * 100, 2) AS repeat_delivered_rate_pct,\n    SUM(total_orders) AS total_orders_all,\n    SUM(delivered_orders) AS delivered_orders_all,\n    SUM(returned_orders) AS returned_orders_all,\n    ROUND(SUM(returned_orders)::numeric / NULLIF(SUM(total_orders), 0) * 100, 2) AS return_rate_pct,\n    ROUND(SUM(lifetime_net_revenue)::numeric / NULLIF(SUM(delivered_orders), 0), 2) AS aov_delivered,\n    ROUND(SUM(lifetime_net_revenue)::numeric, 2) AS total_net_revenue,\n    ROUND((SUM(lifetime_net_revenue) - SUM(lifetime_cost))::numeric, 2) AS total_gross_profit,\n    ROUND((1.0 - SUM(lifetime_cost)::numeric / NULLIF(SUM(lifetime_net_revenue), 0)) * 100, 2) AS realized_gross_margin_pct,\n    -- 90-day standardized metrics (restricted to customers with at least 90 days tenure from first order)\n    COUNT(CASE WHEN has_90d_tenure THEN 1 END) AS customers_90d_cohort,\n    ROUND(SUM(CASE WHEN has_90d_tenure THEN net_rev_90d ELSE 0 END)::numeric / NULLIF(COUNT(CASE WHEN has_90d_tenure THEN 1 END), 0), 2) AS net_revenue_per_cust_90d,\n    ROUND((SUM(CASE WHEN has_90d_tenure THEN net_rev_90d - cost_90d ELSE 0 END))::numeric / NULLIF(COUNT(CASE WHEN has_90d_tenure THEN 1 END), 0), 2) AS gross_profit_per_cust_90d,\n    ROUND((1.0 - SUM(CASE WHEN has_90d_tenure THEN cost_90d ELSE 0 END)::numeric / NULLIF(SUM(CASE WHEN has_90d_tenure THEN net_rev_90d ELSE 0 END), 0)) * 100, 2) AS realized_margin_pct_90d\nFROM cust_summary\nGROUP BY acquisition_channel\nORDER BY net_revenue_per_cust_90d DESC NULLS LAST;", "rows": 7, "error": null}
{"t": 1792334485.355583, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH spend_summary AS (\n    SELECT\n        channel,\n        SUM(spend_usd) AS total_spend\n    FROM public.marketing_spend\n    GROUP BY channel\n),\ncust_2025 AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date,\n        MIN(o.order_date) AS first_order_date\n    FROM public.customers c\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    WHERE c.is_internal = false\n      AND c.signup_date >= '2025-01-01'\n    GROUP BY c.customer_id, c.acquisition_channel, c.signup_date\n),\nmax_date_cte AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders\n),\ncust_perf_90d AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date,\n        c.first_order_date,\n        CASE WHEN c.first_order_date IS NOT NULL THEN 1 ELSE 0 END AS has_delivered_order,\n        CASE WHEN c.signup_date <= (m.max_date - INTERVAL '90 day') THEN 1 ELSE 0 END AS eligible_90d,\n        COALESCE(SUM(CASE WHEN o.order_date <= c.signup_date + INTERVAL '90 day' AND o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) AS net_revenue_90d,\n        COALESCE(SUM(CASE WHEN o.order_date <= c.signup_date + INTERVAL '90 day' AND o.status = 'delivered' THEN (oi.unit_price - p.unit_cost) * oi.quantity ELSE 0 END), 0) AS gross_profit_90d,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END), 0) AS ltv_net_revenue,\n        COALESCE(SUM(CASE WHEN o.status = 'delivered' THEN (oi.unit_price - p.unit_cost) * oi.quantity ELSE 0 END), 0) AS ltv_gross_profit\n    FROM cust_2025 c\n    CROSS JOIN max_date_cte m\n    LEFT JOIN public.orders o ON c.customer_id = o.customer_id\n    LEFT JOIN public.order_items oi ON o.order_id = oi.order_id\n    LEFT JOIN public.products p ON oi.product_id = p.product_id\n    GROUP BY c.customer_id, c.acquisition_channel, c.signup_date, c.first_order_date, m.max_date\n),\nchannel_agg AS (\n    SELECT\n        acquisition_channel,\n        COUNT(customer_id) AS total_signups,\n        SUM(has_delivered_order) AS delivered_customers,\n        SUM(eligible_90d) AS customers_90d_cohort,\n        SUM(CASE WHEN eligible_90d = 1 THEN net_revenue_90d ELSE 0 END) AS cohort_90d_net_revenue,\n        SUM(CASE WHEN eligible_90d = 1 THEN gross_profit_90d ELSE 0 END) AS cohort_90d_gross_profit,\n        SUM(ltv_net_revenue) AS total_ltv_net_revenue,\n        SUM(ltv_gross_profit) AS total_ltv_gross_profit\n    FROM cust_perf_90d\n    GROUP BY acquisition_channel\n)\nSELECT\n    COALESCE(s.channel, c.acquisition_channel) AS channel,\n    COALESCE(s.total_spend, 0) AS total_spend,\n    c.total_signups,\n    c.delivered_customers,\n    ROUND(COALESCE(s.total_spend, 0) / NULLIF(c.total_signups, 0), 2) AS cac_per_signup,\n    ROUND(COALESCE(s.total_spend, 0) / NULLIF(c.delivered_customers, 0), 2) AS cac_per_delivered_customer,\n    c.customers_90d_cohort,\n    ROUND(c.cohort_90d_net_revenue / NULLIF(c.customers_90d_cohort, 0), 2) AS rev_per_cust_90d,\n    ROUND(c.cohort_90d_gross_profit / NULLIF(c.customers_90d_cohort, 0), 2) AS gp_per_cust_90d,\n    ROUND((c.cohort_90d_gross_profit / NULLIF(c.customers_90d_cohort, 0)) / NULLIF(COALESCE(s.total_spend, 0) / NULLIF(c.delivered_customers, 0), 0), 2) AS gp_to_cac_ratio_90d,\n    ROUND(c.total_ltv_gross_profit / NULLIF(c.delivered_customers, 0), 2) AS ltv_gp_per_delivered_customer,\n    ROUND((c.total_ltv_gross_profit / NULLIF(c.delivered_customers, 0)) / NULLIF(COALESCE(s.total_spend, 0) / NULLIF(c.delivered_customers, 0), 0), 2) AS ltv_gp_to_cac_ratio,\n    ROUND(c.total_ltv_net_revenue / NULLIF(NULLIF(s.total_spend, 0), 0), 2) AS total_roas\nFROM spend_summary s\nFULL OUTER JOIN channel_agg c ON s.channel = c.acquisition_channel\nORDER BY total_spend DESC;", "rows": 7, "error": null}
{"t": 1792334497.772044, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_rev AS (\n    SELECT\n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue\n    FROM public.customers c\n    INNER JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    INNER JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.acquisition_channel, c.signup_date\n),\nranked_customers AS (\n    SELECT\n        customer_id,\n        acquisition_channel,\n        signup_date,\n        net_revenue,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, customer_id ASC) AS decile\n    FROM customer_rev\n),\nchannel_decile_all AS (\n    SELECT\n        acquisition_channel,\n        COUNT(*) AS total_delivered_customers,\n        COUNT(*) FILTER (WHERE decile = 1) AS top_decile_customers,\n        ROUND(100.0 * COUNT(*) FILTER (WHERE decile = 1) / COUNT(*), 2) AS top_decile_share_pct\n    FROM ranked_customers\n    GROUP BY acquisition_channel\n),\nchannel_decile_2025 AS (\n    SELECT\n        acquisition_channel,\n        COUNT(*) AS total_delivered_customers_2025,\n        COUNT(*) FILTER (WHERE decile = 1) AS top_decile_customers_2025,\n        ROUND(100.0 * COUNT(*) FILTER (WHERE decile = 1) / COUNT(*), 2) AS top_decile_share_pct_2025\n    FROM ranked_customers\n    WHERE signup_date >= '2025-01-01'\n    GROUP BY acquisition_channel\n)\nSELECT\n    a.acquisition_channel,\n    a.total_delivered_customers,\n    a.top_decile_customers,\n    a.top_decile_share_pct,\n    b.total_delivered_customers_2025,\n    b.top_decile_customers_2025,\n    b.top_decile_share_pct_2025\nFROM channel_decile_all a\nLEFT JOIN channel_decile_2025 b ON a.acquisition_channel = b.acquisition_channel\nORDER BY a.top_decile_customers DESC;", "rows": 7, "error": null}
{"t": 1792334498.996143, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_spend AS (\n    SELECT\n        month,\n        channel,\n        spend_usd\n    FROM public.marketing_spend\n),\nmonthly_totals AS (\n    SELECT\n        month,\n        SUM(spend_usd) AS total_monthly_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'paid_social') AS paid_social_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'influencer') AS influencer_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'paid_search') AS paid_search_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'email_signup') AS email_signup_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'referral') AS referral_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'organic_search') AS organic_search_spend,\n        SUM(spend_usd) FILTER (WHERE channel = 'direct') AS direct_spend\n    FROM monthly_spend\n    GROUP BY month\n)\nSELECT\n    month,\n    ROUND(total_monthly_spend, 2) AS total_monthly_spend,\n    ROUND(20000.0 - total_monthly_spend, 2) AS budget_headroom,\n    ROUND(paid_social_spend, 2) AS paid_social_spend,\n    ROUND(100.0 * paid_social_spend / total_monthly_spend, 2) AS paid_social_share_pct,\n    ROUND(influencer_spend, 2) AS influencer_spend,\n    ROUND(100.0 * influencer_spend / total_monthly_spend, 2) AS influencer_share_pct,\n    ROUND(paid_search_spend, 2) AS paid_search_spend,\n    ROUND(100.0 * paid_search_spend / total_monthly_spend, 2) AS paid_search_share_pct,\n    ROUND(organic_search_spend, 2) AS organic_search_spend,\n    ROUND(email_signup_spend, 2) AS email_signup_spend,\n    ROUND(referral_spend, 2) AS referral_spend\nFROM monthly_totals\nORDER BY month ASC;", "rows": 12, "error": null}
{"t": 1792338563.5636463, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH spend_summary AS (\n    SELECT \n        channel, \n        SUM(spend_usd) AS total_spend \n    FROM public.marketing_spend \n    GROUP BY channel\n),\ncustomer_counts AS (\n    SELECT \n        acquisition_channel, \n        COUNT(customer_id) AS total_customers \n    FROM public.customers \n    WHERE is_internal = false \n      AND signup_date >= '2025-01-01' \n    GROUP BY acquisition_channel\n),\ncombined AS (\n    SELECT \n        COALESCE(s.channel, c.acquisition_channel) AS channel, \n        COALESCE(s.total_spend, 0) AS total_spend, \n        COALESCE(c.total_customers, 0) AS new_customers, \n        ROUND(COALESCE(s.total_spend, 0)::numeric / NULLIF(c.total_customers, 0), 2) AS cac \n    FROM customer_counts c \n    FULL OUTER JOIN spend_summary s ON LOWER(c.acquisition_channel) = LOWER(s.channel)\n)\nSELECT \n    channel,\n    total_spend,\n    new_customers,\n    cac,\n    ROUND((100.0 * total_spend / NULLIF(SUM(total_spend) OVER(), 0))::numeric, 2) AS pct_of_spend,\n    ROUND((100.0 * new_customers / NULLIF(SUM(new_customers) OVER(), 0))::numeric, 2) AS pct_of_customers,\n    SUM(total_spend) OVER() AS overall_total_spend,\n    SUM(new_customers) OVER() AS overall_total_customers,\n    ROUND((SUM(total_spend) OVER()::numeric / NULLIF(SUM(new_customers) OVER(), 0))::numeric, 2) AS blended_cac\nFROM combined\nORDER BY total_spend DESC;", "rows": 7, "error": null}
{"t": 1792338701.358348, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH cohort_bounds AS (\n    SELECT \n        '2025-01-01'::date AS cohort_start,\n        (MAX(order_date) - INTERVAL '90 days')::date AS cohort_end\n    FROM public.orders\n),\neligible_customers AS (\n    SELECT \n        c.customer_id,\n        c.acquisition_channel,\n        c.signup_date\n    FROM public.customers c\n    CROSS JOIN cohort_bounds cb\n    WHERE c.is_internal = false\n      AND c.signup_date >= cb.cohort_start\n      AND c.signup_date <= cb.cohort_end\n),\ncustomer_orders AS (\n    SELECT \n        ec.customer_id,\n        ec.acquisition_channel,\n        o.order_id,\n        o.order_date,\n        o.status,\n        CASE WHEN o.status = 'delivered' THEN 1 ELSE 0 END AS is_delivered,\n        CASE WHEN o.status = 'returned' THEN 1 ELSE 0 END AS is_returned,\n        CASE WHEN o.status = 'cancelled' THEN 1 ELSE 0 END AS is_cancelled\n    FROM eligible_customers ec\n    LEFT JOIN public.orders o \n      ON ec.customer_id = o.customer_id\n     AND o.order_date >= ec.signup_date\n     AND o.order_date <= ec.signup_date + INTERVAL '90 days'\n),\ndelivered_items AS (\n    SELECT \n        co.acquisition_channel,\n        co.customer_id,\n        co.order_id,\n        oi.quantity * oi.unit_price AS line_net_revenue,\n        oi.quantity * (oi.unit_price - p.unit_cost) AS line_gross_profit\n    FROM customer_orders co\n    JOIN public.order_items oi ON co.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE co.is_delivered = 1\n),\nchannel_customers AS (\n    SELECT \n        acquisition_channel,\n        COUNT(DISTINCT customer_id) AS cohort_customers\n    FROM eligible_customers\n    GROUP BY acquisition_channel\n),\nchannel_orders_agg AS (\n    SELECT \n        acquisition_channel,\n        COUNT(DISTINCT order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN is_delivered = 1 THEN order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN is_returned = 1 THEN order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN is_cancelled = 1 THEN order_id END) AS cancelled_orders,\n        COUNT(DISTINCT CASE WHEN is_delivered = 1 THEN customer_id END) AS customers_with_delivered_order\n    FROM customer_orders\n    WHERE order_id IS NOT NULL\n    GROUP BY acquisition_channel\n),\ncustomer_repeat_agg AS (\n    SELECT \n        acquisition_channel,\n        COUNT(DISTINCT customer_id) AS repeat_customers_delivered\n    FROM (\n        SELECT \n            acquisition_channel,\n            customer_id,\n            COUNT(DISTINCT order_id) AS delivered_order_count\n        FROM customer_orders\n        WHERE is_delivered = 1\n        GROUP BY acquisition_channel, customer_id\n        HAVING COUNT(DISTINCT order_id) >= 2\n    ) sub\n    GROUP BY acquisition_channel\n),\nchannel_financials AS (\n    SELECT \n        acquisition_channel,\n        SUM(line_net_revenue) AS total_net_revenue,\n        SUM(line_gross_profit) AS total_gross_profit\n    FROM delivered_items\n    GROUP BY acquisition_channel\n),\nspend_agg AS (\n    SELECT \n        channel,\n        SUM(spend_usd) AS channel_spend\n    FROM public.marketing_spend\n    WHERE month >= '2025-01-01'\n      AND month <= (SELECT MAX(cohort_end) FROM cohort_bounds)\n    GROUP BY channel\n),\ncombined AS (\n    SELECT \n        cc.acquisition_channel AS channel,\n        cc.cohort_customers,\n        COALESCE(coa.total_orders, 0) AS total_orders,\n        COALESCE(coa.delivered_orders, 0) AS delivered_orders,\n        COALESCE(coa.returned_orders, 0) AS returned_orders,\n        COALESCE(coa.cancelled_orders, 0) AS cancelled_orders,\n        COALESCE(cra.repeat_customers_delivered, 0) AS repeat_customers,\n        COALESCE(cf.total_net_revenue, 0) AS net_revenue,\n        COALESCE(cf.total_gross_profit, 0) AS gross_profit,\n        COALESCE(s.channel_spend, 0) AS channel_spend\n    FROM channel_customers cc\n    LEFT JOIN channel_orders_agg coa ON cc.acquisition_channel = coa.acquisition_channel\n    LEFT JOIN customer_repeat_agg cra ON cc.acquisition_channel = cra.acquisition_channel\n    LEFT JOIN channel_financials cf ON cc.acquisition_channel = cf.acquisition_channel\n    LEFT JOIN spend_agg s ON cc.acquisition_channel = s.channel\n)\nSELECT \n    channel,\n    cohort_customers,\n    total_orders,\n    delivered_orders,\n    returned_orders,\n    -- Return rate as % of placed orders (delivered + returned, or total orders)\n    ROUND(returned_orders::numeric / NULLIF(total_orders, 0) * 100, 2) AS return_rate_pct,\n    repeat_customers,\n    -- Repeat rate: repeat delivered buyers / cohort customers\n    ROUND(repeat_customers::numeric / NULLIF(cohort_customers, 0) * 100, 2) AS repeat_rate_cohort_pct,\n    -- Net revenue and gross profit\n    ROUND(net_revenue, 2) AS net_revenue,\n    ROUND(gross_profit, 2) AS gross_profit,\n    -- Per cohort customer\n    ROUND(net_revenue / NULLIF(cohort_customers, 0), 2) AS net_revenue_per_customer,\n    ROUND(gross_profit / NULLIF(cohort_customers, 0), 2) AS gross_profit_per_customer,\n    -- Realized margin\n    ROUND(gross_profit / NULLIF(net_revenue, 0) * 100, 2) AS realized_margin_pct,\n    -- Spend and CAC for this cohort window\n    ROUND(channel_spend, 2) AS spend_in_cohort_window,\n    ROUND(channel_spend / NULLIF(cohort_customers, 0), 2) AS cohort_cac,\n    -- Gross profit per CAC dollar (GP / Spend)\n    ROUND(gross_profit / NULLIF(channel_spend, 0), 2) AS gp_per_cac_dollar\nFROM combined\nORDER BY gross_profit DESC;", "rows": 7, "error": null}
{"t": 1792338711.1459382, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel_data AS (\n    SELECT \n        DATE_TRUNC('month', c.signup_date)::date AS signup_month,\n        c.acquisition_channel,\n        COUNT(DISTINCT c.customer_id) AS new_customers\n    FROM public.customers c\n    WHERE c.is_internal = false\n      AND c.signup_date >= '2025-01-01'\n    GROUP BY 1, 2\n),\nmonthly_spend AS (\n    SELECT \n        month::date AS spend_month,\n        channel,\n        spend_usd\n    FROM public.marketing_spend\n    WHERE month >= '2025-01-01'\n),\nchannel_monthly_summary AS (\n    SELECT \n        COALESCE(s.spend_month, c.signup_month) AS month,\n        COALESCE(s.channel, c.acquisition_channel) AS channel,\n        COALESCE(s.spend_usd, 0) AS spend_usd,\n        COALESCE(c.new_customers, 0) AS new_customers,\n        CASE \n            WHEN COALESCE(c.new_customers, 0) > 0 THEN ROUND(COALESCE(s.spend_usd, 0) / c.new_customers, 2)\n            ELSE NULL \n        END AS monthly_cac\n    FROM monthly_spend s\n    FULL OUTER JOIN monthly_channel_data c\n        ON s.spend_month = c.signup_month AND s.channel = c.acquisition_channel\n),\nchannel_monthly_lagged AS (\n    SELECT \n        month,\n        channel,\n        spend_usd,\n        new_customers,\n        monthly_cac,\n        LAG(spend_usd) OVER (PARTITION BY channel ORDER BY month) AS prev_spend,\n        LAG(new_customers) OVER (PARTITION BY channel ORDER BY month) AS prev_customers,\n        spend_usd - LAG(spend_usd) OVER (PARTITION BY channel ORDER BY month) AS delta_spend,\n        new_customers - LAG(new_customers) OVER (PARTITION BY channel ORDER BY month) AS delta_customers,\n        CASE \n            WHEN (new_customers - LAG(new_customers) OVER (PARTITION BY channel ORDER BY month)) > 0 \n            THEN ROUND((spend_usd - LAG(spend_usd) OVER (PARTITION BY channel ORDER BY month)) / (new_customers - LAG(new_customers) OVER (PARTITION BY channel ORDER BY month)), 2)\n            ELSE NULL \n        END AS marginal_cac\n    FROM channel_monthly_summary\n)\nSELECT \n    month,\n    channel,\n    spend_usd,\n    new_customers,\n    monthly_cac,\n    prev_spend,\n    prev_customers,\n    delta_spend,\n    delta_customers,\n    marginal_cac\nFROM channel_monthly_lagged\nORDER BY channel, month;", "rows": 84, "error": null}
{"t": 1792338716.5696948, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel AS (\n    SELECT \n        DATE_TRUNC('month', c.signup_date)::date AS mth,\n        c.acquisition_channel AS channel,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        ms.spend_usd,\n        ROUND(ms.spend_usd / NULLIF(COUNT(DISTINCT c.customer_id), 0), 2) AS monthly_cac\n    FROM public.customers c\n    JOIN public.marketing_spend ms \n      ON ms.channel = c.acquisition_channel \n     AND ms.month = DATE_TRUNC('month', c.signup_date)::date\n    WHERE c.is_internal = false\n      AND c.signup_date >= '2025-01-01'\n    GROUP BY 1, 2, 4\n),\nchannel_summary AS (\n    SELECT \n        channel,\n        ROUND(MIN(monthly_cac), 2) AS min_monthly_cac,\n        ROUND(MAX(monthly_cac), 2) AS max_monthly_cac,\n        ROUND(AVG(monthly_cac), 2) AS avg_monthly_cac,\n        ROUND(MIN(spend_usd), 2) AS min_monthly_spend,\n        ROUND(MAX(spend_usd), 2) AS max_monthly_spend,\n        ROUND(SUM(spend_usd), 2) AS total_annual_spend,\n        SUM(new_customers) AS total_annual_customers,\n        ROUND(SUM(spend_usd) / SUM(new_customers), 2) AS full_year_cac\n    FROM monthly_channel\n    GROUP BY channel\n)\nSELECT * FROM channel_summary\nORDER BY total_annual_spend DESC;", "rows": 7, "error": null}
{"t": 1792338724.5320814, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_paid AS (\n    SELECT \n        ms.month::date AS spend_month,\n        ms.channel,\n        ms.spend_usd,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        ROUND(ms.spend_usd / NULLIF(COUNT(DISTINCT c.customer_id), 0), 2) AS monthly_cac\n    FROM public.marketing_spend ms\n    LEFT JOIN public.customers c \n      ON c.acquisition_channel = ms.channel \n     AND DATE_TRUNC('month', c.signup_date)::date = ms.month::date\n     AND c.is_internal = false\n    WHERE ms.channel IN ('paid_social', 'paid_search', 'influencer')\n    GROUP BY ms.month, ms.channel, ms.spend_usd\n),\nspend_tiers AS (\n    SELECT \n        channel,\n        CASE \n            WHEN spend_usd < AVG(spend_usd) OVER (PARTITION BY channel) THEN 'low_spend_months'\n            ELSE 'high_spend_months'\n        END AS spend_tier,\n        spend_usd,\n        new_customers\n    FROM monthly_paid\n)\nSELECT \n    channel,\n    spend_tier,\n    COUNT(*) AS month_count,\n    ROUND(SUM(spend_usd), 2) AS total_tier_spend,\n    SUM(new_customers) AS total_tier_customers,\n    ROUND(SUM(spend_usd) / NULLIF(SUM(new_customers), 0), 2) AS tier_cac\nFROM spend_tiers\nGROUP BY channel, spend_tier\nORDER BY channel, spend_tier DESC;", "rows": 6, "error": null}
{"t": 1792338737.3702104, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_paid AS (\n    SELECT \n        ms.month::date AS spend_month,\n        ms.channel,\n        ms.spend_usd,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        ROUND(ms.spend_usd / NULLIF(COUNT(DISTINCT c.customer_id), 0), 2) AS monthly_cac\n    FROM public.marketing_spend ms\n    LEFT JOIN public.customers c \n      ON c.acquisition_channel = ms.channel \n     AND DATE_TRUNC('month', c.signup_date)::date = ms.month::date\n     AND c.is_internal = false\n    WHERE ms.channel IN ('paid_social', 'paid_search', 'influencer')\n    GROUP BY 1, 2, 3\n),\ntiered AS (\n    SELECT \n        channel,\n        CASE \n            WHEN channel = 'paid_social' AND spend_usd >= 3000 THEN 'high_spend'\n            WHEN channel = 'paid_social' THEN 'low_spend'\n            WHEN channel = 'paid_search' AND spend_usd >= 1500 THEN 'high_spend'\n            WHEN channel = 'paid_search' THEN 'low_spend'\n            WHEN channel = 'influencer' AND spend_usd >= 2000 THEN 'high_spend'\n            WHEN channel = 'influencer' THEN 'low_spend'\n        END AS tier,\n        spend_usd,\n        new_customers\n    FROM monthly_paid\n),\naggregated AS (\n    SELECT \n        channel,\n        tier,\n        COUNT(*) AS months_in_tier,\n        SUM(spend_usd) AS total_spend,\n        SUM(new_customers) AS total_customers,\n        ROUND(SUM(spend_usd) / NULLIF(SUM(new_customers), 0), 2) AS avg_cac\n    FROM tiered\n    GROUP BY 1, 2\n),\nmarginal_calc AS (\n    SELECT \n        a_high.channel,\n        a_low.total_spend AS low_spend,\n        a_low.total_customers AS low_cust,\n        a_low.avg_cac AS low_cac,\n        a_high.total_spend AS high_spend,\n        a_high.total_customers AS high_cust,\n        a_high.avg_cac AS high_cac,\n        (a_high.total_spend - a_low.total_spend) AS delta_spend,\n        (a_high.total_customers - a_low.total_customers) AS delta_cust,\n        ROUND((a_high.total_spend - a_low.total_spend) / NULLIF(a_high.total_customers - a_low.total_customers, 0), 2) AS marginal_cac,\n        ROUND((a_high.avg_cac - a_low.avg_cac) / NULLIF(a_low.avg_cac, 0) * 100, 2) AS cac_pct_increase\n    FROM aggregated a_high\n    JOIN aggregated a_low ON a_high.channel = a_low.channel AND a_high.tier = 'high_spend' AND a_low.tier = 'low_spend'\n)\nSELECT * FROM marginal_calc;", "rows": 3, "error": null}
{"t": 1792338744.10095, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_data AS (\n    SELECT \n        ms.month::date AS mth,\n        ms.channel,\n        ms.spend_usd,\n        COUNT(DISTINCT c.customer_id) AS new_customers,\n        ROUND(ms.spend_usd / NULLIF(COUNT(DISTINCT c.customer_id), 0), 2) AS monthly_cac\n    FROM public.marketing_spend ms\n    LEFT JOIN public.customers c \n      ON c.acquisition_channel = ms.channel \n     AND DATE_TRUNC('month', c.signup_date)::date = ms.month::date\n     AND c.is_internal = false\n    WHERE ms.channel IN ('paid_social', 'paid_search', 'influencer')\n    GROUP BY 1, 2, 3\n),\nhalf_comparison AS (\n    SELECT \n        channel,\n        -- H1 (Jan - Jun)\n        SUM(CASE WHEN mth < '2025-07-01' THEN spend_usd ELSE 0 END) AS h1_spend,\n        SUM(CASE WHEN mth < '2025-07-01' THEN new_customers ELSE 0 END) AS h1_customers,\n        ROUND(SUM(CASE WHEN mth < '2025-07-01' THEN spend_usd ELSE 0 END) / \n              NULLIF(SUM(CASE WHEN mth < '2025-07-01' THEN new_customers ELSE 0 END), 0), 2) AS h1_cac,\n        -- H2 (Jul - Dec)\n        SUM(CASE WHEN mth >= '2025-07-01' THEN spend_usd ELSE 0 END) AS h2_spend,\n        SUM(CASE WHEN mth >= '2025-07-01' THEN new_customers ELSE 0 END) AS h2_customers,\n        ROUND(SUM(CASE WHEN mth >= '2025-07-01' THEN spend_usd ELSE 0 END) / \n              NULLIF(SUM(CASE WHEN mth >= '2025-07-01' THEN new_customers ELSE 0 END), 0), 2) AS h2_cac\n    FROM monthly_data\n    GROUP BY channel\n)\nSELECT \n    channel,\n    h1_spend,\n    h1_customers,\n    h1_cac,\n    h2_spend,\n    h2_customers,\n    h2_cac,\n    ROUND(h2_spend - h1_spend, 2) AS delta_spend,\n    h2_customers - h1_customers AS delta_customers,\n    ROUND((h2_spend - h1_spend) / NULLIF(h2_customers - h1_customers, 0), 2) AS marginal_cac_h2_vs_h1,\n    ROUND(((h2_cac - h1_cac) / NULLIF(h1_cac, 0)) * 100, 2) AS cac_growth_pct\nFROM half_comparison;", "rows": 3, "error": null}
{"t": 1792338749.7885134, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    DATE_TRUNC('month', month)::date AS mth,\n    SUM(spend_usd) AS total_monthly_spend,\n    ROUND(SUM(spend_usd), 2) AS total_spend_rounded\nFROM public.marketing_spend\nGROUP BY 1\nORDER BY 1;", "rows": 12, "error": null}
{"t": 1792340780.6459928, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH date_bounds AS (\n    SELECT \n        MIN(month) AS spend_start_date,\n        MAX(order_date) AS max_order_date,\n        -- cohort_end: MAX(orders.order_date) minus acquisition_value_window_days (90), rounded down to end of last complete calendar month\n        -- If max_order_date is e.g. 2025-12-31, - 90 days = 2025-10-02, date_trunc('month', ...) - interval '1 day' = 2025-09-30\n        (date_trunc('month', MAX(order_date) - INTERVAL '90 days') - INTERVAL '1 day')::date AS cohort_end_date\n    FROM public.orders\n    CROSS JOIN public.marketing_spend\n),\ncohort_customers AS (\n    SELECT \n        c.customer_id,\n        c.signup_date,\n        c.acquisition_channel,\n        db.cohort_end_date\n    FROM public.customers c\n    CROSS JOIN date_bounds db\n    WHERE c.is_internal = false\n      AND c.signup_date >= db.spend_start_date\n      AND c.signup_date <= db.cohort_end_date\n),\nchannel_spend AS (\n    SELECT \n        ms.channel AS acquisition_channel,\n        SUM(ms.spend_usd) AS total_spend\n    FROM public.marketing_spend ms\n    CROSS JOIN date_bounds db\n    WHERE ms.month >= db.spend_start_date\n      AND ms.month <= db.cohort_end_date\n    GROUP BY ms.channel\n),\ncustomer_orders AS (\n    SELECT \n        cc.customer_id,\n        cc.acquisition_channel,\n        o.order_id,\n        oi.quantity,\n        oi.unit_price,\n        p.unit_cost\n    FROM cohort_customers cc\n    JOIN public.orders o \n      ON cc.customer_id = o.customer_id\n     AND o.status = 'delivered'\n     AND o.order_date >= cc.signup_date\n     AND o.order_date <= cc.signup_date + INTERVAL '90 days'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n),\nchannel_perf AS (\n    SELECT \n        cc.acquisition_channel,\n        COUNT(DISTINCT cc.customer_id) AS cohort_customers_count,\n        COALESCE(SUM(co.quantity * co.unit_price), 0) AS net_revenue_90d,\n        COALESCE(SUM(co.quantity * (co.unit_price - co.unit_cost)), 0) AS gross_profit_90d\n    FROM cohort_customers cc\n    LEFT JOIN customer_orders co ON cc.customer_id = co.customer_id\n    GROUP BY cc.acquisition_channel\n),\nchannel_summary AS (\n    SELECT \n        cp.acquisition_channel,\n        cp.cohort_customers_count,\n        COALESCE(cs.total_spend, 0) AS total_spend,\n        cp.net_revenue_90d,\n        cp.gross_profit_90d,\n        ROUND(COALESCE(cs.total_spend, 0)::numeric / NULLIF(cp.cohort_customers_count, 0), 2) AS cac,\n        ROUND(cp.net_revenue_90d::numeric / NULLIF(cp.cohort_customers_count, 0), 2) AS net_revenue_per_customer_90d,\n        ROUND(cp.gross_profit_90d::numeric / NULLIF(cp.cohort_customers_count, 0), 2) AS gross_profit_per_customer_90d,\n        ROUND(cp.gross_profit_90d::numeric / NULLIF(cs.total_spend, 0), 2) AS gross_profit_per_cac_dollar,\n        ROUND(cp.net_revenue_90d::numeric / NULLIF(cs.total_spend, 0), 2) AS roas_90d\n    FROM channel_perf cp\n    LEFT JOIN channel_spend cs ON cp.acquisition_channel = cs.acquisition_channel\n),\ntotals AS (\n    SELECT \n        'Total / Blended' AS acquisition_channel,\n        SUM(cohort_customers_count) AS cohort_customers_count,\n        SUM(total_spend) AS total_spend,\n        SUM(net_revenue_90d) AS net_revenue_90d,\n        SUM(gross_profit_90d) AS gross_profit_90d,\n        ROUND(SUM(total_spend)::numeric / NULLIF(SUM(cohort_customers_count), 0), 2) AS cac,\n        ROUND(SUM(net_revenue_90d)::numeric / NULLIF(SUM(cohort_customers_count), 0), 2) AS net_revenue_per_customer_90d,\n        ROUND(SUM(gross_profit_90d)::numeric / NULLIF(SUM(cohort_customers_count), 0), 2) AS gross_profit_per_customer_90d,\n        ROUND(SUM(gross_profit_90d)::numeric / NULLIF(SUM(total_spend), 0), 2) AS gross_profit_per_cac_dollar,\n        ROUND(SUM(net_revenue_90d)::numeric / NULLIF(SUM(total_spend), 0), 2) AS roas_90d\n    FROM channel_summary\n)\nSELECT * FROM channel_summary\nUNION ALL\nSELECT * FROM totals\nORDER BY total_spend DESC;", "rows": 8, "error": null}
{"t": 1792340794.8347778, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH date_bounds AS (\n    SELECT \n        MIN(month) AS spend_start_date,\n        (date_trunc('month', MAX(order_date) - INTERVAL '90 days') - INTERVAL '1 day')::date AS cohort_end_date\n    FROM marketing_spend, orders\n),\ncohort_customers AS (\n    SELECT \n        c.customer_id,\n        c.signup_date,\n        c.acquisition_channel\n    FROM customers c\n    CROSS JOIN date_bounds b\n    WHERE c.is_internal = false\n      AND c.signup_date >= b.spend_start_date\n      AND c.signup_date <= b.cohort_end_date\n),\ncust_orders_90d AS (\n    SELECT \n        cc.customer_id,\n        cc.acquisition_channel,\n        o.order_id,\n        o.order_date,\n        o.status,\n        o.discount_code,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS order_revenue\n    FROM cohort_customers cc\n    LEFT JOIN orders o \n        ON cc.customer_id = o.customer_id\n        AND o.order_date >= cc.signup_date\n        AND o.order_date <= cc.signup_date + INTERVAL '90 days'\n    LEFT JOIN order_items oi\n        ON o.order_id = oi.order_id\n    GROUP BY cc.customer_id, cc.acquisition_channel, o.order_id, o.order_date, o.status, o.discount_code\n),\ncust_summary AS (\n    SELECT \n        customer_id,\n        acquisition_channel,\n        COUNT(order_id) AS total_orders_placed,\n        COUNT(order_id) FILTER (WHERE status = 'delivered') AS delivered_orders,\n        COUNT(order_id) FILTER (WHERE status = 'returned') AS returned_orders,\n        COUNT(order_id) FILTER (WHERE status = 'cancelled') AS cancelled_orders,\n        COUNT(order_id) FILTER (WHERE discount_code IS NOT NULL AND discount_code <> '') AS discounted_orders,\n        SUM(order_revenue) FILTER (WHERE status = 'delivered') AS total_delivered_revenue\n    FROM cust_orders_90d\n    GROUP BY customer_id, acquisition_channel\n),\nchannel_metrics AS (\n    SELECT \n        acquisition_channel,\n        COUNT(customer_id) AS cohort_size,\n        -- buyers: customers with at least 1 delivered order\n        COUNT(customer_id) FILTER (WHERE delivered_orders >= 1) AS delivered_buyers,\n        -- repeat buyers: customers with at least 2 delivered orders\n        COUNT(customer_id) FILTER (WHERE delivered_orders >= 2) AS repeat_delivered_buyers,\n        -- orders\n        SUM(total_orders_placed) AS total_orders_placed,\n        SUM(delivered_orders) AS total_delivered_orders,\n        SUM(returned_orders) AS total_returned_orders,\n        SUM(cancelled_orders) AS total_cancelled_orders,\n        SUM(discounted_orders) AS total_discounted_orders,\n        SUM(total_delivered_revenue) AS total_delivered_revenue\n    FROM cust_summary\n    GROUP BY acquisition_channel\n\n    UNION ALL\n\n    SELECT \n        'Total / Blended' AS acquisition_channel,\n        COUNT(customer_id) AS cohort_size,\n        COUNT(customer_id) FILTER (WHERE delivered_orders >= 1) AS delivered_buyers,\n        COUNT(customer_id) FILTER (WHERE delivered_orders >= 2) AS repeat_delivered_buyers,\n        SUM(total_orders_placed) AS total_orders_placed,\n        SUM(delivered_orders) AS total_delivered_orders,\n        SUM(returned_orders) AS total_returned_orders,\n        SUM(cancelled_orders) AS total_cancelled_orders,\n        SUM(discounted_orders) AS total_discounted_orders,\n        SUM(total_delivered_revenue) AS total_delivered_revenue\n    FROM cust_summary\n)\nSELECT \n    acquisition_channel,\n    cohort_size,\n    delivered_buyers,\n    repeat_delivered_buyers,\n    -- repeat rate among all cohort customers (%)\n    ROUND(100.0 * repeat_delivered_buyers / NULLIF(cohort_size, 0), 2) AS repeat_rate_cohort_pct,\n    -- repeat rate among delivered buyers (%)\n    ROUND(100.0 * repeat_delivered_buyers / NULLIF(delivered_buyers, 0), 2) AS repeat_rate_buyers_pct,\n    -- AOV (delivered revenue / delivered orders)\n    ROUND(total_delivered_revenue / NULLIF(total_delivered_orders, 0), 2) AS aov_delivered,\n    -- total orders placed\n    total_orders_placed,\n    total_delivered_orders,\n    total_returned_orders,\n    total_cancelled_orders,\n    -- return rate (% of all placed orders)\n    ROUND(100.0 * total_returned_orders / NULLIF(total_orders_placed, 0), 2) AS return_rate_pct,\n    -- cancellation rate (% of all placed orders)\n    ROUND(100.0 * total_cancelled_orders / NULLIF(total_orders_placed, 0), 2) AS cancellation_rate_pct,\n    -- discount code reliance (% of placed orders that used a discount code)\n    ROUND(100.0 * total_discounted_orders / NULLIF(total_orders_placed, 0), 2) AS discount_order_share_pct\nFROM channel_metrics\nORDER BY cohort_size DESC;", "rows": 8, "error": null}
{"t": 1792340827.4540083, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel AS (\n    SELECT \n        s.month,\n        s.channel,\n        s.spend_usd,\n        COUNT(c.customer_id) AS acquired_customers,\n        ROUND(s.spend_usd / NULLIF(COUNT(c.customer_id), 0), 2) AS monthly_cac\n    FROM marketing_spend s\n    LEFT JOIN customers c \n        ON c.acquisition_channel = s.channel \n        AND date_trunc('month', c.signup_date) = s.month\n        AND c.is_internal = false\n    GROUP BY s.month, s.channel, s.spend_usd\n),\nmonthly_totals AS (\n    SELECT\n        month,\n        'Total' AS channel,\n        SUM(spend_usd) AS spend_usd,\n        SUM(acquired_customers) AS acquired_customers,\n        ROUND(SUM(spend_usd) / NULLIF(SUM(acquired_customers), 0), 2) AS monthly_cac\n    FROM monthly_channel\n    GROUP BY month\n),\ncombined AS (\n    SELECT * FROM monthly_channel\n    UNION ALL\n    SELECT * FROM monthly_totals\n)\nSELECT \n    month,\n    channel,\n    spend_usd,\n    acquired_customers,\n    monthly_cac,\n    -- Also calculate share of monthly spend for each channel\n    ROUND(100.0 * spend_usd / SUM(spend_usd) OVER (PARTITION BY month, CASE WHEN channel = 'Total' THEN 1 ELSE 2 END), 2) AS spend_share_pct\nFROM combined\nORDER BY month, CASE WHEN channel = 'Total' THEN 1 ELSE 0 END, spend_usd DESC;", "rows": 96, "error": null}
{"t": 1792340833.5716493, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_spend AS (\n    SELECT \n        month,\n        SUM(spend_usd) AS total_monthly_spend,\n        SUM(CASE WHEN channel = 'paid_social' THEN spend_usd ELSE 0 END) AS paid_social_spend,\n        SUM(CASE WHEN channel = 'influencer' THEN spend_usd ELSE 0 END) AS influencer_spend,\n        SUM(CASE WHEN channel = 'paid_search' THEN spend_usd ELSE 0 END) AS paid_search_spend,\n        SUM(CASE WHEN channel IN ('paid_social', 'influencer', 'paid_search') THEN spend_usd ELSE 0 END) AS top_paid_spend\n    FROM marketing_spend\n    GROUP BY month\n)\nSELECT \n    MIN(total_monthly_spend) AS min_monthly_spend,\n    MAX(total_monthly_spend) AS max_monthly_spend,\n    ROUND(AVG(total_monthly_spend), 2) AS avg_monthly_spend,\n    ROUND(AVG(paid_social_spend), 2) AS avg_paid_social_spend,\n    ROUND(AVG(influencer_spend), 2) AS avg_influencer_spend,\n    ROUND(AVG(paid_search_spend), 2) AS avg_paid_search_spend,\n    ROUND(AVG(top_paid_spend), 2) AS avg_top_paid_spend,\n    ROUND(MAX(total_monthly_spend) / 20000.0 * 100, 2) AS max_spend_pct_of_20k_cap,\n    ROUND(AVG(total_monthly_spend) / 20000.0 * 100, 2) AS avg_spend_pct_of_20k_cap\nFROM monthly_spend;", "rows": 1, "error": null}
{"t": 1792340842.2431045, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel AS (\n    SELECT \n        s.month,\n        s.channel,\n        s.spend_usd,\n        COUNT(c.customer_id) AS acquired_customers,\n        ROUND(s.spend_usd / NULLIF(COUNT(c.customer_id), 0), 2) AS monthly_cac\n    FROM marketing_spend s\n    LEFT JOIN customers c \n        ON c.acquisition_channel = s.channel \n        AND date_trunc('month', c.signup_date) = s.month\n        AND c.is_internal = false\n    WHERE s.channel IN ('paid_social', 'influencer', 'paid_search')\n    GROUP BY s.month, s.channel, s.spend_usd\n),\nchannel_summary AS (\n    SELECT\n        channel,\n        COUNT(DISTINCT month) AS active_months,\n        ROUND(MIN(spend_usd), 2) AS min_spend,\n        ROUND(MAX(spend_usd), 2) AS max_spend,\n        ROUND(AVG(spend_usd), 2) AS avg_spend,\n        ROUND(MIN(monthly_cac), 2) AS min_cac,\n        ROUND(MAX(monthly_cac), 2) AS max_cac,\n        ROUND(AVG(monthly_cac), 2) AS avg_cac,\n        SUM(spend_usd) AS total_spend,\n        SUM(acquired_customers) AS total_acquired,\n        ROUND(SUM(spend_usd) / NULLIF(SUM(acquired_customers), 0), 2) AS blended_cac\n    FROM monthly_channel\n    GROUP BY channel\n),\nreallocation_sim AS (\n    -- Shift $500/month from paid_social to paid_search (using 2025 avg CACs or blended CACs)\n    SELECT\n        'Shift $500/mo from paid_social to paid_search' AS scenario,\n        500.0 AS shifted_amount,\n        ROUND(500.0 / 37.31, 1) AS lost_social_customers_approx,\n        ROUND(500.0 / 28.62, 1) AS gained_search_customers_approx,\n        ROUND((500.0 / 28.62) - (500.0 / 37.31), 1) AS net_customer_gain_approx,\n        ROUND((500.0 / 28.62) * 86.01 - (500.0 / 37.31) * 62.90, 2) AS net_90d_gp_gain_usd\n)\nSELECT * FROM channel_summary\nUNION ALL\nSELECT \n    scenario AS channel,\n    NULL AS active_months,\n    shifted_amount AS min_spend,\n    lost_social_customers_approx AS max_spend,\n    gained_search_customers_approx AS avg_spend,\n    net_customer_gain_approx AS min_cac,\n    net_90d_gp_gain_usd AS max_cac,\n    NULL AS avg_cac,\n    NULL AS total_spend,\n    NULL AS total_acquired,\n    NULL AS blended_cac\nFROM reallocation_sim;", "rows": 4, "error": null}
{"t": 1792401747.7656133, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT o.order_id\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nprod_sales AS (\n    SELECT \n        oi.product_id,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        SUM(oi.quantity * p.list_price) AS list_revenue,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n    FROM order_items oi\n    JOIN delivered_orders d ON oi.order_id = d.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    GROUP BY oi.product_id\n),\nprod_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM reviews r\n    JOIN customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n),\noverall_totals AS (\n    SELECT \n        SUM(delivered_units) AS tot_units,\n        SUM(net_revenue) AS tot_revenue,\n        SUM(gross_profit) AS tot_gross_profit\n    FROM prod_sales\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0))::numeric, 4) AS list_margin,\n    COALESCE(s.delivered_units, 0) AS delivered_units,\n    ROUND((COALESCE(s.delivered_units, 0)::numeric / NULLIF(ot.tot_units, 0)) * 100, 2) AS unit_share_pct,\n    ROUND(COALESCE(s.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND((COALESCE(s.net_revenue, 0)::numeric / NULLIF(ot.tot_revenue, 0)) * 100, 2) AS revenue_share_pct,\n    ROUND(COALESCE(s.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((COALESCE(s.gross_profit, 0)::numeric / NULLIF(ot.tot_gross_profit, 0)) * 100, 2) AS profit_share_pct,\n    ROUND(((COALESCE(s.gross_profit, 0) / NULLIF(s.net_revenue, 0)))::numeric, 4) AS realized_margin,\n    ROUND((((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) - (COALESCE(s.gross_profit, 0) / NULLIF(s.net_revenue, 0)))::numeric, 4) AS margin_gap,\n    ROUND(COALESCE(s.discount_cost, 0)::numeric, 2) AS discount_cost,\n    ROUND((COALESCE(s.net_revenue, 0) / NULLIF(s.delivered_units, 0))::numeric, 2) AS realized_price,\n    ROUND((p.list_price - (COALESCE(s.net_revenue, 0) / NULLIF(s.delivered_units, 0)))::numeric, 2) AS price_gap,\n    COALESCE(r.review_count, 0) AS review_count,\n    COALESCE(r.avg_rating, 0) AS avg_rating\nFROM products p\nCROSS JOIN overall_totals ot\nLEFT JOIN prod_sales s ON p.product_id = s.product_id\nLEFT JOIN prod_reviews r ON p.product_id = r.product_id\nORDER BY gross_profit DESC;", "rows": 17, "error": null}
{"t": 1792401901.11865, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT o.order_id\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nprod_sales AS (\n    SELECT \n        oi.product_id,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n    FROM order_items oi\n    JOIN delivered_orders d ON oi.order_id = d.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    GROUP BY oi.product_id\n),\ntotals AS (\n    SELECT \n        SUM(delivered_units) AS total_units,\n        SUM(net_revenue) AS total_rev,\n        SUM(gross_profit) AS total_gp\n    FROM prod_sales\n),\nrev_stats AS (\n    SELECT \n        product_id,\n        COUNT(*) AS review_count,\n        ROUND(AVG(rating)::numeric, 2) AS avg_rating\n    FROM reviews\n    GROUP BY product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / p.list_price)::numeric, 4) AS list_margin,\n    COALESCE(ps.delivered_units, 0) AS delivered_units,\n    ROUND((ps.delivered_units * 100.0 / t.total_units)::numeric, 2) AS unit_share_pct,\n    ROUND(COALESCE(ps.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND((ps.net_revenue * 100.0 / t.total_rev)::numeric, 2) AS revenue_share_pct,\n    ROUND(COALESCE(ps.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((ps.gross_profit * 100.0 / t.total_gp)::numeric, 2) AS profit_share_pct,\n    ROUND((ps.gross_profit / NULLIF(ps.net_revenue, 0))::numeric, 4) AS realized_margin,\n    ROUND((((p.list_price - p.unit_cost) / p.list_price) - (ps.gross_profit / NULLIF(ps.net_revenue, 0)))::numeric, 4) AS margin_gap,\n    ROUND(COALESCE(ps.discount_cost, 0)::numeric, 2) AS discount_cost,\n    ROUND((ps.net_revenue / NULLIF(ps.delivered_units, 0))::numeric, 2) AS realized_price,\n    ROUND((p.list_price - (ps.net_revenue / NULLIF(ps.delivered_units, 0)))::numeric, 2) AS price_gap,\n    COALESCE(rs.review_count, 0) AS review_count,\n    COALESCE(rs.avg_rating, 0) AS avg_rating\nFROM products p\nCROSS JOIN totals t\nLEFT JOIN prod_sales ps ON p.product_id = ps.product_id\nLEFT JOIN rev_stats rs ON p.product_id = rs.product_id\nORDER BY gross_profit DESC;", "rows": 17, "error": null}
{"t": 1792402187.164249, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH max_date AS (\n    SELECT MAX(order_date) AS max_order_date FROM orders WHERE status = 'delivered'\n),\ndelivered_orders AS (\n    SELECT o.order_id, o.order_date\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nrecent_sales AS (\n    SELECT\n        oi.product_id,\n        SUM(CASE WHEN do.order_date >= (SELECT max_order_date - INTERVAL '29 days' FROM max_date) THEN oi.quantity ELSE 0 END) AS units_l30d,\n        ROUND(SUM(CASE WHEN do.order_date >= (SELECT max_order_date - INTERVAL '29 days' FROM max_date) THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS rev_l30d,\n        SUM(CASE WHEN do.order_date >= (SELECT max_order_date - INTERVAL '59 days' FROM max_date) THEN oi.quantity ELSE 0 END) AS units_l60d,\n        ROUND(SUM(CASE WHEN do.order_date >= (SELECT max_order_date - INTERVAL '59 days' FROM max_date) THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS rev_l60d\n    FROM order_items oi\n    JOIN delivered_orders do ON oi.order_id = do.order_id\n    GROUP BY oi.product_id\n),\nstock_summary AS (\n    SELECT \n        product_id,\n        COUNT(*) AS total_stock_events,\n        STRING_AGG(event_type || ' (' || start_date || ' to ' || COALESCE(end_date::text, 'ongoing') || ')', '; ') AS stock_event_details,\n        MAX(CASE WHEN end_date IS NULL OR end_date >= (SELECT max_order_date FROM max_date) THEN 1 ELSE 0 END) AS currently_affected\n    FROM stock_events, max_date\n    GROUP BY product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COALESCE(ss.total_stock_events, 0) AS total_stock_events,\n    COALESCE(ss.currently_affected, 0) AS is_currently_stock_affected,\n    COALESCE(ss.stock_event_details, 'None') AS stock_event_details,\n    COALESCE(rs.units_l30d, 0) AS units_l30d,\n    COALESCE(rs.rev_l30d, 0) AS rev_l30d,\n    COALESCE(rs.units_l60d, 0) AS units_l60d,\n    COALESCE(rs.rev_l60d, 0) AS rev_l60d,\n    ROUND(COALESCE(rs.units_l30d, 0)::numeric / 30.0, 2) AS daily_velocity_l30d,\n    ROUND(COALESCE(rs.units_l60d, 0)::numeric / 60.0, 2) AS daily_velocity_l60d\nFROM products p\nLEFT JOIN recent_sales rs ON p.product_id = rs.product_id\nLEFT JOIN stock_summary ss ON p.product_id = ss.product_id\nORDER BY rs.rev_l30d DESC NULLS LAST;", "rows": null, "error": "Forbidden query."}
{"t": 1792402523.427032, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH max_dt AS (\n    SELECT MAX(order_date) AS max_order_date FROM orders\n),\nrecent_orders AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        c.is_internal\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    CROSS JOIN max_dt m\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n      AND o.order_date >= m.max_order_date - INTERVAL '60 days'\n),\nvelocity AS (\n    SELECT \n        oi.product_id,\n        SUM(CASE WHEN ro.order_date >= m.max_order_date - INTERVAL '30 days' THEN oi.quantity ELSE 0 END) AS units_last_30d,\n        ROUND(SUM(CASE WHEN ro.order_date >= m.max_order_date - INTERVAL '30 days' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS rev_last_30d,\n        SUM(oi.quantity) AS units_last_60d,\n        ROUND(SUM(oi.quantity * oi.unit_price), 2) AS rev_last_60d\n    FROM recent_orders ro\n    JOIN order_items oi ON ro.order_id = oi.order_id\n    CROSS JOIN max_dt m\n    GROUP BY oi.product_id\n),\nstock AS (\n    SELECT \n        product_id,\n        COUNT(*) AS total_stock_events,\n        SUM(CASE WHEN event_type = 'stockout' THEN 1 ELSE 0 END) AS stockout_count,\n        MAX(end_date) AS latest_stock_event_end,\n        MAX(start_date) AS latest_stock_event_start\n    FROM stock_events\n    GROUP BY product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    COALESCE(s.total_stock_events, 0) AS total_stock_events,\n    COALESCE(s.stockout_count, 0) AS stockout_count,\n    s.latest_stock_event_start,\n    s.latest_stock_event_end,\n    COALESCE(v.units_last_30d, 0) AS units_last_30d,\n    COALESCE(v.rev_last_30d, 0) AS rev_last_30d,\n    COALESCE(v.units_last_60d, 0) AS units_last_60d,\n    COALESCE(v.rev_last_60d, 0) AS rev_last_60d\nFROM products p\nLEFT JOIN stock s ON p.product_id = s.product_id\nLEFT JOIN velocity v ON p.product_id = v.product_id\nORDER BY rev_last_30d DESC;", "rows": 17, "error": null}
{"t": 1792404481.6227121, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        ROUND((1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))) * 100, 2) AS realized_margin_pct,\n        ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) * 100, 2) AS list_margin_pct,\n        ROUND((1.0 - (SUM(oi.quantity * oi.unit_price) / NULLIF(SUM(oi.quantity * p.list_price), 0))) * 100, 2) AS avg_discount_depth_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY oi.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'cancelled' THEN o.order_id END) AS cancelled_orders,\n        ROUND((COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END)::numeric / NULLIF(COUNT(DISTINCT o.order_id), 0)) * 100, 2) AS return_rate_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    d.product_id,\n    d.product_name,\n    d.category,\n    d.list_price,\n    d.unit_cost,\n    d.delivered_units,\n    ROUND(d.net_revenue, 2) AS net_revenue,\n    ROUND(d.gross_profit, 2) AS gross_profit,\n    d.list_margin_pct,\n    d.realized_margin_pct,\n    d.avg_discount_depth_pct,\n    po.total_orders_ordered,\n    po.delivered_orders,\n    po.returned_orders,\n    po.return_rate_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0.00) AS avg_rating\nFROM delivered_lines d\nLEFT JOIN product_orders po ON d.product_id = po.product_id\nLEFT JOIN product_reviews pr ON d.product_id = pr.product_id\nORDER BY d.net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792404720.5215418, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        ROUND((1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))) * 100, 2) AS realized_margin_pct,\n        ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) * 100, 2) AS list_margin_pct,\n        ROUND(AVG(oi.discount_pct), 2) AS avg_discount_depth_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY oi.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        ROUND((COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END)::numeric / \n               NULLIF(COUNT(DISTINCT CASE WHEN o.status IN ('delivered', 'returned') THEN o.order_id END), 0)) * 100, 2) AS return_rate_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating), 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    dl.product_id,\n    dl.product_name,\n    dl.category,\n    dl.list_price,\n    dl.unit_cost,\n    dl.delivered_units,\n    dl.net_revenue,\n    dl.gross_profit,\n    dl.list_margin_pct,\n    dl.realized_margin_pct,\n    ROUND(dl.list_margin_pct - dl.realized_margin_pct, 2) AS margin_erosion_pct,\n    dl.avg_discount_depth_pct,\n    po.total_orders_ordered,\n    po.delivered_orders,\n    po.returned_orders,\n    po.return_rate_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating\nFROM delivered_lines dl\nLEFT JOIN product_orders po ON dl.product_id = po.product_id\nLEFT JOIN product_reviews pr ON dl.product_id = pr.product_id\nORDER BY dl.gross_profit DESC;", "rows": 17, "error": null}
{"t": 1792405111.4038405, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH product_delivered AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((p.list_price - p.unit_cost) / p.list_price * 100, 2) AS list_margin_pct,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        ROUND((1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))) * 100, 2) AS realized_margin_pct,\n        ROUND(((SUM(oi.quantity * p.list_price) - SUM(oi.quantity * oi.unit_price)) / NULLIF(SUM(oi.quantity * p.list_price), 0)) * 100, 2) AS avg_discount_depth_pct\n    FROM order_items oi\n    JOIN orders o ON oi.order_id = o.order_id\n    JOIN customers c ON o.customer_id = c.customer_id\n    JOIN products p ON oi.product_id = p.product_id\n    WHERE (c.is_internal IS FALSE OR c.is_internal IS NULL)\n      AND o.status = 'delivered'\n    GROUP BY oi.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT oi.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN oi.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END) AS returned_orders,\n        ROUND(COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END)::numeric / NULLIF(COUNT(DISTINCT oi.order_id), 0) * 100, 2) AS return_rate_on_ordered_orders_pct,\n        ROUND(COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END)::numeric / NULLIF(COUNT(DISTINCT CASE WHEN o.status IN ('delivered', 'returned') THEN oi.order_id END), 0) * 100, 2) AS return_rate_on_fulfilled_pct\n    FROM order_items oi\n    JOIN orders o ON oi.order_id = o.order_id\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE (c.is_internal IS FALSE OR c.is_internal IS NULL)\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM reviews r\n    JOIN customers c ON r.customer_id = c.customer_id\n    WHERE (c.is_internal IS FALSE OR c.is_internal IS NULL)\n    GROUP BY r.product_id\n)\nSELECT \n    pd.product_id,\n    pd.product_name,\n    pd.category,\n    pd.list_price,\n    pd.unit_cost,\n    pd.list_margin_pct,\n    pd.delivered_units,\n    pd.net_revenue,\n    pd.gross_profit,\n    pd.realized_margin_pct,\n    ROUND(pd.list_margin_pct - pd.realized_margin_pct, 2) AS margin_erosion_pct,\n    pd.avg_discount_depth_pct,\n    po.total_orders_ordered,\n    po.delivered_orders,\n    po.returned_orders,\n    po.return_rate_on_ordered_orders_pct,\n    po.return_rate_on_fulfilled_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating\nFROM product_delivered pd\nLEFT JOIN product_orders po ON pd.product_id = po.product_id\nLEFT JOIN product_reviews pr ON pd.product_id = pr.product_id\nORDER BY pd.gross_profit DESC;", "rows": 17, "error": null}
{"t": 1792405137.7377126, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((p.list_price - p.unit_cost) / p.list_price * 100, 2) AS list_margin_pct,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        ROUND((1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))) * 100, 2) AS realized_margin_pct,\n        ROUND(((p.list_price - p.unit_cost) / p.list_price * 100) - ((1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))) * 100), 2) AS margin_erosion_pct,\n        ROUND(AVG(oi.discount_pct), 2) AS avg_discount_depth_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY oi.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nproduct_order_returns AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT oi.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN oi.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END) AS returned_orders,\n        ROUND(COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END)::numeric / NULLIF(COUNT(DISTINCT oi.order_id), 0) * 100, 2) AS return_rate_on_ordered_orders_pct,\n        ROUND(COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END)::numeric / NULLIF(COUNT(DISTINCT CASE WHEN o.status IN ('delivered', 'returned') THEN oi.order_id END), 0) * 100, 2) AS return_rate_on_fulfilled_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    d.product_id,\n    d.product_name,\n    d.category,\n    d.list_price,\n    d.unit_cost,\n    d.list_margin_pct,\n    d.delivered_units,\n    d.net_revenue,\n    d.gross_profit,\n    d.realized_margin_pct,\n    d.margin_erosion_pct,\n    d.avg_discount_depth_pct,\n    r_ord.total_orders_ordered,\n    r_ord.delivered_orders,\n    r_ord.returned_orders,\n    r_ord.return_rate_on_ordered_orders_pct,\n    r_ord.return_rate_on_fulfilled_pct,\n    COALESCE(rev.review_count, 0) AS review_count,\n    rev.avg_rating\nFROM delivered_lines d\nLEFT JOIN product_order_returns r_ord ON d.product_id = r_ord.product_id\nLEFT JOIN product_reviews rev ON d.product_id = rev.product_id\nORDER BY d.gross_profit DESC;", "rows": 17, "error": null}
{"t": 1792405286.3358386, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    se.product_id,\n    p.product_name,\n    se.event_type,\n    se.start_date,\n    se.end_date,\n    (se.end_date - se.start_date + 1) AS stockout_days\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nORDER BY se.start_date DESC, se.product_id;", "rows": 3, "error": null}
{"t": 1792405287.4268014, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date, o.order_id) AS order_sequence\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\norder_lines AS (\n    SELECT \n        oi.product_id,\n        do.customer_id,\n        do.order_id,\n        do.order_sequence,\n        CASE WHEN do.order_sequence = 1 THEN 'first_order' ELSE 'repeat_order' END AS order_type\n    FROM delivered_orders do\n    JOIN public.order_items oi ON do.order_id = oi.order_id\n),\ncustomer_product_stats AS (\n    SELECT \n        product_id,\n        COUNT(DISTINCT customer_id) AS total_unique_buyers,\n        COUNT(DISTINCT CASE WHEN order_sequence = 1 THEN customer_id END) AS first_order_buyers,\n        COUNT(DISTINCT CASE WHEN order_sequence > 1 THEN customer_id END) AS repeat_order_buyers,\n        COUNT(DISTINCT order_id) AS total_delivered_orders,\n        COUNT(DISTINCT CASE WHEN order_sequence = 1 THEN order_id END) AS first_orders_count,\n        COUNT(DISTINCT CASE WHEN order_sequence > 1 THEN order_id END) AS repeat_orders_count\n    FROM order_lines\n    GROUP BY product_id\n),\ncustomer_repeat_profile AS (\n    -- Look at customers who bought product P in their first order: what percentage of them went on to make a repeat order overall?\n    SELECT \n        ol.product_id,\n        COUNT(DISTINCT ol.customer_id) AS new_customers_acquired,\n        COUNT(DISTINCT CASE WHEN max_cust_orders.total_customer_orders > 1 THEN ol.customer_id END) AS customers_who_repeated_brand,\n        ROUND(COUNT(DISTINCT CASE WHEN max_cust_orders.total_customer_orders > 1 THEN ol.customer_id END)::numeric / NULLIF(COUNT(DISTINCT ol.customer_id), 0) * 100, 2) AS brand_repeat_rate_from_first_product_pct\n    FROM order_lines ol\n    JOIN (\n        SELECT customer_id, MAX(order_sequence) AS total_customer_orders\n        FROM delivered_orders\n        GROUP BY customer_id\n    ) max_cust_orders ON ol.customer_id = max_cust_orders.customer_id\n    WHERE ol.order_sequence = 1\n    GROUP BY ol.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    cps.total_unique_buyers,\n    cps.first_order_buyers,\n    cps.repeat_order_buyers,\n    ROUND(cps.repeat_order_buyers::numeric / NULLIF(cps.total_unique_buyers, 0) * 100, 2) AS repeat_buyer_share_pct,\n    cps.total_delivered_orders,\n    cps.first_orders_count,\n    cps.repeat_orders_count,\n    ROUND(cps.repeat_orders_count::numeric / NULLIF(cps.total_delivered_orders, 0) * 100, 2) AS repeat_order_share_pct,\n    crp.new_customers_acquired,\n    crp.customers_who_repeated_brand,\n    crp.brand_repeat_rate_from_first_product_pct\nFROM public.products p\nLEFT JOIN customer_product_stats cps ON p.product_id = cps.product_id\nLEFT JOIN customer_repeat_profile crp ON p.product_id = crp.product_id\nORDER BY cps.total_delivered_orders DESC NULLS LAST;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42601', 'M': 'syntax error at or near \"do\"', 'P': '441', 'F': 'scan.l', 'L': '1244', 'R': 'scanner_yyerror'}"}
{"t": 1792405387.1607754, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_orders AS (\n    SELECT \n        o.customer_id,\n        o.order_id,\n        o.order_date,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        co.customer_id,\n        co.order_id,\n        co.order_seq\n    FROM customer_orders co\n    JOIN public.order_items oi ON co.order_id = oi.order_id\n),\nproduct_first_order_customers AS (\n    SELECT \n        product_id,\n        customer_id\n    FROM product_orders\n    WHERE order_seq = 1\n    GROUP BY product_id, customer_id\n),\ncustomer_repeat_flag AS (\n    SELECT \n        customer_id,\n        MAX(CASE WHEN order_seq > 1 THEN 1 ELSE 0 END) AS has_repeated\n    FROM customer_orders\n    GROUP BY customer_id\n),\nfirst_order_stats AS (\n    SELECT \n        foc.product_id,\n        COUNT(DISTINCT foc.customer_id) AS acquisition_customers,\n        COUNT(DISTINCT CASE WHEN crf.has_repeated = 1 THEN foc.customer_id END) AS acquired_customers_who_repeated,\n        ROUND(COUNT(DISTINCT CASE WHEN crf.has_repeated = 1 THEN foc.customer_id END)::numeric / NULLIF(COUNT(DISTINCT foc.customer_id), 0) * 100, 2) AS post_acquisition_repeat_rate_pct\n    FROM product_first_order_customers foc\n    JOIN customer_repeat_flag crf ON foc.customer_id = crf.customer_id\n    GROUP BY foc.product_id\n),\nproduct_buyer_mix AS (\n    SELECT \n        po.product_id,\n        COUNT(DISTINCT po.customer_id) AS total_unique_buyers,\n        COUNT(DISTINCT CASE WHEN po.order_seq = 1 THEN po.customer_id END) AS buyers_on_first_order,\n        COUNT(DISTINCT CASE WHEN po.order_seq > 1 THEN po.customer_id END) AS buyers_on_repeat_order,\n        ROUND(COUNT(DISTINCT CASE WHEN po.order_seq > 1 THEN po.customer_id END)::numeric / NULLIF(COUNT(DISTINCT po.customer_id), 0) * 100, 2) AS repeat_buyer_share_pct\n    FROM product_orders po\n    GROUP BY po.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    pbm.total_unique_buyers,\n    pbm.buyers_on_first_order,\n    pbm.buyers_on_repeat_order,\n    pbm.repeat_buyer_share_pct,\n    COALESCE(fos.acquisition_customers, 0) AS acquisition_customers,\n    COALESCE(fos.acquired_customers_who_repeated, 0) AS acquired_customers_who_repeated,\n    COALESCE(fos.post_acquisition_repeat_rate_pct, 0.00) AS post_acquisition_repeat_rate_pct\nFROM public.products p\nLEFT JOIN product_buyer_mix pbm ON p.product_id = pbm.product_id\nLEFT JOIN first_order_stats fos ON p.product_id = fos.product_id\nORDER BY p.product_id;", "rows": 17, "error": null}
{"t": 1792407056.6074042, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_items AS (\n    SELECT \n        oi.product_id,\n        SUM(oi.quantity) AS delivered_units,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY oi.product_id\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'cancelled' THEN o.order_id END) AS cancelled_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) * 100)::numeric, 2) AS list_margin_pct,\n    COALESCE(di.delivered_units, 0) AS delivered_units,\n    ROUND(COALESCE(di.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND(COALESCE(di.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((COALESCE(di.gross_profit, 0) / NULLIF(di.net_revenue, 0) * 100)::numeric, 2) AS realized_margin_pct,\n    ROUND(COALESCE(di.discount_cost, 0)::numeric, 2) AS discount_cost,\n    COALESCE(po.total_orders, 0) AS total_orders,\n    COALESCE(po.returned_orders, 0) AS returned_orders,\n    ROUND((COALESCE(po.returned_orders, 0)::numeric / NULLIF(po.total_orders, 0) * 100)::numeric, 2) AS return_rate_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating\nFROM public.products p\nLEFT JOIN delivered_items di ON p.product_id = di.product_id\nLEFT JOIN product_orders po ON p.product_id = po.product_id\nLEFT JOIN product_reviews pr ON p.product_id = pr.product_id\nORDER BY di.net_revenue DESC NULLS LAST;", "rows": 17, "error": null}
{"t": 1792407064.5753856, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    se.product_id,\n    p.product_name,\n    p.category,\n    se.event_type,\n    se.start_date,\n    se.end_date,\n    CASE \n        WHEN se.end_date IS NULL THEN 'Ongoing / Active'\n        ELSE (se.end_date - se.start_date + 1)::text || ' days'\n    END AS duration\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nORDER BY se.start_date DESC, se.product_id;", "rows": 3, "error": null}
{"t": 1792407740.9293296, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH item_metrics AS (\n    SELECT\n        p.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) * 100)::numeric, 2) AS list_margin_pct,\n        SUM(oi.quantity) AS units_sold,\n        ROUND(SUM(oi.quantity * oi.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND((100.0 * (1 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))))::numeric, 2) AS realized_margin_pct,\n        ROUND(((((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) - (1 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0)))) * 100)::numeric, 2) AS margin_gap_pct_pts,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price))::numeric, 2) AS discount_cost\n    FROM public.products p\n    LEFT JOIN public.order_items oi ON p.product_id = oi.product_id\n    LEFT JOIN public.orders o ON oi.order_id = o.order_id\n    LEFT JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE (o.status = 'delivered' OR o.status IS NULL)\n      AND (c.is_internal = false OR c.is_internal IS NULL)\n    GROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nportfolio_totals AS (\n    SELECT\n        SUM(units_sold) AS total_units,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit,\n        ROUND((100.0 * (1 - (SUM(units_sold * unit_cost) / NULLIF(SUM(net_revenue), 0))))::numeric, 2) AS portfolio_realized_margin_pct\n    FROM item_metrics\n)\nSELECT\n    im.product_id,\n    im.product_name,\n    im.category,\n    im.list_price,\n    im.unit_cost,\n    im.list_margin_pct,\n    im.units_sold,\n    ROUND((100.0 * im.units_sold / NULLIF(pt.total_units, 0))::numeric, 2) AS unit_share_pct,\n    im.net_revenue,\n    ROUND((100.0 * im.net_revenue / NULLIF(pt.total_net_revenue, 0))::numeric, 2) AS revenue_share_pct,\n    im.gross_profit,\n    ROUND((100.0 * im.gross_profit / NULLIF(pt.total_gross_profit, 0))::numeric, 2) AS gross_profit_share_pct,\n    im.realized_margin_pct,\n    im.margin_gap_pct_pts,\n    im.discount_cost\nFROM item_metrics im\nCROSS JOIN portfolio_totals pt\nORDER BY im.net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792407749.9926264, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH item_metrics AS (\n    SELECT\n        p.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) * 100)::numeric, 2) AS list_margin_pct,\n        SUM(oi.quantity) AS units_sold,\n        ROUND(SUM(oi.quantity * oi.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND((100.0 * (1 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))))::numeric, 2) AS realized_margin_pct,\n        ROUND(((((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)) * 100) - (100.0 * (1 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0)))))::numeric, 2) AS margin_gap_pct_pts,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price))::numeric, 2) AS discount_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\ncatalog_totals AS (\n    SELECT\n        SUM(units_sold) AS total_units,\n        SUM(net_revenue) AS total_revenue,\n        SUM(gross_profit) AS total_gross_profit,\n        SUM(discount_cost) AS total_discount_cost,\n        ROUND((100.0 * (total_gross_profit / NULLIF(total_revenue, 0)))::numeric, 2) AS catalog_realized_margin_pct\n    FROM (\n        SELECT\n            SUM(oi.quantity) AS units_sold,\n            SUM(oi.quantity * oi.unit_price) AS net_revenue,\n            SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n            SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n        FROM public.order_items oi\n        JOIN public.orders o ON oi.order_id = o.order_id\n        JOIN public.customers c ON o.customer_id = c.customer_id\n        JOIN public.products p ON oi.product_id = p.product_id\n        WHERE o.status = 'delivered'\n          AND c.is_internal = false\n    ) t\n)\nSELECT\n    im.product_id,\n    im.product_name,\n    im.category,\n    im.list_price,\n    im.unit_cost,\n    im.list_margin_pct,\n    im.units_sold,\n    ROUND((100.0 * im.units_sold / ct.total_units)::numeric, 2) AS unit_share_pct,\n    im.net_revenue,\n    ROUND((100.0 * im.net_revenue / ct.total_revenue)::numeric, 2) AS revenue_share_pct,\n    im.gross_profit,\n    ROUND((100.0 * im.gross_profit / ct.total_gross_profit)::numeric, 2) AS gross_profit_share_pct,\n    im.realized_margin_pct,\n    im.margin_gap_pct_pts,\n    im.discount_cost,\n    ROUND((100.0 * im.discount_cost / ct.total_discount_cost)::numeric, 2) AS discount_cost_share_pct\nFROM item_metrics im\nCROSS JOIN catalog_totals ct\nORDER BY im.net_revenue DESC;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42703', 'M': 'column \"total_gross_profit\" does not exist', 'P': '1525', 'F': 'parse_relation.c', 'L': '3716', 'R': 'errorMissingColumn'}"}
{"t": 1792407757.7410138, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_items AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\ntotals AS (\n    SELECT\n        SUM(quantity) AS total_units,\n        SUM(quantity * unit_price) AS total_net_rev,\n        SUM(quantity * (unit_price - unit_cost)) AS total_gp\n    FROM delivered_items\n),\nprod_metrics AS (\n    SELECT\n        di.product_id,\n        di.product_name,\n        di.category,\n        di.list_price,\n        di.unit_cost,\n        ROUND((((di.list_price - di.unit_cost) / NULLIF(di.list_price, 0)) * 100)::numeric, 2) AS list_margin_pct,\n        SUM(di.quantity) AS units_sold,\n        ROUND(SUM(di.quantity * di.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(di.quantity * (di.unit_price - di.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND((100.0 * SUM(di.quantity * (di.unit_price - di.unit_cost)) / NULLIF(SUM(di.quantity * di.unit_price), 0))::numeric, 2) AS realized_margin_pct,\n        ROUND(((((di.list_price - di.unit_cost) / NULLIF(di.list_price, 0)) * 100) - (100.0 * SUM(di.quantity * (di.unit_price - di.unit_cost)) / NULLIF(SUM(di.quantity * di.unit_price), 0)))::numeric, 2) AS margin_gap_pct_pts,\n        ROUND(SUM(di.quantity * (di.list_price - di.unit_price))::numeric, 2) AS discount_cost,\n        ROUND((100.0 * SUM(di.quantity) / t.total_units)::numeric, 2) AS unit_share_pct,\n        ROUND((100.0 * SUM(di.quantity * di.unit_price) / t.total_net_rev)::numeric, 2) AS revenue_share_pct,\n        ROUND((100.0 * SUM(di.quantity * (di.unit_price - di.unit_cost)) / t.total_gp)::numeric, 2) AS gross_profit_share_pct\n    FROM delivered_items di\n    CROSS JOIN totals t\n    GROUP BY di.product_id, di.product_name, di.category, di.list_price, di.unit_cost, t.total_units, t.total_net_rev, t.total_gp\n)\nSELECT *\nFROM prod_metrics\nORDER BY net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792407765.2375636, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_items AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\ntotals AS (\n    SELECT\n        SUM(quantity) AS total_units,\n        SUM(quantity * unit_price) AS total_net_rev,\n        SUM(quantity * (unit_price - unit_cost)) AS total_gp\n    FROM delivered_items\n),\nby_product AS (\n    SELECT\n        di.product_id,\n        di.product_name,\n        di.category,\n        di.list_price,\n        di.unit_cost,\n        ROUND((((di.list_price - di.unit_cost) / NULLIF(di.list_price, 0)) * 100)::numeric, 2) AS list_margin_pct,\n        SUM(di.quantity) AS units_sold,\n        ROUND(SUM(di.quantity * di.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(di.quantity * (di.unit_price - di.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND((100 * (1 - SUM(di.quantity * di.unit_cost) / NULLIF(SUM(di.quantity * di.unit_price), 0)))::numeric, 2) AS realized_margin_pct,\n        ROUND((((di.list_price - di.unit_cost) / NULLIF(di.list_price, 0) * 100) - (100 * (1 - SUM(di.quantity * di.unit_cost) / NULLIF(SUM(di.quantity * di.unit_price), 0))))::numeric, 2) AS margin_gap_pct_pts,\n        ROUND(SUM(di.quantity * (di.list_price - di.unit_price))::numeric, 2) AS discount_cost,\n        ROUND((100.0 * SUM(di.quantity) / (SELECT total_units FROM totals))::numeric, 2) AS unit_share_pct,\n        ROUND((100.0 * SUM(di.quantity * di.unit_price) / (SELECT total_net_rev FROM totals))::numeric, 2) AS revenue_share_pct,\n        ROUND((100.0 * SUM(di.quantity * (di.unit_price - di.unit_cost)) / (SELECT total_gp FROM totals))::numeric, 2) AS gross_profit_share_pct\n    FROM delivered_items di\n    GROUP BY di.product_id, di.product_name, di.category, di.list_price, di.unit_cost\n)\nSELECT * FROM by_product\nORDER BY net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792407798.485198, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_scope AS (\n    SELECT customer_id FROM public.customers WHERE is_internal = false\n),\norder_scope AS (\n    SELECT o.order_id, o.customer_id, o.status\n    FROM public.orders o\n    JOIN customer_scope c ON o.customer_id = c.customer_id\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT oi.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN os.status = 'delivered' THEN oi.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN os.status = 'returned' THEN oi.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN os.status = 'cancelled' THEN oi.order_id END) AS cancelled_orders,\n        SUM(oi.quantity) AS total_units_ordered,\n        SUM(CASE WHEN os.status = 'delivered' THEN oi.quantity ELSE 0 END) AS delivered_units,\n        SUM(CASE WHEN os.status = 'returned' THEN oi.quantity ELSE 0 END) AS returned_units,\n        SUM(CASE WHEN os.status = 'cancelled' THEN oi.quantity ELSE 0 END) AS cancelled_units\n    FROM public.order_items oi\n    JOIN order_scope os ON oi.order_id = os.order_id\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(*) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        COUNT(CASE WHEN r.rating >= 4 THEN 1 END) AS positive_reviews,\n        COUNT(CASE WHEN r.rating <= 2 THEN 1 END) AS negative_reviews,\n        ROUND((COUNT(CASE WHEN r.rating >= 4 THEN 1 END) * 100.0 / NULLIF(COUNT(*), 0))::numeric, 2) AS positive_review_pct\n    FROM public.reviews r\n    JOIN customer_scope c ON r.customer_id = c.customer_id\n    GROUP BY r.product_id\n),\nproduct_stock AS (\n    SELECT \n        product_id,\n        COUNT(*) AS total_stock_events,\n        STRING_AGG(DISTINCT event_type, ', ') AS event_types,\n        SUM(end_date - start_date + 1) AS total_stock_event_days\n    FROM public.stock_events\n    GROUP BY product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating,\n    COALESCE(pr.positive_review_pct, 0) AS positive_review_pct,\n    COALESCE(po.delivered_units, 0) AS delivered_units,\n    COALESCE(po.returned_units, 0) AS returned_units,\n    ROUND((COALESCE(po.returned_units, 0) * 100.0 / NULLIF(COALESCE(po.delivered_units, 0) + COALESCE(po.returned_units, 0), 0))::numeric, 2) AS return_rate_pct,\n    ROUND((COALESCE(po.returned_orders, 0) * 100.0 / NULLIF(COALESCE(po.delivered_orders, 0) + COALESCE(po.returned_orders, 0), 0))::numeric, 2) AS order_return_rate_pct,\n    COALESCE(ps.total_stock_events, 0) AS stock_event_count,\n    COALESCE(ps.total_stock_event_days, 0) AS stock_event_days,\n    ps.event_types\nFROM public.products p\nLEFT JOIN product_orders po ON p.product_id = po.product_id\nLEFT JOIN product_reviews pr ON p.product_id = pr.product_id\nLEFT JOIN product_stock ps ON p.product_id = ps.product_id\nORDER BY delivered_units DESC;\n", "rows": 17, "error": null}
{"t": 1792407824.1651886, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH customer_orders AS (\n    SELECT\n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\norder_items_enhanced AS (\n    SELECT\n        oi.order_id,\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.product_name,\n        p.category,\n        co.customer_id,\n        co.order_seq,\n        CASE WHEN co.order_seq = 1 THEN 'new' ELSE 'repeat' END AS customer_type\n    FROM public.order_items oi\n    JOIN customer_orders co ON oi.order_id = co.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n),\nproduct_cust_stats AS (\n    SELECT\n        product_id,\n        product_name,\n        category,\n        COUNT(DISTINCT customer_id) AS total_customers,\n        COUNT(DISTINCT CASE WHEN customer_type = 'new' THEN customer_id END) AS new_customers,\n        COUNT(DISTINCT CASE WHEN customer_type = 'repeat' THEN customer_id END) AS repeat_customers,\n        SUM(quantity) AS total_units,\n        SUM(CASE WHEN customer_type = 'new' THEN quantity ELSE 0 END) AS units_to_new,\n        SUM(CASE WHEN customer_type = 'repeat' THEN quantity ELSE 0 END) AS units_to_repeat,\n        ROUND(SUM(quantity * unit_price)::numeric, 2) AS total_net_revenue,\n        ROUND(SUM(CASE WHEN customer_type = 'new' THEN quantity * unit_price ELSE 0 END)::numeric, 2) AS net_revenue_new,\n        ROUND(SUM(CASE WHEN customer_type = 'repeat' THEN quantity * unit_price ELSE 0 END)::numeric, 2) AS net_revenue_repeat\n    FROM order_items_enhanced\n    GROUP BY product_id, product_name, category\n)\nSELECT\n    product_id,\n    product_name,\n    category,\n    total_customers,\n    new_customers,\n    repeat_customers,\n    ROUND((new_customers::numeric / NULLIF(total_customers, 0) * 100), 2) AS new_cust_share_pct,\n    ROUND((repeat_customers::numeric / NULLIF(total_customers, 0) * 100), 2) AS repeat_cust_share_pct,\n    total_units,\n    units_to_new,\n    units_to_repeat,\n    ROUND((units_to_new::numeric / NULLIF(total_units, 0) * 100), 2) AS units_to_new_pct,\n    ROUND((units_to_repeat::numeric / NULLIF(total_units, 0) * 100), 2) AS units_to_repeat_pct,\n    total_net_revenue,\n    net_revenue_new,\n    net_revenue_repeat,\n    ROUND((net_revenue_new / NULLIF(total_net_revenue, 0) * 100)::numeric, 2) AS revenue_new_pct,\n    ROUND((net_revenue_repeat / NULLIF(total_net_revenue, 0) * 100)::numeric, 2) AS revenue_repeat_pct\nFROM product_cust_stats\nORDER BY total_net_revenue DESC;\n", "rows": 17, "error": null}
{"t": 1792407825.726503, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT\n        o.order_id,\n        o.customer_id\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\norder_counts AS (\n    SELECT\n        oi.order_id,\n        COUNT(DISTINCT oi.product_id) AS distinct_products_in_order,\n        SUM(oi.quantity) AS total_items_in_order\n    FROM public.order_items oi\n    JOIN delivered_orders do_ord ON oi.order_id = do_ord.order_id\n    GROUP BY oi.order_id\n),\nproduct_order_summary AS (\n    SELECT\n        oi.product_id,\n        p.product_name,\n        p.category,\n        COUNT(DISTINCT oi.order_id) AS total_orders_with_product,\n        COUNT(DISTINCT CASE WHEN oc.distinct_products_in_order > 1 THEN oi.order_id END) AS multi_product_orders,\n        COUNT(DISTINCT CASE WHEN oc.distinct_products_in_order = 1 THEN oi.order_id END) AS solo_product_orders\n    FROM public.order_items oi\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN delivered_orders do_ord ON oi.order_id = do_ord.order_id\n    JOIN order_counts oc ON oi.order_id = oc.order_id\n    GROUP BY oi.product_id, p.product_name, p.category\n),\nfirst_orders AS (\n    SELECT\n        o.customer_id,\n        o.order_id\n    FROM (\n        SELECT\n            o.customer_id,\n            o.order_id,\n            ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) as rn\n        FROM public.orders o\n        JOIN public.customers c ON o.customer_id = c.customer_id\n        WHERE o.status = 'delivered' AND c.is_internal = false\n    ) o\n    WHERE o.rn = 1\n),\nfirst_order_products AS (\n    SELECT\n        oi.product_id,\n        COUNT(DISTINCT fo.customer_id) AS acquired_customers_count\n    FROM first_orders fo\n    JOIN public.order_items oi ON fo.order_id = oi.order_id\n    GROUP BY oi.product_id\n),\ncust_total_orders AS (\n    SELECT\n        o.customer_id,\n        COUNT(DISTINCT o.order_id) AS lifetime_orders\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered' AND c.is_internal = false\n    GROUP BY o.customer_id\n),\nfirst_product_repeat AS (\n    SELECT\n        oi.product_id,\n        COUNT(DISTINCT fo.customer_id) AS buyers_first_order,\n        COUNT(DISTINCT CASE WHEN cto.lifetime_orders > 1 THEN fo.customer_id END) AS buyers_who_repeated\n    FROM first_orders fo\n    JOIN public.order_items oi ON fo.order_id = oi.order_id\n    JOIN cust_total_orders cto ON fo.customer_id = cto.customer_id\n    GROUP BY oi.product_id\n)\nSELECT\n    pos.product_id,\n    pos.product_name,\n    pos.category,\n    pos.total_orders_with_product,\n    pos.multi_product_orders,\n    pos.solo_product_orders,\n    ROUND((pos.multi_product_orders::numeric / NULLIF(pos.total_orders_with_product, 0) * 100), 2) AS cross_sell_attachment_rate_pct,\n    COALESCE(fpr.buyers_first_order, 0) AS first_order_acquisitions,\n    COALESCE(fpr.buyers_who_repeated, 0) AS first_order_repeaters,\n    ROUND((COALESCE(fpr.buyers_who_repeated, 0)::numeric / NULLIF(fpr.buyers_first_order, 0) * 100), 2) AS repeat_rate_after_first_order_pct\nFROM product_order_summary pos\nLEFT JOIN first_product_repeat fpr ON pos.product_id = fpr.product_id\nORDER BY pos.total_orders_with_product DESC;\n", "rows": 17, "error": null}
{"t": 1792409483.3041995, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH product_sales AS (\n    SELECT \n        p.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)::numeric, 4) AS list_margin,\n        COUNT(DISTINCT oi.order_id) AS delivered_orders_count,\n        SUM(oi.quantity) AS units_sold,\n        ROUND(SUM(oi.quantity * oi.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * p.unit_cost)::numeric, 2) AS total_cost,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND(1.0 - (SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))::numeric, 4) AS realized_margin,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price))::numeric, 2) AS discount_cost\n    FROM public.products p\n    LEFT JOIN public.order_items oi ON p.product_id = oi.product_id\n    LEFT JOIN public.orders o ON oi.order_id = o.order_id\n    LEFT JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE (c.is_internal IS FALSE OR c.is_internal IS NULL)\n      AND (o.status = 'delivered' OR o.status IS NULL)\n    GROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\ntotals AS (\n    SELECT \n        SUM(units_sold) AS total_units_sold,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit\n    FROM product_sales\n)\nSELECT \n    ps.product_id,\n    ps.product_name,\n    ps.category,\n    ps.list_price,\n    ps.unit_cost,\n    ps.list_margin,\n    ps.delivered_orders_count,\n    ps.units_sold,\n    ps.net_revenue,\n    ps.total_cost,\n    ps.gross_profit,\n    ps.realized_margin,\n    ps.discount_cost,\n    ROUND((ps.list_margin - ps.realized_margin)::numeric, 4) AS margin_gap,\n    ROUND((ps.net_revenue / NULLIF(t.total_net_revenue, 0) * 100)::numeric, 2) AS revenue_share_pct,\n    ROUND((ps.units_sold / NULLIF(t.total_units_sold, 0) * 100)::numeric, 2) AS units_share_pct,\n    ROUND((ps.gross_profit / NULLIF(t.total_gross_profit, 0) * 100)::numeric, 2) AS profit_share_pct\nFROM product_sales ps\nCROSS JOIN totals t\nORDER BY ps.net_revenue DESC NULLS LAST;", "rows": 17, "error": null}
{"t": 1792409491.1749532, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH product_sales AS (\n    SELECT \n        p.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0)::numeric, 4) AS list_margin,\n        COUNT(DISTINCT oi.order_id) AS delivered_orders_count,\n        SUM(oi.quantity) AS units_sold,\n        ROUND(SUM(oi.quantity * oi.unit_price)::numeric, 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * p.unit_cost)::numeric, 2) AS total_cost,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost))::numeric, 2) AS gross_profit,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / NULLIF(SUM(oi.quantity * oi.unit_price), 0)::numeric, 4) AS realized_margin,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price))::numeric, 2) AS discount_cost,\n        ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) - SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / NULLIF(SUM(oi.quantity * oi.unit_price), 0))::numeric, 4) AS margin_gap\n    FROM public.products p\n    JOIN public.order_items oi ON p.product_id = oi.product_id\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\ntotals AS (\n    SELECT \n        SUM(units_sold) AS total_units,\n        SUM(net_revenue) AS total_revenue,\n        SUM(gross_profit) AS total_profit\n    FROM product_sales\n)\nSELECT \n    ps.product_id,\n    ps.product_name,\n    ps.category,\n    ps.list_price,\n    ps.unit_cost,\n    ps.list_margin,\n    ps.delivered_orders_count,\n    ps.units_sold,\n    ps.net_revenue,\n    ps.total_cost,\n    ps.gross_profit,\n    ps.realized_margin,\n    ps.discount_cost,\n    ps.margin_gap,\n    ROUND((ps.net_revenue / t.total_revenue * 100)::numeric, 2) AS revenue_share_pct,\n    ROUND((ps.units_sold / t.total_units * 100)::numeric, 2) AS units_share_pct,\n    ROUND((ps.gross_profit / t.total_profit * 100)::numeric, 2) AS profit_share_pct\nFROM product_sales ps\nCROSS JOIN totals t\nORDER BY ps.net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792409983.4158156, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT o.order_id, o.customer_id, o.order_date, o.status\n    FROM orders o\n    JOIN customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n),\norder_item_metrics AS (\n    SELECT \n        oi.product_id,\n        -- Total ordered units (all statuses except internal)\n        SUM(oi.quantity) AS total_units_ordered,\n        -- Delivered units & revenue\n        SUM(CASE WHEN nio.status = 'delivered' THEN oi.quantity ELSE 0 END) AS units_sold,\n        SUM(CASE WHEN nio.status = 'delivered' THEN oi.quantity * oi.unit_price ELSE 0 END) AS net_revenue,\n        SUM(CASE WHEN nio.status = 'delivered' THEN oi.quantity * p.unit_cost ELSE 0 END) AS total_cogs,\n        SUM(CASE WHEN nio.status = 'delivered' THEN oi.quantity * (oi.unit_price - p.unit_cost) ELSE 0 END) AS gross_profit,\n        -- Returned units\n        SUM(CASE WHEN nio.status = 'returned' THEN oi.quantity ELSE 0 END) AS units_returned,\n        -- Total valid units for return rate denominator (delivered + returned, or all non-cancelled)\n        SUM(CASE WHEN nio.status IN ('delivered', 'returned') THEN oi.quantity ELSE 0 END) AS units_delivered_or_returned\n    FROM order_items oi\n    JOIN non_internal_orders nio ON oi.order_id = nio.order_id\n    JOIN products p ON oi.product_id = p.product_id\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM reviews r\n    JOIN customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0))::numeric, 4) AS list_margin,\n    COALESCE(oim.units_sold, 0) AS units_sold,\n    ROUND(COALESCE(oim.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND(COALESCE(oim.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((COALESCE(oim.gross_profit, 0) / NULLIF(oim.net_revenue, 0))::numeric, 4) AS realized_margin,\n    COALESCE(oim.units_returned, 0) AS units_returned,\n    ROUND((COALESCE(oim.units_returned, 0)::numeric / NULLIF(oim.units_delivered_or_returned, 0))::numeric, 4) AS return_rate,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating\nFROM products p\nLEFT JOIN order_item_metrics oim ON p.product_id = oim.product_id\nLEFT JOIN product_reviews pr ON p.product_id = pr.product_id\nORDER BY net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792411382.03176, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH max_order AS (\n    SELECT MAX(order_date) AS max_date FROM public.orders\n),\ncohort_calc AS (\n    SELECT \n        max_date,\n        max_date - INTERVAL '90 days' AS cutoff_raw,\n        -- Round down to the end of the last complete calendar month\n        DATE_TRUNC('month', max_date - INTERVAL '90 days') - INTERVAL '1 day' AS cohort_end_date\n    FROM max_order\n)\nSELECT \n    c.max_date,\n    c.cutoff_raw::date AS cutoff_raw_date,\n    c.cohort_end_date::date AS cohort_end_date,\n    '2025-01-01'::date AS cohort_start_date\nFROM cohort_calc c;", "rows": 1, "error": null}
{"t": 1792411383.3811166, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH cohort_dates AS (\n    SELECT \n        '2025-01-01'::date AS start_date,\n        (DATE_TRUNC('month', (SELECT MAX(order_date) FROM public.orders) - INTERVAL '90 days') - INTERVAL '1 day')::date AS end_date\n),\nspend_by_channel AS (\n    SELECT \n        s.channel,\n        SUM(s.spend_usd) AS total_spend_usd\n    FROM public.marketing_spend s\n    JOIN cohort_dates cd ON s.month >= cd.start_date AND s.month <= cd.end_date\n    GROUP BY s.channel\n),\nsignups_by_channel AS (\n    SELECT \n        c.acquisition_channel AS channel,\n        COUNT(*) AS signup_count\n    FROM public.customers c\n    JOIN cohort_dates cd ON c.signup_date >= cd.start_date AND c.signup_date <= cd.end_date\n    WHERE c.is_internal = false\n    GROUP BY c.acquisition_channel\n),\nchannels AS (\n    SELECT channel FROM spend_by_channel\n    UNION\n    SELECT channel FROM signups_by_channel\n),\nchannel_summary AS (\n    SELECT \n        ch.channel,\n        COALESCE(sp.total_spend_usd, 0) AS spend_usd,\n        COALESCE(su.signup_count, 0) AS signups,\n        ROUND(COALESCE(sp.total_spend_usd, 0) / NULLIF(su.signup_count, 0), 2) AS cac_per_signup\n    FROM channels ch\n    LEFT JOIN spend_by_channel sp ON ch.channel = sp.channel\n    LEFT JOIN signups_by_channel su ON ch.channel = su.channel\n),\ntotals AS (\n    SELECT \n        'ALL_CHANNELS' AS channel,\n        SUM(spend_usd) AS spend_usd,\n        SUM(signups) AS signups,\n        ROUND(SUM(spend_usd) / NULLIF(SUM(signups), 0), 2) AS cac_per_signup\n    FROM channel_summary\n)\nSELECT * FROM channel_summary\nUNION ALL\nSELECT * FROM totals\nORDER BY spend_usd DESC;", "rows": 8, "error": null}
{"t": 1792411399.0152276, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH cohort_bounds AS (\n    SELECT \n        '2025-01-01'::date AS start_date,\n        '2025-09-30'::date AS end_date,\n        90 AS window_days\n),\ncohort_customers AS (\n    SELECT \n        c.customer_id,\n        c.signup_date,\n        c.acquisition_channel,\n        (c.signup_date + INTERVAL '90 days')::date AS window_end_date\n    FROM public.customers c\n    JOIN cohort_bounds cb ON c.signup_date >= cb.start_date AND c.signup_date <= cb.end_date\n    WHERE c.is_internal = false\n),\nchannel_spend AS (\n    SELECT \n        s.channel,\n        SUM(s.spend_usd) AS spend_usd\n    FROM public.marketing_spend s\n    JOIN cohort_bounds cb ON s.month >= cb.start_date AND s.month <= cb.end_date\n    GROUP BY s.channel\n),\ncustomer_orders AS (\n    -- Delivered orders within the 90-day window from signup\n    SELECT \n        cc.customer_id,\n        cc.acquisition_channel,\n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_rev,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS order_gross_profit\n    FROM cohort_customers cc\n    JOIN public.orders o \n      ON cc.customer_id = o.customer_id \n     AND o.status = 'delivered'\n     AND o.order_date >= cc.signup_date \n     AND o.order_date <= cc.window_end_date\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    GROUP BY cc.customer_id, cc.acquisition_channel, o.order_id, o.order_date\n),\ncustomer_metrics AS (\n    SELECT \n        cc.customer_id,\n        cc.acquisition_channel,\n        COUNT(co.order_id) AS delivered_orders_count,\n        COALESCE(SUM(co.order_net_rev), 0) AS total_net_rev,\n        COALESCE(SUM(co.order_gross_profit), 0) AS total_gross_profit,\n        CASE WHEN COUNT(co.order_id) >= 2 THEN 1 ELSE 0 END AS is_repeat_buyer,\n        CASE WHEN COUNT(co.order_id) >= 1 THEN 1 ELSE 0 END AS is_buyer\n    FROM cohort_customers cc\n    LEFT JOIN customer_orders co ON cc.customer_id = co.customer_id\n    GROUP BY cc.customer_id, cc.acquisition_channel\n),\nchannel_agg AS (\n    SELECT \n        cm.acquisition_channel,\n        COUNT(cm.customer_id) AS signups,\n        SUM(cm.is_buyer) AS buyers,\n        SUM(cm.is_repeat_buyer) AS repeat_buyers,\n        SUM(cm.total_net_rev) AS cohort_90d_net_rev,\n        SUM(cm.total_gross_profit) AS cohort_90d_gross_profit\n    FROM customer_metrics cm\n    GROUP BY cm.acquisition_channel\n),\nall_channels_agg AS (\n    SELECT \n        'ALL_CHANNELS'::text AS acquisition_channel,\n        COUNT(cm.customer_id) AS signups,\n        SUM(cm.is_buyer) AS buyers,\n        SUM(cm.is_repeat_buyer) AS repeat_buyers,\n        SUM(cm.total_net_rev) AS cohort_90d_net_rev,\n        SUM(cm.total_gross_profit) AS cohort_90d_gross_profit\n    FROM customer_metrics cm\n),\ncombined_agg AS (\n    SELECT * FROM channel_agg\n    UNION ALL\n    SELECT * FROM all_channels_agg\n),\nall_spend AS (\n    SELECT 'ALL_CHANNELS'::text AS channel, SUM(spend_usd) AS spend_usd FROM channel_spend\n    UNION ALL\n    SELECT channel, spend_usd FROM channel_spend\n)\nSELECT \n    ca.acquisition_channel AS channel,\n    ca.signups,\n    ca.buyers,\n    ca.repeat_buyers,\n    ROUND(COALESCE(asp.spend_usd, 0)::numeric, 2) AS spend_usd,\n    ROUND((COALESCE(asp.spend_usd, 0) / NULLIF(ca.signups, 0))::numeric, 2) AS cac_per_signup,\n    ROUND((ca.repeat_buyers::numeric / NULLIF(ca.signups, 0) * 100)::numeric, 2) AS repeat_rate_pct_signups,\n    ROUND((ca.repeat_buyers::numeric / NULLIF(ca.buyers, 0) * 100)::numeric, 2) AS repeat_rate_pct_buyers,\n    ROUND(ca.cohort_90d_net_rev::numeric, 2) AS cohort_90d_net_revenue,\n    ROUND((ca.cohort_90d_net_rev / NULLIF(ca.signups, 0))::numeric, 2) AS rev_per_signup,\n    ROUND(ca.cohort_90d_gross_profit::numeric, 2) AS cohort_90d_gross_profit,\n    ROUND((ca.cohort_90d_gross_profit / NULLIF(ca.signups, 0))::numeric, 2) AS gp_per_signup,\n    ROUND((ca.cohort_90d_gross_profit / NULLIF(asp.spend_usd, 0))::numeric, 2) AS gp_per_cac_dollar,\n    ROUND((ca.cohort_90d_net_rev / NULLIF(asp.spend_usd, 0))::numeric, 2) AS roas_net_rev_per_spend\nFROM combined_agg ca\nLEFT JOIN all_spend asp ON ca.acquisition_channel = asp.channel\nORDER BY \n    CASE WHEN ca.acquisition_channel = 'ALL_CHANNELS' THEN 0 ELSE 1 END,\n    gp_per_cac_dollar DESC NULLS LAST;", "rows": 8, "error": null}
{"t": 1792411409.5736468, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_channel_spend AS (\n    SELECT \n        channel,\n        month,\n        spend_usd\n    FROM public.marketing_spend\n),\nmonthly_cohort_customers AS (\n    SELECT \n        acquisition_channel AS channel,\n        DATE_TRUNC('month', signup_date)::date AS month,\n        COUNT(customer_id) AS signups\n    FROM public.customers\n    WHERE is_internal = false\n      AND signup_date >= '2025-01-01'\n      AND signup_date <= '2025-09-30'\n    GROUP BY acquisition_channel, DATE_TRUNC('month', signup_date)::date\n),\nmonthly_metrics AS (\n    SELECT \n        s.channel,\n        s.month,\n        s.spend_usd,\n        COALESCE(c.signups, 0) AS signups,\n        ROUND(s.spend_usd / NULLIF(c.signups, 0), 2) AS monthly_cac\n    FROM monthly_channel_spend s\n    LEFT JOIN monthly_cohort_customers c \n      ON s.channel = c.channel AND s.month = c.month\n    WHERE s.month >= '2025-01-01' AND s.month <= '2025-09-30'\n)\nSELECT \n    channel,\n    month,\n    spend_usd,\n    signups,\n    monthly_cac\nFROM monthly_metrics\nORDER BY channel, month;", "rows": 63, "error": null}
{"t": 1792411425.3155475, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    DATE_TRUNC('month', month)::date AS month,\n    ROUND(SUM(spend_usd), 2) AS total_spend_usd,\n    ROUND(SUM(CASE WHEN channel = 'paid_social' THEN spend_usd ELSE 0 END), 2) AS paid_social_spend,\n    ROUND(SUM(CASE WHEN channel = 'paid_search' THEN spend_usd ELSE 0 END), 2) AS paid_search_spend,\n    ROUND(SUM(CASE WHEN channel = 'influencer' THEN spend_usd ELSE 0 END), 2) AS influencer_spend,\n    ROUND(SUM(CASE WHEN channel IN ('paid_social', 'paid_search', 'influencer') THEN spend_usd ELSE 0 END), 2) AS total_paid_media_spend,\n    ROUND(SUM(CASE WHEN channel = 'paid_social' THEN spend_usd ELSE 0 END) / NULLIF(SUM(spend_usd), 0) * 100, 2) AS paid_social_spend_share_pct\nFROM public.marketing_spend\nWHERE month >= '2025-01-01' AND month <= '2025-09-30'\nGROUP BY DATE_TRUNC('month', month)::date\nORDER BY month;", "rows": 9, "error": null}
{"t": 1792411429.914965, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH paid_channels_monthly AS (\n    SELECT \n        DATE_TRUNC('month', ms.month)::date AS month,\n        ms.channel,\n        ms.spend_usd,\n        COUNT(c.customer_id) AS signups,\n        ROUND(ms.spend_usd / NULLIF(COUNT(c.customer_id), 0), 2) AS monthly_cac\n    FROM public.marketing_spend ms\n    LEFT JOIN public.customers c \n        ON c.acquisition_channel = ms.channel \n        AND c.is_internal = false \n        AND c.signup_date >= ms.month \n        AND c.signup_date < (ms.month + INTERVAL '1 month')::date\n    WHERE ms.channel IN ('paid_social', 'paid_search', 'influencer')\n      AND ms.month >= '2025-01-01' AND ms.month <= '2025-09-01'\n    GROUP BY ms.month, ms.channel, ms.spend_usd\n)\nSELECT \n    month,\n    channel,\n    spend_usd,\n    signups,\n    monthly_cac\nFROM paid_channels_monthly\nORDER BY channel, month;", "rows": 27, "error": null}
{"t": 1792411436.811897, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT\n    ROUND(SUM(spend_usd), 2) AS total_spend_2025,\n    ROUND(AVG(monthly_spend), 2) AS avg_monthly_spend,\n    ROUND(MAX(monthly_spend), 2) AS max_monthly_spend,\n    ROUND(MIN(monthly_spend), 2) AS min_monthly_spend,\n    ROUND(SUM(paid_media_spend), 2) AS total_paid_media_spend,\n    ROUND(AVG(paid_media_spend), 2) AS avg_monthly_paid_media,\n    ROUND(MAX(paid_media_spend), 2) AS max_monthly_paid_media\nFROM (\n    SELECT \n        month,\n        SUM(spend_usd) AS monthly_spend,\n        SUM(CASE WHEN channel IN ('paid_social', 'paid_search', 'influencer') THEN spend_usd ELSE 0 END) AS paid_media_spend\n    FROM public.marketing_spend\n    GROUP BY month\n) t", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42703', 'M': 'column \"spend_usd\" does not exist', 'P': '37', 'F': 'parse_relation.c', 'L': '3716', 'R': 'errorMissingColumn'}"}
{"t": 1792411443.6318464, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_paid AS (\n    SELECT \n        ms.month,\n        ms.channel,\n        ms.spend_usd,\n        COUNT(c.customer_id) AS signups,\n        ROUND(ms.spend_usd / NULLIF(COUNT(c.customer_id), 0), 2) AS monthly_cac\n    FROM public.marketing_spend ms\n    LEFT JOIN public.customers c \n        ON c.acquisition_channel = ms.channel \n        AND c.is_internal = false \n        AND c.signup_date >= ms.month \n        AND c.signup_date < (ms.month + INTERVAL '1 month')::date\n    WHERE ms.channel IN ('paid_social', 'paid_search', 'influencer')\n    GROUP BY ms.month, ms.channel, ms.spend_usd\n),\nspend_ranges AS (\n    SELECT \n        channel,\n        MIN(spend_usd) AS min_monthly_spend,\n        MAX(spend_usd) AS max_monthly_spend,\n        MIN(monthly_cac) AS min_monthly_cac,\n        MAX(monthly_cac) AS max_monthly_cac,\n        ROUND(AVG(monthly_cac), 2) AS avg_monthly_cac\n    FROM monthly_paid\n    GROUP BY channel\n),\noverall_budget AS (\n    SELECT \n        MAX(monthly_total_spend) AS max_monthly_total_spend,\n        MIN(monthly_total_spend) AS min_monthly_total_spend,\n        ROUND(AVG(monthly_total_spend), 2) AS avg_monthly_total_spend\n    FROM (\n        SELECT month, SUM(spend_usd) AS monthly_total_spend\n        FROM public.marketing_spend\n        GROUP BY month\n    ) t\n)\nSELECT \n    sr.channel,\n    sr.min_monthly_spend,\n    sr.max_monthly_spend,\n    sr.min_monthly_cac,\n    sr.max_monthly_cac,\n    sr.avg_monthly_cac,\n    ob.max_monthly_total_spend,\n    ob.min_monthly_total_spend,\n    ob.avg_monthly_total_spend\nFROM spend_ranges sr\nCROSS JOIN overall_budget ob\nORDER BY sr.channel;", "rows": 3, "error": null}
{"t": 1792411946.9149685, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT o.order_id, o.customer_id, o.order_date, o.status\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n),\norder_line_delivered AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.list_price,\n        p.unit_cost,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost,\n        (oi.quantity * (p.list_price - oi.unit_price)) AS line_discount_gap\n    FROM public.order_items oi\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n),\ndelivered_product_econ AS (\n    SELECT\n        product_id,\n        SUM(quantity) AS units_sold,\n        ROUND(SUM(line_net_revenue)::numeric, 2) AS net_revenue,\n        ROUND(SUM(line_cost)::numeric, 2) AS total_cost,\n        ROUND((SUM(line_net_revenue) - SUM(line_cost))::numeric, 2) AS gross_profit,\n        ROUND(((1.0 - (SUM(line_cost) / NULLIF(SUM(line_net_revenue), 0))) * 100)::numeric, 2) AS realized_margin_pct,\n        ROUND(SUM(line_discount_gap)::numeric, 2) AS discount_gap\n    FROM order_line_delivered\n    GROUP BY product_id\n),\nreturns_per_product AS (\n    SELECT\n        oi.product_id,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT o.order_id) AS total_non_cancelled_orders,\n        ROUND((COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END)::numeric / \n               NULLIF(COUNT(DISTINCT CASE WHEN o.status IN ('delivered', 'returned') THEN o.order_id END), 0) * 100)::numeric, 2) AS order_return_rate_pct\n    FROM public.order_items oi\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    WHERE o.status IN ('delivered', 'returned')\n    GROUP BY oi.product_id\n),\nreviews_per_product AS (\n    SELECT\n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n    GROUP BY r.product_id\n)\nSELECT\n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) * 100)::numeric, 2) AS list_margin_pct,\n    COALESCE(e.units_sold, 0) AS delivered_units,\n    COALESCE(e.net_revenue, 0) AS net_revenue,\n    COALESCE(e.gross_profit, 0) AS gross_profit,\n    COALESCE(e.realized_margin_pct, 0) AS realized_margin_pct,\n    ROUND((ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) * 100)::numeric, 2) - COALESCE(e.realized_margin_pct, 0))::numeric, 2) AS margin_erosion_pct,\n    COALESCE(e.discount_gap, 0) AS total_discount_gap,\n    COALESCE(rp.order_return_rate_pct, 0) AS return_rate_pct,\n    COALESCE(rv.review_count, 0) AS review_count,\n    COALESCE(rv.avg_rating, 0) AS avg_rating\nFROM public.products p\nLEFT JOIN delivered_product_econ e ON p.product_id = e.product_id\nLEFT JOIN returns_per_product rp ON p.product_id = rp.product_id\nLEFT JOIN reviews_per_product rv ON p.product_id = rv.product_id\nORDER BY e.net_revenue DESC NULLS LAST;", "rows": 17, "error": null}
{"t": 1792411957.1005688, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT o.order_id, o.customer_id, o.order_date, o.status\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n),\norder_line_delivered AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.list_price,\n        p.unit_cost,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost,\n        (oi.quantity * (p.list_price - oi.unit_price)) AS line_discount_gap\n    FROM public.order_items oi\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n),\nproduct_sales AS (\n    SELECT\n        product_id,\n        SUM(quantity) AS delivered_units,\n        SUM(line_net_revenue) AS net_revenue,\n        SUM(line_cost) AS total_cost,\n        SUM(line_net_revenue - line_cost) AS gross_profit,\n        SUM(line_discount_gap) AS total_discount_gap\n    FROM order_line_delivered\n    GROUP BY product_id\n),\nproduct_returns AS (\n    SELECT\n        oi.product_id,\n        COUNT(DISTINCT oi.order_id) AS total_order_count,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN oi.order_id END) AS returned_order_count,\n        SUM(oi.quantity) AS total_ordered_units,\n        SUM(CASE WHEN o.status = 'returned' THEN oi.quantity ELSE 0 END) AS returned_units\n    FROM public.order_items oi\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    WHERE o.status IN ('delivered', 'returned')\n    GROUP BY oi.product_id\n),\nproduct_reviews AS (\n    SELECT\n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n    GROUP BY r.product_id\n)\nSELECT\n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / p.list_price * 100)::numeric, 2) AS list_margin_pct,\n    COALESCE(ps.delivered_units, 0) AS delivered_units,\n    ROUND(COALESCE(ps.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND(COALESCE(ps.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((COALESCE(ps.gross_profit, 0) / NULLIF(ps.net_revenue, 0) * 100)::numeric, 2) AS realized_margin_pct,\n    ROUND((((p.list_price - p.unit_cost) / p.list_price * 100) - (COALESCE(ps.gross_profit, 0) / NULLIF(ps.net_revenue, 0) * 100))::numeric, 2) AS margin_erosion_pct,\n    ROUND(COALESCE(ps.total_discount_gap, 0)::numeric, 2) AS total_discount_gap,\n    ROUND((COALESCE(prt.returned_units, 0)::numeric / NULLIF(prt.total_ordered_units, 0) * 100)::numeric, 2) AS return_rate_pct,\n    COALESCE(prv.review_count, 0) AS review_count,\n    COALESCE(prv.avg_rating, 0) AS avg_rating\nFROM public.products p\nLEFT JOIN product_sales ps ON p.product_id = ps.product_id\nLEFT JOIN product_returns prt ON p.product_id = prt.product_id\nLEFT JOIN product_reviews prv ON p.product_id = prv.product_id\nORDER BY net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792411966.544325, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT o.order_id, o.customer_id, o.order_date, o.status\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n),\nproduct_delivered_agg AS (\n    SELECT\n        p.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        ROUND(((p.list_price - p.unit_cost) / p.list_price) * 100, 2) AS list_margin_pct,\n        SUM(oi.quantity) AS delivered_units,\n        ROUND(SUM(oi.quantity * oi.unit_price), 2) AS net_revenue,\n        ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 2) AS gross_profit,\n        ROUND((SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / SUM(oi.quantity * oi.unit_price)) * 100, 2) AS realized_margin_pct,\n        ROUND((((p.list_price - p.unit_cost) / p.list_price) - (SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / SUM(oi.quantity * oi.unit_price))) * 100, 2) AS margin_erosion_pct,\n        ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price)), 2) AS total_discount_gap\n    FROM public.products p\n    JOIN public.order_items oi ON p.product_id = oi.product_id\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    WHERE o.status = 'delivered'\n    GROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost\n),\nproduct_order_status AS (\n    SELECT\n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        ROUND(COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END)::numeric / COUNT(DISTINCT o.order_id)::numeric * 100, 2) AS return_rate_pct\n    FROM public.order_items oi\n    JOIN non_internal_orders o ON oi.order_id = o.order_id\n    GROUP BY oi.product_id\n),\nproduct_reviews_agg AS (\n    SELECT\n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating), 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n    GROUP BY r.product_id\n),\ncatalog_summary AS (\n    SELECT\n        SUM(delivered_units) AS total_delivered_units,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit\n    FROM product_delivered_agg\n)\nSELECT\n    pda.product_id,\n    pda.product_name,\n    pda.category,\n    pda.list_price,\n    pda.unit_cost,\n    pda.list_margin_pct,\n    pda.delivered_units,\n    ROUND((pda.delivered_units::numeric / cs.total_delivered_units) * 100, 2) AS unit_share_pct,\n    pda.net_revenue,\n    ROUND((pda.net_revenue / cs.total_net_revenue) * 100, 2) AS revenue_share_pct,\n    pda.gross_profit,\n    ROUND((pda.gross_profit / cs.total_gross_profit) * 100, 2) AS profit_share_pct,\n    pda.realized_margin_pct,\n    pda.margin_erosion_pct,\n    pda.total_discount_gap,\n    pos.return_rate_pct,\n    pra.review_count,\n    pra.avg_rating\nFROM product_delivered_agg pda\nCROSS JOIN catalog_summary cs\nLEFT JOIN product_order_status pos ON pda.product_id = pos.product_id\nLEFT JOIN product_reviews_agg pra ON pda.product_id = pra.product_id\nORDER BY pda.net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792411972.6613173, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    se.product_id,\n    p.product_name,\n    p.category,\n    se.event_type,\n    se.start_date,\n    se.end_date,\n    (se.end_date - se.start_date + 1) AS incident_days,\n    CASE WHEN se.end_date >= CURRENT_DATE OR se.end_date IS NULL THEN TRUE ELSE FALSE END AS is_currently_active\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nORDER BY se.start_date DESC, se.product_id;", "rows": 3, "error": null}
{"t": 1792411980.4490838, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT o.order_id, o.order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE AND o.status = 'delivered'\n),\nrecent_sales AS (\n    SELECT\n        oi.product_id,\n        SUM(CASE WHEN nio.order_date >= '2025-10-01' THEN oi.quantity ELSE 0 END) AS units_q4_2025,\n        ROUND(SUM(CASE WHEN nio.order_date >= '2025-10-01' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS net_revenue_q4_2025,\n        SUM(CASE WHEN nio.order_date >= '2025-07-01' AND nio.order_date < '2025-10-01' THEN oi.quantity ELSE 0 END) AS units_q3_2025,\n        ROUND(SUM(CASE WHEN nio.order_date >= '2025-07-01' AND nio.order_date < '2025-10-01' THEN oi.quantity * oi.unit_price ELSE 0 END), 2) AS net_revenue_q3_2025\n    FROM public.order_items oi\n    JOIN non_internal_orders nio ON oi.order_id = nio.order_id\n    GROUP BY oi.product_id\n)\nSELECT\n    p.product_id,\n    p.product_name,\n    p.category,\n    rs.units_q3_2025,\n    rs.net_revenue_q3_2025,\n    rs.units_q4_2025,\n    rs.net_revenue_q4_2025,\n    ROUND(CASE WHEN rs.units_q3_2025 > 0 THEN ((rs.units_q4_2025 - rs.units_q3_2025)::numeric / rs.units_q3_2025::numeric) * 100 ELSE NULL END, 2) AS unit_growth_q4_vs_q3_pct\nFROM public.products p\nLEFT JOIN recent_sales rs ON p.product_id = rs.product_id\nORDER BY rs.net_revenue_q4_2025 DESC NULLS LAST;", "rows": 17, "error": null}
{"t": 1792411992.5391178, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT \n        o.order_id, \n        o.customer_id, \n        o.order_date, \n        o.status,\n        c.acquisition_channel,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n),\norder_classification AS (\n    SELECT \n        order_id,\n        customer_id,\n        order_date,\n        acquisition_channel,\n        CASE WHEN order_seq = 1 THEN 'first_purchase' ELSE 'repeat_purchase' END AS purchase_type\n    FROM non_internal_orders\n),\nitem_level AS (\n    SELECT \n        oc.purchase_type,\n        oc.acquisition_channel,\n        oi.product_id,\n        p.product_name,\n        p.category,\n        oi.quantity,\n        (oi.quantity * oi.unit_price) AS line_net_revenue\n    FROM order_classification oc\n    JOIN public.order_items oi ON oc.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n),\nproduct_totals AS (\n    SELECT \n        product_id,\n        product_name,\n        category,\n        SUM(CASE WHEN purchase_type = 'first_purchase' THEN quantity ELSE 0 END) AS first_order_units,\n        SUM(CASE WHEN purchase_type = 'repeat_purchase' THEN quantity ELSE 0 END) AS repeat_order_units,\n        SUM(quantity) AS total_units,\n        ROUND(SUM(CASE WHEN purchase_type = 'first_purchase' THEN line_net_revenue ELSE 0 END), 2) AS first_order_revenue,\n        ROUND(SUM(CASE WHEN purchase_type = 'repeat_purchase' THEN line_net_revenue ELSE 0 END), 2) AS repeat_order_revenue,\n        ROUND(SUM(line_net_revenue), 2) AS total_revenue,\n        ROUND(100.0 * SUM(CASE WHEN purchase_type = 'first_purchase' THEN line_net_revenue ELSE 0 END) / NULLIF(SUM(line_net_revenue), 0), 2) AS first_order_rev_pct,\n        ROUND(100.0 * SUM(CASE WHEN purchase_type = 'repeat_purchase' THEN line_net_revenue ELSE 0 END) / NULLIF(SUM(line_net_revenue), 0), 2) AS repeat_order_rev_pct,\n        ROUND(100.0 * SUM(CASE WHEN purchase_type = 'first_purchase' THEN quantity ELSE 0 END) / NULLIF(SUM(quantity), 0), 2) AS first_order_unit_pct,\n        ROUND(100.0 * SUM(CASE WHEN purchase_type = 'repeat_purchase' THEN quantity ELSE 0 END) / NULLIF(SUM(quantity), 0), 2) AS repeat_order_unit_pct\n    FROM item_level\n    GROUP BY product_id, product_name, category\n)\nSELECT * \nFROM product_totals\nORDER BY total_revenue DESC;", "rows": 17, "error": null}
{"t": 1792411993.8241847, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH non_internal_orders AS (\n    SELECT \n        o.order_id, \n        o.customer_id, \n        o.order_date, \n        o.status,\n        c.acquisition_channel,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n),\nfirst_orders AS (\n    SELECT \n        nio.order_id,\n        nio.customer_id,\n        nio.acquisition_channel,\n        oi.product_id,\n        p.product_name,\n        oi.quantity,\n        (oi.quantity * oi.unit_price) AS line_net_revenue\n    FROM non_internal_orders nio\n    JOIN public.order_items oi ON nio.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE nio.order_seq = 1\n),\nchannel_product_agg AS (\n    SELECT \n        acquisition_channel,\n        product_id,\n        product_name,\n        SUM(quantity) AS first_purchase_units,\n        ROUND(SUM(line_net_revenue), 2) AS first_purchase_revenue,\n        ROUND(100.0 * SUM(line_net_revenue) / SUM(SUM(line_net_revenue)) OVER (PARTITION BY acquisition_channel), 2) AS channel_rev_share_pct\n    FROM first_orders\n    GROUP BY acquisition_channel, product_id, product_name\n)\nSELECT *\nFROM channel_product_agg\nORDER BY acquisition_channel, first_purchase_revenue DESC;", "rows": 119, "error": null}
{"t": 1792415314.7539022, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    p.product_id, \n    p.product_name, \n    p.category, \n    p.list_price, \n    p.unit_cost, \n    ROUND((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) * 100, 2) AS list_margin_pct, \n    COUNT(DISTINCT o.order_id) AS delivered_orders, \n    SUM(oi.quantity) AS units_sold, \n    ROUND(SUM(oi.quantity * oi.unit_price), 2) AS net_revenue, \n    ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 2) AS gross_profit, \n    ROUND((1 - SUM(oi.quantity * p.unit_cost) / NULLIF(SUM(oi.quantity * oi.unit_price), 0)) * 100, 2) AS realized_margin_pct, \n    ROUND(SUM(oi.quantity * (p.list_price - oi.unit_price)), 2) AS total_discount_given \nFROM public.products p \nJOIN public.order_items oi ON p.product_id = oi.product_id \nJOIN public.orders o ON oi.order_id = o.order_id \nJOIN public.customers c ON o.customer_id = c.customer_id \nWHERE o.status = 'delivered' AND c.is_internal = false \nGROUP BY p.product_id, p.product_name, p.category, p.list_price, p.unit_cost \nORDER BY net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792415349.1229622, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH product_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        COUNT(CASE WHEN r.rating >= 4 THEN 1 END) AS positive_reviews,\n        COUNT(CASE WHEN r.rating <= 2 THEN 1 END) AS negative_reviews\n    FROM public.reviews r\n    GROUP BY r.product_id\n),\nproduct_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'cancelled' THEN o.order_id END) AS cancelled_orders,\n        SUM(oi.quantity) AS total_units_ordered,\n        SUM(CASE WHEN o.status = 'delivered' THEN oi.quantity ELSE 0 END) AS delivered_units,\n        SUM(CASE WHEN o.status = 'returned' THEN oi.quantity ELSE 0 END) AS returned_units,\n        SUM(CASE WHEN o.status = 'cancelled' THEN oi.quantity ELSE 0 END) AS cancelled_units\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n),\nproduct_stock AS (\n    SELECT \n        product_id,\n        COUNT(*) AS stock_events_count,\n        MAX(end_date) AS latest_stock_event_end\n    FROM public.stock_events\n    GROUP BY product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0.00) AS avg_rating,\n    COALESCE(pr.positive_reviews, 0) AS positive_reviews,\n    COALESCE(pr.negative_reviews, 0) AS negative_reviews,\n    COALESCE(po.total_orders_ordered, 0) AS total_orders_ordered,\n    COALESCE(po.delivered_orders, 0) AS delivered_orders,\n    COALESCE(po.returned_orders, 0) AS returned_orders,\n    COALESCE(po.cancelled_orders, 0) AS cancelled_orders,\n    ROUND(COALESCE(po.returned_orders::numeric / NULLIF(po.delivered_orders + po.returned_orders, 0) * 100, 0), 2) AS return_rate_pct,\n    ROUND(COALESCE(po.cancelled_orders::numeric / NULLIF(po.total_orders_ordered, 0) * 100, 0), 2) AS cancellation_rate_pct,\n    COALESCE(ps.stock_events_count, 0) AS stock_events_count,\n    COALESCE(ps.latest_stock_event_end, '1970-01-01'::date) AS latest_stock_event_end\nFROM public.products p\nLEFT JOIN product_reviews pr ON p.product_id = pr.product_id\nLEFT JOIN product_orders po ON p.product_id = po.product_id\nLEFT JOIN product_stock ps ON p.product_id = ps.product_id\nORDER BY pr.avg_rating DESC NULLS LAST, review_count DESC;", "rows": 17, "error": null}
{"t": 1792415364.4775188, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COALESCE(r.review_count, 0) AS review_count,\n    COALESCE(r.avg_rating, 0) AS avg_rating,\n    COALESCE(r.positive_reviews, 0) AS positive_reviews,\n    COALESCE(r.negative_reviews, 0) AS negative_reviews,\n    o.total_orders_ordered,\n    o.delivered_orders,\n    o.returned_orders,\n    o.cancelled_orders,\n    ROUND((o.returned_orders::numeric / NULLIF(o.delivered_orders + o.returned_orders, 0)) * 100, 2) AS return_rate_pct,\n    ROUND((o.cancelled_orders::numeric / NULLIF(o.total_orders_ordered, 0)) * 100, 2) AS cancellation_rate_pct,\n    COALESCE(se.stock_events_count, 0) AS stock_events_count,\n    COALESCE(se.latest_stock_event_end, '1970-01-01') AS latest_stock_event_end\nFROM public.products p\nLEFT JOIN (\n    SELECT \n        product_id,\n        COUNT(review_id) AS review_count,\n        ROUND(AVG(rating)::numeric, 2) AS avg_rating,\n        COUNT(CASE WHEN rating >= 4 THEN 1 END) AS positive_reviews,\n        COUNT(CASE WHEN rating <= 2 THEN 1 END) AS negative_reviews\n    FROM public.reviews\n    GROUP BY product_id\n) r ON p.product_id = r.product_id\nLEFT JOIN (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.order_id) AS total_orders_ordered,\n        COUNT(DISTINCT CASE WHEN o.status = 'delivered' THEN o.order_id END) AS delivered_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'cancelled' THEN o.order_id END) AS cancelled_orders\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY oi.product_id\n) o ON p.product_id = o.product_id\nLEFT JOIN (\n    SELECT \n        product_id,\n        COUNT(*) AS stock_events_count,\n        MAX(end_date) AS latest_stock_event_end\n    FROM public.stock_events\n    GROUP BY product_id\n) se ON p.product_id = se.product_id\nORDER BY avg_rating ASC;", "rows": 17, "error": null}
{"t": 1792415383.0131981, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date ASC, o.order_id ASC) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered' AND c.is_internal = false\n),\nproduct_customer_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT do.customer_id) AS total_unique_customers,\n        COUNT(DISTINCT CASE WHEN do.order_seq = 1 THEN do.customer_id END) AS first_order_customers,\n        COUNT(DISTINCT CASE WHEN do.order_seq > 1 THEN do.customer_id END) AS repeat_order_customers,\n        COUNT(DISTINCT CASE WHEN do.order_seq = 1 THEN do.order_id END) AS first_orders_count,\n        COUNT(DISTINCT CASE WHEN do.order_seq > 1 THEN do.order_id END) AS repeat_orders_count\n    FROM public.order_items oi\n    JOIN delivered_orders do ON oi.order_id = do.order_id\n    GROUP BY oi.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    pco.total_unique_customers,\n    pco.first_order_customers,\n    pco.repeat_order_customers,\n    ROUND((pco.first_order_customers::numeric / NULLIF(pco.total_unique_customers, 0)) * 100, 2) AS first_order_cust_pct,\n    ROUND((pco.repeat_order_customers::numeric / NULLIF(pco.total_unique_customers, 0)) * 100, 2) AS repeat_order_cust_pct,\n    pco.first_orders_count,\n    pco.repeat_orders_count,\n    ROUND((pco.first_orders_count::numeric / NULLIF(pco.first_orders_count + pco.repeat_orders_count, 0)) * 100, 2) AS first_order_share_pct,\n    ROUND((pco.repeat_orders_count::numeric / NULLIF(pco.first_orders_count + pco.repeat_orders_count, 0)) * 100, 2) AS repeat_order_share_pct\nFROM public.products p\nJOIN product_customer_orders pco ON p.product_id = pco.product_id\nORDER BY pco.total_unique_customers DESC;", "rows": null, "error": "{'S': 'ERROR', 'V': 'ERROR', 'C': '42601', 'M': 'syntax error at or near \"do\"', 'P': '465', 'F': 'scan.l', 'L': '1244', 'R': 'scanner_yyerror'}"}
{"t": 1792415389.9669664, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY o.order_date, o.order_id) AS order_seq\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COUNT(DISTINCT CASE WHEN d.order_seq = 1 THEN d.customer_id END) AS first_order_buyers,\n    COUNT(DISTINCT CASE WHEN d.order_seq > 1 THEN d.customer_id END) AS repeat_order_buyers,\n    COUNT(DISTINCT d.customer_id) AS total_unique_buyers,\n    ROUND(\n        COUNT(DISTINCT CASE WHEN d.order_seq = 1 THEN d.customer_id END)::numeric / \n        NULLIF(COUNT(DISTINCT d.customer_id), 0) * 100, 2\n    ) AS first_order_buyer_pct,\n    ROUND(\n        COUNT(DISTINCT CASE WHEN d.order_seq > 1 THEN d.customer_id END)::numeric / \n        NULLIF(COUNT(DISTINCT d.customer_id), 0) * 100, 2\n    ) AS repeat_order_buyer_pct\nFROM public.products p\nJOIN public.order_items oi ON p.product_id = oi.product_id\nJOIN delivered_orders d ON oi.order_id = d.order_id\nGROUP BY p.product_id, p.product_name, p.category\nORDER BY total_unique_buyers DESC;", "rows": 17, "error": null}
{"t": 1792441134.1398983, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_items AS (\n    SELECT \n        oi.product_id,\n        SUM(oi.quantity) AS units_sold,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit,\n        SUM(oi.quantity * (p.list_price - oi.unit_price)) AS discount_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n    GROUP BY oi.product_id\n),\ncategory_totals AS (\n    SELECT \n        p.category,\n        SUM(di.units_sold) AS category_units_sold\n    FROM delivered_items di\n    JOIN public.products p ON di.product_id = p.product_id\n    GROUP BY p.category\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS total_reviews,\n        COUNT(CASE WHEN r.verified_purchase = true THEN 1 END) AS verified_reviews,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        ROUND(AVG(CASE WHEN r.verified_purchase = true THEN r.rating END)::numeric, 2) AS verified_avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    p.list_price,\n    p.unit_cost,\n    ROUND(((p.list_price - p.unit_cost) / NULLIF(p.list_price, 0) * 100)::numeric, 2) AS list_margin_pct,\n    COALESCE(di.units_sold, 0) AS units_sold,\n    ROUND(COALESCE(di.net_revenue, 0)::numeric, 2) AS net_revenue,\n    ROUND(COALESCE(di.gross_profit, 0)::numeric, 2) AS gross_profit,\n    ROUND((COALESCE(di.gross_profit, 0) / NULLIF(di.net_revenue, 0) * 100)::numeric, 2) AS realized_margin_pct,\n    ROUND((COALESCE(di.units_sold, 0)::numeric / NULLIF(ct.category_units_sold, 0) * 100)::numeric, 2) AS category_unit_share_pct,\n    COALESCE(pr.total_reviews, 0) AS total_reviews,\n    COALESCE(pr.verified_reviews, 0) AS verified_reviews,\n    COALESCE(pr.avg_rating, 0) AS avg_rating,\n    COALESCE(pr.verified_avg_rating, 0) AS verified_avg_rating,\n    -- Threshold screenings: min_realized_margin_pct >= 55, min_avg_rating >= 4.6, min_review_count >= 30, max_category_unit_share_pct <= 30\n    CASE WHEN ROUND((COALESCE(di.gross_profit, 0) / NULLIF(di.net_revenue, 0) * 100)::numeric, 2) >= 55.0 THEN true ELSE false END AS meets_margin_threshold,\n    CASE WHEN COALESCE(pr.avg_rating, 0) >= 4.60 THEN true ELSE false END AS meets_rating_threshold,\n    CASE WHEN COALESCE(pr.total_reviews, 0) >= 30 THEN true ELSE false END AS meets_review_count_threshold,\n    CASE WHEN COALESCE(pr.verified_reviews, 0) >= 30 THEN true ELSE false END AS meets_verified_review_count_threshold,\n    CASE WHEN ROUND((COALESCE(di.units_sold, 0)::numeric / NULLIF(ct.category_units_sold, 0) * 100)::numeric, 2) <= 30.0 THEN true ELSE false END AS meets_category_share_threshold\nFROM public.products p\nLEFT JOIN delivered_items di ON p.product_id = di.product_id\nLEFT JOIN category_totals ct ON p.category = ct.category\nLEFT JOIN product_reviews pr ON p.product_id = pr.product_id\nORDER BY p.category, net_revenue DESC;", "rows": 17, "error": null}
{"t": 1792484747.452735, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_items AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        p.list_price,\n        p.unit_cost,\n        oi.quantity,\n        oi.unit_price,\n        (oi.quantity * oi.unit_price) AS line_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\ncategory_totals AS (\n    SELECT \n        category,\n        SUM(quantity) AS cat_total_units\n    FROM delivered_items\n    GROUP BY category\n),\nproduct_sales AS (\n    SELECT \n        di.product_id,\n        di.product_name,\n        di.category,\n        di.list_price,\n        di.unit_cost,\n        SUM(di.quantity) AS total_units,\n        SUM(di.line_revenue) AS total_net_revenue,\n        SUM(di.line_cost) AS total_cost,\n        SUM(di.line_revenue) - SUM(di.line_cost) AS total_gross_profit,\n        ROUND((1.0 - (SUM(di.line_cost)::numeric / NULLIF(SUM(di.line_revenue), 0)::numeric)) * 100.0, 2) AS realized_margin_pct,\n        ROUND((1.0 - (di.unit_cost::numeric / NULLIF(di.list_price, 0)::numeric)) * 100.0, 2) AS list_margin_pct,\n        ROUND((SUM(di.quantity)::numeric / ct.cat_total_units::numeric) * 100.0, 2) AS category_unit_share_pct\n    FROM delivered_items di\n    JOIN category_totals ct ON di.category = ct.category\n    GROUP BY di.product_id, di.product_name, di.category, di.list_price, di.unit_cost, ct.cat_total_units\n),\nproduct_reviews AS (\n    SELECT \n        product_id,\n        COUNT(review_id) AS review_count,\n        ROUND(AVG(rating)::numeric, 2) AS avg_rating\n    FROM public.reviews\n    GROUP BY product_id\n)\nSELECT \n    ps.product_id,\n    ps.product_name,\n    ps.category,\n    ps.list_price,\n    ps.unit_cost,\n    ps.total_units,\n    ps.total_net_revenue,\n    ps.total_gross_profit,\n    ps.list_margin_pct,\n    ps.realized_margin_pct,\n    ps.category_unit_share_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0.00) AS avg_rating,\n    CASE \n        WHEN ps.realized_margin_pct >= 55.0 \n         AND COALESCE(pr.avg_rating, 0.00) >= 4.60 \n         AND COALESCE(pr.review_count, 0) >= 30 \n         AND ps.category_unit_share_pct <= 30.0 \n        THEN true \n        ELSE false \n    END AS qualifies_hidden_gem\nFROM product_sales ps\nLEFT JOIN product_reviews pr ON ps.product_id = pr.product_id\nORDER BY qualifies_hidden_gem DESC, ps.realized_margin_pct DESC, pr.avg_rating DESC;", "rows": 17, "error": null}
{"t": 1792484948.9929569, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    se.product_id,\n    p.product_name,\n    p.category,\n    se.event_type,\n    se.start_date,\n    se.end_date,\n    (se.end_date - se.start_date + 1) AS stockout_duration_days\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nORDER BY se.product_id, se.start_date;", "rows": 3, "error": null}
{"t": 1792485018.9600065, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH first_orders AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\ncustomer_first_products AS (\n    SELECT DISTINCT\n        fo.customer_id,\n        fo.first_order_date,\n        oi.product_id\n    FROM first_orders fo\n    JOIN public.orders o ON fo.customer_id = o.customer_id AND fo.first_order_date = o.order_date\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE o.status = 'delivered'\n),\ncustomer_total_orders AS (\n    SELECT \n        o.customer_id,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        SUM(oi.quantity * oi.unit_price) AS total_net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS total_gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\ncustomer_90d_metrics AS (\n    SELECT \n        fo.customer_id,\n        COUNT(DISTINCT o.order_id) AS orders_90d,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue_90d,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit_90d\n    FROM first_orders fo\n    JOIN public.orders o ON fo.customer_id = o.customer_id \n        AND o.order_date >= fo.first_order_date \n        AND o.order_date <= fo.first_order_date + INTERVAL '90 days'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n    GROUP BY fo.customer_id\n),\nproduct_cohort AS (\n    SELECT \n        cfp.product_id,\n        COUNT(DISTINCT cfp.customer_id) AS acquired_customers,\n        COUNT(DISTINCT CASE WHEN cto.total_orders > 1 THEN cfp.customer_id END) AS repeat_customers,\n        ROUND(COUNT(DISTINCT CASE WHEN cto.total_orders > 1 THEN cfp.customer_id END)::numeric / NULLIF(COUNT(DISTINCT cfp.customer_id), 0) * 100, 2) AS repeat_rate_pct,\n        ROUND(AVG(cto.total_orders)::numeric, 2) AS avg_lifetime_orders,\n        ROUND(AVG(cto.total_net_revenue)::numeric, 2) AS avg_lifetime_revenue,\n        ROUND(AVG(c90.net_revenue_90d)::numeric, 2) AS avg_90d_revenue,\n        ROUND(AVG(c90.gross_profit_90d)::numeric, 2) AS avg_90d_gross_profit\n    FROM customer_first_products cfp\n    JOIN customer_total_orders cto ON cfp.customer_id = cto.customer_id\n    LEFT JOIN customer_90d_metrics c90 ON cfp.customer_id = c90.customer_id\n    GROUP BY cfp.product_id\n),\noverall_product_orders AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.customer_id) AS total_unique_buyers,\n        COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END) AS discount_orders,\n        COUNT(DISTINCT o.order_id) AS total_orders_for_prod,\n        ROUND(COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL AND o.discount_code <> '' THEN o.order_id END)::numeric / NULLIF(COUNT(DISTINCT o.order_id), 0) * 100, 2) AS discount_order_pct\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY oi.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    COALESCE(pc.acquired_customers, 0) AS acquired_customers,\n    COALESCE(pc.repeat_customers, 0) AS repeat_customers,\n    pc.repeat_rate_pct,\n    pc.avg_lifetime_orders,\n    pc.avg_lifetime_revenue,\n    pc.avg_90d_revenue,\n    pc.avg_90d_gross_profit,\n    opo.total_unique_buyers,\n    opo.total_orders_for_prod,\n    opo.discount_orders,\n    opo.discount_order_pct\nFROM public.products p\nLEFT JOIN product_cohort pc ON p.product_id = pc.product_id\nLEFT JOIN overall_product_orders opo ON p.product_id = opo.product_id\nORDER BY pc.repeat_rate_pct DESC NULLS LAST;", "rows": 17, "error": null}
{"t": 1792485062.375221, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH first_orders AS (\n    SELECT \n        o.customer_id,\n        MIN(o.order_date) AS first_order_date\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY o.customer_id\n),\ncustomer_first_products AS (\n    SELECT DISTINCT\n        fo.customer_id,\n        fo.first_order_date,\n        oi.product_id\n    FROM first_orders fo\n    JOIN public.orders o ON fo.customer_id = o.customer_id AND fo.first_order_date = o.order_date\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    WHERE o.status = 'delivered'\n),\ncustomer_lifetime AS (\n    SELECT \n        o.customer_id,\n        COUNT(DISTINCT o.order_id) AS lifetime_orders,\n        SUM(oi.quantity * oi.unit_price) AS lifetime_revenue,\n        SUM(CASE WHEN o.order_date <= fo.first_order_date + INTERVAL '90 days' THEN oi.quantity * oi.unit_price ELSE 0 END) AS revenue_90d,\n        SUM(CASE WHEN o.order_date <= fo.first_order_date + INTERVAL '90 days' THEN (oi.quantity * oi.unit_price) - (oi.quantity * p.unit_cost) ELSE 0 END) AS gross_profit_90d\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    JOIN first_orders fo ON o.customer_id = fo.customer_id\n    WHERE o.status = 'delivered'\n    GROUP BY o.customer_id\n),\nproduct_acquisition_metrics AS (\n    SELECT \n        cfp.product_id,\n        COUNT(DISTINCT cfp.customer_id) AS acquired_customers,\n        COUNT(DISTINCT CASE WHEN cl.lifetime_orders > 1 THEN cfp.customer_id END) AS repeat_customers,\n        ROUND(COUNT(DISTINCT CASE WHEN cl.lifetime_orders > 1 THEN cfp.customer_id END)::numeric / NULLIF(COUNT(DISTINCT cfp.customer_id), 0) * 100, 2) AS repeat_rate_pct,\n        ROUND(AVG(cl.lifetime_orders)::numeric, 2) AS avg_lifetime_orders,\n        ROUND(AVG(cl.lifetime_revenue)::numeric, 2) AS avg_lifetime_revenue,\n        ROUND(AVG(cl.revenue_90d)::numeric, 2) AS avg_90d_revenue,\n        ROUND(AVG(cl.gross_profit_90d)::numeric, 2) AS avg_90d_gross_profit\n    FROM customer_first_products cfp\n    JOIN customer_lifetime cl ON cfp.customer_id = cl.customer_id\n    GROUP BY cfp.product_id\n),\nproduct_order_stats AS (\n    SELECT \n        oi.product_id,\n        COUNT(DISTINCT o.customer_id) AS total_unique_buyers,\n        COUNT(DISTINCT o.order_id) AS total_orders_for_prod,\n        COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL OR oi.discount_pct > 0 THEN o.order_id END) AS discount_orders,\n        ROUND(COUNT(DISTINCT CASE WHEN o.discount_code IS NOT NULL OR oi.discount_pct > 0 THEN o.order_id END)::numeric / COUNT(DISTINCT o.order_id) * 100, 2) AS discount_order_pct\n    FROM public.orders o\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY oi.product_id\n)\nSELECT \n    p.product_id,\n    p.product_name,\n    p.category,\n    pam.acquired_customers,\n    pam.repeat_customers,\n    pam.repeat_rate_pct,\n    pam.avg_lifetime_orders,\n    pam.avg_lifetime_revenue,\n    pam.avg_90d_revenue,\n    pam.avg_90d_gross_profit,\n    pos.total_unique_buyers,\n    pos.total_orders_for_prod,\n    pos.discount_orders,\n    pos.discount_order_pct\nFROM public.products p\nJOIN product_acquisition_metrics pam ON p.product_id = pam.product_id\nJOIN product_order_stats pos ON p.product_id = pos.product_id\nWHERE p.product_id IN ('P15', 'P14', 'P12')\nORDER BY pam.repeat_rate_pct DESC;", "rows": 3, "error": null}
{"t": 1792485471.2107005, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.unit_cost,\n        p.list_price,\n        p.category,\n        p.product_name,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nproduct_sales AS (\n    SELECT\n        product_id,\n        product_name,\n        category,\n        list_price,\n        unit_cost,\n        SUM(quantity) AS units_sold,\n        SUM(line_net_revenue) AS net_revenue,\n        SUM(line_cost) AS total_cost,\n        SUM(line_net_revenue) - SUM(line_cost) AS gross_profit,\n        ROUND((1.0 - SUM(line_cost)::numeric / NULLIF(SUM(line_net_revenue), 0)::numeric) * 100, 2) AS realized_margin_pct,\n        ROUND(((list_price - unit_cost)::numeric / NULLIF(list_price, 0)::numeric) * 100, 2) AS list_margin_pct\n    FROM delivered_lines\n    GROUP BY product_id, product_name, category, list_price, unit_cost\n),\ncategory_totals AS (\n    SELECT\n        category,\n        SUM(units_sold) AS category_units_sold,\n        SUM(net_revenue) AS category_net_revenue,\n        SUM(gross_profit) AS category_gross_profit\n    FROM product_sales\n    GROUP BY category\n),\nproduct_reviews AS (\n    SELECT\n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT\n    ps.product_id,\n    ps.product_name,\n    ps.category,\n    ps.list_price,\n    ps.unit_cost,\n    ps.units_sold,\n    ps.net_revenue,\n    ps.gross_profit,\n    ps.list_margin_pct,\n    ps.realized_margin_pct,\n    ROUND((ps.units_sold::numeric / NULLIF(ct.category_units_sold, 0)::numeric) * 100, 2) AS category_unit_share_pct,\n    ROUND((ps.net_revenue::numeric / NULLIF(ct.category_net_revenue, 0)::numeric) * 100, 2) AS category_revenue_share_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    COALESCE(pr.avg_rating, 0) AS avg_rating,\n    CASE \n        WHEN ps.realized_margin_pct >= 55.0 \n         AND COALESCE(pr.avg_rating, 0) >= 4.6 \n         AND COALESCE(pr.review_count, 0) >= 30 \n         AND (ps.units_sold::numeric / NULLIF(ct.category_units_sold, 0)::numeric) * 100 <= 30.0 \n        THEN true \n        ELSE false \n    END AS meets_thresholds\nFROM product_sales ps\nJOIN category_totals ct ON ps.category = ct.category\nLEFT JOIN product_reviews pr ON ps.product_id = pr.product_id\nORDER BY ps.category, ps.net_revenue DESC;\n", "rows": 17, "error": null}
{"t": 1792485562.667391, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.unit_cost,\n        p.list_price,\n        p.category,\n        p.product_name,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nproduct_aggregates AS (\n    SELECT\n        product_id,\n        product_name,\n        category,\n        list_price,\n        unit_cost,\n        SUM(quantity) AS units_sold,\n        SUM(line_net_revenue) AS net_revenue,\n        SUM(line_net_revenue - line_cost) AS gross_profit,\n        ROUND((list_price - unit_cost) / list_price * 100, 2) AS list_margin_pct,\n        ROUND(SUM(line_net_revenue - line_cost) / SUM(line_net_revenue) * 100, 2) AS realized_margin_pct\n    FROM delivered_lines\n    GROUP BY product_id, product_name, category, list_price, unit_cost\n),\ncategory_totals AS (\n    SELECT\n        category,\n        SUM(units_sold) AS cat_units,\n        SUM(net_revenue) AS cat_revenue\n    FROM product_aggregates\n    GROUP BY category\n),\nreview_aggregates AS (\n    SELECT\n        r.product_id,\n        COUNT(*) AS review_count,\n        ROUND(AVG(r.rating), 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT\n    pa.product_id,\n    pa.product_name,\n    pa.category,\n    pa.list_price,\n    pa.unit_cost,\n    pa.units_sold,\n    pa.net_revenue,\n    pa.gross_profit,\n    pa.list_margin_pct,\n    pa.realized_margin_pct,\n    ROUND(pa.units_sold::numeric / ct.cat_units * 100, 2) AS category_unit_share_pct,\n    ROUND(pa.net_revenue::numeric / ct.cat_revenue * 100, 2) AS category_revenue_share_pct,\n    COALESCE(ra.review_count, 0) AS review_count,\n    COALESCE(ra.avg_rating, 0) AS avg_rating,\n    CASE\n        WHEN pa.realized_margin_pct >= 55.0\n         AND COALESCE(ra.avg_rating, 0) >= 4.6\n         AND COALESCE(ra.review_count, 0) >= 30\n         AND (pa.units_sold::numeric / ct.cat_units * 100) <= 30.0\n        THEN true\n        ELSE false\n    END AS meets_thresholds\nFROM product_aggregates pa\nJOIN category_totals ct ON pa.category = ct.category\nLEFT JOIN review_aggregates ra ON pa.product_id = ra.product_id\nORDER BY pa.category, pa.product_id;", "rows": 17, "error": null}
{"t": 1792485802.6839693, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH delivered_lines AS (\n    SELECT\n        oi.product_id,\n        oi.quantity,\n        oi.unit_price,\n        p.unit_cost,\n        p.list_price,\n        p.category,\n        p.product_name,\n        (oi.quantity * oi.unit_price) AS line_net_revenue,\n        (oi.quantity * p.unit_cost) AS line_cost\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE o.status = 'delivered'\n      AND c.is_internal = false\n),\nproduct_aggregates AS (\n    SELECT\n        product_id,\n        product_name,\n        category,\n        list_price,\n        unit_cost,\n        SUM(quantity) AS units_sold,\n        SUM(line_net_revenue) AS net_revenue,\n        SUM(line_net_revenue - line_cost) AS gross_profit,\n        ROUND((SUM(line_net_revenue - line_cost)::numeric / NULLIF(SUM(line_net_revenue), 0)::numeric) * 100, 2) AS realized_margin_pct,\n        ROUND(((list_price - unit_cost)::numeric / NULLIF(list_price, 0)::numeric) * 100, 2) AS list_margin_pct\n    FROM delivered_lines\n    GROUP BY product_id, product_name, category, list_price, unit_cost\n),\ncategory_totals AS (\n    SELECT\n        category,\n        SUM(units_sold) AS cat_units,\n        SUM(net_revenue) AS cat_revenue\n    FROM product_aggregates\n    GROUP BY category\n),\nreview_aggregates AS (\n    SELECT\n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n    GROUP BY r.product_id\n)\nSELECT\n    pa.product_id,\n    pa.product_name,\n    pa.category,\n    pa.list_price,\n    pa.unit_cost,\n    pa.units_sold,\n    ROUND(pa.net_revenue, 2) AS net_revenue,\n    ROUND(pa.gross_profit, 2) AS gross_profit,\n    pa.list_margin_pct,\n    pa.realized_margin_pct,\n    ROUND((pa.units_sold::numeric / ct.cat_units::numeric) * 100, 2) AS category_unit_share_pct,\n    ROUND((pa.net_revenue::numeric / ct.cat_revenue::numeric) * 100, 2) AS category_revenue_share_pct,\n    COALESCE(ra.review_count, 0) AS review_count,\n    COALESCE(ra.avg_rating, 0) AS avg_rating,\n    CASE\n        WHEN pa.realized_margin_pct >= 55.0\n         AND COALESCE(ra.avg_rating, 0) >= 4.6\n         AND COALESCE(ra.review_count, 0) >= 30\n         AND ROUND((pa.units_sold::numeric / ct.cat_units::numeric) * 100, 2) <= 30.0\n        THEN true\n        ELSE false\n    END AS meets_thresholds\nFROM product_aggregates pa\nJOIN category_totals ct ON pa.category = ct.category\nLEFT JOIN review_aggregates ra ON pa.product_id = ra.product_id\nORDER BY meets_thresholds DESC, pa.net_revenue DESC", "rows": 17, "error": null}
{"t": 1792487210.9977589, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH order_details AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.status,\n        o.promised_days,\n        o.ship_days,\n        oi.product_id,\n        p.product_name,\n        p.category,\n        CASE WHEN o.ship_days > o.promised_days THEN 1 ELSE 0 END AS is_late,\n        CASE WHEN o.status = 'returned' THEN 1 ELSE 0 END AS is_returned,\n        CASE WHEN o.status = 'delivered' THEN 1 ELSE 0 END AS is_delivered\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n),\ncategory_orders AS (\n    SELECT \n        category,\n        COUNT(DISTINCT order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN status = 'returned' THEN order_id END) AS returned_orders,\n        ROUND(100.0 * COUNT(DISTINCT CASE WHEN status = 'returned' THEN order_id END) / NULLIF(COUNT(DISTINCT order_id), 0), 2) AS return_rate_pct,\n        COUNT(DISTINCT CASE WHEN ship_days > promised_days THEN order_id END) AS late_orders,\n        ROUND(100.0 * COUNT(DISTINCT CASE WHEN ship_days > promised_days THEN order_id END) / NULLIF(COUNT(DISTINCT order_id), 0), 2) AS late_delivery_rate_pct\n    FROM order_details\n    GROUP BY category\n),\ncategory_reviews AS (\n    SELECT \n        p.category,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        COUNT(CASE WHEN r.rating <= 2 THEN 1 END) AS negative_reviews,\n        ROUND(100.0 * COUNT(CASE WHEN r.rating <= 2 THEN 1 END) / NULLIF(COUNT(r.review_id), 0), 2) AS negative_review_pct\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    JOIN public.products p ON r.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY p.category\n)\nSELECT \n    co.category,\n    co.total_orders,\n    co.returned_orders,\n    co.return_rate_pct,\n    co.late_orders,\n    co.late_delivery_rate_pct,\n    cr.review_count,\n    cr.avg_rating,\n    cr.negative_reviews,\n    cr.negative_review_pct\nFROM category_orders co\nLEFT JOIN category_reviews cr ON co.category = cr.category\nORDER BY co.category;\n", "rows": 6, "error": null}
{"t": 1792487212.2254982, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH product_orders AS (\n    SELECT \n        oi.product_id,\n        p.product_name,\n        p.category,\n        COUNT(DISTINCT o.order_id) AS total_orders,\n        COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) AS returned_orders,\n        ROUND(100.0 * COUNT(DISTINCT CASE WHEN o.status = 'returned' THEN o.order_id END) / NULLIF(COUNT(DISTINCT o.order_id), 0), 2) AS return_rate_pct,\n        COUNT(DISTINCT CASE WHEN o.ship_days > o.promised_days THEN o.order_id END) AS late_orders,\n        ROUND(100.0 * COUNT(DISTINCT CASE WHEN o.ship_days > o.promised_days THEN o.order_id END) / NULLIF(COUNT(DISTINCT o.order_id), 0), 2) AS late_delivery_rate_pct\n    FROM public.order_items oi\n    JOIN public.orders o ON oi.order_id = o.order_id\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false AND p.category = 'Backpacks'\n    GROUP BY oi.product_id, p.product_name, p.category\n),\nproduct_reviews AS (\n    SELECT \n        r.product_id,\n        COUNT(r.review_id) AS review_count,\n        ROUND(AVG(r.rating)::numeric, 2) AS avg_rating,\n        COUNT(CASE WHEN r.rating <= 2 THEN 1 END) AS negative_reviews,\n        ROUND(100.0 * COUNT(CASE WHEN r.rating <= 2 THEN 1 END) / NULLIF(COUNT(r.review_id), 0), 2) AS negative_review_pct\n    FROM public.reviews r\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    JOIN public.products p ON r.product_id = p.product_id\n    WHERE c.is_internal = false AND p.category = 'Backpacks'\n    GROUP BY r.product_id\n)\nSELECT \n    po.product_id,\n    po.product_name,\n    po.total_orders,\n    po.returned_orders,\n    po.return_rate_pct,\n    po.late_orders,\n    po.late_delivery_rate_pct,\n    COALESCE(pr.review_count, 0) AS review_count,\n    pr.avg_rating,\n    COALESCE(pr.negative_reviews, 0) AS negative_reviews,\n    COALESCE(pr.negative_review_pct, 0.0) AS negative_review_pct\nFROM product_orders po\nLEFT JOIN product_reviews pr ON po.product_id = pr.product_id\nORDER BY po.total_orders DESC;\n", "rows": 3, "error": null}
{"t": 1792487340.4659822, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "SELECT \n    r.review_id,\n    r.product_id,\n    p.product_name,\n    r.rating,\n    r.review_date,\n    r.review_title,\n    r.review_text\nFROM public.reviews r\nJOIN public.products p ON r.product_id = p.product_id\nJOIN public.customers c ON r.customer_id = c.customer_id\nWHERE c.is_internal = false\n  AND p.category = 'Backpacks'\n  AND r.rating <= 2\nORDER BY r.review_date DESC\nLIMIT 100;", "rows": 100, "error": null}
{"t": 1792487341.8727856, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH backpack_reviews AS (\n    SELECT \n        r.review_id,\n        r.product_id,\n        p.product_name,\n        r.rating,\n        r.review_date,\n        DATE_TRUNC('month', r.review_date)::date AS review_month,\n        LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) AS full_text\n    FROM public.reviews r\n    JOIN public.products p ON r.product_id = p.product_id\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND p.category = 'Backpacks'\n)\nSELECT \n    review_month,\n    product_name,\n    COUNT(*) AS total_reviews,\n    COUNT(CASE WHEN rating <= 2 THEN 1 END) AS negative_reviews,\n    ROUND(100.0 * COUNT(CASE WHEN rating <= 2 THEN 1 END) / COUNT(*), 2) AS negative_review_pct,\n    COUNT(CASE WHEN full_text LIKE '%zipper%' OR full_text LIKE '%zip%' THEN 1 END) AS zipper_mentions,\n    COUNT(CASE WHEN full_text LIKE '%strap%' THEN 1 END) AS strap_mentions,\n    COUNT(CASE WHEN full_text LIKE '%seam%' OR full_text LIKE '%tear%' OR full_text LIKE '%rip%' OR full_text LIKE '%stitch%' THEN 1 END) AS seam_tear_mentions,\n    COUNT(CASE WHEN full_text LIKE '%water%' OR full_text LIKE '%leak%' OR full_text LIKE '%rain%' THEN 1 END) AS water_leak_mentions,\n    COUNT(CASE WHEN full_text LIKE '%late%' OR full_text LIKE '%ship%' OR full_text LIKE '%deliver%' OR full_text LIKE '%delay%' THEN 1 END) AS shipping_mentions\nFROM backpack_reviews\nGROUP BY review_month, product_name\nORDER BY review_month ASC, product_name;", "rows": 36, "error": null}
{"t": 1792487364.3521428, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH backpack_negative_reviews AS (\n    SELECT \n        r.review_id,\n        r.product_id,\n        p.product_name,\n        r.rating,\n        r.review_date,\n        DATE_TRUNC('month', r.review_date)::date AS review_month,\n        LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) AS full_text\n    FROM public.reviews r\n    JOIN public.products p ON r.product_id = p.product_id\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND p.category = 'Backpacks'\n      AND r.rating <= 2\n)\nSELECT \n    product_name,\n    COUNT(*) AS total_negative_reviews,\n    SUM(CASE WHEN full_text LIKE '%zipper%' OR full_text LIKE '%zip%' THEN 1 ELSE 0 END) AS zipper_complaints,\n    ROUND(100.0 * SUM(CASE WHEN full_text LIKE '%zipper%' OR full_text LIKE '%zip%' THEN 1 ELSE 0 END) / COUNT(*), 2) AS zipper_pct,\n    SUM(CASE WHEN full_text LIKE '%strap%' THEN 1 ELSE 0 END) AS strap_complaints,\n    ROUND(100.0 * SUM(CASE WHEN full_text LIKE '%strap%' THEN 1 ELSE 0 END) / COUNT(*), 2) AS strap_pct,\n    SUM(CASE WHEN full_text LIKE '%tear%' OR full_text LIKE '%rip%' OR full_text LIKE '%seam%' OR full_text LIKE '%stitch%' THEN 1 ELSE 0 END) AS seam_stitch_complaints,\n    ROUND(100.0 * SUM(CASE WHEN full_text LIKE '%tear%' OR full_text LIKE '%rip%' OR full_text LIKE '%seam%' OR full_text LIKE '%stitch%' THEN 1 ELSE 0 END) / COUNT(*), 2) AS seam_stitch_pct,\n    SUM(CASE WHEN full_text LIKE '%ship%' OR full_text LIKE '%delay%' OR full_text LIKE '%deliver%' OR full_text LIKE '%late%' OR full_text LIKE '%arrive%' THEN 1 ELSE 0 END) AS shipping_complaints,\n    ROUND(100.0 * SUM(CASE WHEN full_text LIKE '%ship%' OR full_text LIKE '%delay%' OR full_text LIKE '%deliver%' OR full_text LIKE '%late%' OR full_text LIKE '%arrive%' THEN 1 ELSE 0 END) / COUNT(*), 2) AS shipping_pct,\n    SUM(CASE WHEN full_text LIKE '%water%' OR full_text LIKE '%leak%' THEN 1 ELSE 0 END) AS water_leak_complaints,\n    ROUND(100.0 * SUM(CASE WHEN full_text LIKE '%water%' OR full_text LIKE '%leak%' THEN 1 ELSE 0 END) / COUNT(*), 2) AS water_leak_pct\nFROM backpack_negative_reviews\nGROUP BY product_name\nORDER BY total_negative_reviews DESC;", "rows": 2, "error": null}
{"t": 1792487396.3593774, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH monthly_trends AS (\n    SELECT \n        DATE_TRUNC('month', r.review_date)::date AS review_month,\n        p.product_name,\n        COUNT(*) AS total_reviews,\n        COUNT(CASE WHEN r.rating <= 2 THEN 1 END) AS negative_reviews,\n        ROUND(100.0 * COUNT(CASE WHEN r.rating <= 2 THEN 1 END) / NULLIF(COUNT(*), 0), 2) AS negative_review_pct,\n        COUNT(CASE WHEN LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) LIKE '%zipper%' THEN 1 END) AS zipper_mentions,\n        ROUND(100.0 * COUNT(CASE WHEN LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) LIKE '%zipper%' THEN 1 END) / NULLIF(COUNT(*), 0), 2) AS zipper_pct_of_reviews\n    FROM public.reviews r\n    JOIN public.products p ON r.product_id = p.product_id\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    WHERE c.is_internal = false\n      AND p.product_name = 'Alder Daypack 20L'\n    GROUP BY DATE_TRUNC('month', r.review_date)::date, p.product_name\n)\nSELECT \n    review_month,\n    product_name,\n    total_reviews,\n    negative_reviews,\n    negative_review_pct,\n    zipper_mentions,\n    zipper_pct_of_reviews\nFROM monthly_trends\nORDER BY review_month;", "rows": 12, "error": null}
{"t": 1792487551.6293674, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "-- Query 1: Stock events for Backpacks products\nSELECT \n    se.product_id,\n    p.product_name,\n    p.category,\n    se.event_type,\n    se.start_date,\n    se.end_date\nFROM public.stock_events se\nJOIN public.products p ON se.product_id = p.product_id\nWHERE p.category = 'Backpacks'\nORDER BY se.start_date;\n", "rows": null, "error": "Only a single SELECT is allowed."}
{"t": 1792487551.6768758, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "-- Query 2: Fulfillment performance and rating breakdown for Backpacks (late vs on-time)\nWITH reviews_orders AS (\n    SELECT \n        r.review_id,\n        r.product_id,\n        p.product_name,\n        r.rating,\n        r.review_date,\n        o.order_id,\n        o.order_date,\n        o.promised_days,\n        o.ship_days,\n        CASE WHEN o.ship_days > o.promised_days THEN 1 ELSE 0 END AS is_late,\n        CASE WHEN LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) LIKE '%zipper%' THEN 1 ELSE 0 END AS is_zipper_complaint,\n        CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END AS is_negative\n    FROM public.reviews r\n    JOIN public.products p ON r.product_id = p.product_id\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    LEFT JOIN public.orders o ON r.order_id = o.order_id\n    WHERE c.is_internal = false\n      AND p.category = 'Backpacks'\n)\nSELECT \n    product_name,\n    is_late,\n    COUNT(*) AS total_reviews,\n    ROUND(AVG(rating)::numeric, 2) AS avg_rating,\n    SUM(is_negative) AS negative_reviews,\n    ROUND(100.0 * SUM(is_negative)::numeric / NULLIF(COUNT(*), 0), 2) AS negative_review_pct,\n    SUM(is_zipper_complaint) AS zipper_complaints,\n    ROUND(100.0 * SUM(is_zipper_complaint)::numeric / NULLIF(COUNT(*), 0), 2) AS zipper_complaint_pct\nFROM reviews_orders\nGROUP BY product_name, is_late\nORDER BY product_name, is_late;\n", "rows": null, "error": "Only a single SELECT is allowed."}
{"t": 1792487551.6780584, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "-- Query 3: Overall fulfillment metrics (late order rate) for Backpacks by month in 2025\nSELECT \n    DATE_TRUNC('month', o.order_date)::date AS order_month,\n    p.product_name,\n    COUNT(DISTINCT o.order_id) AS total_orders,\n    SUM(CASE WHEN o.ship_days > o.promised_days THEN 1 ELSE 0 END) AS late_orders,\n    ROUND(100.0 * SUM(CASE WHEN o.ship_days > o.promised_days THEN 1 ELSE 0 END)::numeric / COUNT(DISTINCT o.order_id), 2) AS late_order_pct,\n    ROUND(AVG(o.ship_days)::numeric, 2) AS avg_ship_days,\n    ROUND(AVG(o.promised_days)::numeric, 2) AS avg_promised_days\nFROM public.orders o\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nJOIN public.customers c ON o.customer_id = c.customer_id\nWHERE c.is_internal = false\n  AND p.category = 'Backpacks'\nGROUP BY 1, 2\nORDER BY 1, 2;\n", "rows": null, "error": "Only a single SELECT is allowed."}
{"t": 1792487596.4352715, "brand": "479e3c12-dda8-453c-b7a0-035983eb38f5", "sql": "WITH backpack_reviews AS (\n    SELECT \n        r.review_id,\n        r.product_id,\n        p.product_name,\n        r.rating,\n        r.review_date,\n        o.order_id,\n        o.order_date,\n        o.promised_days,\n        o.ship_days,\n        CASE WHEN o.ship_days > o.promised_days THEN 1 ELSE 0 END AS is_late,\n        CASE WHEN LOWER(COALESCE(r.review_title, '') || ' ' || COALESCE(r.review_text, '')) LIKE '%zipper%' THEN 1 ELSE 0 END AS is_zipper_complaint,\n        CASE WHEN r.rating <= 2 THEN 1 ELSE 0 END AS is_negative\n    FROM public.reviews r\n    JOIN public.products p ON r.product_id = p.product_id\n    JOIN public.customers c ON r.customer_id = c.customer_id\n    LEFT JOIN public.orders o ON r.order_id = o.order_id\n    WHERE c.is_internal = false\n      AND p.category = 'Backpacks'\n)\nSELECT \n    product_name,\n    CASE WHEN is_late = 1 THEN 'Late' ELSE 'On-Time' END AS fulfillment_status,\n    COUNT(*) AS total_reviews,\n    ROUND(AVG(rating), 2) AS avg_rating,\n    SUM(is_negative) AS negative_reviews,\n    ROUND(100.0 * SUM(is_negative) / COUNT(*), 2) AS negative_pct,\n    SUM(is_zipper_complaint) AS zipper_complaints,\n    ROUND(100.0 * SUM(is_zipper_complaint) / COUNT(*), 2) AS zipper_pct\nFROM backpack_reviews\nGROUP BY product_name, is_late\nORDER BY product_name, fulfillment_status;", "rows": 6, "error": null}
