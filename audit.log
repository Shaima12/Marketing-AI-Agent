{"t": 1791809569.3916266, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    discount_code, \n    COUNT(*) AS order_count,\n    MIN(order_date) AS first_used,\n    MAX(order_date) AS last_used\nFROM public.orders\nWHERE order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY discount_code\nORDER BY order_count DESC;", "rows": 5, "error": null}
{"t": 1791811372.247939, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
