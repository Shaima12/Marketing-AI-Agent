{"t": 1791836888.7779162, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT discount_code, COUNT(*) AS order_count, MIN(order_date) AS min_date, MAX(order_date) AS max_date FROM public.orders WHERE order_date BETWEEN '2025-07-01' AND '2025-07-31' GROUP BY discount_code ORDER BY order_count DESC;", "rows": 5, "error": null}
{"t": 1791836899.0224075, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT MIN(order_date) AS min_order_date, MAX(order_date) AS max_order_date, COUNT(*) AS total_orders\nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791836952.5420387, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    CASE \n        WHEN o.order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-sale (Jul 1-10)'\n        WHEN o.order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (Jul 11-20)'\n        WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-sale (Jul 21-30)'\n        WHEN o.order_date BETWEEN '2025-07-21' AND '2025-07-31' THEN 'Post-sale (Jul 21-31)'\n    END as period,\n    COUNT(DISTINCT o.order_id) as orders,\n    COUNT(DISTINCT o.order_date) as days,\n    ROUND(COUNT(DISTINCT o.order_id)::numeric / COUNT(DISTINCT o.order_date), 2) as orders_per_day,\n    ROUND(SUM(oi.quantity * oi.unit_price), 2) as net_revenue,\n    ROUND(SUM(oi.quantity * oi.unit_price) / COUNT(DISTINCT o.order_date), 2) as net_revenue_per_day,\n    ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 2) as gross_profit,\n    ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / COUNT(DISTINCT o.order_date), 2) as gross_profit_per_day,\n    ROUND(SUM(oi.quantity * oi.unit_price) / COUNT(DISTINCT o.order_id), 2) as aov,\n    ROUND(SUM(oi.quantity * (oi.unit_price - p.unit_cost)) / SUM(oi.quantity * oi.unit_price) * 100, 2) as realized_margin_pct\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.order_items oi ON o.order_id = oi.order_id\nJOIN public.products p ON oi.product_id = p.product_id\nWHERE o.status = 'delivered'\n  AND c.is_internal = false\n  AND o.order_date BETWEEN '2025-07-01' AND '2025-07-31'\nGROUP BY 1\nORDER BY MIN(o.order_date);", "rows": 4, "error": null}
{"t": 1791837935.6784396, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct\nFROM public.promotions\nORDER BY start_date;", "rows": 4, "error": null}
{"t": 1791837943.9226148, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT \n    MIN(order_date) as min_date, \n    MAX(order_date) as max_date,\n    COUNT(*) as total_orders\nFROM public.orders;", "rows": 1, "error": null}
{"t": 1791837960.0995014, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_financials AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        o.customer_id,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS order_gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date, o.customer_id\n),\nperiod_tagged AS (\n    SELECT \n        *,\n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN '1. Pre-sale (10d: Jul 01-10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2. Sale (10d: Jul 11-20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN '3. Post-sale (10d: Jul 21-30)'\n            ELSE NULL\n        END AS period_10d,\n        CASE \n            WHEN order_date BETWEEN '2025-06-27' AND '2025-07-10' THEN '1. Pre-sale (14d: Jun 27-Jul 10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN '2. Sale (10d: Jul 11-20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-08-03' THEN '3. Post-sale (14d: Jul 21-Aug 03)'\n            ELSE NULL\n        END AS period_14d\n    FROM order_financials\n)\nSELECT \n    period_10d AS period,\n    COUNT(DISTINCT order_date) AS days_in_period,\n    COUNT(order_id) AS total_orders,\n    ROUND(COUNT(order_id)::numeric / COUNT(DISTINCT order_date), 2) AS daily_orders,\n    ROUND(SUM(order_net_revenue), 2) AS total_net_revenue,\n    ROUND(SUM(order_net_revenue) / COUNT(DISTINCT order_date), 2) AS daily_net_revenue,\n    ROUND(SUM(order_gross_profit), 2) AS total_gross_profit,\n    ROUND(SUM(order_gross_profit) / COUNT(DISTINCT order_date), 2) AS daily_gross_profit,\n    ROUND(SUM(order_net_revenue) / COUNT(order_id), 2) AS aov,\n    ROUND((SUM(order_gross_profit) / SUM(order_net_revenue)) * 100, 2) AS gross_margin_pct\nFROM period_tagged\nWHERE period_10d IS NOT NULL\nGROUP BY period_10d\nORDER BY period_10d;", "rows": 3, "error": null}
{"t": 1791837970.5494452, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH order_financials AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS order_net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS order_cogs,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS order_gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_metrics AS (\n    SELECT \n        CASE \n            WHEN order_date BETWEEN '2025-07-01' AND '2025-07-10' THEN 'Pre-sale (Jul 01-10)'\n            WHEN order_date BETWEEN '2025-07-11' AND '2025-07-20' THEN 'Sale (Jul 11-20)'\n            WHEN order_date BETWEEN '2025-07-21' AND '2025-07-30' THEN 'Post-sale (Jul 21-30)'\n        END AS period,\n        COUNT(DISTINCT order_date) AS days,\n        COUNT(order_id) AS total_orders,\n        SUM(order_net_revenue) AS total_net_revenue,\n        SUM(order_gross_profit) AS total_gross_profit\n    FROM order_financials\n    WHERE order_date BETWEEN '2025-07-01' AND '2025-07-30'\n    GROUP BY 1\n),\nbase AS (\n    SELECT * FROM period_metrics WHERE period = 'Pre-sale (Jul 01-10)'\n)\nSELECT \n    pm.period,\n    pm.days,\n    pm.total_orders,\n    ROUND(pm.total_orders::numeric / pm.days, 2) AS daily_orders,\n    ROUND(((pm.total_orders::numeric / pm.days) - (b.total_orders::numeric / b.days)) / (b.total_orders::numeric / b.days) * 100, 2) AS daily_orders_pct_change,\n    ROUND(pm.total_net_revenue, 2) AS total_net_revenue,\n    ROUND(pm.total_net_revenue / pm.days, 2) AS daily_net_revenue,\n    ROUND(((pm.total_net_revenue / pm.days) - (b.total_net_revenue / b.days)) / (b.total_net_revenue / b.days) * 100, 2) AS daily_revenue_pct_change,\n    ROUND(pm.total_gross_profit, 2) AS total_gross_profit,\n    ROUND(pm.total_gross_profit / pm.days, 2) AS daily_gross_profit,\n    ROUND(((pm.total_gross_profit / pm.days) - (b.total_gross_profit / b.days)) / (b.total_gross_profit / b.days) * 100, 2) AS daily_gross_profit_pct_change,\n    ROUND(pm.total_net_revenue / pm.total_orders, 2) AS aov,\n    ROUND((pm.total_gross_profit / pm.total_net_revenue) * 100, 2) AS gross_margin_pct,\n    ROUND((pm.total_gross_profit / pm.total_net_revenue) * 100 - (b.total_gross_profit / b.total_net_revenue) * 100, 2) AS margin_pt_diff,\n    ROUND(pm.total_net_revenue - (b.total_net_revenue / b.days * pm.days), 2) AS incremental_net_revenue,\n    ROUND(pm.total_gross_profit - (b.total_gross_profit / b.days * pm.days), 2) AS incremental_gross_profit\nFROM period_metrics pm\nCROSS JOIN base b\nORDER BY pm.period;", "rows": 3, "error": null}
{"t": 1791838001.3165216, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH cust_orders AS (\n    SELECT \n        c.customer_id,\n        c.signup_date,\n        c.acquisition_channel,\n        MIN(o.order_date) AS first_order_date\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    WHERE c.is_internal = false AND o.status = 'delivered'\n    GROUP BY c.customer_id, c.signup_date, c.acquisition_channel\n)\nSELECT \n    COUNT(*) AS total_delivered_customers,\n    COUNT(CASE WHEN signup_date = first_order_date THEN 1 END) AS signup_equals_first_order,\n    COUNT(CASE WHEN signup_date < first_order_date THEN 1 END) AS signup_before_first_order,\n    COUNT(CASE WHEN signup_date > first_order_date THEN 1 END) AS signup_after_first_order\nFROM cust_orders;", "rows": 1, "error": null}
{"t": 1791876871.0812976, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct FROM public.promotions WHERE (start_date >= '2025-06-15' AND start_date <= '2025-07-31') OR description ILIKE '%july%' OR promo_code ILIKE '%july%';", "rows": 1, "error": null}
{"t": 1791876902.4233742, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_definitions AS (\n    SELECT 'Baseline (28d: Jun 13 - Jul 10)' AS period_name, '2025-06-13'::date AS start_date, '2025-07-10'::date AS end_date, 28 AS days\n    UNION ALL\n    SELECT 'Sale (10d: Jul 11 - Jul 20)', '2025-07-11'::date, '2025-07-20'::date, 10\n    UNION ALL\n    SELECT 'Post-Sale (10d: Jul 21 - Jul 30)', '2025-07-21'::date, '2025-07-30'::date, 10\n    UNION ALL\n    SELECT 'Post-Sale (14d: Jul 21 - Aug 03)', '2025-07-21'::date, '2025-08-03'::date, 14\n    UNION ALL\n    SELECT 'Post-Sale (20d: Jul 21 - Aug 09)', '2025-07-21'::date, '2025-08-09'::date, 20\n    UNION ALL\n    SELECT 'Combined (Sale+10d: Jul 11 - Jul 30)', '2025-07-11'::date, '2025-07-30'::date, 20\n    UNION ALL\n    SELECT 'Combined (Sale+14d: Jul 11 - Aug 03)', '2025-07-11'::date, '2025-08-03'::date, 24\n    UNION ALL\n    SELECT 'Combined (Sale+20d: Jul 11 - Aug 09)', '2025-07-11'::date, '2025-08-09'::date, 30\n),\nperiod_metrics AS (\n    SELECT \n        p.period_name,\n        p.days,\n        p.start_date,\n        p.end_date,\n        COUNT(d.order_id) AS total_orders,\n        ROUND(COUNT(d.order_id)::numeric / p.days, 2) AS orders_per_day,\n        ROUND(SUM(COALESCE(d.net_revenue, 0)), 2) AS total_net_revenue,\n        ROUND(SUM(COALESCE(d.net_revenue, 0)) / p.days, 2) AS net_revenue_per_day,\n        ROUND(SUM(COALESCE(d.gross_profit, 0)), 2) AS total_gross_profit,\n        ROUND(SUM(COALESCE(d.gross_profit, 0)) / p.days, 2) AS gross_profit_per_day,\n        ROUND(SUM(COALESCE(d.net_revenue, 0)) / NULLIF(COUNT(d.order_id), 0), 2) AS aov,\n        ROUND(100.0 * SUM(COALESCE(d.gross_profit, 0)) / NULLIF(SUM(d.net_revenue), 0), 2) AS gross_margin_pct\n    FROM period_definitions p\n    LEFT JOIN delivered_orders d ON d.order_date >= p.start_date AND d.order_date <= p.end_date\n    GROUP BY p.period_name, p.days, p.start_date, p.end_date\n)\nSELECT * FROM period_metrics ORDER BY start_date, days;", "rows": 8, "error": null}
{"t": 1791876926.142593, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH delivered_orders AS (\n    SELECT \n        o.order_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = FALSE\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.order_date\n),\nperiod_definitions AS (\n    SELECT 'Baseline (28d: Jun 13 - Jul 10)' AS period_name, 1 AS sort_order, '2025-06-13'::date AS start_date, '2025-07-10'::date AS end_date, 28 AS days\n    UNION ALL\n    SELECT 'Sale (10d: Jul 11 - Jul 20)', 2, '2025-07-11'::date, '2025-07-20'::date, 10\n    UNION ALL\n    SELECT 'Post-Sale (10d: Jul 21 - Jul 30)', 3, '2025-07-21'::date, '2025-07-30'::date, 10\n    UNION ALL\n    SELECT 'Post-Sale (14d: Jul 21 - Aug 03)', 4, '2025-07-21'::date, '2025-08-03'::date, 14\n    UNION ALL\n    SELECT 'Post-Sale (20d: Jul 21 - Aug 09)', 5, '2025-07-21'::date, '2025-08-09'::date, 20\n    UNION ALL\n    SELECT 'Combined (Sale+10d: Jul 11 - Jul 30)', 6, '2025-07-11'::date, '2025-07-30'::date, 20\n    UNION ALL\n    SELECT 'Combined (Sale+14d: Jul 11 - Aug 03)', 7, '2025-07-11'::date, '2025-08-03'::date, 24\n    UNION ALL\n    SELECT 'Combined (Sale+20d: Jul 11 - Aug 09)', 8, '2025-07-11'::date, '2025-08-09'::date, 30\n),\nmetrics AS (\n    SELECT \n        p.period_name,\n        p.sort_order,\n        p.days,\n        p.start_date,\n        p.end_date,\n        COUNT(d.order_id) AS total_orders,\n        ROUND(COUNT(d.order_id)::numeric / p.days, 2) AS orders_per_day,\n        ROUND(SUM(d.net_revenue), 2) AS total_net_revenue,\n        ROUND(SUM(d.net_revenue) / p.days, 2) AS net_revenue_per_day,\n        ROUND(SUM(d.gross_profit), 2) AS total_gross_profit,\n        ROUND(SUM(d.gross_profit) / p.days, 2) AS gross_profit_per_day,\n        ROUND(SUM(d.net_revenue) / NULLIF(COUNT(d.order_id), 0), 2) AS aov,\n        ROUND((SUM(d.gross_profit) / NULLIF(SUM(d.net_revenue), 0)) * 100, 2) AS gross_margin_pct\n    FROM period_definitions p\n    LEFT JOIN delivered_orders d ON d.order_date >= p.start_date AND d.order_date <= p.end_date\n    GROUP BY p.period_name, p.sort_order, p.days, p.start_date, p.end_date\n),\nbaseline AS (\n    SELECT * FROM metrics WHERE sort_order = 1\n)\nSELECT \n    m.period_name,\n    m.days,\n    m.total_orders,\n    m.orders_per_day,\n    ROUND(((m.orders_per_day - b.orders_per_day) / b.orders_per_day) * 100, 2) AS orders_per_day_pct_change,\n    ROUND(m.total_orders - (b.orders_per_day * m.days), 2) AS incremental_orders,\n    m.total_net_revenue,\n    m.net_revenue_per_day,\n    ROUND(((m.net_revenue_per_day - b.net_revenue_per_day) / b.net_revenue_per_day) * 100, 2) AS net_revenue_per_day_pct_change,\n    ROUND(m.total_net_revenue - (b.net_revenue_per_day * m.days), 2) AS incremental_net_revenue,\n    m.total_gross_profit,\n    m.gross_profit_per_day,\n    ROUND(((m.gross_profit_per_day - b.gross_profit_per_day) / b.gross_profit_per_day) * 100, 2) AS gross_profit_per_day_pct_change,\n    ROUND(m.total_gross_profit - (b.gross_profit_per_day * m.days), 2) AS incremental_gross_profit,\n    m.aov,\n    ROUND(((m.aov - b.aov) / b.aov) * 100, 2) AS aov_pct_change,\n    m.gross_margin_pct,\n    ROUND(m.gross_margin_pct - b.gross_margin_pct, 2) AS gross_margin_pts_change\nFROM metrics m\nCROSS JOIN baseline b\nORDER BY m.sort_order;", "rows": 8, "error": null}
{"t": 1791876963.9435084, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_orders AS (\n    SELECT \n        o.order_id,\n        o.customer_id,\n        o.order_date,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * p.unit_cost) AS total_cost,\n        SUM(oi.quantity * oi.unit_price) - SUM(oi.quantity * p.unit_cost) AS gross_profit\n    FROM public.orders o\n    JOIN public.customers c ON o.customer_id = c.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY o.order_id, o.customer_id, o.order_date\n),\nfirst_orders AS (\n    SELECT \n        customer_id,\n        MIN(order_date) AS first_order_date\n    FROM customer_orders\n    GROUP BY customer_id\n),\nsale_customers AS (\n    SELECT \n        co.customer_id,\n        fo.first_order_date,\n        CASE \n            WHEN fo.first_order_date >= '2025-07-11' AND fo.first_order_date <= '2025-07-20' THEN 'New Customer'\n            ELSE 'Existing Customer'\n        END AS customer_type,\n        COUNT(co.order_id) AS sale_orders,\n        SUM(co.net_revenue) AS sale_net_revenue,\n        SUM(co.gross_profit) AS sale_gross_profit\n    FROM customer_orders co\n    JOIN first_orders fo ON co.customer_id = fo.customer_id\n    WHERE co.order_date BETWEEN '2025-07-11' AND '2025-07-20'\n    GROUP BY co.customer_id, fo.first_order_date\n),\nsale_customer_summary AS (\n    SELECT \n        customer_type,\n        COUNT(DISTINCT customer_id) AS customer_count,\n        SUM(sale_orders) AS total_sale_orders,\n        ROUND(SUM(sale_net_revenue), 2) AS total_sale_net_revenue,\n        ROUND(SUM(sale_gross_profit), 2) AS total_sale_gross_profit,\n        ROUND(SUM(sale_net_revenue) / SUM(sale_orders), 2) AS sale_aov,\n        ROUND(SUM(sale_gross_profit) / SUM(sale_net_revenue) * 100, 2) AS sale_gross_margin_pct\n    FROM sale_customers\n    GROUP BY customer_type\n),\nsale_repeats AS (\n    SELECT \n        sc.customer_type,\n        COUNT(DISTINCT sc.customer_id) AS total_customers,\n        COUNT(DISTINCT CASE WHEN post.order_id IS NOT NULL THEN sc.customer_id END) AS repeat_customers,\n        ROUND(COUNT(DISTINCT CASE WHEN post.order_id IS NOT NULL THEN sc.customer_id END)::numeric / COUNT(DISTINCT sc.customer_id) * 100, 2) AS repeat_rate_pct,\n        COUNT(post.order_id) AS post_sale_repeat_orders,\n        ROUND(COALESCE(SUM(post.net_revenue), 0), 2) AS post_sale_repeat_net_revenue,\n        ROUND(COALESCE(SUM(post.gross_profit), 0), 2) AS post_sale_repeat_gross_profit,\n        ROUND(COALESCE(SUM(post.gross_profit), 0) / COUNT(DISTINCT sc.customer_id), 2) AS post_sale_gp_per_customer,\n        ROUND((SUM(sc.sale_gross_profit) + COALESCE(SUM(post.gross_profit), 0)), 2) AS total_combined_gross_profit,\n        ROUND((SUM(sc.sale_gross_profit) + COALESCE(SUM(post.gross_profit), 0)) / COUNT(DISTINCT sc.customer_id), 2) AS total_gp_per_customer\n    FROM sale_customers sc\n    LEFT JOIN customer_orders post ON sc.customer_id = post.customer_id AND post.order_date > '2025-07-20'\n    GROUP BY sc.customer_type\n)\nSELECT \n    s.customer_type,\n    s.customer_count,\n    ROUND(s.customer_count::numeric / (SELECT SUM(customer_count) FROM sale_customer_summary) * 100, 2) AS pct_of_sale_customers,\n    s.total_sale_orders,\n    ROUND(s.total_sale_orders::numeric / (SELECT SUM(total_sale_orders) FROM sale_customer_summary) * 100, 2) AS pct_of_sale_orders,\n    s.total_sale_net_revenue,\n    ROUND(s.total_sale_net_revenue / (SELECT SUM(total_sale_net_revenue) FROM sale_customer_summary) * 100, 2) AS pct_of_sale_net_revenue,\n    s.total_sale_gross_profit,\n    ROUND(s.total_sale_gross_profit / (SELECT SUM(total_sale_gross_profit) FROM sale_customer_summary) * 100, 2) AS pct_of_sale_gross_profit,\n    s.sale_aov,\n    s.sale_gross_margin_pct,\n    r.repeat_customers,\n    r.repeat_rate_pct,\n    r.post_sale_repeat_orders,\n    r.post_sale_repeat_net_revenue,\n    r.post_sale_repeat_gross_profit,\n    r.post_sale_gp_per_customer,\n    r.total_combined_gross_profit,\n    r.total_gp_per_customer\nFROM sale_customer_summary s\nJOIN sale_repeats r ON s.customer_type = r.customer_type;", "rows": 2, "error": null}
{"t": 1792138605.3325934, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH anchor AS (\n    SELECT MAX(order_date) AS max_order_date\n    FROM public.orders\n    WHERE status = 'delivered'\n),\ncust_metrics AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit,\n        (SELECT max_order_date FROM anchor) - MAX(o.order_date) AS recency_days\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\ntotals AS (\n    SELECT \n        COUNT(*) AS total_purchasing_customers,\n        SUM(net_revenue) AS total_revenue,\n        SUM(gross_profit) AS total_profit,\n        SUM(order_count) AS total_orders\n    FROM cust_metrics\n),\nranked AS (\n    SELECT \n        cm.*,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile,\n        PERCENT_RANK() OVER (ORDER BY net_revenue DESC) AS rev_percent_rank\n    FROM cust_metrics cm\n),\ndecile_summary AS (\n    SELECT \n        r.decile,\n        COUNT(*) AS customer_count,\n        ROUND(COUNT(*)::numeric / t.total_purchasing_customers * 100, 2) AS pct_of_customers,\n        ROUND(SUM(r.net_revenue), 2) AS decile_net_revenue,\n        ROUND(SUM(r.net_revenue) / t.total_revenue * 100, 2) AS pct_of_net_revenue,\n        ROUND(SUM(r.gross_profit), 2) AS decile_gross_profit,\n        ROUND(SUM(r.gross_profit) / t.total_profit * 100, 2) AS pct_of_gross_profit,\n        ROUND(SUM(r.gross_profit) / NULLIF(SUM(r.net_revenue), 0) * 100, 2) AS gross_margin_pct,\n        ROUND(AVG(r.net_revenue), 2) AS avg_revenue_per_cust,\n        ROUND(AVG(r.order_count), 2) AS avg_orders_per_cust,\n        ROUND(AVG(r.recency_days), 1) AS avg_recency_days,\n        ROUND(MIN(r.net_revenue), 2) AS min_revenue,\n        ROUND(MAX(r.net_revenue), 2) AS max_revenue\n    FROM ranked r\n    CROSS JOIN totals t\n    GROUP BY r.decile, t.total_purchasing_customers, t.total_revenue, t.total_profit\n)\nSELECT \n    decile,\n    customer_count,\n    pct_of_customers,\n    decile_net_revenue,\n    pct_of_net_revenue,\n    ROUND(SUM(pct_of_net_revenue) OVER (ORDER BY decile), 2) AS cum_pct_net_revenue,\n    decile_gross_profit,\n    pct_of_gross_profit,\n    ROUND(SUM(pct_of_gross_profit) OVER (ORDER BY decile), 2) AS cum_pct_gross_profit,\n    gross_margin_pct,\n    avg_revenue_per_cust,\n    avg_orders_per_cust,\n    avg_recency_days,\n    min_revenue,\n    max_revenue\nFROM decile_summary\nORDER BY decile;", "rows": 10, "error": null}
{"t": 1792138665.105342, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH anchor AS (\n    SELECT MAX(order_date) AS max_order_date\n    FROM public.orders\n    WHERE status = 'delivered'\n),\ncust_metrics AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit,\n        (SELECT max_order_date FROM anchor) - MAX(o.order_date) AS recency_days\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\nrfm_scores AS (\n    SELECT \n        customer_id,\n        order_count,\n        net_revenue,\n        gross_profit,\n        recency_days,\n        NTILE(3) OVER (ORDER BY recency_days ASC) AS r_score,   -- 3 = most recent, 1 = least recent\n        NTILE(3) OVER (ORDER BY order_count ASC) AS f_score,    -- 3 = highest frequency\n        NTILE(3) OVER (ORDER BY net_revenue ASC) AS m_score     -- 3 = highest spend\n    FROM cust_metrics\n),\nrfm_segments AS (\n    SELECT \n        customer_id,\n        order_count,\n        net_revenue,\n        gross_profit,\n        recency_days,\n        r_score,\n        f_score,\n        m_score,\n        CASE \n            WHEN r_score = 3 AND f_score = 3 AND m_score = 3 THEN 'Champions'\n            WHEN r_score >= 2 AND f_score >= 2 AND m_score >= 2 THEN 'Loyal High-Value'\n            WHEN r_score = 3 AND f_score = 1 THEN 'New Customers'\n            WHEN r_score = 1 AND (f_score >= 2 OR m_score >= 2) THEN 'At Risk / Lapsing High-Value'\n            WHEN r_score = 1 AND f_score = 1 AND m_score = 1 THEN 'Lost Low-Value'\n            ELSE 'Mid-Tier / Developing'\n        END AS segment_name\n    FROM rfm_scores\n),\ntotals AS (\n    SELECT \n        COUNT(*)::numeric AS total_cust,\n        SUM(net_revenue) AS total_rev,\n        SUM(gross_profit) AS total_gp\n    FROM rfm_segments\n)\nSELECT \n    s.segment_name,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*) * 100.0 / MAX(t.total_cust), 2) AS pct_of_customers,\n    ROUND(SUM(s.net_revenue), 2) AS segment_net_revenue,\n    ROUND(SUM(s.net_revenue) * 100.0 / MAX(t.total_rev), 2) AS pct_of_net_revenue,\n    ROUND(SUM(s.gross_profit), 2) AS segment_gross_profit,\n    ROUND(SUM(s.gross_profit) * 100.0 / MAX(t.total_gp), 2) AS pct_of_gross_profit,\n    ROUND(SUM(s.gross_profit) * 100.0 / NULLIF(SUM(s.net_revenue), 0), 2) AS gross_margin_pct,\n    ROUND(AVG(s.net_revenue), 2) AS avg_revenue_per_cust,\n    ROUND(AVG(s.order_count), 2) AS avg_orders_per_cust,\n    ROUND(AVG(s.recency_days), 1) AS avg_recency_days\nFROM rfm_segments s\nCROSS JOIN totals t\nGROUP BY s.segment_name\nORDER BY segment_net_revenue DESC;\n", "rows": 6, "error": null}
{"t": 1792138707.5174892, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH anchor AS (\n    SELECT MAX(order_date) AS max_order_date\n    FROM public.orders\n    WHERE status = 'delivered'\n),\ncust_orders AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS order_count,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit,\n        (SELECT max_order_date FROM anchor) - MAX(o.order_date) AS recency_days\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id AND o.status = 'delivered'\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\noverall_totals AS (\n    SELECT \n        COUNT(*) AS total_customers,\n        SUM(net_revenue) AS total_revenue,\n        SUM(gross_profit) AS total_profit\n    FROM cust_orders\n),\nranked_customers AS (\n    SELECT \n        co.*,\n        NTILE(5) OVER (ORDER BY recency_days ASC) AS r_score, -- 5 is most recent, 1 is least recent\n        NTILE(5) OVER (ORDER BY order_count ASC) AS f_score,  -- 5 is most frequent\n        NTILE(5) OVER (ORDER BY net_revenue ASC) AS m_score,  -- 5 is highest spend\n        PERCENT_RANK() OVER (ORDER BY net_revenue DESC) AS rev_percent_rank\n    FROM cust_orders co\n),\nrfm_segmented AS (\n    SELECT \n        *,\n        CASE \n            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions (Recent, Frequent, High Spend)'\n            WHEN r_score >= 3 AND f_score >= 3 AND m_score >= 3 THEN 'Loyal Customers (Active & High/Mid Value)'\n            WHEN r_score >= 4 AND f_score <= 2 THEN 'Recent New / Low Frequency'\n            WHEN r_score <= 2 AND f_score >= 3 AND m_score >= 3 THEN 'At Risk / Lapsing High-Value'\n            WHEN r_score <= 2 AND f_score <= 2 AND m_score <= 2 THEN 'Lost Low-Value'\n            ELSE 'Mid-Tier / Developing'\n        END AS rfm_segment,\n        CASE\n            WHEN rev_percent_rank < 0.05 THEN 'Top 5%'\n            WHEN rev_percent_rank < 0.10 THEN 'Top 5-10%'\n            WHEN rev_percent_rank < 0.20 THEN 'Top 10-20%'\n            ELSE 'Bottom 80%'\n        END AS pareto_tier\n    FROM ranked_customers\n)\nSELECT \n    'rfm_segment' AS analysis_type,\n    rfm_segment AS segment_name,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*) * 100.0 / (SELECT total_customers FROM overall_totals), 2) AS pct_customers,\n    ROUND(SUM(net_revenue), 2) AS segment_net_revenue,\n    ROUND(SUM(net_revenue) * 100.0 / (SELECT total_revenue FROM overall_totals), 2) AS pct_revenue,\n    ROUND(SUM(gross_profit), 2) AS segment_gross_profit,\n    ROUND(SUM(gross_profit) * 100.0 / (SELECT total_profit FROM overall_totals), 2) AS pct_gross_profit,\n    ROUND(SUM(gross_profit) * 100.0 / NULLIF(SUM(net_revenue), 0), 2) AS gross_margin_pct,\n    ROUND(AVG(net_revenue), 2) AS avg_revenue_per_customer,\n    ROUND(AVG(order_count), 2) AS avg_orders,\n    ROUND(AVG(recency_days), 1) AS avg_recency_days\nFROM rfm_segmented\nGROUP BY rfm_segment\n\nUNION ALL\n\nSELECT \n    'pareto_tier' AS analysis_type,\n    pareto_tier AS segment_name,\n    COUNT(*) AS customer_count,\n    ROUND(COUNT(*) * 100.0 / (SELECT total_customers FROM overall_totals), 2) AS pct_customers,\n    ROUND(SUM(net_revenue), 2) AS segment_net_revenue,\n    ROUND(SUM(net_revenue) * 100.0 / (SELECT total_revenue FROM overall_totals), 2) AS pct_revenue,\n    ROUND(SUM(gross_profit), 2) AS segment_gross_profit,\n    ROUND(SUM(gross_profit) * 100.0 / (SELECT total_profit FROM overall_totals), 2) AS pct_gross_profit,\n    ROUND(SUM(gross_profit) * 100.0 / NULLIF(SUM(net_revenue), 0), 2) AS gross_margin_pct,\n    ROUND(AVG(net_revenue), 2) AS avg_revenue_per_customer,\n    ROUND(AVG(order_count), 2) AS avg_orders,\n    ROUND(AVG(recency_days), 1) AS avg_recency_days\nFROM rfm_segmented\nGROUP BY pareto_tier\n\nUNION ALL\n\nSELECT \n    'overall_total' AS analysis_type,\n    'Total Customer Base' AS segment_name,\n    COUNT(*) AS customer_count,\n    100.00 AS pct_customers,\n    ROUND(SUM(net_revenue), 2) AS segment_net_revenue,\n    100.00 AS pct_revenue,\n    ROUND(SUM(gross_profit), 2) AS segment_gross_profit,\n    100.00 AS pct_gross_profit,\n    ROUND(SUM(gross_profit) * 100.0 / NULLIF(SUM(net_revenue), 0), 2) AS gross_margin_pct,\n    ROUND(AVG(net_revenue), 2) AS avg_revenue_per_customer,\n    ROUND(AVG(order_count), 2) AS avg_orders,\n    ROUND(AVG(recency_days), 1) AS avg_recency_days\nFROM rfm_segmented\nORDER BY analysis_type, segment_net_revenue DESC;", "rows": 11, "error": null}
{"t": 1792139197.1010168, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_delivered AS (\n    SELECT \n        c.customer_id,\n        c.signup_date,\n        c.acquisition_channel,\n        c.country,\n        COUNT(DISTINCT o.order_id) AS delivered_orders,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit,\n        COALESCE(SUM(oi.quantity), 0) AS total_units\n    FROM public.customers c\n    LEFT JOIN public.orders o \n        ON c.customer_id = o.customer_id \n        AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON o.order_id = oi.order_id\n    LEFT JOIN public.products p \n        ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id, c.signup_date, c.acquisition_channel, c.country\n),\nranked_customers AS (\n    SELECT \n        *,\n        NTILE(10) OVER (ORDER BY net_revenue DESC) AS decile_all,\n        PERCENT_RANK() OVER (ORDER BY net_revenue DESC) AS pct_rank_all\n    FROM customer_delivered\n),\noverall_totals AS (\n    SELECT \n        COUNT(*) AS total_customers,\n        COUNT(*) FILTER (WHERE delivered_orders > 0) AS active_purchasers,\n        SUM(delivered_orders) AS total_delivered_orders,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit\n    FROM ranked_customers\n),\ndecile_summary AS (\n    SELECT \n        r.decile_all,\n        COUNT(*) AS customers_in_decile,\n        ROUND(COUNT(*)::numeric / t.total_customers * 100, 2) AS pct_of_customers,\n        SUM(r.delivered_orders) AS decile_orders,\n        ROUND(SUM(r.delivered_orders)::numeric / NULLIF(SUM(COUNT(*)) OVER (), 0) * 100, 2) AS pct_of_orders,\n        ROUND(SUM(r.net_revenue), 2) AS decile_net_revenue,\n        ROUND(SUM(r.net_revenue) / NULLIF(t.total_net_revenue, 0) * 100, 2) AS pct_of_net_revenue,\n        ROUND(SUM(r.gross_profit), 2) AS decile_gross_profit,\n        ROUND(SUM(r.gross_profit) / NULLIF(t.total_gross_profit, 0) * 100, 2) AS pct_of_gross_profit,\n        ROUND(SUM(r.gross_profit) / NULLIF(SUM(r.net_revenue), 0) * 100, 2) AS gross_margin_pct,\n        ROUND(SUM(r.net_revenue) / NULLIF(SUM(r.delivered_orders), 0), 2) AS aov,\n        ROUND(SUM(r.delivered_orders)::numeric / COUNT(*), 2) AS orders_per_customer,\n        ROUND(SUM(r.net_revenue) / COUNT(*), 2) AS revenue_per_customer,\n        MIN(ROUND(r.net_revenue, 2)) AS min_net_revenue_in_decile,\n        MAX(ROUND(r.net_revenue, 2)) AS max_net_revenue_in_decile\n    FROM ranked_customers r\n    CROSS JOIN overall_totals t\n    GROUP BY r.decile_all, t.total_customers, t.total_net_revenue, t.total_gross_profit\n    ORDER BY r.decile_all\n)\nSELECT * FROM decile_summary;", "rows": 10, "error": null}
{"t": 1792139255.5445304, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_delivered AS (\n    SELECT \n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS delivered_orders,\n        COALESCE(SUM(oi.quantity * oi.unit_price), 0) AS net_revenue,\n        COALESCE(SUM(oi.quantity * (oi.unit_price - p.unit_cost)), 0) AS gross_profit\n    FROM public.customers c\n    LEFT JOIN public.orders o \n        ON c.customer_id = o.customer_id \n        AND o.status = 'delivered'\n    LEFT JOIN public.order_items oi \n        ON o.order_id = oi.order_id\n    LEFT JOIN public.products p \n        ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n    GROUP BY c.customer_id\n),\nranked_customers AS (\n    SELECT \n        customer_id,\n        delivered_orders,\n        net_revenue,\n        gross_profit,\n        NTILE(10) OVER (ORDER BY net_revenue DESC, gross_profit DESC, customer_id) AS decile\n    FROM customer_delivered\n),\ntiered_customers AS (\n    SELECT \n        customer_id,\n        delivered_orders,\n        net_revenue,\n        gross_profit,\n        CASE WHEN decile = 1 THEN 'Top 10%' ELSE 'Remaining 90%' END AS customer_tier\n    FROM ranked_customers\n),\ntier_aggregates AS (\n    SELECT \n        customer_tier,\n        COUNT(*) AS customer_count,\n        SUM(delivered_orders) AS total_orders,\n        SUM(net_revenue) AS total_net_revenue,\n        SUM(gross_profit) AS total_gross_profit,\n        MIN(net_revenue) AS min_revenue,\n        MAX(net_revenue) AS max_revenue\n    FROM tiered_customers\n    GROUP BY customer_tier\n),\ntotals AS (\n    SELECT \n        COUNT(*) AS all_customers,\n        SUM(delivered_orders) AS all_orders,\n        SUM(net_revenue) AS all_net_revenue,\n        SUM(gross_profit) AS all_gross_profit\n    FROM tiered_customers\n)\nSELECT \n    ta.customer_tier,\n    ta.customer_count,\n    ROUND(100.0 * ta.customer_count / t.all_customers, 2) AS pct_of_customers,\n    ta.total_orders,\n    ROUND(100.0 * ta.total_orders / t.all_orders, 2) AS pct_of_orders,\n    ROUND(ta.total_net_revenue, 2) AS total_net_revenue,\n    ROUND(100.0 * ta.total_net_revenue / t.all_net_revenue, 2) AS pct_of_net_revenue,\n    ROUND(ta.total_gross_profit, 2) AS total_gross_profit,\n    ROUND(100.0 * ta.total_gross_profit / t.all_gross_profit, 2) AS pct_of_gross_profit,\n    ROUND(100.0 * ta.total_gross_profit / NULLIF(ta.total_net_revenue, 0), 2) AS gross_margin_pct,\n    ROUND(ta.total_net_revenue / NULLIF(ta.total_orders, 0), 2) AS aov,\n    ROUND(ta.total_orders::numeric / ta.customer_count, 2) AS orders_per_customer,\n    ROUND(ta.total_net_revenue / ta.customer_count, 2) AS revenue_per_customer,\n    ROUND(ta.min_revenue, 2) AS min_revenue,\n    ROUND(ta.max_revenue, 2) AS max_revenue\nFROM tier_aggregates ta\nCROSS JOIN totals t\n\nUNION ALL\n\nSELECT \n    'Total / Overall' AS customer_tier,\n    t.all_customers AS customer_count,\n    100.00 AS pct_of_customers,\n    t.all_orders AS total_orders,\n    100.00 AS pct_of_orders,\n    ROUND(t.all_net_revenue, 2) AS total_net_revenue,\n    100.00 AS pct_of_net_revenue,\n    ROUND(t.all_gross_profit, 2) AS total_gross_profit,\n    100.00 AS pct_of_gross_profit,\n    ROUND(100.0 * t.all_gross_profit / NULLIF(t.all_net_revenue, 0), 2) AS gross_margin_pct,\n    ROUND(t.all_net_revenue / NULLIF(t.all_orders, 0), 2) AS aov,\n    ROUND(t.all_orders::numeric / t.all_customers, 2) AS orders_per_customer,\n    ROUND(t.all_net_revenue / t.all_customers, 2) AS revenue_per_customer,\n    (SELECT ROUND(MIN(net_revenue), 2) FROM customer_delivered) AS min_revenue,\n    (SELECT ROUND(MAX(net_revenue), 2) FROM customer_delivered) AS max_revenue\nFROM totals t\nORDER BY customer_tier;", "rows": 3, "error": null}
{"t": 1792150370.0359466, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "WITH customer_delivered AS (\n    SELECT\n        c.customer_id,\n        COUNT(DISTINCT o.order_id) AS delivered_orders,\n        SUM(oi.quantity * oi.unit_price) AS net_revenue,\n        SUM(oi.quantity * (oi.unit_price - p.unit_cost)) AS gross_profit\n    FROM public.customers c\n    JOIN public.orders o ON c.customer_id = o.customer_id\n    JOIN public.order_items oi ON o.order_id = oi.order_id\n    JOIN public.products p ON oi.product_id = p.product_id\n    WHERE c.is_internal = false\n      AND o.status = 'delivered'\n    GROUP BY c.customer_id\n),\noverall_totals AS (\n    SELECT\n        COUNT(DISTINCT c.customer_id) AS total_customers_signed_up,\n        COUNT(DISTINCT cd.customer_id) AS total_delivered_customers,\n        SUM(cd.delivered_orders) AS grand_total_orders,\n        SUM(cd.net_revenue) AS grand_total_revenue,\n        SUM(cd.gross_profit) AS grand_total_gross_profit\n    FROM public.customers c\n    LEFT JOIN customer_delivered cd ON c.customer_id = cd.customer_id\n    WHERE c.is_internal = false\n),\ncustomer_ranked AS (\n    SELECT\n        cd.*,\n        NTILE(10) OVER (ORDER BY cd.net_revenue DESC) AS decile,\n        PERCENT_RANK() OVER (ORDER BY cd.net_revenue DESC) AS pct_rank\n    FROM customer_delivered cd\n),\ndecile_summary AS (\n    SELECT\n        cr.decile,\n        COUNT(*) AS customer_count,\n        ROUND(COUNT(*)::numeric / ot.total_delivered_customers * 100, 2) AS pct_of_active_customers,\n        ROUND(SUM(cr.net_revenue), 2) AS decile_revenue,\n        ROUND(SUM(cr.net_revenue) / ot.grand_total_revenue * 100, 2) AS revenue_share_pct,\n        ROUND(SUM(cr.gross_profit), 2) AS decile_gross_profit,\n        ROUND(SUM(cr.gross_profit) / ot.grand_total_gross_profit * 100, 2) AS gross_profit_share_pct,\n        SUM(cr.delivered_orders) AS decile_orders,\n        ROUND(SUM(cr.delivered_orders)::numeric / ot.grand_total_orders * 100, 2) AS order_share_pct,\n        ROUND(AVG(cr.net_revenue), 2) AS avg_revenue_per_customer,\n        ROUND(AVG(cr.gross_profit), 2) AS avg_profit_per_customer,\n        ROUND(AVG(cr.delivered_orders), 2) AS avg_orders_per_customer,\n        ROUND(SUM(cr.net_revenue) / SUM(cr.delivered_orders), 2) AS decile_aov,\n        ROUND(MIN(cr.net_revenue), 2) AS min_customer_revenue,\n        ROUND(MAX(cr.net_revenue), 2) AS max_customer_revenue\n    FROM customer_ranked cr\n    CROSS JOIN overall_totals ot\n    GROUP BY cr.decile, ot.total_delivered_customers, ot.grand_total_revenue, ot.grand_total_gross_profit, ot.grand_total_orders\n    ORDER BY cr.decile\n)\nSELECT * FROM decile_summary;", "rows": 10, "error": null}
{"t": 1792231410.3395133, "brand": "aa8af0b0-2045-496e-8157-d3a63c551ef4", "sql": "SELECT promo_code, description, start_date, end_date, discount_pct FROM public.promotions ORDER BY start_date;", "rows": 4, "error": null}
